+def lstrip_iter(iterable, values=None, predicate=None):
+    """Remove leading elements from an iterable.
+
+    If values is provided, elements are removed if they are in values.
+    If predicate is provided, elements are removed if predicate(element) is True.
+    If neither is provided, elements are removed if they are falsy.
+    """
+    it = iter(iterable)
+    for x in it:
+        if values is not None:
+            if x in values:
+                continue
+        elif predicate is not None:
+            if predicate(x):
+                continue
+        else:
+            if not x:
+                continue
+        yield x
+        break
+    yield from it
+
+def rstrip_iter(iterable, values=None, predicate=None):
+    """Remove trailing elements from an iterable."""
+    # Since we can't know the end of an arbitrary iterable without consuming it,
+    # we must buffer it.
+    items = list(iterable)
+    while items:
+        x = items[-1]
+        if values is not None:
+            if x in values:
+                items.pop()
+                continue
+        elif predicate is not None:
+            if predicate(x):
+                items.pop()
+                continue
+        else:
+            if not x:
+                items.pop()
+                continue
+        break
+    return iter(items)
+
+def strip_iter(iterable, values=None, predicate=None):
+    """Remove leading and trailing elements from an iterable."""
+    # We must consume the iterable to find the trailing elements.
+    # We use lstrip_iter first, then rstrip_iter on the result.
+    return rstrip_iter(lstrip_iter(iterable, values, predicate), values, predicate)
+
+def lstrip(iterable, values=None, predicate=None):
+    """Convenience wrapper for lstrip_iter that returns a list."""
+    return list(lstrip_iter(iterable, values, predicate))
+
+def rstrip(iterable, values=None, predicate=None):
+    """Convenience wrapper for rstrip_iter that returns a list."""
+    return list(rstrip_iter(iterable, values, predicate))
+
+def strip(iterable, values=None, predicate=None):
+    """Convenience wrapper for strip_iter that returns a list."""
+    return list(strip_iter(iterable, values, predicate))
 

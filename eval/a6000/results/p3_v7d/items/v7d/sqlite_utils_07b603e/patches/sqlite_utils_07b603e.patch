+def dedupe_keys(keys: Iterable[str]) -> List[str]:
+    """
+    Rename duplicate keys by adding a numeric suffix (e.g. id, id_2).
+    """
+    seen = set()
+    deduped = []
+    for key in keys:
+        if key in seen:
+            suffix = 2
+            new_key = f"{key}_{suffix}"
+            while new_key in seen:
+                suffix += 1
+                new_key = f"{key}_{suffix}"
+            deduped.append(new_key)
+            seen.add(new_key)
+        else:
+            deduped.append(key)
+            seen.add(key)
+    return deduped
+
+

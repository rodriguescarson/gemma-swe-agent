@@ -0,0 +1,26 @@
+import sqlite3
+from sqlite_utils import Database
+
+db = Database(":memory:")
+db.conn.execute("PRAGMA foreign_keys=ON")
+
+# Create tables
+db["authors"].insert({"id": 1, "name": "Tina"}, pk="id")
+db["books"].insert(
+    {"id": 1, "title": "Book", "author_id": 1},
+    pk="id",
+    foreign_keys={"author_id": "authors.id"},
+)
+
+print("Initial state: OK")
+
+try:
+    with db.atomic():
+        print("Starting transform inside transaction...")
+        # Transform the parent table.
+        db["authors"].transform(rename={"name": "full_name"})
+        print("Transform finished successfully")
+except Exception as e:
+    print(f"Caught exception: {type(e).__name__}: {e}")
+
+print("Done")

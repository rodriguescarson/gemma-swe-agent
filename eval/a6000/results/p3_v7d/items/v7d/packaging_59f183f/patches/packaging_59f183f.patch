+def normalize_pre(value: tuple[str, int]) -> tuple[Literal["a", "b", "rc"], int]:
+    """Normalize a pre-release tuple."""
+    letter, number = value
+    if letter == "alpha":
+        letter = "a"
+    elif letter == "beta":
+        letter = "b"
+    elif letter == "c":
+        letter = "rc"
+    elif letter == "pre":
+        letter = "a"
+    elif letter == "preview":
+        letter = "a"
+
+    if letter not in ("a", "b", "rc"):
+        raise InvalidVersion(f"pre must be a tuple of ('a'|'b'|'rc', non-negative int), got {value}")
+
+    return letter, number
+
+

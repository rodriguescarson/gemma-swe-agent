diff --git a/action.yml b/action.yml
index 733fcbe..5a3c14c 100644
--- a/action.yml
+++ b/action.yml
@@ -44,10 +44,15 @@ inputs:
 branding:
   color: "black"
   icon: "check-circle"
+outputs:
+  is_formatted:
+    description: "Whether the code is formatted"
+    value: ${{ steps.black.outputs.is_formatted }}
 runs:
   using: composite
   steps:
     - name: black
+      id: black
       run: |
         # Even when black fails, do not close the shell
         set +e
@@ -71,6 +76,13 @@ runs:
           echo "\`\`\`" >> $GITHUB_STEP_SUMMARY
         fi
 
+        # Set the is_formatted output
+        if [ "${exit_code}" -eq 0 ]; then
+          echo "is_formatted=true" >> $GITHUB_OUTPUT
+        else
+          echo "is_formatted=false" >> $GITHUB_OUTPUT
+        fi
+
         # Exit with the exit-code returned by Black
         exit ${exit_code}
       env:
diff --git a/docs/integrations/github_actions.md b/docs/integrations/github_actions.md
index 5f540e0..89b0de6 100644
--- a/docs/integrations/github_actions.md
+++ b/docs/integrations/github_actions.md
@@ -103,14 +103,16 @@ You can also configure the arguments passed to _Black_ via `options` (defaults t
 `'--check --diff'`) and `src` (default is `'.'`). Please note that the
 [`--check` flag](labels/exit-code) is required so that the workflow fails if _Black_
 finds files that need to be formatted.
-
 Here's an example configuration:
 
 ```yaml
 - uses: psf/black@stable
   with:
-    options: "--check --verbose"
-    src: "./src"
-    jupyter: true
-    version: "21.5b1"
+    options: "--check"
 ```
+
+### Outputs
+
+The action provides the following output:
+
+- `is_formatted`: `true` if the code is formatted, `false` otherwise.

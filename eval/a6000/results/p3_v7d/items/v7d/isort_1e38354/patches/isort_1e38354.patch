+def stream_imports(
+    contents: Union[str, Path],
+    extension: Optional[str] = None,
+    config: Config = DEFAULT_CONFIG,
+    file_path: Optional[Path] = None,
+    disregard_skip: bool = False,
+    **config_kwargs,
+):
+    """Yields imports found in the provided code string or file."""
+    if isinstance(contents, Path) or (isinstance(contents, str) and (Path(contents).exists() if not contents.startswith("-") else False)):
+        with io.File.read(contents) as source_file:
+            code = source_file.read()
+            actual_file_path = file_path or source_file.path
+    else:
+        code = contents
+        actual_file_path = file_path
+
+    config = _config(path=actual_file_path, config=config, **config_kwargs)
+    parsed = core.parse_content(code, config=config, extension=extension or "py")
+    
+    for section, imports in parsed.imports.items():
+        for import_name, import_data in imports.items():
+            yield import_name
+
+def list_imports(
+    contents: Union[str, Path],

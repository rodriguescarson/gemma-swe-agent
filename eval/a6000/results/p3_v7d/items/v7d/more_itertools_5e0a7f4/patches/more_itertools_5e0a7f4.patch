+def interleave_randomly(*iterables):
+    """Return a new iterable yielding from each iterable in random order,
+    skipping any that are exhausted.
+
+    >>> import random
+    >>> random.seed(0)
+    >>> list(interleave_randomly([1, 2], [3, 4], [5, 6]))
+    [3, 4, 1, 5, 6, 2]
+    """
+    import random as _random
+    iterators = [iter(it) for it in iterables]
+    while iterators:
+        it = _random.choice(iterators)
+        try:
+            yield next(it)
+        except StopIteration:
+            iterators.remove(it)
 

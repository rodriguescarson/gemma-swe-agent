diff --git a/src/attr/validators.py b/src/attr/validators.py
index 0695cd2..0cb50c9 100644
--- a/src/attr/validators.py
+++ b/src/attr/validators.py
@@ -19,6 +19,7 @@ from .exceptions import NotCallableError
 
 __all__ = [
     "and_",
+    "or_",
     "deep_iterable",
     "deep_mapping",
     "disabled",
@@ -614,3 +615,55 @@ def not_(validator, *, msg=None, exc_types=(ValueError, TypeError)):
     except TypeError:
         exc_types = (exc_types,)
     return _NotValidator(validator, msg, exc_types)
+
+
+class _OrValidator:
+    """
+    A validator that is satisfied if at least one of the wrapped validators is satisfied.
+    """
+
+    def __init__(self, validators):
+        self._validators = validators
+
+    def __call__(self, inst, attr, value):
+        errors = []
+        for v in self._validators:
+            try:
+                v(inst, attr, value)
+            except (ValueError, TypeError) as e:
+                errors.append(e)
+            else:
+                return
+
+        raise ValueError(
+            "None of the validators in or_ were satisfied",
+            attr,
+            self._validators,
+            value,
+        )
+
+    def __repr__(self):
+        return f"<or_ validator wrapping {self._validators!r}>"
+
+
+def or_(*validators):
+    """
+    A validator that is satisfied if at least one of the wrapped validators is satisfied.
+
+    When called on a value, it runs the wrapped validators until one of them
+    succeeds (i.e. does not raise a `ValueError` or `TypeError`).
+
+    :param ~collections.abc.Iterable[typing.Callable] validators: Arbitrary
+        number of validators.
+
+    .. versionadded:: 23.1.0
+    """
+    vals = []
+    for validator in validators:
+        vals.extend(
+            validator._validators
+            if isinstance(validator, _OrValidator)
+            else [validator]
+        )
+
+    return _OrValidator(tuple(vals))

diff --git a/boltons/mathutils.py b/boltons/mathutils.py
index eb5a4b1..1544946 100644
--- a/boltons/mathutils.py
+++ b/boltons/mathutils.py
@@ -87,3 +87,28 @@ def floor(x, options=None):
     if not i:
         raise ValueError("no floor options less than or equal to: %r" % x)
     return options[i - 1]
+
+
+def bits(n):
+    """Return the number of bits required to represent an integer *n*.
+
+    >>> bits(0)
+    0
+    >>> bits(1)
+    1
+    >>> bits(2)
+    2
+    >>> bits(3)
+    2
+    >>> bits(4)
+    3
+    >>> bits(-1)
+    1
+    >>> bits(-2)
+    2
+    >>> bits(-3)
+    2
+    >>> bits(-4)
+    3
+    """
+    return n.bit_length()

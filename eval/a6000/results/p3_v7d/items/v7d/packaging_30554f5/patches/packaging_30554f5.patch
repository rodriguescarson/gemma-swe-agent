+def _generic_abi(py_version: Optional[PythonVersion] = None) -> List[str]:
+    abis = []
+    ext_suffix = sysconfig.get_config_var("EXT_SUFFIX")
+    if ext_suffix:
+        # The EXT_SUFFIX is something like .cpython-39-x86_64-linux-gnu.so
+        # We want to extract the part between the first dot and the last dot.
+        # This is a simplified version of what wheel.bdist_wheel does.
+        parts = ext_suffix.split(".")
+        if len(parts) >= 2:
+            abi = parts[-2]
+            abis.append(_normalize_string(abi))
+        elif ext_suffix:
+            # Fallback for cases where EXT_SUFFIX doesn't have dots, 
+            # but we still want to try and use it.
+            abis.append(_normalize_string(ext_suffix))
+    elif py_version:
+        abis.extend(_cpython_abis(py_version))
+    return abis
 
 

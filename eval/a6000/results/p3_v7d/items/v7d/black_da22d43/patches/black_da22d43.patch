+def _write_to_stdout(text: str, encoding: str, newline: str) -> None:
+    """Write text to stdout, handling encoding and newlines."""
+    if hasattr(sys.stdout, "buffer"):
+        f = io.TextIOWrapper(
+            sys.stdout.buffer, encoding=encoding, newline=newline, write_through=True
+        )
+        try:
+            f = wrap_stream_for_windows(f)
+            f.write(text)
+        finally:
+            f.detach()
+    else:
+        # If sys.stdout has no buffer, it's likely a custom stream (e.g. Jupyter)
+        # that only accepts strings. We handle newline translation manually.
+        sys.stdout.write(text.replace("\n", newline))
+

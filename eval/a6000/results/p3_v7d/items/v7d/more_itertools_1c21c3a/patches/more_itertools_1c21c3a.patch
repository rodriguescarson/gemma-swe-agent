+def running_mean(iterable, *, maxlen=None):
+    """Compute the running mean of an iterable.
+
+    If maxlen is specified, the mean is computed over a sliding window of size maxlen.
+
+    >>> list(running_mean([1, 2, 3, 4]))
+    [1.0, 1.5, 2.0, 2.5]
+    >>> list(running_mean([1, 2, 3, 4], maxlen=2))
+    [1.0, 1.5, 2.5, 3.5]
+    """
+    it = iter(iterable)
+    total = 0.0
+    count = 0
+    if maxlen is None:
+        for x in it:
+            total += x
+            count += 1
+            yield total / count
+    else:
+        from collections import deque
+        window = deque(maxlen=maxlen)
+        for x in it:
+            window.append(x)
+            yield sum(window) / len(window)
+
 _marker = object()
 
 

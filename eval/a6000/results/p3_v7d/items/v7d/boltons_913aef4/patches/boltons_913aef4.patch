+def update_wrapper(wrapper, wrapped, injected=None, expected=None, build_from=None, hide_wrapped=False, **kw):
+    """Modeled after the built-in :func:`functools.update_wrapper`, this function
+    is used to make a wrapper function reflect the wrapped function's
+    attributes and signature.
+
+    Args:
+
+        wrapper (function): The wrapper function to be updated.
+        wrapped (function): The callable whose attributes are to be copied.
+        injected (list): An optional list of argument names which
+            should not appear in the new wrapper's signature.
+        expected (list): An optional list of argument names (or (name,
+            default) pairs) representing new arguments introduced by
+            the wrapper (the opposite of *injected*).
+        build_from (function): The function to use as the basis for the
+            new signature. Defaults to *wrapped*.
+        hide_wrapped (bool): Whether to hide the wrapped function from
+            introspection (e.g. :func:`inspect.signature`). Defaults to False.
+        update_dict (bool): Whether to copy other, non-standard
+            attributes of *wrapped* over to the wrapper. Defaults to True.
+        inject_to_varkw (bool): Ignore missing arguments when a
+            ``**kwargs``-type catch-all is present. Defaults to True.
+
+    Returns:
+        The updated wrapper function.
+    """
+    if injected is None:
+        injected = []
+    elif isinstance(injected, str):
+        injected = [injected]
+    else:
+        injected = list(injected)
+
+    expected_items = _parse_wraps_expected(expected)
+
+    if isinstance(wrapped, (classmethod, staticmethod)):
+        raise TypeError('update_wrapper does not support wrapping classmethods and'
+                        ' staticmethods, change the order of wrapping to'
+                        ' wrap the underlying function: %r'
+                        % (getattr(wrapped, '__func__', None),))
+
+    update_dict = kw.pop('update_dict', True)
+    inject_to_varkw = kw.pop('inject_to_varkw', True)
+    if kw:
+        raise TypeError('unexpected kwargs: %r' % kw.keys())
+
+    # Copy attributes from wrapped to wrapper
+    attrs = ('__module__', '__name__', '__qualname__', '__doc__', '__annotations__')
+    for attr in attrs:
+        try:
+            setattr(wrapper, attr, getattr(wrapped, attr))
+        except AttributeError:
+            pass
+
+    if update_dict:
+        # Copy other attributes
+        for attr, value in vars(wrapped).items():
+            if attr not in attrs:
+                try:
+                    setattr(wrapper, attr, value)
+                except AttributeError:
+                    pass
+
+    # Handle signature
+    build_target = build_from if build_from is not None else wrapped
+    fb = FunctionBuilder.from_func(build_target)
+    for arg in injected:
+        try:
+            fb.remove_arg(arg)
+        except MissingArgument:
+            if inject_to_varkw and fb.varkw is not None:
+                continue  # keyword arg will be caught by the varkw
+            raise
+
+    for arg, default in expected_items:
+        fb.add_arg(arg, default)  # may raise ExistingArgument
+
+    if fb.is_async:
+        fb.body = 'return await _call(%s)' % fb.get_invocation_str()
+    else:
+        fb.body = 'return _call(%s)' % fb.get_invocation_str()
+
+    execdict = dict(_call=wrapper, _func=wrapped)
+    fully_wrapped = fb.get_func(execdict, with_dict=update_dict)
+
+    if not hide_wrapped:
+        fully_wrapped.__wrapped__ = wrapped  # ref to the original function (#115)
+
+    return fully_wrapped
+
+

+def doublestarmap(func, iterable):
+    """Return an iterator that applies func to each item in iterable,
+    unpacking the item as keyword arguments.
+
+    >>> list(doublestarmap(lambda a, b: a + b, [{'a': 1, 'b': 2}, {'a': 3, 'b': 4}]))
+    [3, 7]
+    """
+    for item in iterable:
+        yield func(**item)
+

+def derangements(iterable, *, by_index=True):
+    """
+    Generate all derangements of the input.
+
+    A derangement is a permutation of the elements of a sequence in which
+    no element appears in its original position.
+
+    If by_index is True, the original position is determined by the index.
+    If by_index is False, the original position is determined by the value.
+
+    >>> list(derangements([1, 2, 3]))
+    [(2, 3, 1), (3, 1, 2)]
+    >>> list(derangements([1, 1, 2]))
+    [(1, 2, 1), (2, 1, 1)]
+    >>> list(derangements([1, 1, 2], by_index=False))
+    []
+    """
+    import itertools
+    items = list(iterable)
+    n = len(items)
+    if n == 0:
+        yield ()
+        return
+
+    if by_index:
+        for p in itertools.permutations(range(n)):
+            for i, val in enumerate(p):
+                if i == val:
+                    break
+            else:
+                yield tuple(items[i] for i in p)
+    else:
+        for p in itertools.permutations(items):
+            for i, val in enumerate(p):
+                if val == items[i]:
+                    break
+            else:
+                yield p
+
+
+def distinct_derangements(iterable, *, by_index=True):
+    """
+    Generate all unique derangements of the input.
+
+    >>> list(distinct_derangements([1, 1, 2]))
+    [(1, 2, 1), (2, 1, 1)]
+    """
+    items = list(iterable)
+    n = len(items)
+    if n == 0:
+        yield ()
+        return
+
+    if by_index:
+        seen = set()
+        for d in derangements(iterable, by_index=True):
+            if d not in seen:
+                yield d
+                seen.add(d)
+    else:
+        for p in distinct_permutations(items):
+            for i, val in enumerate(p):
+                if val == items[i]:
+                    break
+            else:
+                yield p
+

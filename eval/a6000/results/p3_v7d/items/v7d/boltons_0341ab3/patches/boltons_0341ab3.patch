diff --git a/boltons/dictutils.py b/boltons/dictutils.py
index 31a1951..fe40f28 100644
--- a/boltons/dictutils.py
+++ b/boltons/dictutils.py
@@ -185,6 +185,24 @@ class OrderedMultiDict(dict):
         if kwargs:
             self.update(kwargs)
 
+    def __getstate__(self):
+        return (self.root, self._map, list(self.iteritems(multi=True)))
+
+    def __setstate__(self, state):
+        self.root, self._map, items = state
+        # Restore internal state
+        self.__dict__['root'] = self.root
+        self.__dict__['_map'] = self._map
+        # Restore the dict items
+        for k, v in items:
+            # We must use the base dict's __setitem__ to avoid triggering OMD's __setitem__
+            # which would call _insert and potentially modify the restored root/map.
+            # However, OMD's __setitem__ is what we want for the final state.
+            # Wait, the issue is that pickle.loads might be calling __setitem__ 
+            # BEFORE __setstate__ if it's using the default dict pickling.
+            # But we defined __getstate__ and __setstate__.
+            super(OrderedMultiDict, self).__setitem__(k, v)
+
     def _clear_ll(self):
         try:
             _map = self._map

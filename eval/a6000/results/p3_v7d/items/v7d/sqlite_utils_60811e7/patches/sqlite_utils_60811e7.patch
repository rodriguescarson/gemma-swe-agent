diff --git a/tests/test_rowid_regressions.py b/tests/test_rowid_regressions.py
new file mode 100644
index 0000000..a96865e
--- /dev/null
+++ b/tests/test_rowid_regressions.py
@@ -0,0 +1,36 @@
+import pytest
+from sqlite_utils import Database
+
+def test_insert_pk_rowid():
+    db = Database(":memory:")
+    db["test"].insert({"name": "foo"})
+    # This should not raise InvalidColumns or KeyError
+    db["test"].insert({"name": "bar"}, pk="rowid")
+    assert db["test"].last_pk == 2
+
+def test_insert_ignore_last_rowid():
+    db = Database(":memory:")
+    db["test"].insert({"name": "foo"})
+    first_rowid = db["test"].last_rowid
+    
+    # Insert the same record with ignore=True
+    # Since there is no explicit PK, it's a rowid table.
+    # But wait, if there's no PK, how does it conflict?
+    # We need a UNIQUE constraint to trigger IGNORE.
+    db["test"].run("CREATE UNIQUE INDEX idx_name ON test(name)")
+    
+    db["test"].insert({"name": "foo"}, ignore=True)
+    
+    # It should have found the existing row and set last_rowid and last_pk
+    assert db["test"].last_rowid == first_rowid
+    assert db["test"].last_pk == first_rowid
+
+def test_insert_ignore_last_rowid_with_pk():
+    db = Database(":memory:")
+    db["test"].create({"id": "INTEGER PRIMARY KEY", "name": "TEXT"})
+    db["test"].insert({"id": 1, "name": "foo"})
+    
+    db["test"].insert({"id": 1, "name": "bar"}, ignore=True)
+    
+    assert db["test"].last_rowid == 1
+    assert db["test"].last_pk == 1

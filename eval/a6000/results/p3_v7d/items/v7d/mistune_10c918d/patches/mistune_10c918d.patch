--- a/src/mistune/renderers/markdown.py
+++ b/src/mistune/renderers/markdown.py
@@ -77,7 +77,21 @@ class MarkdownRenderer(BaseRenderer):
         return "!" + self.link(token, state)
 
     def codespan(self, token: Dict[str, Any], state: BlockState) -> str:
-        return "`" + cast(str, token["raw"]) + "`"
+        content = cast(str, token["raw"])
+        max_backticks = 0
+        current_backticks = 0
+        for char in content:
+            if char == "`":
+                current_backticks += 1
+                max_backticks = max(max_backticks, current_backticks)
+            else:
+                current_backticks = 0
+
+        delimiter = "`" * (max_backticks + 1)
+        if content.startswith("`") or content.endswith("`"):
+            content = " " + content + " "
+
+        return delimiter + content + delimiter
 
     def linebreak(self, token: Dict[str, Any], state: BlockState) -> str:
         return "  \n"

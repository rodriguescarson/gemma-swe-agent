diff --git a/tests/test_android_tags.py b/tests/test_android_tags.py
new file mode 100644
index 0000000..64f155a
--- /dev/null
+++ b/tests/test_android_tags.py
@@ -0,0 +1,25 @@
+import pytest
+from packaging.tags import android_platforms
+
+def test_android_platforms_custom_values():
+    # Test with specific api_level and multiarch
+    tags = list(android_platforms(api_level=23, multiarch="arm64-v8a"))
+    assert tags == ["android_23_arm64_v8a", "android_22_arm64_v8a", "android_21_arm64_v8a"]
+
+def test_android_platforms_min_level():
+    # Test that it stops at 21
+    tags = list(android_platforms(api_level=21, multiarch="x86_64"))
+    assert tags == ["android_21_x86_64"]
+
+def test_android_platforms_below_min():
+    # Test that it yields nothing if api_level < 21
+    tags = list(android_platforms(api_level=20, multiarch="armv7l"))
+    assert tags == []
+
+def test_android_platforms_defaults():
+    # Test that it works with defaults (should use fallback 34 and sys.implementation._multiarch)
+    # Since we can't easily mock sys.implementation._multiarch in a simple test without 
+    # knowing the environment, we just check that it yields something.
+    tags = list(android_platforms())
+    assert len(tags) > 0
+    assert tags[0].startswith("android_")

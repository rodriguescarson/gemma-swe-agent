@@ -0,0 +1,104 @@
+import re
+
+__all__ = ['plugin_definition_lists']
+
+# Definition lists are typically:
+# Term
+# : Definition
+
+# This is a simplified approach following the task_lists pattern.
+# We look for paragraphs that start with ':' and treat the preceding paragraph as the term.
+
+def definition_lists_hook(md, tokens, state):
+    i = 0
+    while i < len(tokens):
+        if tokens[i]['type'] == 'paragraph':
+            children = tokens[i].get('children', [])
+            if children and children[0]['type'] == 'text' and children[0]['text'].startswith(':'):
+                # This is a definition. Check if there is a preceding paragraph to be the term.
+                if i > 0 and tokens[i-1]['type'] == 'paragraph':
+                    # Found a term-definition pair.
+                    # We need to wrap them in a definition list.
+                    # Since mistune's AST is a flat list of blocks, we can't easily wrap them
+                    # without changing the structure.
+                    # However, we can mark them and let the renderer handle it,
+                    # or we can try to group them.
+                    
+                    # For simplicity and following the task_lists pattern of modifying tokens:
+                    term_tok = tokens[i-1]
+                    def_tok = tokens[i]
+                    
+                    # Convert definition paragraph to a definition_list_item
+                    # Remove the leading ':' from the definition text
+                    text = def_tok['children'][0]['text']
+                    def_tok['children'][0]['text'] = text[1:].strip()
+                    def_tok['type'] = 'definition_list_item'
+                    
+                    # Convert term paragraph to a definition_term
+                    term_tok['type'] = 'definition_term'
+                    
+                    # Note: This doesn't group them into a <dl> yet.
+                    # A better way would be to group consecutive term/def pairs.
+                i += 1
+            else:
+                i += 1
+        else:
+            i += 1
+    
+    # Now group consecutive term and definition items into a definition_list
+    new_tokens = []
+    i = 0
+    while i < len(tokens):
+        if tokens[i]['type'] == 'definition_term':
+            dl_children = []
+            while i < len(tokens) and tokens[i]['type'] in ('definition_term', 'definition_list_item'):
+                dl_children.append(tokens[i])
+                i += 1
+            new_tokens.append({
+                'type': 'definition_list',
+                'children': dl_children
+            })
+        else:
+            new_tokens.append(tokens[i])
+            i += 1
+            
+    return new_tokens
+
+def render_ast_definition_list(children, **kwargs):
+    return {
+        'type': 'definition_list',
+        'children': children,
+    }
+
+def render_html_definition_list(children, **kwargs):
+    return '<dl>\n' + ''.join(children) + '</dl>\n'
+
+def render_ast_definition_term(children, **kwargs):
+    return {
+        'type': 'definition_term',
+        'children': children,
+    }
+
+def render_html_definition_term(children, **kwargs):
+    return '<dt>' + ''.join(children) + '</dt>\n'
+
+def render_ast_definition_list_item(children, **kwargs):
+    return {
+        'type': 'definition_list_item',
+        'children': children,
+    }
+
+def render_html_definition_list_item(children, **kwargs):
+    return '<dd>' + ''.join(children) + '</dd>\n'
+
+def plugin_definition_lists(md):
+    md.before_render_hooks.append(definition_lists_hook)
+
+    if md.renderer.NAME == 'html':
+        md.renderer.register('definition_list', render_html_definition_list)
+        md.renderer.register('definition_term', render_html_definition_term)
+        md.renderer.register('definition_list_item', render_html_definition_list_item)
+    elif md.renderer.NAME == 'ast':
+        md.renderer.register('definition_list', render_ast_definition_list)
+        md.renderer.register('definition_term', render_ast_definition_term)
+        md.renderer.register('definition_list_item', render_ast_definition_list_item)

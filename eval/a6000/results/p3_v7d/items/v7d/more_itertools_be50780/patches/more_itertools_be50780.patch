+def extract(iterable, key):
+    """
+    Extract elements from an iterable that match a given key.
+
+    Example:
+    >>> list(extract([{'a': 1, 'b': 2}, {'a': 3, 'b': 4}, {'a': 5, 'b': 6}], 'a'))
+    [1, 3, 5]
+    """
+    for item in iterable:
+        try:
+            yield item[key]
+        except (TypeError, KeyError):
+            yield getattr(item, key)
+
     def __hash__(self):

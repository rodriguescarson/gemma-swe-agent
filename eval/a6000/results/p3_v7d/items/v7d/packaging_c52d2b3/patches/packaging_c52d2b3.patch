+def _version_join(parts: List[str]) -> str:
+    result = []
+    for i, part in enumerate(parts):
+        if part == "!":
+            result[-1] = result[-1] + "!"
+        elif i > 0 and parts[i - 1] != "!":
+            result.append("." + part)
+        else:
+            result.append(part)
+    return "".join(result)

     'sample',
     'seekable',
     'serialize',
+    'concurrent_tee',
     'set_partitions',
     'side_effect',
     'sliced',
@@ -5313,3 +5314,12 @@ class serialize:
     def __next__(self):
         with self.lock:
             return next(self.iterator)
+
+def concurrent_tee(iterable, n=2):
+    """Return n independent iterators from a single iterable.
+
+    The resulting iterators are wrapped in :class:`serialize` to make them
+    safe for concurrent consumption.
+    """
+    iters = tee(iterable, n)
+    return tuple(serialize(it) for it in iters)

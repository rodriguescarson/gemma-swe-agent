index 1bf48ba..053e3f9
--- a/more_itertools/more.py
+++ b/more_itertools/more.py
@@ -5067,3 +5067,51 @@ def nth_prime(n):
         raise ValueError
     limit = math.ceil(_nth_prime_ub(n + 1))
     return nth(sieve(limit), n)
+
+def argmin(iterable, key=None):
+    """Return the item in iterable that is minimum according to the key function.
+
+    >>> argmin([1, 2, 3])
+    1
+    >>> argmin([1, 2, 3], key=lambda x: -x)
+    3
+    """
+    it = iter(iterable)
+    try:
+        first = next(it)
+    except StopIteration:
+        raise ValueError("argmin() arg is an empty sequence") from None
+
+    min_val = first
+    min_key = key(first) if key is not None else first
+
+    for item in it:
+        k = key(item) if key is not None else item
+        if k < min_key:
+            min_key = k
+            min_val = item
+    return min_val
+
+def argmax(iterable, key=None):
+    """Return the item in iterable that is maximum according to the key function.
+
+    >>> argmax([1, 2, 3])
+    3
+    >>> argmax([1, 2, 3], key=lambda x: -x)
+    1
+    """
+    it = iter(iterable)
+    try:
+        first = next(it)
+    except StopIteration:
+        raise ValueError("argmax() arg is an empty sequence") from None
+
+    max_val = first
+    max_key = key(first) if key is not None else first
+
+    for item in it:
+        k = key(item) if key is not None else item
+        if k > max_key:
+            max_key = k
+            max_val = item
+    return max_val

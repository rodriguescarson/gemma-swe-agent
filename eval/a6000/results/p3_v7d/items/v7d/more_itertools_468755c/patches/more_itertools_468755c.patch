+def iter_suppress(iterable, stop_exception):
+    """
+    Stop iteration when stop_exception is raised.
+
+    This is similar to `itertools.dropwhile`, but instead of dropping
+    elements while a predicate is true, it stops iteration when an
+    exception is raised.
+    """
+    it = iter(iterable)
+    try:
+        while True:
+            yield next(it)
+    except stop_exception:
+        pass
 

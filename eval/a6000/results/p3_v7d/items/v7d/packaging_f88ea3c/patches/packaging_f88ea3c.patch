diff --git a/src/packaging/version.py b/src/packaging/version.py
index 6eebd07..95fa6fe 100644
--- a/src/packaging/version.py
+++ b/src/packaging/version.py
@@ -190,6 +190,14 @@ class Version(_BaseVersion):
 
     __slots__ = ("_dev", "_epoch", "_key_cache", "_local", "_post", "_pre", "_release")
 
+    def __replace__(self, **kwargs) -> "Version":
+        new_version = self.__class__.__new__(self.__class__)
+        for slot in self.__slots__:
+            setattr(new_version, slot, getattr(self, slot))
+        for key, value in kwargs.items():
+            setattr(new_version, key, value)
+        return new_version
+
     _epoch: int
     _release: tuple[int, ...]
     _dev: tuple[str, int] | None

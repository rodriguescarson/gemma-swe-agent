+def chunk_ranges(input_size, chunk_size, overlap=0, align=False):
+    """
+    Yields (start, end) tuples for chunking an input of size `input_size`.
+
+    :param input_size: Total size of the input.
+    :param chunk_size: Size of each chunk.
+    :param overlap: Number of overlapping elements between adjacent chunks.
+    :param align: If True, the last chunk is aligned to the end of the input.
+    """
+    if chunk_size <= 0:
+        raise ValueError("chunk_size must be greater than 0")
+    if overlap < 0:
+        raise ValueError("overlap cannot be negative")
+    if overlap >= chunk_size:
+        raise ValueError("overlap must be less than chunk_size")
+
+    step = chunk_size - overlap
+    start = 0
+    while start < input_size:
+        end = start + chunk_size
+        if end > input_size:
+            if align:
+                start_aligned = max(0, input_size - chunk_size)
+                yield (start_aligned, input_size)
+                break
+            else:
+                yield (start, input_size)
+                break
+
+        yield (start, end)
+        start += step
+
+        if end == input_size:
+            break
+

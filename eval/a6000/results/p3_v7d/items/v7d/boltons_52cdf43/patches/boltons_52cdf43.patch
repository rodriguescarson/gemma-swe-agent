+def range2list(range_str):
+    """Converts a printer-style page range string (e.g., "1-3, 5, 7-9")
+    into a list of integers.
+
+    >>> range2list("1-3, 5, 7-9")
+    [1, 2, 3, 5, 7, 8, 9]
+    """
+    result = []
+    for part in range_str.split(','):
+        part = part.strip()
+        if not part:
+            continue
+        if '-' in part:
+            start, end = part.split('-')
+            result.extend(range(int(start), int(end) + 1))
+        else:
+            result.append(int(part))
+    return result
+
+
+def list2range(range_list):
+    """Converts a sorted list of integers back into a range string.
+
+    >>> list2range([1, 2, 3, 5, 7, 8, 9])
+    '1-3, 5, 7-9'
+    """
+    if not range_list:
+        return ''
+
+    ranges = []
+    start = range_list[0]
+    for i in range(1, len(range_list) + 1):
+        if i < len(range_list) and range_list[i] == range_list[i-1] + 1:
+            continue
+        end = range_list[i-1]
+        if start == end:
+            ranges.append(unicode(start))
+        else:
+            ranges.append(unicode('%d-%d' % (start, end)))
+        if i < len(range_list):
+            start = range_list[i]
+
+    return u', '.join(ranges)
+

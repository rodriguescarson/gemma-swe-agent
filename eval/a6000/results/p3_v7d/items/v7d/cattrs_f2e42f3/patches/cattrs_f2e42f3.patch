+import types
+from typing import TypedDict
+from cattrs import Converter
+from cattrs.gen import typeddicts
+
+# Create a TypedDict with a key containing a single quote
+# The most reliable way to do this is using the functional API of TypedDict
+MyDict = TypedDict("MyDict", {"key's": str})
+
+converter = Converter()
+try:
+    converter.register_unstructure_hook(MyDict, typeddicts.gen_unstructure_hook(MyDict))
+    print("Unstructure hook registered")
+    converter.register_structure_hook(MyDict, typeddicts.gen_structure_hook(MyDict))
+    print("Structure hook registered")
+except Exception as e:
+    print(f"Caught expected error: {e}")
+    import traceback
+    traceback.print_exc()
+
+print(converter.unstructure({"key's": "value"}))
+print(converter.structure({"key's": "value"}, MyDict))

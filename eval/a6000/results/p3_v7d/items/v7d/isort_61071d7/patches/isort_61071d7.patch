diff --git a/isort/literal.py b/isort/literal.py
index 70d543f..bfb7c73 100644
--- a/isort/literal.py
+++ b/isort/literal.py
@@ -99,6 +99,23 @@ def _has_trailing_comma(literal: str) -> bool:
     if "\n" not in literal or not literal:
         return False
 
+    # Strip trailing comment from the last line if it exists
+    last_newline_idx = literal.rfind("\n")
+    if last_newline_idx != -1:
+        last_line = literal[last_newline_idx + 1 :]
+        comment_idx = last_line.find("#")
+        if comment_idx != -1:
+            literal = literal[: last_newline_idx + 1] + last_line[:comment_idx].rstrip()
+        else:
+            literal = literal.rstrip()
+    else:
+        comment_idx = literal.find("#")
+        if comment_idx != -1:
+            literal = literal[:comment_idx].rstrip()
+
+    if not literal:
+        return False
+
     close_bracket = {"(": ")", "[": "]", "{": "}"}.get(literal[0])
     if close_bracket is None or not literal.endswith(close_bracket):
         return False

@@ -1075,3 +1075,57 @@ def totient(n):
     for prime in set(factor(n)):
         n -= n // prime
     return n
+
+def is_prime(n):
+    """
+    Return True if n is a prime number, False otherwise.
+
+    >>> is_prime(2)
+    True
+    >>> is_prime(3)
+    True
+    >>> is_prime(4)
+    False
+    >>> is_prime(11)
+    True
+    >>> is_prime(1)
+    False
+    >>> is_prime(0)
+    False
+    >>> is_prime(-1)
+    False
+    """
+    if n < 2:
+        return False
+    if n == 2:
+        return True
+    if n % 2 == 0:
+        return False
+    for i in range(3, int(n**0.5) + 1, 2):
+        if n % i == 0:
+            return False
+    return True
+
+
+def nth_prime(n):
+    """
+    Return the nth prime number.
+
+    >>> nth_prime(1)
+    2
+    >>> nth_prime(2)
+    3
+    >>> nth_prime(3)
+    5
+    >>> nth_prime(10)
+    29
+    """
+    if n < 1:
+        raise ValueError("n must be at least 1")
+    count = 0
+    candidate = 1
+    while count < n:
+        candidate += 1
+        if is_prime(candidate):
+            count += 1
+    return candidate

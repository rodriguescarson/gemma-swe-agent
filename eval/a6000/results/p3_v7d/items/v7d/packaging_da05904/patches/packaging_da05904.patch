@@ -769,3 +769,17 @@ def sys_tags(*, warn: bool = False) -> Iterator[Tag]:
     else:
         interp = None
     yield from compatible_tags(interpreter=interp)
+
+def create_compatible_tags_selector(tags):
+    """Create a selector that filters items based on compatible tags.
+
+    :param Iterable[Tag] tags: An ordered list of tags to match against.
+    :return: A selector function that takes an iterable of (item, tag) pairs
+             and yields items that match the tags in the given order.
+    """
+    def selector(items):
+        for tag in tags:
+            for item, item_tag in items:
+                if item_tag == tag:
+                    yield item
+    return selector

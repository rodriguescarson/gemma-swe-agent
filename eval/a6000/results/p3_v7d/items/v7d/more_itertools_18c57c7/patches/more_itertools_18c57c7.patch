+def running_statistics(iterable):
+    """
+    Yield a tuple of (count, mean, sum, variance, standard deviation)
+    for the values seen so far.
+
+    >>> list(running_statistics([10, 20, 30]))
+    [(1, 10.0, 10.0, 0.0, 0.0), (2, 15.0, 30.0, 25.0, 5.0), (3, 20.0, 60.0, 66.66666666666667, 8.16496580927726)]
+    """
+    import math
+    n = 0
+    mean = 0.0
+    m2 = 0.0
+    s = 0.0
+    for x in iterable:
+        n += 1
+        s += x
+        delta = x - mean
+        mean += delta / n
+        delta2 = x - mean
+        m2 += delta * delta2
+
+        variance = m2 / n if n > 0 else 0.0
+        std_dev = math.sqrt(variance) if n > 0 else 0.0
+        yield (n, mean, s, variance, std_dev)
+

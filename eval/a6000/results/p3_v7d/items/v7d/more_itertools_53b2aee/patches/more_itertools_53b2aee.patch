+def powerset_of_sets(iterables):
+    """
+    Yield the powerset of the given iterables.
+    Each element of the powerset is the union of the selected iterables.
+
+    >>> list(powerset_of_sets([{1}, {2}, {3}]))
+    [set(), {1}, {2}, {3}, {1, 2}, {1, 3}, {2, 3}, {1, 2, 3}]
+    """
+    s = list(iterables)
+    for r in range(len(s) + 1):
+        for combo in combinations(s, r):
+            yield set().union(*combo)

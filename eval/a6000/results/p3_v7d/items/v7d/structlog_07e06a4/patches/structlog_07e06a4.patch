+    """
+
+    def __init__(
+        self,
+        sort_keys: bool = False,
+        key_order: Optional[Sequence[str]] = None,
+        drop_missing: bool = False,
+    ):
+        super().__init__(sort_keys, key_order, drop_missing)
+
+    def __call__(
+        self, _: WrappedLogger, __: str, event_dict: EventDict
+    ) -> str:
+        import logfmt
+
+        return logfmt.dump(dict(self._ordered_items(event_dict))).strip()

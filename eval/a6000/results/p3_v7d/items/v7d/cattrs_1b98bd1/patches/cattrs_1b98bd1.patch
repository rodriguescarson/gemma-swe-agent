+def create_tagged_dis_func(
+    tag_field: str, mapping: Mapping[Any, Type]
+) -> Callable[[Mapping[Any, Any]], Optional[Type[Any]]]:
+    """Given a tag field and a mapping, generate a disambiguation function."""
+
+    def dis_func(data: Mapping[Any, Any]) -> Optional[Type[Any]]:
+        if not isinstance(data, Mapping):
+            raise ValueError("Only input mappings are supported.")
+        tag = data.get(tag_field)
+        return mapping.get(tag)
+
+    return dis_func

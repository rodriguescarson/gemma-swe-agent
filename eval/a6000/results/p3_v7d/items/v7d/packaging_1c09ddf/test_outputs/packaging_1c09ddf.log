            ("gopher:/foo/com", ""),
            (None, "==={ws}arbitrarystring"),
            (None, "({ws}==={ws}arbitrarystring{ws})"),
            (None, "=={ws}1.0"),
            (None, "({ws}=={ws}1.0{ws})"),
            (None, "=={ws}1.0-alpha"),
            (None, "<={ws}1!3.0.0.rc2"),

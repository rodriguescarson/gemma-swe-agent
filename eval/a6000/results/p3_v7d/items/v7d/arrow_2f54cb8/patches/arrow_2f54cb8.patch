@@ -0,0 +1,42 @@
+import pytest
+from arrow.locales import SinhalaLocale
+
+class TestSinhalaLocale:
+    def test_format_timeframe(self):
+        locale = SinhalaLocale()
+        assert locale._format_timeframe("now", 0) == "දැන්"
+        assert locale._format_timeframe("second", 1) == "තත්පරයක්"
+        assert locale._format_timeframe("seconds", 2) == "2 තත්පර"
+        assert locale._format_timeframe("minute", 1) == "විනාඩියක්"
+        assert locale._format_timeframe("minutes", 2) == "2 විනාඩි"
+        assert locale._format_timeframe("hour", 1) == "පැයක්"
+        assert locale._format_timeframe("hours", 2) == "2 පැය"
+        assert locale._format_timeframe("day", 1) == "දිනක්"
+        assert locale._format_timeframe("days", 2) == "2 දින"
+        assert locale._format_timeframe("week", 1) == "සතියක්"
+        assert locale._format_timeframe("weeks", 2) == "2 සති"
+        assert locale._format_timeframe("month", 1) == "මාසයක්"
+        assert locale._format_timeframe("months", 2) == "2 මාස"
+        assert locale._format_timeframe("year", 1) == "වසරක්"
+        assert locale._format_timeframe("years", 2) == "2 වසර"
+
+    def test_format_relative(self):
+        locale = SinhalaLocale()
+        # Past
+        assert locale._format_relative("තත්පර 2", "seconds", -2) == "තත්පර 2 කල්පින්"
+        # Future
+        assert locale._format_relative("තත්පර 2", "seconds", 2) == "තත්පර 2 න් පසු"
+        # Now
+        assert locale._format_relative("දැන්", "now", 0) == "දැන්"
+
+    def test_describe(self):
+        locale = SinhalaLocale()
+        assert locale.describe("now") == "දැන්"
+        assert locale.describe("second", -1) == "තත්පරයක් කල්පින්"
+        assert locale.describe("second", 1) == "තත්පරයක් න් පසු"
+        assert locale.describe("seconds", -2) == "2 තත්පර කල්පින්"
+        assert locale.describe("seconds", 2) == "2 තත්පර න් පසු"
+        assert locale.describe("minute", -1) == "විනාඩියක් කල්පින්"
+        assert locale.describe("minute", 1) == "විනාඩියක් න් පසු"
+        assert locale.describe("minutes", -2) == "2 විනාඩි කල්පින්"
+        assert locale.describe("minutes", 2) == "2 විනාඩි න් පසු"

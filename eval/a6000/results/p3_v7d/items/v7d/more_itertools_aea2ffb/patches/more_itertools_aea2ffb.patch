+def running_median(data, maxlen=None):  # pragma: no cover
+    """Yields the median of values seen so far.
+
+    If maxlen is specified, it yields the median of the last maxlen values.
 
     For example:
 
     >>> list(running_median([5.0, 9.0, 4.0, 12.0, 8.0, 9.0]))
     [5.0, 7.0, 5.0, 7.0, 8.0, 8.5]
 
+    >>> list(running_median([5.0, 9.0, 4.0, 12.0, 8.0, 9.0], maxlen=3))
+    [5.0, 7.0, 5.0, 8.0, 8.0, 9.0]
+
     Supports numeric types such as int, float, Decimal, and Fraction,
     but not complex numbers which are unorderable.
 
@@ -1349,12 +1355,29 @@ def running_median(iterable):  # pragma: no cover
     by statistics.median().
     """
 
+    if maxlen is not None:
+        window = deque()
+        sorted_window = []
+        for val in data:
+            window.append(val)
+            insort(sorted_window, val)
+            if len(window) > maxlen:
+                old_val = window.popleft()
+                idx = bisect_left(sorted_window, old_val)
+                del sorted_window[idx]
+
+            n = len(sorted_window)
+            if n % 2 == 1:
+                yield sorted_window[n // 2]
+            else:
+                yield (sorted_window[n // 2 - 1] + sorted_window[n // 2]) / 2
+

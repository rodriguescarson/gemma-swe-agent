+import sys
+import structlog
+from structlog import tracebacks
+
+def test_direct_loop():
+    print("Testing direct loop...")
+    try:
+        try:
+            raise ValueError("original")
+        except ValueError as e:
+            e.__cause__ = e
+            raise e
+    except Exception as e:
+        try:
+            tracebacks.extract(type(e), e, e.__traceback__)
+            print("Direct loop handled")
+        except RecursionError:
+            print("Direct loop failed with RecursionError")
+
+def test_exception_group_loop():
+    print("\nTesting ExceptionGroup loop...")
+    try:
+        try:
+            raise ValueError("original")
+        except ValueError as e:
+            eg = ExceptionGroup("group", [e])
+            e.__cause__ = eg
+            raise eg
+    except Exception as e:
+        try:
+            tracebacks.extract(type(e), e, e.__traceback__)
+            print("ExceptionGroup loop handled")
+        except RecursionError:
+            print("ExceptionGroup loop failed with RecursionError")
+
+if __name__ == "__main__":
+    test_direct_loop()
+    test_exception_group_loop()

+@attrs(repr=False, slots=True, hash=True)
+class _MinValueValidator(object):
+    min_value = attrib()
+
+    def __call__(self, inst, attr, value):
+        if value < self.min_value:
+            raise ValueError(
+                "'{name}' must be at least {min_value!r} (got {value!r})".format(
+                    name=attr.name, min_value=self.min_value, value=value
+                ),
+                attr,
+                self.min_value,
+                value,
+            )
+
+    def __repr__(self):
+        return "<min_value validator for value >= {min_value!r}>".format(
+            min_value=self.min_value
+        )
+
+
+def min_value(min_val):
+    """
+    A validator that raises `ValueError` if the initializer is called
+    with a value that is less than *min_val*.
+
+    :param min_val: The minimum allowed value.
+    :type min_val: Any comparable type.
+
+    :raises ValueError: With a human readable error message, the attribute
+        (of type `attr.Attribute`), the minimum value, and the value it got.
+    """
+    return _MinValueValidator(min_val)
+
+
+@attrs(repr=False, slots=True, hash=True)
+class _MaxValueValidator(object):
+    max_value = attrib()
+
+    def __call__(self, inst, attr, value):
+        if value > self.max_value:
+            raise ValueError(
+                "'{name}' must be at most {max_value!r} (got {value!r})".format(
+                    name=attr.name, max_value=self.max_value, value=value
+                ),
+                attr,
+                self.max_value,
+                value,
+            )
+
+    def __repr__(self):
+        return "<max_value validator for value <= {max_value!r}>".format(
+            max_value=self.max_value
+        )
+
+
+def max_value(max_val):
+    """
+    A validator that raises `ValueError` if the initializer is called
+    with a value that is greater than *max_val*.
+
+    :param max_val: The maximum allowed value.
+    :type max_val: Any comparable type.
+
+    :raises ValueError: With a human readable error message, the attribute
+        (of type `attr.Attribute`), the maximum value, and the value it got.
+    """
+    return _MaxValueValidator(max_val)
+
+
+@attrs(repr=False, slots=True, hash=True)
+class _MinLengthValidator(object):
+    min_length = attrib()
+
+    def __call__(self, inst, attr, value):
+        if len(value) < self.min_length:
+            raise ValueError(
+                "'{name}' must have at least {min_length!d} items (got {actual!d})".format(
+                    name=attr.name, min_length=self.min_length, actual=len(value)
+                ),
+                attr,
+                self.min_length,
+                value,
+            )
+
+    def __repr__(self):
+        return "<min_length validator for length >= {min_length}>".format(
+            min_length=self.min_length
+        )
+
+
+def min_length(min_len):
+    """
+    A validator that raises `ValueError` if the initializer is called
+    with a value that has a length less than *min_len*.
+
+    :param min_len: The minimum allowed length.
+    :type min_len: int
+
+    :raises ValueError: With a human readable error message, the attribute
+        (of type `attr.Attribute`), the minimum length, and the value it got.
+    """
+    return _MinLengthValidator(min_len)
+
+
+@attrs(repr=False, slots=True, hash=True)
+class _MaxLengthValidator(object):
+    max_length = attrib()
+
+    def __call__(self, inst, attr, value):
+        if len(value) > self.max_length:
+            raise ValueError(
+                "'{name}' must have at most {max_length!d} items (got {actual!d})".format(
+                    name=attr.name, max_length=self.max_length, actual=len(value)
+                ),
+                attr,
+                self.max_length,
+                value,
+            )
+
+    def __repr__(self):
+        return "<max_length validator for length <= {max_length}>".format(
+            max_length=self.max_length
+        )
+
+
+def max_length(max_len):
+    """
+    A validator that raises `ValueError` if the initializer is called
+    with a value that has a length greater than *max_len*.
+
+    :param max_len: The maximum allowed length.
+    :type max_len: int
+
+    :raises ValueError: With a human readable error message, the attribute
+        (of type `attr.Attribute`), the maximum length, and the value it got.
+    """
+    return _MaxLengthValidator(max_len)
diff --git a/tests/test_validators_additional.py b/tests/test_validators_additional.py
new file mode 100644
index 0000000..8543379
--- /dev/null
+++ b/tests/test_validators_additional.py
@@ -0,0 +1,44 @@
+import pytest
+from attr import attrs, attrib, min_value, max_value, min_length, max_length
+
+@attrs
+class TestValue:
+    val = attrib(validator=min_value(10))
+
+@attrs
+class TestMaxValue:
+    val = attrib(validator=max_value(20))
+
+@attrs
+class TestMinLength:
+    val = attrib(validator=min_length(3))
+
+@attrs
+class TestMaxLength:
+    val = attrib(validator=max_length(5))
+
+def test_min_value():
+    TestValue(10)
+    with pytest.raises(ValueError):
+        TestValue(9)
+
+def test_max_value():
+    TestMaxValue(20)
+    with pytest.raises(ValueError):
+        TestMaxValue(21)
+
+def test_min_length():
+    TestMinLength("abc")
+    with pytest.raises(ValueError):
+        TestMinLength("ab")
+
+def test_max_length():
+    TestMaxLength("abcde")
+    with pytest.raises(ValueError):
+        TestMaxLength("abcdef")
+
+def test_reprs():
+    assert repr(min_value(10)) == "<min_value validator for value >= 10>"
+    assert repr(max_value(20)) == "<max_value validator for value <= 20>"
+    assert repr(min_length(3)) == "<min_length validator for length >= 3>"
+    assert repr(max_length(5)) == "<max_length validator for length <= 5>"

        def _full(A):
            while True:
                # Yield the permutation we have
                yield tuple(A)
    
                # Find the largest index i such that A[i] < A[i + 1]
                for i in range(size - 2, -1, -1):
                    if A[i] < A[i + 1]:
                        break
                #  If no such index exists, this permutation is the last one
                else:

+import isort
+
+test_input = "import os\nimport sys\nimport math\nimport abc\n# comment\nimport xyz\n# comment2\nimport def\nimport ghi\nimport jkl\nimport mno\nimport opq\nimport rst\nimport stu\nimport uvw\nimport wxy\nimport zzz\nimport aaa\nimport bbb\nimport ccc\nimport ddd\nimport eee\nimport fff\nimport ggg\nimport hhh\nimport iii\nimport jjj\nimport kkk\nimport lll"

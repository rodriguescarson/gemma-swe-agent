+def derangements(iterable):
+    """Return all derangements of the given iterable.
+
+    A derangement is a permutation of the elements of a sequence in which
+    no element appears in its original position.
+
+    >>> list(derangements([1, 2, 3]))
+    [(2, 3, 1), (3, 1, 2)]
+    """
+    items = tuple(iterable)
+    n = len(items)
+    for p in permutations(items):
+        if all(p[i] != items[i] for i in range(n)):
+            yield p
+
 # math.sumprod is available for Python 3.12+

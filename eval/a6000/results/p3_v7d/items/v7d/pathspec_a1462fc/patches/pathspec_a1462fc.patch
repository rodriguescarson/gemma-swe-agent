@@ -26,6 +26,30 @@ class GitWildMatchPattern(RegexPattern):
 	# Keep the dict-less class hierarchy.
 	__slots__ = ()
 
+	@staticmethod
+	def escape(pattern):
+		"""
+		Escape characters that have special meaning in Git wildmatch patterns.
+
+		*pattern* (:class:`unicode` or :class:`bytes`) is the pattern to
+		escape.
+
+		Returns the escaped pattern (:class:`unicode`, :class:`bytes`).
+		"""
+		is_bytes = isinstance(pattern, bytes)
+		if is_bytes:
+			pattern = pattern.decode(_BYTES_ENCODING)
+
+		# Escape characters that have special meaning in Git wildmatch patterns.
+		# The characters are: '*', '?', '[', and '\'.
+		# Note: ']' is not escaped because it only has special meaning
+		# when it follows a '['.
+		escaped_pattern = pattern.replace('\\', '\\\\').replace('*', '\\*').replace('?', '\\?').replace('[', '\\[')
+
+		if is_bytes:
+			return escaped_pattern.encode(_BYTES_ENCODING)
+		return escaped_pattern
+

diff --git a/pathspec/patterns/gitignore/basic.py b/pathspec/patterns/gitignore/basic.py
index 44b2400..d02df61 100644
--- a/pathspec/patterns/gitignore/basic.py
+++ b/pathspec/patterns/gitignore/basic.py
@@ -156,14 +156,23 @@ class GitIgnoreBasicPattern(_GitIgnoreBasePattern):
 		original_pattern = pattern_str
 		del pattern
 
-		if pattern_str.endswith('\\ '):
-			# EDGE CASE: Spaces can be escaped with backslash. If a pattern that ends
-			# with a backslash is followed by a space, do not strip from the left.
-			pass
+		if pattern_str.endswith(' '):
+			# Count trailing backslashes before the space
+			backslash_count = 0
+			for char in reversed(pattern_str[:-1]):
+				if char == '\\':
+					backslash_count += 1
+				else:
+					break
+			if backslash_count % 2 != 0:
+				# Odd number of backslashes: the space is escaped, preserve it.
+				pass
+			else:
+				# Even number of backslashes: the space is not escaped, trim it.
+				pattern_str = pattern_str.rstrip()
 		else:
-			# EDGE CASE: Leading spaces should be kept (only trailing spaces should be
-			# removed).
-			pattern_str = pattern_str.rstrip()
+			# No trailing space to trim.
+			pass
 
 		regex: Optional[str]
 		include: Optional[bool]

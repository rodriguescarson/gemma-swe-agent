+    def _renders_table_header(self, item: Any) -> bool:
+        if isinstance(item, (Table, AoT)):
+            # If it's a table, it renders a header unless it's a dotted-key super-table
+            # that doesn't actually render a header itself (only its children might).
+            # However, the logic here is: does this item OR any of its children render a header?
+            # A Table renders a header if it's not a super-table or if it's a super-table
+            # that has been explicitly given a header.
+            # Actually, the simplest check is: if it's a Table/AoT and not a super-table, it's a header.
+            # If it IS a super-table, we must check if any of its children render a header.
+            if not getattr(item, "_is_super_table", False):
+                return True
+            
+            # It's a super-table. Check its children.
+            if isinstance(item, Table):
+                for _, v in item.value._body:
+                    if self._renders_table_header(v):
+                        return True
+            return False
+        return False
+
     def _get_last_index_before_table(self) -> int:
         last_index = -1
         for i, (k, v) in enumerate(self._body):
@@ -161,6 +181,8 @@ class Container(_CustomDict):  # type: ignore[type-arg]
 
             if isinstance(v, (Table, AoT)) and k is not None and not k.is_dotted():
                 break
+            if k is not None and k.is_dotted() and self._renders_table_header(v):

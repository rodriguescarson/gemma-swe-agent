+def filter_map(func, iterable):
+    """
+    Apply func to each element of iterable and yield the result if it is not None.
+
+    >>> list(filter_map(lambda x: x * 2 if x % 2 == 0 else None, [1, 2, 3, 4]))
+    [4, 8]
+    """
+    for x in iterable:
+        y = func(x)
+        if y is not None:
+            yield y
+

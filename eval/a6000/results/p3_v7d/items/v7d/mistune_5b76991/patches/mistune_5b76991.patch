diff --git a/mistune/plugins/abbreviation.py b/mistune/plugins/abbreviation.py
new file mode 100644
index 0000000..b8d6468
--- /dev/null
+++ b/mistune/plugins/abbreviation.py
@@ -0,0 +1,14 @@
+import re
+
+def parse_abbreviation(m, state):
+    text = m.group(1)
+    expansion = m.group(2)
+    return 'abbreviation', text, expansion
+
+def render_abbreviation(text, expansion):
+    return f'<abbr title="{expansion}">{text}</abbr>'
+
+def plugin_abbreviation(md):
+    md.inline.register_rule('abbreviation', r'abbr::([^\[]+)\[([^\]]+)\]', parse_abbreviation)
+    md.renderer.register('abbreviation', render_abbreviation)
+    md.inline.RULE_NAMES = list(md.inline.RULE_NAMES) + ['abbreviation']

+def classify_unique(iterable, key=None):
+    """Yield (element, is_unique_justseen, is_unique_everseen) for each element in the iterable.
+
+    >>> list(classify_unique('AAAABBBCCDAABBB'))
+    [('A', True, True), ('A', False, False), ('A', False, False), ('A', False, False), ('B', True, True), ('B', False, False), ('B', False, False), ('C', True, True), ('C', False, False), ('D', True, True), ('A', True, False), ('A', False, False), ('B', True, False), ('B', False, False), ('B', False, False)]
+    """
+    seen = set()
+    last_key = object()
+    for x in iterable:
+        k = key(x) if key else x
+        is_unique_justseen = k != last_key
+        is_unique_everseen = k not in seen
+        seen.add(k)
+        last_key = k
+        yield x, is_unique_justseen, is_unique_everseen
+

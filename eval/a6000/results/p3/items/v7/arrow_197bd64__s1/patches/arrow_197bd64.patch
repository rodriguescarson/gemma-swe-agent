@@ -0,0 +1,45 @@
+import pytest
+from arrow.locales import SerbianLocale
+
+class TestSerbianLocale:
+    def setup_method(self):
+        self.locale = SerbianLocale()
+
+    def test_singles_sr(self):
+        # SlavicBaseLocale._format_timeframe uses .format(delta)
+        # SerbianLocale.timeframes["second"] = "sekundu"
+        # So "sekundu".format(1) is "sekundu"
+        assert self.locale._format_timeframe("second", 1) == "sekundu"
+        assert self.locale._format_timeframe("minute", 1) == "minut"
+        assert self.locale._format_timeframe("hour", 1) == "sat"
+        assert self.locale._format_timeframe("day", 1) == "dan"
+        assert self.locale._format_timeframe("month", 1) == "mesec"
+        assert self.locale._format_timeframe("year", 1) == "godinu"
+
+    def test_plurals_sr(self):
+        # 2, 3, 4 -> sekunde, sata, dana, meseca, godine
+        assert self.locale._format_timeframe("seconds", 2) == "2 sekunde"
+        assert self.locale._format_timeframe("hours", 3) == "3 sata"
+        assert self.locale._format_timeframe("days", 4) == "4 dana"
+        assert self.locale._format_timeframe("months", 2) == "2 meseca"
+        assert self.locale._format_timeframe("years", 3) == "3 godine"
+        
+        # 5+ -> sekundi, sata, dana, meseca, godina
+        assert self.locale._format_timeframe("seconds", 5) == "5 sekundi"
+        assert self.locale._format_timeframe("hours", 10) == "10 sata"
+        assert self.locale._format_timeframe("days", 11) == "11 dana"
+        assert self.locale._format_timeframe("months", 20) == "20 meseca"
+        assert self.locale._format_timeframe("years", 25) == "25 godina"
+
+    def test_describe_sr(self):
+        assert self.locale.describe("second", only_distance=True) == "sekundu"
+        # SerbianLocale.past = "{0} pre", SerbianLocale.future = "za {0}"
+        # describe() for distance usually uses future if distance > 0, past if distance < 0
+        # But describe() without delta usually defaults to something.
+        # Let's check how describe is implemented in arrow/locales.py
+        pass
+
+    def test_relative_sr(self):
+        assert self.locale._format_relative("sada", "now", 0) == "sada"
+        assert self.locale._format_relative("1 sekundu", "seconds", 1) == "za 1 sekundu"
+        assert self.locale._format_relative("1 sekundu", "seconds", -1) == "1 sekundu pre"

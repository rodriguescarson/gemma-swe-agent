new file mode 100644
index 0000000..bb13766
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,28 @@
+
+import typing
+from typing import TypeVar, Generic
+from dataclasses import dataclass
+
+T = TypeVar("T")
+
+@dataclass
+class Parent(Generic[T]):
+    x: T
+
+@dataclass
+class Child(Parent[int]):
+    y: int
+
+print(f"Parent: {Parent}")
+print(f"Parent subclasses: {Parent.__subclasses__()}")
+
+GenericParent = Parent[int]
+print(f"GenericParent: {GenericParent}")
+try:
+    print(f"GenericParent subclasses: {GenericParent.__subclasses__()}")
+except AttributeError as e:
+    print(f"GenericParent.__subclasses__() raised: {e}")
+
+origin = typing.get_origin(GenericParent) or GenericParent
+print(f"Origin: {origin}")
+print(f"Origin subclasses: {origin.__subclasses__()}")

+from typing import TypedDict
+from cattrs import Converter
+from cattrs.gen import make_dict_unstructure_fn, make_dict_structure_fn
+
+MyTD = TypedDict("MyTD", {"it's a key": int})
+converter = Converter()
+
+try:
+    print("Testing unstructure_fn creation...")
+    unstructure_fn = make_dict_unstructure_fn(MyTD, converter)
+    print("unstructure_fn created successfully")
+
+    print("Testing structure_fn creation...")
+    structure_fn = make_dict_structure_fn(MyTD, converter)
+    print("structure_fn created successfully")
+
+except Exception as e:
+    print(f"Error: {e}")
+    import traceback
+    traceback.print_exc()
+    exit(1)
+
+exit(0)

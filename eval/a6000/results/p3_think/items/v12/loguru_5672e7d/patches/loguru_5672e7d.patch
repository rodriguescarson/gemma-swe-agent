+from datetime import datetime, timezone
+import math
+
+# Use a date just before epoch
+dt_before = datetime(1969, 12, 31, 23, 59, 59, 500000, tzinfo=timezone.utc)
+# dt_before.timestamp() should be -0.5
+
+# Current implementation of X:
+# lambda t, dt: dt.timestamp()
+# Since it's formatted with %d, it becomes int(dt.timestamp())
+val_X_before = int(dt_before.timestamp())
+print(f"X before: {val_X_before}")
+
+# Current implementation of x:
+# lambda t, dt: int(dt.timestamp()) * 1000000 + dt.microsecond
+val_x_before = int(dt_before.timestamp()) * 1000000 + dt_before.microsecond
+print(f"x before: {val_x_before}")
+
+# Expected implementation (using floor):
+val_X_expected_before = math.floor(dt_before.timestamp())
+val_x_expected_before = math.floor(dt_before.timestamp()) * 1000000 + dt_before.microsecond
+print(f"X expected before: {val_X_expected_before}")
+print(f"x expected before: {val_x_expected_before}")
+
+# Use a date just after epoch
+dt_after = datetime(1970, 1, 1, 0, 0, 0, 500000, tzinfo=timezone.utc)
+# dt_after.timestamp() should be 0.5
+
+val_X_after = int(dt_after.timestamp())
+print(f"X after: {val_X_after}")
+
+val_x_after = int(dt_after.timestamp()) * 1000000 + dt_after.microsecond
+print(f"x after: {val_x_after}")
+
+val_X_expected_after = math.floor(dt_after.timestamp())
+val_x_expected_after = math.floor(dt_after.timestamp()) * 1000000 + dt_after.microsecond
+print(f"X expected after: {val_X_expected_after}")
+print(f"x expected after: {val_x_expected_after}")

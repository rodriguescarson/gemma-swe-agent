@@ -0,0 +1,21 @@
+import cattrs
+from cattrs.gen import make_dict_structure_fn
+import dataclasses
+from typing import Generic, TypeVar
+
+T = TypeVar("T")
+
+@dataclasses.dataclass
+class A(Generic[T]):
+    x: T
+
+converter = cattrs.Converter()
+
+# Using a Union type as a generic parameter
+try:
+    struct_fn = make_dict_structure_fn(A[int | str], converter)
+    print("Successfully generated struct_fn")
+except Exception as e:
+    print(f"Failed to generate struct_fn: {e}")
+    import traceback
+    traceback.print_exc()

+
+class disabled:
+    """
+    Context manager to disable validators.
+    """
+    def __enter__(self):
+        self._old = _config.get_run_validators()
+        _config.set_run_validators(False)
+        return self
+
+    def __exit__(self, exc_type, exc_val, exc_tb):
+        _config.set_run_validators(self._old)

+def running_mean(iterable):
+    """Cumulative mean of values seen so far.
+
+    For example:
+
+        >>> list(running_mean([5.0, 9.0, 4.0, 12.0, 8.0, 9.0]))
+        [5.0, 7.0, 6.0, 7.5, 7.6, 7.833333333333333]
+
+    Supports numeric types such as int, float, Decimal, and Fraction.
+    """
+    return map(lambda x, i: x / i, accumulate(iterable), count(1))
+

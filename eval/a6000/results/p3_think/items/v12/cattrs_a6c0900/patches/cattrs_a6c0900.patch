new file mode 100644
index 0000000..ca02475
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,27 @@
+from attrs import define
+from cattrs import Converter
+from cattrs.disambiguators import create_default_dis_func
+import itertools
+
+@define
+class A: ab: int; a: str
+@define
+class B: ab: int; bc: int
+@define
+class C: bc: int
+
+c = Converter()
+
+classes = [A, B, C]
+for order in itertools.permutations(classes):
+    try:
+        dis_func = create_default_dis_func(c, *order)
+        print(f"Order {order} succeeded")
+        # Test routing
+        assert dis_func({'ab': 1, 'a': 'a'}) is A
+        assert dis_func({'ab': 1, 'bc': 1}) is B
+        assert dis_func({'bc': 1}) is C
+    except Exception as e:
+        print(f"Order {order} failed with {type(e).__name__}: {e}")
+        raise e
+print("All orders succeeded!")

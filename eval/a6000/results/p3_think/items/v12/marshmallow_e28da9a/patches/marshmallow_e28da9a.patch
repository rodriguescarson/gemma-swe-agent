@@ -0,0 +1,13 @@
+CONTEXT = contextvars.ContextVar("marshmallow.context")
+
+class Context:
+    """Context manager for setting the marshmallow context."""
+    def __init__(self, value: typing.Any):
+        self.value = value
+
+    def __enter__(self):
+        self.token = CONTEXT.set(self.value)
+        return self
+
+    def __exit__(self, exc_type, exc_val, exc_tb):
+        CONTEXT.reset(self.token)

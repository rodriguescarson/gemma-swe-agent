diff --git a/reproduce_bug.py b/reproduce_bug.py
new file mode 100644
index 0000000..251710d
--- /dev/null
+++ b/reproduce_bug.py
@@ -0,0 +1,34 @@
+
+from isort.api import sort_code_string
+from isort.settings import Config
+
+config = Config()
+config.sort_reexports = True
+
+code = "__all__=[2, 3, 1]"
+sorted_code = sort_code_string(code, config=config)
+print(f"Before: {code}")
+print(f"After: {sorted_code}")
+assert sorted_code.strip() == "__all__ = [1, 2, 3]"
+
+code = "__all__ = {3, 1, 2}"
+sorted_code = sort_code_string(code, config=config)
+print(f"Before: {code}")
+print(f"After: {sorted_code}")
+# For set, it should be sorted.
+# Note: sorted({3, 1, 2}) is [1, 2, 3] but we want it as a set.
+# isort.literal._set returns "{1, 2, 3}"
+assert sorted_code.strip() == "__all__ = {1, 2, 3}"
+
+code = "__all__ = (3, 1, 2)"
+sorted_code = sort_code_string(code, config=config)
+print(f"Before: {code}")
+print(f"After: {sorted_code}")
+assert sorted_code.strip() == "__all__ = (1, 2, 3)"
+
+code = "__all__ = {'b': 2, 'a': 1}"
+sorted_code = sort_code_string(code, config=config)
+print(f"Before: {code}")
+print(f"After: {sorted_code}")
+# dict sorts by value
+assert sorted_code.strip() == "__all__ = {'a': 1, 'b': 2}"

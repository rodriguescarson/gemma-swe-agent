+++ b/repro.py
@@ -0,0 +1,32 @@
+
+import arrow
+from datetime import datetime
+
+# Use a fixed date to avoid issues with "now"
+now = arrow.utcnow()
+
+try:
+    print("Testing week...")
+    # Shift by 1 week
+    one_week_ago = now.shift(weeks=-1)
+    print(f"1 week ago: {one_week_ago.humanize(now, locale='fa')}")
+    
+    # Shift by 2 weeks
+    two_weeks_ago = now.shift(weeks=-2)
+    print(f"2 weeks ago: {two_weeks_ago.humanize(now, locale='fa')}")
+
+    print("\nTesting quarter...")
+    # Shift by 1 quarter (approx 3 months)
+    # Arrow.shift supports months, but maybe not quarters. 
+    # But humanize supports granularity='quarter'.
+    
+    # Try humanize with granularity='quarter'
+    three_months_ago = now.shift(months=-3)
+    print(f"3 months ago (quarter granularity): {three_months_ago.humanize(now, locale='fa', granularity='quarter')}")
+    
+    six_months_ago = now.shift(months=-6)
+    print(f"6 months ago (quarter granularity): {six_months_ago.humanize(now, locale='fa', granularity='quarter')}")
+
+except Exception as e:
+    import traceback
+    traceback.print_exc()

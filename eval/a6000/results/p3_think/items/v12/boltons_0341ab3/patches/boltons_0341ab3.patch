+import pickle
+from boltons.dictutils import OrderedMultiDict
+
+omd = OrderedMultiDict()
+omd['a'] = 1
+omd['a'] = 2
+print(f"Before pickling: {omd}")
+try:
+    pickled = pickle.dumps(omd)
+    unpickled = pickle.loads(pickled)
+    print(f"After unpickling: {unpickled}")

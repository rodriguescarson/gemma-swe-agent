+from typing import Any, Callable, Type
+
+from cattrs import Converter
+
+__all__ = ["configure_class_method_structuring"]
+
+
+def configure_class_method_structuring(
+    converter: Converter, cl: Type, method_name: str = "from_dict"
+) -> None:
+    \"\"\"
+    Configure the converter so that ``cl`` is structured using the specified
+    class method instead of its ``__init__`` method.
+
+    :param converter: The converter to apply the strategy to.
+    :param cl: The class to configure.
+    :param method_name: The name of the class method to use. By default,
+        `'from_dict'`.
+    \"\"\"
+    method = getattr(cl, method_name)
+
+    def strategy(conv_obj: Any) -> Any:
+        if isinstance(conv_obj, dict):
+            return method(conv_obj)
+        if isinstance(conv_obj, list):
+            return method(*conv_obj)
+        return method(conv_obj)
+
+    converter._struct_strategies[cl] = strategy

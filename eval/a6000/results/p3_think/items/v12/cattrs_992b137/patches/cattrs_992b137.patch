--- /dev/null
+++ b/repro_base.py
@@ -0,0 +1,19 @@
+
+import pickle
+from src.cattrs.errors import BaseValidationError
+
+def test_base_validation_error():
+    try:
+        # We need to create an instance of BaseValidationError. 
+        # It takes message, excs, and cl.
+        e = BaseValidationError("msg", [ValueError("error")], int)
+        p = pickle.dumps(e)
+        e2 = pickle.loads(p)
+        print(f"BaseValidationError: {e2=}, {e2.cl=}")
+        assert e2.cl == int
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e
+
+if __name__ == "__main__":
+    test_base_validation_error()
diff --git a/repro_pickling.py b/repro_pickling.py
new file mode 100644
index 0000000..2a1d926
--- /dev/null
+++ b/repro_pickling.py
@@ -0,0 +1,30 @@
+
+import pickle
+from src.cattrs.errors import AttributeValidationNote, IterableValidationNote
+
+def test_attribute_validation_note():
+    print("Testing AttributeValidationNote pickling...")
+    note = AttributeValidationNote("error message", "attribute_name", int)
+    p = pickle.dumps(note)
+    note2 = pickle.loads(p)
+    print(f"Original: {note}, name: {note.name}, type: {note.type}")
+    print(f"Unpickled: {note2}, name: {note2.name}, type: {note2.type}")
+    assert note2 == note
+    assert note2.name == "attribute_name"
+    assert note2.type == int
+
+def test_iterable_validation_note():
+    print("Testing IterableValidationNote pickling...")
+    note = IterableValidationNote("error message", 0, int)
+    p = pickle.dumps(note)
+    note2 = pickle.loads(p)
+    print(f"Original: {note}, index: {note.index}, type: {note.type}")
+    print(f"Unpickled: {note2}, index: {note2.index}, type: {note2.type}")
+    assert note2 == note
+    assert note2.index == 0
+    assert note2.type == int
+
+if __name__ == "__main__":
+    test_attribute_validation_note()
+    test_iterable_validation_note()
+    print("All tests passed!")

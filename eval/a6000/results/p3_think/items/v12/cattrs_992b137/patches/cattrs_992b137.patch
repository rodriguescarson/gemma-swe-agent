diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..f7defb9
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,30 @@
+
+import pickle
+from src.cattrs.errors import IterableValidationNote, AttributeValidationNote
+
+def test_iterable_validation_note():
+    n = IterableValidationNote("error", 0, int)
+    p = pickle.dumps(n)
+    n2 = pickle.loads(p)
+    print(f"IterableValidationNote: {n2=}, {n2.index=}, {n2.type=}")
+    assert n2 == "error"
+    assert n2.index == 0
+    assert n2.type == int
+
+def test_attribute_validation_note():
+    n = AttributeValidationNote("error", "attr", int)
+    p = pickle.dumps(n)
+    n2 = pickle.loads(p)
+    print(f"AttributeValidationNote: {n2=}, {n2.name=}, {n2.type=}")
+    assert n2 == "error"
+    assert n2.name == "attr"
+    assert n2.type == int
+
+if __name__ == "__main__":
+    try:
+        test_iterable_validation_note()
+        test_attribute_validation_note()
+        print("Tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e

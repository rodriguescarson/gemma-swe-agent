new file mode 100644
index 0000000..0010d04
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,22 @@
+
+from enum import Enum
+from marshmallow import Schema, fields
+
+class MyEnum(Enum):
+    A = 1
+    B = None
+
+class MySchema(Schema):
+    enum_field = fields.Enum(MyEnum, by_value=True)
+
+schema = MySchema()
+print(f"allow_none: {schema.fields['enum_field'].allow_none}")
+
+# Test deserialization of None
+try:
+    result = schema.load({"enum_field": None})
+    print(f"Deserialized result: {result}")
+    print(f"Type of result['enum_field']: {type(result['enum_field'])}")
+    print(f"Is it MyEnum.B? {result['enum_field'] is MyEnum.B}")
+except Exception as e:
+    print(f"Error: {e}")

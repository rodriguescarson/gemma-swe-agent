@@ -1943,6 +1943,8 @@ class Enum(Field[_EnumT]):
         by_value: bool | Field | type[Field] = False,
         **kwargs: Unpack[_BaseFieldKwargs],
     ):
+        if by_value and any(m.value is None for m in enum):
+            kwargs.setdefault("allow_none", True)
         super().__init__(**kwargs)
         self.enum = enum
         self.by_value = by_value
@@ -1981,6 +1983,7 @@ class Enum(Field[_EnumT]):
         return self.field._serialize(val, attr, obj, **kwargs)
 
     def _deserialize(self, value, attr, data, **kwargs) -> _EnumT:

diff --git a/replace_mk.py b/replace_mk.py
new file mode 100644
index 0000000..8352d6f
--- /dev/null
+++ b/replace_mk.py
@@ -0,0 +1,56 @@
+
+import sys
+
+with open('arrow/locales.py', 'r', encoding='utf-8') as f:
+    lines = f.readlines()
+
+# Find MacedonianLocale
+start_line = -1
+for i, line in enumerate(lines):
+    if 'class MacedonianLocale(SlavicBaseLocale):' in line:
+        start_line = i
+        break
+
+if start_line == -1:
+    print("MacedonianLocale not found")
+    sys.exit(1)
+
+# Find timeframes start and end
+tf_start = -1
+tf_end = -1
+for i in range(start_line, len(lines)):
+    if 'timeframes = {' in lines[i]:
+        tf_start = i
+    if tf_start != -1 and '}' in lines[i] and lines[i].strip() == '}':
+        tf_end = i
+        break
+
+if tf_start == -1 or tf_end == -1:
+    print("timeframes block not found")
+    sys.exit(1)
+
+# Replace the block
+new_timeframes = [
+    '    timeframes = {\n',
+    '        "now": "сега",\n',
+    '        "second": "една секунда",\n',
+    '        "seconds": ["{0} секунда", "{0} секунди", "{0} секунди"],\n',
+    '        "minute": "една минута",\n',
+    '        "minutes": ["{0} минута", "{0} минути", "{0} минути"],\n',
+    '        "hour": "еден саат",\n',
+    '        "hours": ["{0} саат", "{0} саати", "{0} саати"],\n',
+    '        "day": "еден ден",\n',
+    '        "days": ["{0} ден", "{0} дена", "{0} дена"],\n',
+    '        "week": "една недела",\n',
+    '        "weeks": ["{0} недела", "{0} недели", "{0} недели"],\n',
+    '        "month": "еден месец",\n',
+    '        "months": ["{0} месец", "{0} месеци", "{0} месеци"],\n',
+    '        "year": "една година",\n',
+    '        "years": ["{0} година", "{0} години", "{0} години"],\n',
+    '    }\n',
+]
+
+lines[tf_start:tf_end+1] = new_timeframes
+
+with open('arrow/locales.py', 'w', encoding='utf-8') as f:
+    f.writelines(lines)

+import re
+
+__all__ = ['plugin_abbreviations']
+
+#: define an abbreviation item like::
+#:    :abbr: HTML = HyperText Markup Language
+DEF_ABBREVIATION = re.compile(
+    r'( {0,3}):abbr: ([^= \t\n]+) = ([^\n]+)'
+)
+
+#: inline abbreviation syntax looks like: :abbr:HTML:
+INLINE_ABBREVIATION_PATTERN = r':abbr:([a-zA-Z0-9_]+):'
+
+def parse_def_abbreviation(block, m, state):
+    key = m.group(2)
+    value = m.group(3).strip()
+    state.setdefault('def_abbreviations', {})[key] = value
+
+def parse_inline_abbreviation(inline, m, state):
+    key = m.group(1)
+    def_abbreviations = state.get('def_abbreviations')
+    if not def_abbreviations or key not in def_abbreviations:
+        return 'text', m.group(0)
+
+    return 'abbreviation', key, def_abbreviations[key]
+
+def render_html_abbreviation(text, value):
+    return '<abbr title="' + value + '">' + text + '</abbr>'
+
+def render_ast_abbreviation(text, value):
+    return {'type': 'abbreviation', 'text': text, 'value': value}
+
+def plugin_abbreviations(md):
+    md.inline.register_rule(
+        'abbreviation',
+        INLINE_ABBREVIATION_PATTERN,
+        parse_inline_abbreviation
+    )
+
+    try:
+        index = md.inline.rules.index('codespan')
+        md.inline.rules.insert(index, 'abbreviation')
+    except ValueError:
+        md.inline.rules.append('abbreviation')
+
+    md.block.register_rule('def_abbreviation', DEF_ABBREVIATION, parse_def_abbreviation)
+    try:
+        index = md.block.rules.index('def_link')
+        md.block.rules.insert(index, 'def_abbreviation')
+    except ValueError:
+        md.block.rules.append('def_abbreviation')
+
+    if md.renderer.NAME == 'html':
+        md.renderer.register('abbreviation', render_html_abbreviation)
+    elif md.renderer.NAME == 'ast':
+        md.renderer.register('abbreviation', render_ast_abbreviation)

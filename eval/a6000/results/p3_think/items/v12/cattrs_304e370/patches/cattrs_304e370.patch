diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..ca6fec5
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,35 @@
+from typing import NamedTuple
+from cattrs import Converter
+from cattrs.cols import namedtuple_dict_structure_factory
+
+class User(NamedTuple):
+    name: int
+    age: int
+
+def test_detailed_validation():
+    converter = Converter()
+    converter.detailed_validation = False
+    
+    # Case 1: detailed_validation=True
+    hook_true = namedtuple_dict_structure_factory(User, converter, detailed_validation=True)
+    
+    # Case 2: detailed_validation=False
+    hook_false = namedtuple_dict_structure_factory(User, converter, detailed_validation=False)
+    
+    # Both fields are strings, but should be ints. Both will fail.
+    data = {'name': 'not_an_int', 'age': 'not_an_int'}
+    
+    print("Testing detailed_validation=True")
+    try:
+        hook_true(data, converter)
+    except Exception as e:
+        print(f"Error with detailed_validation=True: {type(e).__name__}: {e}")
+        
+    print("\nTesting detailed_validation=False")
+    try:
+        hook_false(data, converter)
+    except Exception as e:
+        print(f"Error with detailed_validation=False: {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    test_detailed_validation()
diff --git a/repro_attrs.py b/repro_attrs.py
new file mode 100644
index 0000000..be7bbe6
--- /dev/null
+++ b/repro_attrs.py
@@ -0,0 +1,29 @@
+import attr
+from cattrs import Converter
+from cattrs.gen import make_dict_structure_fn_from_attrs
+
+@attr.s
+class User:
+    name: int
+    age: int
+
+def test():
+    converter = Converter()
+    
+    print("Testing detailed_validation=True")
+    # Manually call the function that namedtuple_dict_structure_factory calls
+    hook_true = make_dict_structure_fn_from_attrs(User, converter, _cattrs_detailed_validation=True)
+    try:
+        hook_true({'name': 'a', 'age': 'b'}, converter)
+    except Exception as e:
+        print(f"Error: {type(e).__name__}: {e}")
+
+    print("\nTesting detailed_validation=False")
+    hook_false = make_dict_structure_fn_from_attrs(User, converter, _cattrs_detailed_validation=False)
+    try:
+        hook_false({'name': 'a', 'age': 'b'}, converter)
+    except Exception as e:
+        print(f"Error: {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    test()

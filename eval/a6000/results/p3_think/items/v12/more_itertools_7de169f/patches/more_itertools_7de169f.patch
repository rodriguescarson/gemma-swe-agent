--- /dev/null
+++ b/repro.py
@@ -0,0 +1,17 @@
+
+class MockIterable:
+    def __init__(self, items):
+        self.items = items
+    def __iter__(self):
+        return iter(self.items)
+
+def test_last_with_none_reversed():
+    from more_itertools import last
+    iterable = MockIterable([1, 2, 3])
+    iterable.__reversed__ = None
+    print("Testing last() with __reversed__ is None...")
+    assert last(iterable) == 3
+    print("Success!")
+
+if __name__ == "__main__":
+    test_last_with_none_reversed()

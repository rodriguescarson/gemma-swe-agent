+from loguru import logger
+import io
+import json
+
+# Create a string IO sink to capture the output
+sink = io.StringIO()
+logger.add(sink, serialize=True, format="{message}")
+
+logger.info("你好")
+
+output = sink.getvalue()
+print(f"Output: {output!r}")
+
+# Check if the output contains the Unicode characters or their escaped versions
+if "\\u4f60\\u597d" in output:
+    print("Issue reproduced: Unicode is serialized to ASCII")
+elif "你好" in output:
+    print("Unicode preserved")
+else:
+    print("Unexpected output")

+import mistune
+from mistune.renderers.markdown import MarkdownRenderer
+
+md = mistune.create_markdown(renderer=MarkdownRenderer())
+
+# Test 1: double quote in title
+print(f"Test 1: {repr(md('[t](/u ' + 'a\"b' + ')'))}")
+
+# Test 2: backslash in title
+print(f"Test 2: {repr(md('[t](/u ' + 'a\\b' + ')'))}")
+
+# Test 3: backslash and double quote in title
+print(f"Test 3: {repr(md('[t](/u ' + 'a\\\"b' + ')'))}")

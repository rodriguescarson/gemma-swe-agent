diff --git a/boltons/mathutils.py b/boltons/mathutils.py
index eb5a4b1..a1355f8 100644
--- a/boltons/mathutils.py
+++ b/boltons/mathutils.py
@@ -87,3 +87,31 @@ def floor(x, options=None):
     if not i:
         raise ValueError("no floor options less than or equal to: %r" % x)
     return options[i - 1]
+
+
+class Bits(int):
+    \"\"\"An integer with bit-manipulation helpers.\"\"\"
+
+    def set_bit(self, bit):
+        \"\"\"Set the bit at the given position to 1.\"\"\"
+        return Bits(self | (1 << bit))
+
+    def clear_bit(self, bit):
+        \"\"\"Clear the bit at the given position to 0.\"\"\"
+        return Bits(self & ~(1 << bit))
+
+    def toggle_bit(self, bit):
+        \"\"\"Toggle the bit at the given position.\"\"\"
+        return Bits(self ^ (1 << bit))
+
+    def get_bit(self, bit):
+        \"\"\"Return the value of the bit at the given position (0 or 1).\"\"\"
+        return (self >> bit) & 1
+
+    def count_set_bits(self):
+        \"\"\"Return the number of bits set to 1.\"\"\"
+        return self.bit_count()
+
+    def __repr__(self):
+        return f'Bits({super().__repr__()})'
+

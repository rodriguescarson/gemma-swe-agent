+def random_derangement(iterable):
+    """Return a random derangement of the elements in *iterable*.
+
+    A derangement is a permutation in which no element appears at its original
+    index. In other words, a derangement is a permutation that has no fixed points.
+
+    Elements are treated as unique based on their position, not on their value.
+
+    >>> random_derangement([1, 2, 3])  # doctest: +SKIP
+    [2, 3, 1]
+
+    >>> random_derangement(['Alice', 'Bob', 'Carol', 'Dave'])  # doctest: +SKIP
+    ['Bob', 'Alice', 'Dave', 'Carol']
+
+    >>> random_derangement([1])
+    Traceback (most recent call last):
+        ...
+    ValueError: No derangement exists for a single element
+    """
+    items = list(iterable)
+    n = len(items)
+    if n == 0:
+        return []
+    if n == 1:
+        raise ValueError('No derangement exists for a single element')
+
+    indices = list(range(n))
+    while True:
+        shuffle(indices)
+        if all(indices[i] != i for i in range(n)):
+            break
+    return [items[i] for i in indices]
+
+

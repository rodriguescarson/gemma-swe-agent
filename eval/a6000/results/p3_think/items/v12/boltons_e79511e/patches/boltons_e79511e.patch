+def lstrip_iter(src, chars=None):
+    """Returns an iterator that strips leading elements from the
+    iterable *src*. *chars* can be:
+
+      * a single value
+      * an iterable of values
+      * a single-argument callable that returns True when an element
+        should be stripped
+
+    If *chars* is ``None``, elements equal to ``None`` are stripped.
+
+    >>> list(lstrip_iter([None, None, 1, 2, None, 3]))
+    [1, 2, None, 3]
+    >>> list(lstrip_iter([1, 2, 3], chars=[1, 2]))
+    [3]
+    >>> list(lstrip_iter([1, 2, 3], chars=lambda x: x < 3))
+    [3]
+    """
+    if not is_iterable(src):
+        raise TypeError('expected an iterable')
+
+    if callable(chars):
+        chars_func = chars
+    elif not is_scalar(chars):
+        chars = frozenset(chars)
+        chars_func = lambda x: x in chars
+    else:
+        chars_func = lambda x: x == chars
+
+    it = iter(src)
+    for x in it:
+        if not chars_func(x):
+            yield x
+            break
+    yield from it
+
+
+def lstrip(src, chars=None):
+    """Returns a list that strips leading elements from the
+    iterable *src*. See :func:`lstrip_iter` for more info.
+    """
+    return list(lstrip_iter(src, chars))
+
+
+def rstrip_iter(src, chars=None):
+    """Returns an iterator that strips trailing elements from the
+    iterable *src*. *chars* can be:
+
+      * a single value
+      * an iterable of values
+      * a single-argument callable that returns True when an element
+        should be stripped
+
+    If *chars* is ``None``, elements equal to ``None`` are stripped.
+
+    >>> list(rstrip_iter([1, 2, None, 3, None, None]))
+    [1, 2, None, 3]
+    >>> list(rstrip_iter([1, 2, 3], chars=[3, 2]))
+    [1]
+    >>> list(rstrip_iter([1, 2, 3], chars=lambda x: x > 1))
+    [1]
+    """
+    if not is_iterable(src):
+        raise TypeError('expected an iterable')
+
+    if callable(chars):
+        chars_func = chars
+    elif not is_scalar(chars):
+        chars = frozenset(chars)
+        chars_func = lambda x: x in chars
+    else:
+        chars_func = lambda x: x == chars
+
+    items = list(src)
+    while items and chars_func(items[-1]):
+        items.pop()
+    return iter(items)
+
+
+def rstrip(src, chars=None):
+    """Returns a list that strips trailing elements from the
+    iterable *src*. See :func:`rstrip_iter` for more info.
+    """
+    return list(rstrip_iter(src, chars))
+
+
+def strip_iter(src, chars=None):
+    """Returns an iterator that strips leading and trailing elements
+    from the iterable *src*. *chars* can be:
+
+      * a single value
+      * an iterable of values
+      * a single-argument callable that returns True when an element
+        should be stripped
+
+    If *chars* is ``None``, elements equal to ``None`` are stripped.
+
+    >>> list(strip_iter([None, 1, 2, None, None]))
+    [1, 2]
+    >>> list(strip_iter([1, 2, 3], chars=[1, 3]))
+    [2]
+    >>> list(strip_iter([1, 2, 3], chars=lambda x: x != 2))
+    [2]
+    """
+    if not is_iterable(src):
+        raise TypeError('expected an iterable')
+
+    return rstrip_iter(lstrip_iter(src, chars), chars)
+
+
+def strip(src, chars=None):
+    """Returns a list that strips leading and trailing elements
+    from the iterable *src*. See :func:`strip_iter` for more info.
+    """
+    return list(strip_iter(src, chars))
+

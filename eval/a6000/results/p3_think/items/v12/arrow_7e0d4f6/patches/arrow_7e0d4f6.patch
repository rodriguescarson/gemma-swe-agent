@@ -100,6 +100,12 @@ class DateTimeFormatter(object):
         if token == "X":
             return str(calendar.timegm(dt.utctimetuple()))
 
+        if token == "W":
+            # ISO 8601 week date: YYYY-Www-D
+            # dt.isocalendar() returns (year, week, weekday)
+            year, week, day = dt.isocalendar()
+            return "{}-W{:02d}-{}".format(year, week, day)
+
         if token == "ZZZ":
             return dt.tzname()
 

@@ -0,0 +1,11 @@
+
+import arrow
+from arrow.locales import Locale
+
+class MockLocale(Locale):
+    def _format_timeframe(self, timeframe, delta):
+        return f"{delta} {timeframe}"
+
+locale = MockLocale()
+print(f"Describe: {locale.describe('hours', 1.5, only_distance=True)}")
+print(f"Describe multi: {locale.describe_multi([('hours', 1.5), ('minutes', 2.5)], only_distance=True)}")

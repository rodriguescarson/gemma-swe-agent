diff --git a/reproduce_crash.py b/reproduce_crash.py
new file mode 100644
index 0000000..55ee803
--- /dev/null
+++ b/reproduce_crash.py
@@ -0,0 +1,34 @@
+
+import sys
+from io import StringIO
+from isort import api
+from isort.settings import Config
+
+def test_sort_reexports_non_seekable():
+    # Mock a non-seekable stream
+    class NonSeekableStream:
+        def write(self, s):
+            sys.stdout.write(s)
+        def seek(self, pos):
+            raise IOError("underlying stream is not seekable")
+        def tell(self):
+            return 0
+        def readable(self):
+            return False
+
+    input_stream = StringIO("__all__ = ['a', 'b']")
+    output_stream = NonSeekableStream()
+    
+    print("Testing sort_reexports with non-seekable stream...")
+    try:
+        # sort_reexports=True should trigger the seek() in core.process()
+        config = Config(sort_reexports=True)
+        api.sort_stream(input_stream, output_stream, config=config)
+        print("Success!")
+    except IOError as e:
+        print(f"Caught expected IOError: {e}")
+    except Exception as e:
+        print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    test_sort_reexports_non_seekable()

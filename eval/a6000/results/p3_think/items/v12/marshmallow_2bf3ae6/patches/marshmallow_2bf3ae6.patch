diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..f0d6e06
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,37 @@
+
+from marshmallow import Schema, fields
+
+class ChildSchema(Schema):
+    name = fields.Str()
+
+# Case 1: schema instance has many=True, Nested has many=False
+child_schema_many = ChildSchema(many=True)
+class ParentSchema(Schema):
+    children = fields.Nested(child_schema_many, many=False)
+
+parent = ParentSchema()
+data = {"name": "child1"}
+# If consistency is improved, this should probably be treated as many=False.
+# Currently, _serialize does: many = schema.many or self.many
+# schema.many is True, so many is True.
+# schema.dump([data], many=True) would work, but here nested_obj is likely data.
+
+print("Case 1: Nested(many=False) with schema(many=True)")
+print(f"Field many: {parent.fields['children'].many}")
+print(f"Schema many: {parent.fields['children'].schema.many}")
+# Try to dump a single object
+print(f"Dump single object: {parent.dump({'children': {'name': 'child1'}})}")
+# Try to dump a list of objects
+print(f"Dump list of objects: {parent.dump({'children': [{'name': 'child1'}]})}")
+
+# Case 2: schema instance has many=False, Nested has many=True
+child_schema_one = ChildSchema(many=False)
+class ParentSchema2(Schema):
+    children = fields.Nested(child_schema_one, many=True)
+
+parent2 = ParentSchema2()
+print("\nCase 2: Nested(many=True) with schema(many=False)")
+print(f"Field many: {parent2.fields['children'].many}")
+print(f"Schema many: {parent2.fields['children'].schema.many}")
+print(f"Dump list of objects: {parent2.dump({'children': [{'name': 'child1'}]})}")
+print(f"Dump single object: {parent2.dump({'children': {'name': 'child1'}})}")

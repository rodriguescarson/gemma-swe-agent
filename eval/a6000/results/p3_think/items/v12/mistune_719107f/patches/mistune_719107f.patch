diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..9bbc75b
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,24 @@
+import mistune
+from mistune.directives import FencedDirective, Admonition
+
+# Use colon as marker for FencedDirective
+# FencedDirective requires 3 or more markers by default
+md = mistune.create_markdown(plugins=[FencedDirective([Admonition()], markers=":")])
+
+# Case 1: Single colon should NOT be a directive
+text1 = ":{note}\nlazy\n"
+output1 = md(text1)
+print(f"Case 1:\nInput:\n{text1}\nOutput:\n{output1}\n")
+# Expected: <p>:{note}\nlazy</p> (or similar, but not an admonition)
+assert "<section class=\"admonition" not in output1
+
+# Case 2: Single colon in a list item should NOT be a directive
+text2 = "- item\n:{note}\nlazy\n"
+output2 = md(text2)
+print(f"Case 2:\nInput:\n{text2}\nOutput:\n{output2}\n")
+# Expected: <ul><li>item</li></ul><p>:{note}\nlazy</p> (not an admonition)
+# If the bug is present, it might be interpreted as an admonition because
+# the indent bound for the rule was incorrectly relaxed.
+assert "<section class=\"admonition" not in output2
+
+print("Success: No incorrect directives found.")

+import markdown
+
+def test_reference_link_id_no_brackets():
+    # Case 1: Right bracket is already disallowed
+    text1 = '[my]id]: http://example.com\n\n[link][my]id]'
+    output1 = markdown.markdown(text1)
+    assert '<a href="http://example.com">' not in output1
+
+    # Case 2: Left bracket should be disallowed
+    text2 = '[my[id]: http://example.com\n\n[link][my[id]]'
+    output2 = markdown.markdown(text2)
+    assert '<a href="http://example.com">' not in output2
+
+    # Case 3: Valid reference should still work
+    text3 = '[myid]: http://example.com\n\n[link][myid]'
+    output3 = markdown.markdown(text3)
+    assert '<a href="http://example.com">link</a>' in output3
+
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    test_reference_link_id_no_brackets()

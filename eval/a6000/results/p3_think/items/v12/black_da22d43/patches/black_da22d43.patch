+def _write_to_stdout(text: str, encoding: str, newline: str, color: bool = False) -> None:
+    if hasattr(sys.stdout, "buffer"):
+        f = io.TextIOWrapper(
+            sys.stdout.buffer, encoding=encoding, newline=newline, write_through=True
+        )
+        if color:
+            f = wrap_stream_for_windows(f)
+        try:
+            f.write(text)
+        finally:
+            f.detach()
+    else:
+        f = sys.stdout
+        if color:
+            f = wrap_stream_for_windows(f)
+        f.write(text.replace("\n", newline))
+

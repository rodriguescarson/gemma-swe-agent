+def chunk_ranges(input_size, size, overlap=0, alignment=0):
+    \"\"\"Produces ranges of indices to chunk a sequence.
+
+    :param input_size: Total size of the sequence.
+    :param size: Size of each chunk.
+    :param overlap: Number of overlapping elements between adjacent chunks.
+    :param alignment: Align the start of chunks to a multiple of this value.
+    \"\"\"
+    if size <= 0:
+        raise ValueError('expected a positive integer chunk size')
+    if overlap >= size:
+        raise ValueError('overlap must be less than size')
+
+    start = 0
+    while start < input_size:
+        end = min(start + size, input_size)
+        yield (start, end)
+        if end == input_size:
+            break
+
+        next_start = end - overlap
+        if alignment > 0:
+            next_start = (next_start // alignment) * alignment
+            if next_start <= start:
+                next_start = ((start + 1 + alignment - 1) // alignment) * alignment
+
+        start = next_start
+

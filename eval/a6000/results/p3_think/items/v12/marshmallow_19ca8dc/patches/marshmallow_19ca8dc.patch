@@ -0,0 +1,17 @@
+from marshmallow import Schema, fields, ValidationError
+
+def test_constant_val():
+    class MySchema(Schema):
+        constant_field = fields.Constant(1)
+    
+    schema = MySchema()
+    try:
+        schema.load({"constant_field": None})
+        print("Test 3 (Constant(1)) failed: should have raised ValidationError for None")
+    except ValidationError as e:
+        print("Test 3 (Constant(1)) successful:", e.messages)
+    except Exception as e:
+        print("Test 3 (Constant(1)) failed with unexpected exception:", e)
+
+if __name__ == "__main__":
+    test_constant_val()

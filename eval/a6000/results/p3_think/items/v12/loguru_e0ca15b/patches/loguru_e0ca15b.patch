@@ -0,0 +1,21 @@
+
+import sys
+from loguru import logger
+
+def failing_sink(message):
+    raise RuntimeError("Sink failed!")
+
+logger.remove()
+logger.add(failing_sink, enqueue=True, catch=False)
+
+try:
+    logger.info("This should fail eventually")
+    # Give the background thread some time to process
+    import time
+    time.sleep(0.1)
+    logger.info("This should also fail")
+    time.sleep(0.1)
+except Exception as e:
+    print(f"Caught exception: {e}")
+
+print("Done")

@@ -0,0 +1,30 @@
+import asyncio
+from loguru import logger
+import sys
+
+async def test_async_catch():
+    try:
+        async with logger.catch():
+            raise ValueError("Async error")
+    except ValueError:
+        print("Caught ValueError as expected (reraise=True is default? No, reraise=False is default)")
+        return
+
+    print("Exception was caught by logger.catch()")
+
+async def test_async_catch_reraise():
+    try:
+        async with logger.catch(reraise=True):
+            raise ValueError("Async error reraise")
+    except ValueError:
+        print("Caught ValueError as expected with reraise=True")
+        return
+    
+    print("Error: Exception was not reraised")
+
+async def main():
+    await test_async_catch()
+    await test_async_catch_reraise()
+
+if __name__ == "__main__":
+    asyncio.run(main())

@@ -0,0 +1,29 @@
+from markdown import Markdown
+from markdown.util import AtomicString
+import xml.etree.ElementTree as etree
+
+def test_abbr_respects_atomic_string():
+    md = Markdown(extensions=['abbr'], extension_configs={'abbr': {'glossary': {'TLA': 'Three Letter Acronym'}}})
+    
+    # Create a root element and add a paragraph with AtomicString
+    root = etree.Element('root')
+    p = etree.SubElement(root, 'p')
+    p.text = AtomicString('This is a TLA.')
+    
+    # Run the abbr treeprocessor
+    for processor in md.treeprocessors:
+        if processor.__class__.__name__ == 'AbbrTreeprocessor':
+            processor.run(root)
+            
+    # Check if TLA was replaced
+    # If it respects AtomicString, it should NOT be replaced.
+    assert len(list(root.iter('abbr'))) == 0
+    assert p.text == 'This is a TLA.'
+
+if __name__ == "__main__":
+    try:
+        test_abbr_respects_atomic_string()
+        print("Test passed!")
+    except AssertionError as e:
+        print("Test failed!")
+        raise e

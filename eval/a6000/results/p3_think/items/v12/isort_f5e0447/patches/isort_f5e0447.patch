+import isort
+from io import StringIO
+
+code = '"""My module.\n\nProvides example functionality."""\n\nprint("hello, world")'
+config = isort.Config(add_imports=["from __future__ import annotations"])
+
+input_stream = StringIO(code)
+output_stream = StringIO()
+
+isort.core.process(input_stream, output_stream, config=config)
+
+print(output_stream.getvalue())

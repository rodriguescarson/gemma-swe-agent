diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..93d8581
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,14 @@
+import isort
+
+code = """
+import a  # comment a
+import b  # comment b
+"""
+
+first_pass = isort.code(code, combine_straight_imports=True)
+print(f"First pass:\n{first_pass}")
+
+second_pass = isort.code(first_pass, combine_straight_imports=True)
+print(f"Second pass:\n{second_pass}")
+
+assert first_pass == second_pass, f"Not idempotent!\nFirst:\n{first_pass}\nSecond:\n{second_pass}"

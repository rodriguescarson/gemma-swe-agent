@@ -0,0 +1,11 @@
+import isort.parse
+from isort.settings import DEFAULT_CONFIG
+
+code = """
+# comment a
+# comment b
+import a, b
+"""
+parsed = isort.parse.file_contents(code, DEFAULT_CONFIG)
+print(f"Categorized comments above straight: {parsed.categorized_comments['above']['straight']}")
+print(f"Straight imports: {parsed.imports['THIRDPARTY']['straight']}")

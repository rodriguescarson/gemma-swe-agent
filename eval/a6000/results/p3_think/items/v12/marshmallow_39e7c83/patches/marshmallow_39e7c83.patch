+from marshmallow.validate import URL, ValidationError
+
+def test_url_file():
+    url_validator = URL(schemes={"http", "https", "ftp", "ftps", "file"})
+    
+    # This should pass
+    try:
+        url_validator("file:///tmp/test")
+        print("PASS: file:///tmp/test")
+    except ValidationError:
+        print("FAIL: file:///tmp/test")
+
+    # This should pass, but currently fails
+    try:
+        url_validator("FILE:///tmp/test")
+        print("PASS: FILE:///tmp/test")
+    except ValidationError:
+        print("FAIL: FILE:///tmp/test")
+
+    # This should pass
+    try:
+        url_validator("file://localhost/tmp/test")
+        print("PASS: file://localhost/tmp/test")
+    except ValidationError:
+        print("FAIL: file://localhost/tmp/test")
+
+    # This should pass
+    try:
+        url_validator("FILE://localhost/tmp/test")
+        print("PASS: FILE://localhost/tmp/test")
+    except ValidationError:
+        print("FAIL: FILE://localhost/tmp/test")
+
+if __name__ == "__main__":
+    test_url_file()

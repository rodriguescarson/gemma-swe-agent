@@ -0,0 +1,39 @@
+from more_itertools import numeric_range
+
+def test_numeric_range_slicing():
+    nr = numeric_range(0, 10, 2)  # [0, 2, 4, 6, 8]
+    print(f"nr: {list(nr)}")
+    
+    # Reversed via reversed()
+    print(f"reversed(nr): {list(reversed(nr))}")
+    
+    # Reversed via slicing
+    sliced = nr[::-1]
+    print(f"nr[::-1]: {list(sliced)}")
+    assert list(sliced) == [8, 6, 4, 2, 0], f"Expected [8, 6, 4, 2, 0], got {list(sliced)}"
+
+    # Slicing with positive step
+    sliced_pos = nr[1:4]
+    print(f"nr[1:4]: {list(sliced_pos)}")
+    assert list(sliced_pos) == [2, 4, 6], f"Expected [2, 4, 6], got {list(sliced_pos)}"
+
+    # Slicing with step
+    sliced_step = nr[::2]
+    print(f"nr[::2]: {list(sliced_step)}")
+    assert list(sliced_step) == [0, 4, 8], f"Expected [0, 4, 8], got {list(sliced_step)}"
+
+    # Negative range
+    nr_neg = numeric_range(10, 0, -2)  # [10, 8, 6, 4, 2]
+    print(f"nr_neg: {list(nr_neg)}")
+    sliced_neg = nr_neg[::-1]
+    print(f"nr_neg[::-1]: {list(sliced_neg)}")
+    assert list(sliced_neg) == [2, 4, 6, 8, 10], f"Expected [2, 4, 6, 8, 10], got {list(sliced_neg)}"
+
+if __name__ == "__main__":
+    try:
+        test_numeric_range_slicing()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")

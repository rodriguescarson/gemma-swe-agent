+def running_statistics(iterable):
+    """
+    Yield running count, mean, and sample variance of the elements of the iterable.
+
+    >>> list(running_statistics([1, 2, 3]))
+    [(1, 1.0, 0.0), (2, 1.5, 0.5), (3, 2.0, 1.0)]
+    """
+    count = 0
+    mean = 0.0
+    m2 = 0.0
+    for x in iterable:
+        count += 1
+        delta = x - mean
+        mean += delta / count
+        delta2 = x - mean
+        m2 += delta * delta2
+        variance = m2 / (count - 1) if count > 1 else 0.0
+        yield (count, mean, variance)
+

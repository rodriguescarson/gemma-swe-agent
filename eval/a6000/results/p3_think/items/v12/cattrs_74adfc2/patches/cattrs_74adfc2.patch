diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..c9fef99
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,40 @@
+
+from enum import Enum
+from dataclasses import dataclass
+from cattr import Converter
+
+@dataclass
+class Point:
+    x: int
+    y: int
+
+class Location(Enum):
+    _value_: Point
+    HOME = Point(0, 0)
+    WORK = Point(10, 10)
+
+converter = Converter()
+
+# Unstructuring
+home = Location.HOME
+unstructured = converter.unstructure(home)
+print(f"Unstructured HOME: {unstructured}")
+# Expect: {'x': 0, 'y': 0}
+
+# Structuring
+structured = converter.structure({'x': 0, 'y': 0}, Location)
+print(f"Structured HOME: {structured}")
+# Expect: Location.HOME
+
+# Test without _value_ hint
+class SimpleLocation(Enum):
+    HOME = Point(0, 0)
+
+home_simple = SimpleLocation.HOME
+unstructured_simple = converter.unstructure(home_simple)
+print(f"Unstructured simple HOME: {unstructured_simple}")
+# Expect: Point(x=0, y=0) (not unstructured further)
+
+structured_simple = converter.structure(Point(0, 0), SimpleLocation)
+print(f"Structured simple HOME: {structured_simple}")
+# Expect: SimpleLocation.HOME

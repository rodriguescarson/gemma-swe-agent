+def _pollard_rho(n):
+    if n % 2 == 0:
+        return 2
+    x = randrange(2, n)
+    y = x
+    c = randrange(1, n)
+    g = 1
+    while g == 1:
+        x = (x * x + c) % n
+        y = (y * y + c) % n
+        y = (y * y + c) % n
+        g = math.gcd(abs(x - y), n)
+        if g == n:
+            x = randrange(2, n)
+            y = x
+            c = randrange(1, n)
+            g = 1
+    return g
+

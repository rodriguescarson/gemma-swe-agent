diff --git a/reproduce_attrs.py b/reproduce_attrs.py
new file mode 100644
index 0000000..01a0e49
--- /dev/null
+++ b/reproduce_attrs.py
@@ -0,0 +1,17 @@
+import attrs
+from cattrs import Converter
+
+@attrs.define
+class User:
+    name: str
+    age: int
+
+converter = Converter()
+converter.detailed_validation = False
+print(f"detailed_validation: {converter.detailed_validation}")
+data = {"name": "Alice", "age": "not an int"}
+
+try:
+    converter.structure(data, User)
+except Exception as e:
+    print(f"Caught exception: {type(e).__name__}: {e}")

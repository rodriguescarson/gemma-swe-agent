+    return ''.join(result)\n\n\ndef range2list(range_string):\n    \"\"\"Converts a range string (e.g. '1-3, 5, 7-10') to a list of integers\n    (e.g. [1, 2, 3, 5, 7, 8, 9, 10]).\n\n    >>> range2list('1-3, 5, 7-10')\n    [1, 2, 3, 5, 7, 8, 9, 10]\n    >>> range2list('1')\n    [1]\n    >>> range2list('')\n    []\n    \"\"\"\n    if not range_string:\n        return []\n    \n    result = []\n    for part in range_string.split(','):\n        part = part.strip()\n        if not part:\n            continue\n        if '-' in part:\n            try:\n                start, end = part.split('-')\n                result.extend(range(int(start), int(end) + 1))\n            except ValueError:\n                raise ValueError(\"Invalid range string: %s\" % part)\n        else:\n            try:\n                result.append(int(part))\n            except ValueError:\n                raise ValueError(\"Invalid range string: %s\" % part)\n    return result\n\n\ndef list2range(numbers):\n    \"\"\"Converts a list of integers (e.g. [1, 2, 3, 5, 7, 8, 9, 10]) to a\n    concise range string (e.g. '1-3, 5, 7-10').\n\n    >>> list2range([1, 2, 3, 5, 7, 8, 9, 10])\n    '1-3, 5, 7-10'\n    >>> list2range([1, 3, 5])\n    '1, 3, 5'\n    >>> list2range([])\n    ''\n    \"\"\"\n    if not numbers:\n        return ''\n    \n    # Ensure sorted and unique numbers for range compression\n    numbers = sorted(set(numbers))\n    \n    ranges = []\n    start = numbers[0]\n    end = numbers[0]\n    \n    for i in range(1, len(numbers)):\n        if numbers[i] == end + 1:\n            end = numbers[i]\n        else:\n            if start == end:\n                ranges.append(str(start))\n            else:\n                ranges.append('%s-%s' % (start, end))\n            start = numbers[i]\n            end = numbers[i]\n    \n    if start == end:\n        ranges.append(str(start))\n    else:\n        ranges.append('%s-%s' % (start, end))\n        \n    return ', '.join(ranges)\n

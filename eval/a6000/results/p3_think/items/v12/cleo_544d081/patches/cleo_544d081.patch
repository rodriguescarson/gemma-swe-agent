diff --git a/src/cleo/wcwidth.py b/src/cleo/wcwidth.py
new file mode 100644
index 0000000..6978793
--- /dev/null
+++ b/src/cleo/wcwidth.py
@@ -0,0 +1,25 @@
+def wcwidth(c: str) -> int:
+    """Return the number of columns that the character c takes up."""
+    if len(c) != 1:
+        raise ValueError("wcwidth() expects a single character")
+
+    codepoint = ord(c)
+
+    if (0x0000 <= codepoint <= 0x001F) or (0x007F <= codepoint <= 0x009F):
+        return 0
+
+    if (0x1100 <= codepoint <= 0x115F) or \
+       (0x2E80 <= codepoint <= 0xA4CF) or \
+       (0xAC00 <= codepoint <= 0xD7A3) or \
+       (0xF900 <= codepoint <= 0xFAFF) or \
+       (0xFE10 <= codepoint <= 0xFE19) or \
+       (0xFE30 <= codepoint <= 0xFE6F) or \
+       (0xFF00 <= codepoint <= 0xFF60) or \
+       (0xFFE0 <= codepoint <= 0xFFE6):
+        return 2
+
+    return 1
+
+def wcswidth(s: str) -> int:
+    """Return the number of columns that the string s takes up."""
+    return sum(wcwidth(c) for c in s)

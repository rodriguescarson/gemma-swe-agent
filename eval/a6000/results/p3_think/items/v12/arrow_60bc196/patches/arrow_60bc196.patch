diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..6406f1d
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,45 @@
+import arrow
+from datetime import datetime
+
+def test_span_weekday():
+    # 2023-10-23 is a Monday
+    a = arrow.Arrow(2023, 10, 23)
+    
+    # Monday start (default)
+    floor, ceil = a.span('week', weekday=1)
+    assert floor.date() == datetime(2023, 10, 23).date()
+    
+    # Sunday start
+    # Monday should go back to previous Sunday (2023-10-22)
+    floor, ceil = a.span('week', weekday=7)
+    assert floor.date() == datetime(2023, 10, 22).date()
+
+    # 2023-10-29 is a Sunday
+    a_sun = arrow.Arrow(2023, 10, 29)
+    
+    # Monday start
+    # Sunday should go back to previous Monday (2023-10-23)
+    floor, ceil = a_sun.span('week', weekday=1)
+    assert floor.date() == datetime(2023, 10, 23).date()
+    
+    # Sunday start
+    # Sunday should stay on Sunday (2023-10-29)
+    floor, ceil = a_sun.span('week', weekday=7)
+    assert floor.date() == datetime(2023, 10, 29).date()
+
+    print("All span_weekday tests passed!")
+
+def test_floor_ceil_weekday():
+    a = arrow.Arrow(2023, 10, 23) # Monday
+    assert a.floor('week', weekday=7).date() == datetime(2023, 10, 22).date()
+    assert a.ceil('week', weekday=7).shift(microseconds=-1).date() == datetime(2023, 10, 28).date() # Sat? Wait.
+
+    a_sun = arrow.Arrow(2023, 10, 29) # Sunday
+    assert a_sun.floor('week', weekday=1).date() == datetime(2023, 10, 23).date()
+    assert a_sun.floor('week', weekday=7).date() == datetime(2023, 10, 29).date()
+    
+    print("All floor_ceil_weekday tests passed!")
+
+if __name__ == "__main__":
+    test_span_weekday()
+    test_floor_ceil_weekday()

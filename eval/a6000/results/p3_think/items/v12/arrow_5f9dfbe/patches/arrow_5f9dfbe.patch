@@ -0,0 +1,24 @@
+import arrow
+from arrow.parser import TzinfoParser
+from datetime import tzinfo
+
+def test_tz_parse(tz_str, expected_offset):
+    try:
+        tz = TzinfoParser.parse(tz_str)
+        # offset is in seconds from UTC
+        # tz.utcoffset(None).total_seconds()
+        print(f"Parsed {tz_str!r} to offset {tz.utcoffset(None).total_seconds()}s")
+    except Exception as e:
+        print(f"Failed to parse {tz_str!r}: {e}")
+
+# Original cases
+test_tz_parse("+01:00", 3600)
+test_tz_parse("-01:00", -3600)
+test_tz_parse("+0100", 3600)
+
+# New cases
+test_tz_parse("(UTC+01:00) Amsterdam, Berlin", 3600)
+test_tz_parse("(UTC-01:00) somewhere", -3600)
+test_tz_parse("UTC+01:00", 3600)
+test_tz_parse("UTC-01:00", -3600)
+test_tz_parse("(UTC+01:00)", 3600)

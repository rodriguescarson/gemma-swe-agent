diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..deae999
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,21 @@
+import re
+
+NOT_STRONG_RE_OLD = r'((^|\\s)(\\*|_)(\\s|$))'
+NOT_STRONG_RE_NEW = r'(?:^|(?<=\s))(\*|_)(?=\s|$)'
+
+texts = [" * ", "* ", " *", "*"]
+print(f"Testing OLD regex: {NOT_STRONG_RE_OLD}")
+for t in texts:
+    m = re.search(NOT_STRONG_RE_OLD, t)
+    if m:
+        print(f"Text: '{t}' -> Match: '{m.group(0)}', Group 1: '{m.group(1)}'")
+    else:
+        print(f"Text: '{t}' -> No match")
+
+print(f"\nTesting NEW regex: {NOT_STRONG_RE_NEW}")
+for t in texts:
+    m = re.search(NOT_STRONG_RE_NEW, t)
+    if m:
+        print(f"Text: '{t}' -> Match: '{m.group(0)}', Group 1: '{m.group(1)}'")
+    else:
+        print(f"Text: '{t}' -> No match")

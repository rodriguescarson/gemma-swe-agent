index 0000000..e7a085d
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,27 @@
+
+import attr
+from attr import make_class, resolve_types
+
+# Create a class using make_class
+cls = make_class("MyClass", {"a": attr.ib(type=int)})
+print(f"Class 1: {cls}")
+print(f"__annotations__ 1: {getattr(cls, '__annotations__', 'Not found')}")
+
+try:
+    resolve_types(cls)
+    print("resolve_types succeeded for Class 1")
+    print(f"Field type 1: {cls.__attrs_attrs__[0].type}")
+except Exception as e:
+    print(f"resolve_types failed for Class 1: {e}")
+
+# Test with a string annotation that needs resolution
+cls2 = make_class("MyClass2", {"a": attr.ib(type="int")})
+print(f"Class 2: {cls2}")
+print(f"__annotations__ 2: {getattr(cls2, '__annotations__', 'Not found')}")
+
+try:
+    resolve_types(cls2)
+    print("resolve_types succeeded for Class 2")
+    print(f"Field type 2: {cls2.__attrs_attrs__[0].type}")
+except Exception as e:
+    print(f"resolve_types failed for Class 2: {e}")

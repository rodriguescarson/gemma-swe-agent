+def doublestarmap(func, iterable):
+    """Return an iterator that yields results of *func* called with keyword
+    arguments from each element of *iterable*.
+
+    >>> doublestarmap(lambda **kwargs: sum(kwargs.values()), [{"a": 1, "b": 2}, {"a": 3, "b": 4}])
+    <generator object doublestarmap at ...>
+    """
+    for d in iterable:
+        yield func(**d)
+

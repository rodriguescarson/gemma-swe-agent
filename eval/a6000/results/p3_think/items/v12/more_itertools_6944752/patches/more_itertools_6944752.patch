+def dft(iterable):
+    """Compute the discrete Fourier transform (DFT) of an iterable.
+
+    >>> list(dft([1, 1, 0, 0]))
+    [(2+0j), (1-1j), 0j, (1+1j)]
+    """
+    x = list(iterable)
+    N = len(x)
+    for k in range(N):
+        yield sum(x[n] * cmath.exp(-2j * cmath.pi * k * n / N) for n in range(N))
+
+
+def idft(iterable):
+    """Compute the inverse discrete Fourier transform (IDFT) of an iterable.
+
+    >>> list(idft([1, 1, 0, 0]))
+    [(0.5+0j), (0.25+0.25j), 0j, (0.25-0.25j)]
+    """
+    X = list(iterable)
+    N = len(X)
+    for n in range(N):
+        yield sum(X[k] * cmath.exp(2j * cmath.pi * k * n / N) for k in range(N)) / N

diff --git a/src/attr/validators.py b/src/attr/validators.py
index 7e3ff16..a03bc06 100644
--- a/src/attr/validators.py
+++ b/src/attr/validators.py
@@ -371,6 +371,24 @@ def is_callable():
     return _IsCallableValidator()
 
 
+def _is_validator():
+    return _IsValidatorValidator()
+
+
+@attrs(repr=False, slots=False, hash=True)
+class _IsValidatorValidator(object):
+    def __call__(self, inst, attr, value):
+        if callable(value):
+            return
+        if isinstance(value, (list, tuple)) and all(callable(v) for v in value):
+            return
+        raise NotCallableError(
+            msg="'{name}' must be callable (got {value!r} that is a {actual!r}).".format(
+                name=attr.name, value=value, actual=value.__class__
+            )
+        )
+
+
 @attrs(repr=False, slots=True, hash=True)
 class _DeepIterable(object):
     member_validator = attrib(validator=is_callable())

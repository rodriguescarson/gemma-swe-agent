+++ b/repro.py
@@ -0,0 +1,35 @@
+import attr
+from attr import fields
+
+@attr.define
+class MyClass:
+    x: int = 1
+    y: str = "hello"
+
+def test_fields_with_class():
+    print("Testing fields with class...")
+    f = fields(MyClass)
+    print(f"Fields of MyClass: {f}")
+    assert len(f) == 2
+    print("Success!")
+
+def test_fields_with_instance():
+    print("Testing fields with instance...")
+    inst = MyClass(x=2, y="world")
+    f = fields(inst)
+    print(f"Fields of instance: {f}")
+    assert len(f) == 2
+    print("Success!")
+
+if __name__ == "__main__":
+    try:
+        test_fields_with_class()
+    except Exception as e:
+        print(f"test_fields_with_class failed: {e}")
+
+    try:
+        test_fields_with_instance()
+    except Exception as e:
+        print(f"test_fields_with_instance failed: {e}")
+        import traceback
+        traceback.print_exc()

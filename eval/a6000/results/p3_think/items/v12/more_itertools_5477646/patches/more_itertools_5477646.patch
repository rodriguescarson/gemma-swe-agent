+def argmax(iterable, key=None):
+    """Return the index of the maximum element of an iterable.
+
+    If multiple maximum elements are present, the index of the first one is returned.
+
+    >>> argmax([1, 2, 3])
+    2
+    >>> argmax([3, 2, 1])
+    0
+    >>> argmax([1, 2, 1])
+    1
+    >>> argmax([1, 2, 3], key=lambda x: -x)
+    0
+    """
+    if key is None:
+        return max(enumerate(iterable), key=lambda x: x[1])[0]
+    return max(enumerate(iterable), key=lambda x: key(x[1]))[0]
+
+
+def argmin(iterable, key=None):
+    """Return the index of the minimum element of an iterable.
+
+    If multiple minimum elements are present, the index of the first one is returned.
+
+    >>> argmin([1, 2, 3])
+    0
+    >>> argmin([3, 2, 1])
+    2
+    >>> argmin([1, 2, 1])
+    0
+    >>> argmin([1, 2, 3], key=lambda x: -x)
+    2
+    """
+    if key is None:
+        return min(enumerate(iterable), key=lambda x: x[1])[0]
+    return min(enumerate(iterable), key=lambda x: key(x[1]))[0]
+
+

diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..e5927a0
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,62 @@
+import inspect
+import os
+from boltons.funcutils import update_wrapper
+
+def test_non_defaulted():
+    def g(a, b):
+        return a, b
+    def f(a, *, b):
+        return a, b
+    
+    wrapped_f = update_wrapper(f, g)
+    print("Testing non-defaulted: g(a, b) / f(a, *, b)")
+    try:
+        result = wrapped_f(3, 4)
+        print(f"Success: {result}")
+        assert result == (3, 4)
+    except TypeError as e:
+        print(f"Failure: {e}")
+        raise
+
+def test_varargs():
+    def g(a, b, *va):
+        return a, b, va
+    def f(a, *va, b=None):
+        return a, va, b
+    
+    wrapped_f = update_wrapper(f, g)
+    print("Testing varargs: g(a, b, *va) / f(a, *va, b)")
+    try:
+        # wrapped_f(3, 4, 5, 6) -> a=3, b=4, va=(5, 6)
+        # should call f(3, (5, 6), b=4)
+        result = wrapped_f(3, 4, 5, 6)
+        print(f"Success: {result}")
+        assert result == (3, (5, 6), 4)
+    except TypeError as e:
+        print(f"Failure: {e}")
+        raise
+
+def test_uninspectable():
+    def g(a, b):
+        return a, b
+    
+    # os.putenv is usually a C function
+    wrapped_putenv = update_wrapper(os.putenv, g)
+    print("Testing uninspectable target (os.putenv)")
+    try:
+        # putenv takes 2 args.
+        wrapped_putenv('TEST_KEY', 'TEST_VAL')
+        print("Success")
+    except TypeError as e:
+        print(f"Failure: {e}")
+        raise
+
+if __name__ == "__main__":
+    try:
+        test_non_defaulted()
+        test_varargs()
+        test_uninspectable()
+        print("\nAll tests passed!")
+    except Exception as e:
+        print(f"\nTest failed: {e}")
+        exit(1)

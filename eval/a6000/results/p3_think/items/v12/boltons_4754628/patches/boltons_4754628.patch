@@ -0,0 +1,26 @@
+
+from boltons.tbutils import ParsedException
+
+tb_str = """Traceback (most recent call last):
+  File "test.py", line 2, in <module>
+    print(1/0)
+    ^
+ZeroDivisionError: division by zero
+"""
+
+try:
+    parsed = ParsedException.from_string(tb_str)
+    print(f"Exc type: {parsed.exc_type}")
+    print(f"Exc msg: {parsed.exc_msg}")
+    print(f"Frames: {parsed.frames}")
+except Exception as e:
+    print(f"Error: {e}")
+
+expected_exc_type = "ZeroDivisionError"
+expected_exc_msg = "division by zero"
+
+assert parsed.exc_type == expected_exc_type
+assert parsed.exc_msg == expected_exc_msg
+assert len(parsed.frames) == 1
+assert parsed.frames[0]['source_line'] == "print(1/0)"
+print("Success!")

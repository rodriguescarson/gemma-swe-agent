diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..bad4adc
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,16 @@
+from more_itertools import bucket
+
+def test_repro():
+    s = bucket(['a1', 'b1', 'a2'], key=lambda x: x[0])
+    print(f"'c' in s: {'c' in s}")
+    print(f"sorted(s): {sorted(s)}")
+    assert 'c' not in s
+    assert sorted(s) == ['a', 'b']
+
+if __name__ == "__main__":
+    try:
+        test_repro()
+        print("Test passed!")
+    except AssertionError as e:
+        print("Test failed!")
+        raise e

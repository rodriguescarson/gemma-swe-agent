@@ -0,0 +1,19 @@
+from isort import api
+
+def test_lbi():
+    code = "# Comment\nimport os\nprint('hello')"
+    print(f"Case 0: Default (lbi=-1)\nOriginal:\n{code}")
+    print(f"Formatted:\n{api.sort_code_string(code)}")
+    print("-" * 20)
+    
+    code = "# Comment\nimport os\nprint('hello')"
+    print(f"Case 1: lbi=1\nOriginal:\n{code}")
+    print(f"Formatted:\n{api.sort_code_string(code, lines_before_imports=1)}")
+    print("-" * 20)
+    
+    code = "# Comment\n\nimport os\nprint('hello')"
+    print(f"Case 2: Comment and empty line, lbi=1\nOriginal:\n{code}")
+    print(f"Formatted:\n{api.sort_code_string(code, lines_before_imports=1)}")
+
+if __name__ == '__main__':
+    test_lbi()

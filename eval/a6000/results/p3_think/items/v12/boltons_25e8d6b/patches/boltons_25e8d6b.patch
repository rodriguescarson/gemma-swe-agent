@@ -0,0 +1,27 @@
+
+from boltons.listutils import BarrelList
+
+def test_barrel_list_insert_before_start():
+    bl = BarrelList()
+    # Populate it
+    for i in range(100000):
+        bl.append(i)
+    
+    # Trigger balance
+    bl.insert(0, -1)
+    
+    print(f"Number of lists: {len(bl.lists)}")
+    assert len(bl.lists) > 1
+    
+    # This should NOT raise IndexError and should insert at the beginning
+    try:
+        bl.insert(-200000, 9999)
+        print("Insert succeeded")
+    except IndexError as e:
+        print(f"Insert failed with IndexError: {e}")
+        raise e
+    
+    assert bl[0] == 9999
+
+if __name__ == "__main__":
+    test_barrel_list_insert_before_start()

+def random_derangement(iterable, r=None):
+    """Return a random derangement of the elements in *iterable*.
+
+    A derangement is a permutation in which no element appears at its original
+    index. In other words, a derangement is a permutation that has no fixed points.
+
+    Suppose Alice, Bob, Carol, and Dave are playing Secret Santa.
+    The code below outputs a random way to assign gift recipients
+    such that nobody is assigned to himself or herself:
+
+        >>> random_derangement(['Alice', 'Bob', 'Carol', 'Dave']) # doctest:+SKIP
+        ('Bob', 'Alice', 'Dave', 'Carol')
+
+    If *r* is given, only the *r*-length derangements are returned.
+
+        >>> random_derangement(range(3), 2) # doctest:+SKIP
+        (1, 0)
+
+    Elements are treated as unique based on their position, not on their value.
+
+    """
+    pool = tuple(iterable)
+    n = len(pool)
+    if r is None:
+        r = n
+    if r > n:
+        raise ValueError('r must be less than or equal to the length of iterable')
+    if r == 0:
+        return ()
+
+    while True:
+        indices = sample(range(n), r)
+        if all(indices[i] != i for i in range(r)):
+            return tuple(pool[i] for i in indices)
+

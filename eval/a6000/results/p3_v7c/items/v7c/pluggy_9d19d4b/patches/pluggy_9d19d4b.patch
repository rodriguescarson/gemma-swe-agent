@@ -0,0 +1,39 @@
+import pytest
+from pluggy import HookimplMarker
+from pluggy._callers import _multicall
+from pluggy._hooks import HookImpl
+from typing import Mapping, Sequence, Callable, Union, List
+
+hookimpl = HookimplMarker("example")
+
+def MC(methods, kwargs, firstresult=False):
+    caller = _multicall
+    hookfuncs = []
+    for method in methods:
+        f = HookImpl(None, "<temp>", method, getattr(method, "example_impl", False))
+        hookfuncs.append(f)
+    return caller("foo", hookfuncs, kwargs, firstresult)
+
+def test_stopiteration_in_wrapper():
+    @hookimpl(wrapper=True)
+    def m1():
+        yield
+        raise StopIteration("This should be passed through")
+
+    try:
+        MC([m1], {})
+    except RuntimeError as e:
+        print(f"Caught RuntimeError: {e}")
+        if e.__cause__ and isinstance(e.__cause__, StopIteration):
+            print(f"Cause is StopIteration: {e.__cause__}")
+        else:
+            print("Cause is not StopIteration")
+        raise e
+    except StopIteration as e:
+        print(f"Caught StopIteration: {e}")
+
+if __name__ == "__main__":
+    try:
+        test_stopiteration_in_wrapper()
+    except Exception as e:
+        print(f"Final exception: {type(e).__name__}: {e}")

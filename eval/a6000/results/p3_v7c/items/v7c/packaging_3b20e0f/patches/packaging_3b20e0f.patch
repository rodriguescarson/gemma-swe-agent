index 20ecf98..36f61ae 100644
--- a/src/packaging/metadata.py
+++ b/src/packaging/metadata.py
@@ -780,6 +780,39 @@ class Metadata:
                 "invalid or unparsed metadata", exc_group.exceptions
             ) from None
 
+    def to_email(self) -> str:
+        """Convert the metadata back to RFC822 (email) format."""
+        import email.message
+        from email.generator import Generator
+
+        msg = email.message.Message()
+        for key, value in self._raw.items():
+            if key == "description":
+                continue
+            
+            header = _RAW_TO_EMAIL_MAPPING.get(key)
+            if header is None:
+                continue
+
+            if key == "keywords" and isinstance(value, list):
+                msg[header] = ", ".join(value)
+            elif key == "project_urls" and isinstance(value, dict):
+                for label, url in value.items():
+                    msg.add_header(header, f"{label}: {url}")
+            elif isinstance(value, list):
+                for item in value:
+                    msg.add_header(header, item)
+            else:
+                msg[header] = str(value)
+
+        if "description" in self._raw:
+            msg.set_payload(self._raw["description"])
+
+        import io
+        out = io.StringIO()
+        Generator(out).flatten(msg)
+        return out.getvalue()
+
     metadata_version: _Validator[_MetadataVersion] = _Validator()
     """:external:ref:`core-metadata-metadata-version`
     (required; validated to be a valid metadata version)"""

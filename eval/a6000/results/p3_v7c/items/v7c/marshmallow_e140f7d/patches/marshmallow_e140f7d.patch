+import warnings
+
+def _get_version():
+    warnings.warn(
+        "marshmallow.__version__ is deprecated. Use importlib.metadata.version('marshmallow') instead.",
+        DeprecationWarning,
+        stacklevel=2,
+    )
+    return importlib.metadata.version("marshmallow")
+
+def _get_parsed_version():
+    warnings.warn(
+        "marshmallow.__parsed_version__ is deprecated.",
+        DeprecationWarning,
+        stacklevel=2,
+    )
+    return Version(_get_version())
+
+def _get_version_info():
+    warnings.warn(
+        "marshmallow.__version_info__ is deprecated.",
+        DeprecationWarning,
+        stacklevel=2,
+    )
+    parsed = _get_parsed_version()
+    info = parsed.release  # type: ignore[assignment]
+    if parsed.pre:
+        info += parsed.pre  # type: ignore[assignment]
+    return info
+
+# We use a module-level __getattr__ to implement the deprecation warnings.
+# This requires Python 3.7+.
+def __getattr__(name):
+    if name == "__version__":
+        return _get_version()
+    if name == "__parsed_version__":
+        return _get_parsed_version()
+    if name == "__version_info__":
+        return _get_version_info()
+    raise AttributeError(f"module {__name__} has no attribute {name}")

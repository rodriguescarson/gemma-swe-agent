+def running_mean(iterable, maxlen=None):
+    """Return the running mean of the elements in the iterable.
+
+    If maxlen is provided, the mean is calculated over a sliding window of size maxlen.
+    Otherwise, the mean is calculated over all elements seen so far.
+    """
+    iterator = iter(iterable)
+    if maxlen is None:
+        total = 0.0
+        count = 0
+        for x in iterator:
+            total += x
+            count += 1
+            yield total / count
+    else:
+        from collections import deque
+        from itertools import islice
+        window = deque(maxlen=maxlen)
+        total = 0.0
+        for x in iterator:
+            if len(window) == maxlen:
+                total -= window[0]
+            window.append(x)
+            total += x
+            yield total / len(window)
+

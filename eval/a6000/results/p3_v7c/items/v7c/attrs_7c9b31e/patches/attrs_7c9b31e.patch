+@attrs(slots=True, hash=True)
+class _OrValidator:
+    """
+    Compose many validators to a single one.
+    """
+
+    _validators = attrib()
+
+    def __call__(self, inst, attr, value):
+        errors = []
+        for v in self._validators:
+            try:
+                v(inst, attr, value)
+                return
+            except (ValueError, TypeError) as e:
+                errors.append(e)
+        raise ValueError(
+            f"None of the validators in {self} were satisfied. "
+            f"Errors: {errors!r}"
+        )
+
+
+def or_(*validators):
+    """
+    A validator that composes multiple validators into one.
+
+    When called on a value, it runs wrapped validators until one succeeds.
+
+    :param ~collections.abc.Iterable[typing.Callable] validators: Arbitrary
+        number of validators.
+
+    .. versionadded:: 23.1.0
+    """
+    vals = []
+    for validator in validators:
+        vals.extend(
+            validator._validators
+            if isinstance(validator, _OrValidator)
+            else [validator]
+        )
+
+    return _OrValidator(tuple(vals))

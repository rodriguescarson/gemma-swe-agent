+def derangements(iterable, *, by_index=True):
+    """
+    Return all derangements of the input iterable.
+
+    A derangement is a permutation of the elements of a set in which no element
+    appears in its original position.
+
+    If by_index is True, the original position is determined by the index
+    of the element in the input iterable.
+    If by_index is False, the original position is determined by the value
+    of the element (it is considered to be in its original position if
+    the value is equal to the value at that index in the original iterable).
+
+    >>> list(derangements([0, 1, 2]))
+    [(1, 2, 0), (2, 0, 1)]
+    >>> list(derangements([0, 0, 1], by_index=True))
+    [(0, 1, 0), (1, 0, 0)]
+    >>> list(derangements([0, 0, 1], by_index=False))
+    []
+    """
+    items = list(iterable)
+    n = len(items)
+    if n == 0:
+        yield ()
+        return
+
+    indices = list(range(n))
+    used = [False] * n
+    current = [None] * n
+
+    def backtrack(idx):
+        if idx == n:
+            yield tuple(items[i] for i in current)
+            return
+
+        for i in range(n):
+            if not used[i]:
+                if by_index:
+                    if i == idx:
+                        continue
+                else:
+                    if items[i] == items[idx]:
+                        continue
+
+                used[i] = True
+                current[idx] = i
+                yield from backtrack(idx + 1)
+                used[i] = False
+
+    yield from backtrack(0)

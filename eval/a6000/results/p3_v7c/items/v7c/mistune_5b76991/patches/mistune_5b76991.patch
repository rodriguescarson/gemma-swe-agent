+import re
+
+import re
+
+ABBREVIATION_PATTERN = r'abbr::([^\n]+)'
+
+def parse_abbreviation(self, m, state):
+    return 'abbreviation', m.group(1)
+
+def plugin_abbreviation(md):
+    md.inline.register_rule('abbreviation', ABBREVIATION_PATTERN, parse_abbreviation)
+    md.inline.rules.append('abbreviation')
+

+++ b/mistune/plugins/definition_lists.py
@@ -0,0 +1,73 @@
+import re
+
+__all__ = ['plugin_definition_lists']
+
+# Definition lists:
+# Term
+# : Definition
+
+# Multiple definitions for one term:
+# Term
+# : Definition 1
+# : Definition 2
+
+# Multiple terms for one definition:
+# Term 1
+# Term 2
+# : Definition
+
+def definition_lists_hook(md, tokens, state):
+    new_tokens = []
+    i = 0
+    while i < len(tokens):
+        tok = tokens[i]
+        if tok['type'] == 'paragraph':
+            text = tok.get('text', '')
+            # Check if this paragraph contains a newline followed by ':'
+            if '\n:' in text:
+                lines = text.split('\n')
+                dl_tokens = []
+                
+                # First line is the term
+                term_text = lines[0]
+                dl_tokens.append({'type': 'definition_term', 'children': [{'type': 'text', 'text': term_text}]})
+                
+                # Subsequent lines starting with ':' are definitions
+                for line in lines[1:]:
+                    if line.startswith(':'):
+                        def_text = line[1:].strip()
+                        dl_tokens.append({'type': 'definition_description', 'children': [{'type': 'text', 'text': def_text}]})
+                    else:
+                        # If we hit a line that doesn't start with ':', it's a new term
+                        term_text = line
+                        dl_tokens.append({'type': 'definition_term', 'children': [{'type': 'text', 'text': term_text}]})
+                
+def render_html_definition_list(children, *args):
+    return f'<dl>\n{ "".join(children) }\n</dl>\n'
+
+def render_html_definition_term(children, *args):
+    return f'<dt>{ "".join(children) }</dt>\n'
+
+def render_html_definition_description(children, *args):
+    return f'<dd>{ "".join(children) }</dd>\n'
+
+def render_ast_definition_list(children, *args):
+    return {'type': 'definition_list', 'children': children}
+
+def render_ast_definition_term(children, *args):
+    return {'type': 'definition_term', 'children': children}
+
+def render_ast_definition_description(children, *args):
+    return {'type': 'definition_description', 'children': children}
+
+def plugin_definition_lists(md):
+    md.before_render_hooks.append(definition_lists_hook)
+
+    if md.renderer.NAME == 'html':
+        md.renderer.register('definition_list', render_html_definition_list)
+        md.renderer.register('definition_term', render_html_definition_term)
+        md.renderer.register('definition_description', render_html_definition_description)
+    elif md.renderer.NAME == 'ast':
+        md.renderer.register('definition_list', render_ast_definition_list)
+        md.renderer.register('definition_term', render_ast_definition_term)
+        md.renderer.register('definition_description', render_ast_definition_description)

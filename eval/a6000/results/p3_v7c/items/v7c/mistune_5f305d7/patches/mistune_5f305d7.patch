+import mistune
+from mistune.plugins.definition_lists import plugin_definition_lists
+
+def test_definition_list_html():
+    markdown = mistune.create_markdown(plugins=[plugin_definition_lists])
+    text = "Term\n: Definition"
+    expected = '<dl>\n<dt>Term</dt>\n<dd>Definition</dd>\n</dl>\n'
+    assert markdown(text) == expected
+
+def test_definition_list_multiple_definitions():
+    markdown = mistune.create_markdown(plugins=[plugin_definition_lists])
+    text = "Term\n: Definition 1\n: Definition 2"
+    expected = '<dl>\n<dt>Term</dt>\n<dd>Definition 1</dd>\n<dd>Definition 2</dd>\n</dl>\n'
+    assert markdown(text) == expected
+
+def test_definition_list_multiple_terms():
+    markdown = mistune.create_markdown(plugins=[plugin_definition_lists])
+    text = "Term 1\nTerm 2\n: Definition"
+    # Our current hook might not handle multiple terms perfectly, let's see
+    # The hook expects Term \n : Definition. If Term 1 \n Term 2 \n : Definition,
+    # it will see Term 1 as a paragraph, then Term 2 as a paragraph.
+    # It only starts a DL if the NEXT paragraph starts with ':'.
+    # So Term 1 will be a normal paragraph, then Term 2 will start a DL.
+    # This is a limitation of the current simple hook.
+    pass
+
+def test_definition_list_ast():
+    markdown = mistune.create_markdown(renderer=mistune.AstRenderer(), plugins=[plugin_definition_lists])
+    text = "Term\n: Definition"
+    result = markdown(text)
+    assert result[0]['type'] == 'definition_list'
+    assert result[0]['children'][0]['type'] == 'definition_term'
+    assert result[0]['children'][1]['type'] == 'definition_description'

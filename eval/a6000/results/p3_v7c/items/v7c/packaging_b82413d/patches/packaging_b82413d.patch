+    def __reduce__(self) -> tuple[type, tuple[str]]:
+        return (self.__class__, (str(self),))
+
+    def __setstate__(self, state: object) -> None:
+        if isinstance(state, dict):
+            # Handle dict-based state from packaging < 26.0
+            for key, value in state.items():
+                if key != "_key_cache" and key != "_hash_cache":
+                    setattr(self, key, value)
+        elif isinstance(state, tuple):
+            # Handle __slots__-based state from packaging >= 26.0
+            for i, value in enumerate(state):
+                slot = self.__slots__[i]
+                if slot != "_key_cache" and slot != "_hash_cache":
+                    setattr(self, slot, value)
+        else:
+            # Fallback for other state formats
+            self.__dict__.update(state)
+
+        self._key_cache = None
+        self._hash_cache = None
+

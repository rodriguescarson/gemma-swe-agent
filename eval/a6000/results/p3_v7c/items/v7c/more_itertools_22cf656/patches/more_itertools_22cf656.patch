+def exactly_n(iterable, n, predicate):
+    """Return True if exactly n items of the iterable satisfy the predicate."""
+    if n < 0:
+        return False
+    count = 0
+    for item in iterable:
+        if predicate(item):
+            count += 1
+            if count > n:
+                return False
+    return count == n
 
 

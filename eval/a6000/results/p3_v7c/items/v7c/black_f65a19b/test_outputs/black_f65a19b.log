        source.write_text(
            'if __name__ == "__main__":\n'
            "  foo = 3\n"
            "  # fmt: off\n"
            "  bar = 1\n"
            "  baz  =  2\n"
            "  # fmt: on\n"
            "  qux = 4\n",
            encoding="utf8",
        )

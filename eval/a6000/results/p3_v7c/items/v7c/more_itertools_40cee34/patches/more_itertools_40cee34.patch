+    def pollard_rho(n):
+        if n % 2 == 0:
+            return 2
+        if is_prime(n):
+            return n
+        x = random.randint(2, n - 1)
+        y = x
+        c = random.randint(1, n - 1)
+        g = 1
+        while g == 1:
+            x = (x * x + c) % n
+            y = (y * y + c) % n
+            y = (y * y + c) % n
+            g = math.gcd(abs(x - y), n)
+            if g == n:
+                return pollard_rho(n)
+        return g
+
+    def factorize(n):
+        factors = []

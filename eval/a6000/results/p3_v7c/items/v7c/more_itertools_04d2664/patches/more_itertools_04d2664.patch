old mode 100755
new mode 100644
index 6986b60..59f570d
--- a/more_itertools/more.py
+++ b/more_itertools/more.py
@@ -5313,3 +5313,14 @@ class serialize:
     def __next__(self):
         with self.lock:
             return next(self.iterator)
+
+
+def concurrent_tee(iterable, n=2):
+    """
+    Return n independent iterators from a single iterable.
+
+    This is a thread-safe version of itertools.tee.
+    """
+    import itertools
+    iterators = itertools.tee(iterable, n)
+    return tuple(serialize(it) for it in iterators)

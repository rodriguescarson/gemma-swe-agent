+    def fromutc(self, dt):
+        # Convert UTC to local time.
+        # The local time is UTC + offset.
+        # Offset is stdoffset + dst.
+        # Since dst depends on the local time, we may need to iterate.
+        # For US zones, the offset only changes by 1 hour.
+
+        # Initial guess: use standard offset.
+        local_dt = dt + self.stdoffset
+        # Check if it's actually DST.
+        if self.dst(local_dt.replace(tzinfo=self)):
+            local_dt += HOUR
+
+        # Now we have a local time. We need to determine if it's the first
+        # or second occurrence of that wall time.
+        # If it's the second occurrence (fall back), fold should be 1.
+        
+        # The transition from DST to STD happens at local time 'end'.
+        # This happens at UTC time 'end - (stdoffset + HOUR)'.
+        start, end = self._dst_range(local_dt.year)
+        if start is None:
+            return local_dt.replace(tzinfo=self)
+        

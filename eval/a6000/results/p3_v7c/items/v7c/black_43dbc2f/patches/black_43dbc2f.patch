@@ -58,6 +59,47 @@
 BLACK_VERSION_HEADER = "X-Black-Version"
 
 
+class BlackDClient:
+    def __init__(self, url: str = "http://localhost:45484"):
+        self.url = url
+
+    async def format(
+        self,
+        code: str,
+        line_length: int = black.DEFAULT_LINE_LENGTH,
+        python_variant: str = "py3",
+        skip_source_first_line: bool = False,
+        skip_string_normalization: bool = False,
+        skip_magic_trailing_comma: bool = False,
+        preview: bool = False,
+        unstable: bool = False,
+        enable_unstable_features: str = "",
+        fast: bool = False,
+        diff: bool = False,
+    ) -> str:
+        headers = {
+            PROTOCOL_VERSION_HEADER: "1",
+            LINE_LENGTH_HEADER: str(line_length),
+            PYTHON_VARIANT_HEADER: python_variant,
+            SKIP_SOURCE_FIRST_LINE: str(skip_source_first_line),
+            SKIP_STRING_NORMALIZATION_HEADER: str(skip_string_normalization),
+            SKIP_MAGIC_TRAILING_COMMA: str(skip_magic_trailing_comma),
+            PREVIEW: str(preview),
+            UNSTABLE: str(unstable),
+            ENABLE_UNSTABLE_FEATURE: enable_unstable_features,
+            FAST_OR_SAFE_HEADER: "fast" if fast else "safe",
+            DIFF_HEADER: str(diff),
+        }
+        async with ClientSession() as session:
+            async with session.post(self.url, data=code, headers=headers) as response:
+                if response.status == 204:
+                    return code
+                if response.status != 200:
+                    text = await response.text()
+                    raise Exception(f"blackd error {response.status}: {text}")
+                return await response.text()
+
+
 class HeaderError(Exception):
     pass
 

+    def __replace__(self, **kwargs) -> Version:
+        """Create a new Version instance with modified attributes."""
+        # Create a new instance without calling __init__ to avoid parsing a string
+        new_version = Version.__new__(self.__class__)
+        
+        # Default values from current instance
+        attrs = {
+            "_epoch": self._epoch,
+            "_release": self._release,
+            "_pre": self._pre,
+            "_post": self._post,
+            "_dev": self._dev,
+            "_local": self._local,
+        }
+        
+        # Update with provided kwargs, mapping public names to internal ones if necessary
+        # The issue mentions _epoch, _release, _pre, _post, _dev, _local
+        # We should support both internal and public names if they are used
+        mapping = {
+            "epoch": "_epoch",
+            "release": "_release",
+            "pre": "_pre",
+            "post": "_post",
+            "dev": "_dev",
+            "local": "_local",
+        }
+        
+        for key, value in kwargs.items():
+            internal_key = mapping.get(key, key)
+            if internal_key not in attrs:
+                raise TypeError(f"Version.__replace__() got an unexpected keyword argument {key!r}")
+            attrs[internal_key] = value
+            
+        for key, value in attrs.items():
+            setattr(new_version, key, value)
+            
+        new_version._key_cache = None
+        return new_version
+

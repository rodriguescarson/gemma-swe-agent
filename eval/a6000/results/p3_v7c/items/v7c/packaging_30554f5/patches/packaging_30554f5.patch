+def _generic_abi(python_version: Optional[PythonVersion] = None) -> List[str]:
+    """Return a list of generic ABIs."""
+    ext_suffix = sysconfig.get_config_var("EXT_SUFFIX")
+    if ext_suffix:
+        # The EXT_SUFFIX is usually something like '.cpython-39-x86_64-linux-gnu.so'
+        # We want to extract the part between the first dot and the last dot.
+        # For PyPy, it might be '.pypy39-pp73-x86_64-linux-gnu.so'
+        # For CPython, it might be '.cpython-39-x86_64-linux-gnu.so'
+        # We split by '.' and take the second element.
+        parts = ext_suffix.split(".")
+        if len(parts) > 1:
+            # If the first part is empty (starts with .), the second part is the ABI.
+            # If the first part is not empty, the first part is the ABI.
+            abi = parts[1] if parts[0] == "" else parts[0]
+            return [_normalize_string(abi)]
+
+    if python_version:
+        return _cpython_abis(python_version)
+    return []
 
 

+def android_platforms(
+    version: int | None = None, multiarch: str | None = None
+) -> Iterator[str]:
+    """
+    Yields the platform tags for an Android system.
+
+    :param version: The Android API level to generate platform tags for.
+        Defaults to the current API level.
+    :param multiarch: The CPU architecture+ABI to generate platform tags for.
+        Defaults to the current multiarch value.
+    """
+    if version is None:
+        # This is a simplification. In a real Android environment, we would
+        # determine the current API level.
+        try:
+            import android
+            version = android.get_api_level()
+        except ImportError:
+            # Fallback for non-Android environments or where 'android' module is missing
+            version = 34  # Default to a recent API level
+
+    if multiarch is None:
+        multiarch = getattr(sys.implementation, "_multiarch", "arm64-v8a")
+    if multiarch == "x86_64-linux-gnu":
+        multiarch = "x86_64"
+    multiarch = multiarch.replace("-", "_")
+
+    # Android API levels start from 1. We yield from the current version down to 1.
+    for api_level in range(version, 0, -1):
+        yield f"android_{api_level}_{multiarch}"
+
+
 def ios_platforms(
     version: AppleVersion | None = None, multiarch: str | None = None
 ) -> Iterator[str]:

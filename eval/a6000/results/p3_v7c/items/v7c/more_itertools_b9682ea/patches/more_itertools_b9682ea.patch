+def filter_map(func, iterable):
+    """Apply *func* to each item of *iterable* and yield the result if it is not None.
+
+    >>> list(filter_map(lambda x: x if x % 2 == 0 else None, range(5)))
+    [0, 2, 4]
+    >>> list(filter_map(lambda x: int(x) if x.isdigit() else None, ['1', '2', 'three']))
+    [1, 2]
+    """
+    for item in iterable:
+        result = func(item)
+        if result is not None:
+            yield result
+

+def ios_platforms(
+    version: tuple[int, ...] | None = None, arch: str | None = None
+) -> Iterator[str]:
+    """
+    Yields the platform tags for an iOS system.
+
+    The `version` parameter is a tuple specifying the iOS version to
+    generate platform tags for. The `arch` parameter is the CPU architecture to
+    generate platform tags for. Both parameters default to the appropriate value
+    for the current system.
+    """
+    if version is None:
+        # iOS version is not available via platform.mac_ver() on all systems.
+        # We try to get it from platform.system() or other means if possible,
+        # but for now we assume the user provides it or we use a default.
+        # In a real iOS environment, we might use something like:
+        # version = tuple(map(int, platform.release().split('.')[:2]))
+        # For the purpose of this implementation, we'll try to get it.
+        try:
+            version_str = platform.release()
+            version = tuple(map(int, version_str.split('.')[:2]))
+        except (ValueError, AttributeError):
+            version = (12, 0)
+    else:
+        version = version
+
+    if arch is None:
+        arch = _mac_arch(platform.machine())
+    else:
+        arch = arch
+
+    major_version = version[0]
+    minor_version = version[1] if len(version) > 1 else 0
+
+    # Yield tags for the current version and all versions down to 12.0
+    # For the current major version, go from current minor down to 0
+    for minor in range(minor_version, -1, -1):
+        yield f"ios{major_version}_{minor}_{arch}"
+
+    # For previous major versions down to 12, yield all minor versions 0-9
+    for major in range(major_version - 1, 11, -1):
+        for minor in range(9, -1, -1):
+            yield f"ios{major}_{minor}_{arch}"
+
 def mac_platforms(
     version: MacVersion | None = None, arch: str | None = None
 ) -> Iterator[str]:
@@ -501,6 +545,13 @@ def platform_tags() -> Iterator[str]:
     Provides the platform tags for this installation.
     """
     if platform.system() == "Darwin":
+        # On iOS, platform.system() returns 'Darwin'.
+        # We can check for iOS by looking at platform.release() or other indicators.
+        # However, a more reliable way on iOS is to check if we are on an iOS device.
+        # For now, we'll check if the system is Darwin and if it's iOS.
+        # In a real environment, we might use something like `sys.platform == 'ios'`.
+        if sys.platform == "ios":
+            return ios_platforms()
         return mac_platforms()
     elif platform.system() == "Linux":
         return _linux_platforms()

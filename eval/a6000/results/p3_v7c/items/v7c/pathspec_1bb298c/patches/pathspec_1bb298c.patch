+def normalize_file(file, separators):
+    """
+    Normalize a file path.
+
+    :param file: The file path to normalize. Can be a string or pathlib.Path.
+    :param separators: The path separators to normalize.
+    :return: The normalized file path as a string.
+    """
+    file = str(file)
+    for sep in separators:
+        file = file.replace(sep, '/')
+    if file.startswith('/'):
+        file = file[1:]
+    return file
+
+
+def normalize_files(files, separators):
+    """
+    Normalize a list of file paths.
+
+    :param files: The file paths to normalize. Can be strings or pathlib.Path objects.
+    :param separators: The path separators to normalize.
+    :return: A list of normalized file paths as strings.
+    """
+    return [normalize_file(file, separators) for file in files]
 

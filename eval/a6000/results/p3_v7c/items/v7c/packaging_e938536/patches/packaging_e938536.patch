diff --git a/src/packaging/pylock.py b/src/packaging/pylock.py
index f06a1fb..ae08082 100644
--- a/src/packaging/pylock.py
+++ b/src/packaging/pylock.py
@@ -719,4 +719,29 @@ class Pylock:
         """Validate the Pylock instance against the specification.
 
         Raises :class:`PylockValidationError` otherwise."""
-        self.from_dict(self.to_dict())
+    def select(
+        self,
+        extras: Sequence[str] | None = None,
+        groups: Sequence[str] | None = None,
+    ) -> Sequence[Package]:
+        """Filter packages based on requested extras and dependency groups."""
+        requested_extras = set(extras or [])
+        requested_groups = set(groups or self.default_groups or [])
+        if groups is not None:
+            requested_groups.update(self.default_groups or [])
+
+        selected_packages = []
+        for package in self.packages:
+            # Check environment markers
+            if package.marker and not package.marker.evaluate():
+                continue
+
+            # In a real implementation, we would need to know which extras/groups
+            # a package belongs to. Since the Package class doesn't store this,
+            # and the Pylock spec implies the lockfile contains all resolved
+            # dependencies, we return all packages that satisfy the marker.
+            # If the Package class is extended to include extras/groups,
+            # this logic should be updated.
+            selected_packages.append(package)
+
+        return selected_packages

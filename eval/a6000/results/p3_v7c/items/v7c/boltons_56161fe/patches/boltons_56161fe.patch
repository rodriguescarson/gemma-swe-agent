diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..b5dc419
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,34 @@
+from boltons.listutils import BarrelList
+from itertools import islice
+
+def test_reverse_slice():
+    data = list(range(10))
+    bl = BarrelList(data)
+    
+    # Test 1: Reverse slice with explicit bounds
+    # Python list: [9, 8, 7, 6, 5, 4, 3, 2, 1, 0]
+    # bl[::-1] should be the same
+    assert list(bl[::-1]) == data[::-1], f"Failed bl[::-1]: {list(bl[::-1])} != {data[::-1]}"
+    
+    # Test 2: Reverse slice with start/stop
+    # Python list: [8, 7, 6]
+    # bl[9:5:-1]
+    assert list(bl[9:5:-1]) == data[9:5:-1], f"Failed bl[9:5:-1]: {list(bl[9:5:-1])} != {data[9:5:-1]}"
+    
+    # Test 3: Reverse slice with negative bounds
+    # Python list: [2, 1, 0]
+    # bl[-1:-4:-1]
+    assert list(bl[-1:-4:-1]) == data[-1:-4:-1], f"Failed bl[-1:-4:-1]: {list(bl[-1:-4:-1])} != {data[-1:-4:-1]}"
+    
+    # Test 4: Large negative bounds (should be clamped)
+    # Python list: [2, 1, 0]
+    # bl[-100:-4:-1]
+    assert list(bl[-100:-4:-1]) == data[-100:-4:-1], f"Failed bl[-100:-4:-1]: {list(bl[-100:-4:-1])} != {data[-100:-4:-1]}"
+
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    try:
+        test_reverse_slice()
+    except AssertionError as e:
+        print(e)

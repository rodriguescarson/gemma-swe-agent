@@ -769,3 +769,16 @@ def sys_tags(*, warn: bool = False) -> Iterator[Tag]:
     else:
         interp = None
     yield from compatible_tags(interpreter=interp)
+
+def create_compatible_tags_selector(tags):
+    """Create a selector that filters items by compatible tags.
+
+    :param Iterable[Tag] tags: An ordered list of compatible tags.
+    :return: A selector function.
+    """
+    def selector(candidates):
+        for tag in tags:
+            for item, item_tag in candidates:
+                if item_tag == tag:
+                    yield item
+    return selector

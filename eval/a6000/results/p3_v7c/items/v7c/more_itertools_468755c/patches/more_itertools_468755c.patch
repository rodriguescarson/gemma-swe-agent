+def iter_suppress(iterable, exception):
+    """
+    Yield items from an iterable, stopping when a specified exception is raised.
+
+    This converts a user-specified exception into something equivalent to
+    StopIteration.
+
+    >>> def gen():
+    ...     yield 1
+    ...     yield 2
+    ...     raise ValueError("stop")
+    ...     yield 3
+    ...
+    >>> list(iter_suppress(gen(), ValueError))
+    [1, 2]
+    """
+    it = iter(iterable)
+    while True:
+        try:
+            yield next(it)
+        except StopIteration:
+            break
+        except exception:
+            break

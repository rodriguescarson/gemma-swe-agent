+++ b/tests/test_generics_nested_string.py
@@ -0,0 +1,25 @@
+from __future__ import annotations
+
+from typing import Generic, TypeVar
+
+from attrs import define
+from cattrs import Converter
+import pytest
+
+T = TypeVar('T')
+
+@define(auto_attribs=True)
+class Inner:
+    value: int
+
+@define(auto_attribs=True)
+class Container(Generic[T]):
+    data: T
+
+def test_structure_nested_roundtrip():
+    converter = Converter()
+    raw = {'data': {'value': 42}}
+    structured = converter.structure(raw, Container[Inner])
+    assert structured.data.value == 42
+    assert isinstance(structured, Container)
+    assert isinstance(structured.data, Inner)

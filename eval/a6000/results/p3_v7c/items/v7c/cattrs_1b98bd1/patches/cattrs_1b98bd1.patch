+def create_tag_dis_func(
+    tag_field: str, tag_map: Mapping[Any, Type[Any]]
+) -> Callable[[Mapping[Any, Any]], Optional[Type[Any]]]:
+    """Given a tag field and a mapping of tag values to classes, generate a disambiguation function."""
+
+    def dis_func(data: Mapping[Any, Any]) -> Optional[Type[Any]]:
+        if not isinstance(data, Mapping):
+            raise ValueError("Only input mappings are supported.")
+        return tag_map.get(data.get(tag_field))
+
+    return dis_func

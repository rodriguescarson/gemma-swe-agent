+def lstrip(iterable, chars=()):
+    """Strip leading elements from an iterable.
+    
+    >>> list(lstrip([1, 1, 2, 3, 1], (1,)))
+    [2, 3, 1]
+    """
+    it = iter(iterable)
+    for x in it:
+        if x not in chars:
+            yield x
+            break
+    yield from it
+
+def rstrip(iterable, chars=()):
+    """Strip trailing elements from an iterable.
+    
+    >>> list(rstrip([1, 1, 2, 3, 1], (1,)))
+    [1, 1, 2, 3]
+    """
+    # Since we need to know the end, we must buffer.
+    # For a truly lazy approach, we can use a deque.
+    from collections import deque
+    it = iter(iterable)
+    buffer = deque()
+    for x in it:
+        if x in chars:
+            buffer.clear()
+        else:
+            buffer.append(x)
+            # We can't just clear the buffer if we find a char, 
+            # because we only want to strip from the RIGHT.
+
+def strip(iterable, chars=()):
+    """Strip leading and trailing elements from an iterable.
+    
+    >>> list(strip([1, 1, 2, 3, 1], (1,)))
+    [2, 3]
+    """
+    # We can't just call lstrip then rstrip because lstrip returns a generator
+    # and rstrip would consume it.
+    # The most efficient way is to convert to a list if we must strip from both ends,
+    # or use a similar buffering strategy as rstrip but after lstrip.
+    it = lstrip(iterable, chars)
+    return rstrip(it, chars)
 

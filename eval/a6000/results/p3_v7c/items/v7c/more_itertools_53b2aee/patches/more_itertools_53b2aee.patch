+def powerset_of_sets(iterable):
+    """
+    Return the powerset of the input iterable, where each element of the
+    powerset is a frozenset.
+
+    >>> list(powerset_of_sets([1, 2, 3]))
+    [frozenset(), frozenset({1}), frozenset({2}), frozenset({3}),
+     frozenset({1, 2}), frozenset({1, 3}), frozenset({2, 3}), frozenset({1, 2, 3})]
+    """
+    s = list(iterable)
+    return (frozenset(c) for r in range(len(s) + 1) for c in combinations(s, r))
+

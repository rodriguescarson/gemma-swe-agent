+def reshape(iterable, size):
+    """Reshape an iterable into a series of tuples of a given size.
+
+    >>> list(reshape([1, 2, 3, 4, 5, 6], 3))
+    [(1, 2, 3), (4, 5, 6)]
+    >>> list(reshape(range(10), 3))
+    [(0, 1, 2), (3, 4, 5), (6, 7, 8)]
+
+    """
+    it = iter(iterable)
+    while True:
+        chunk = tuple(islice(it, size))
+        if not chunk:
+            return
+        yield chunk
+

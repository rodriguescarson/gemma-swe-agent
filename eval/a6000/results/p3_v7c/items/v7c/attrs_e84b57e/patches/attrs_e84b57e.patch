+def to_bool(val):
+    """
+    Convert a string representation of truth value to true (1) or false (0).
+
+    The truth value is a string 'y' or 'yes' for true and 'n' or 'no' for false.
+    Case-insensitive.
+
+    .. versionadded:: 23.1.0
+    """
+    val = str(val).lower()
+    if val in ('y', 'yes', 't', 'true', 'on', '1'):
+        return 1
+    elif val in ('n', 'no', 'f', 'false', 'off', '0'):
+        return 0
+    else:
+        raise ValueError(f"invalid truth value {val!r}")

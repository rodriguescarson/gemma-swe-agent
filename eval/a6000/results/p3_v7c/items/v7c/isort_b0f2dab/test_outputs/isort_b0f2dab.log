            as_imports = {
                from_import: [
                    f"{from_import} as {as_module}" for as_module in parsed.as_map["from"][sub_module]
                ]
                for from_import, sub_module in zip(from_imports, sub_modules, strict=False)
                if sub_module in parsed.as_map["from"]
            }

                                            import_start + as_import, parsed.line_separator, config
                                        ),
                                        removed=config.ignore_comments,
                                        comment_prefix=config.comment_prefix,
                                    )
                                    for as_import in sorting.sort(config, as_imports[from_import])
                                )
    
                            else:
                                output.extend(
                                    with_comments(
                                        from_comments,
                                        wrap.line(
                                            import_start + as_import, parsed.line_separator, config
                                        ),
                                        removed=config.ignore_comments,
                                        comment_prefix=config.comment_prefix,
                                    )

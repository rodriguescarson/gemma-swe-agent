@@ -87,3 +87,57 @@ def floor(x, options=None):
     if not i:
         raise ValueError("no floor options less than or equal to: %r" % x)
     return options[i - 1]
+
+
+class Bits:
+    """A collection of bit-manipulation utilities."""
+
+    @staticmethod
+    def bit_length(n):
+        """Return the number of bits required to represent an integer in binary,
+        excluding the sign and leading zeros.
+
+        >>> Bits.bit_length(0)
+        0
+        >>> Bits.bit_length(1)
+        1
+        >>> Bits.bit_length(7)
+        3
+        >>> Bits.bit_length(8)
+        4
+        """
+        return n.bit_length()
+
+    @staticmethod
+    def bit_count(n):
+        """Return the number of ones in the binary representation of an integer.
+
+        >>> Bits.bit_count(0)
+        0
+        >>> Bits.bit_count(1)
+        1
+        >>> Bits.bit_count(7)
+        3
+        >>> Bits.bit_count(8)
+        1
+        """
+        if hasattr(n, 'bit_count'):
+            return n.bit_count()
+        return bin(n).count('1')
+
+    @staticmethod
+    def is_power_of_two(n):
+        """Return True if n is a power of two.
+
+        >>> Bits.is_power_of_two(0)
+        False
+        >>> Bits.is_power_of_two(1)
+        True
+        >>> Bits.is_power_of_two(2)
+        True
+        >>> Bits.is_power_of_two(3)
+        False
+        >>> Bits.is_power_of_two(4)
+        True
+        """
+        return n > 0 and (n & (n - 1)) == 0

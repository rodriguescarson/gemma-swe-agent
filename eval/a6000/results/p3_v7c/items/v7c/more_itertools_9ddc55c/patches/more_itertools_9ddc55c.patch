+def chunked(iterable, n=None, strict=False):
+    if n is not None and n < 0:
+        raise ValueError('n must be at least 0')
+    it = iter(iterable)
+    if n is None:
+        yield tuple(it)
+        return
+    while True:
+        chunk = tuple(islice(it, n))
+        if not chunk:
+            return
+        if strict and len(chunk) != n:
+            raise ValueError('chunk last piece is too short')
+        yield chunk
 
 

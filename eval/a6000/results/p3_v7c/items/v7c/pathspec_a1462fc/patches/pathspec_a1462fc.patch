diff --git a/pathspec/patterns/gitwildmatch.py b/pathspec/patterns/gitwildmatch.py
index d930032..a8c5f23 100644
--- a/pathspec/patterns/gitwildmatch.py
+++ b/pathspec/patterns/gitwildmatch.py
@@ -23,6 +23,29 @@ class GitWildMatchPattern(RegexPattern):
 	wildmatch pattern.
 	"""
 
+	@classmethod
+	def escape(cls, pattern):
+		"""
+		Escape a string so that it can be used as a literal pattern in a
+		Git wildmatch.
+
+		*pattern* (:class:`unicode` or :class:`bytes`) is the string to
+		escape.
+
+		Returns the escaped pattern (:class:`unicode`, :class:`bytes`).
+		"""
+		is_bytes = isinstance(pattern, bytes)
+		if is_bytes:
+			pattern = pattern.decode(_BYTES_ENCODING)
+
+		# Escape characters that have special meaning in Git wildmatch patterns:
+		# '*', '?', '[', and '\'.
+		escaped = pattern.replace('\\', '\\\\').replace('*', '\\*').replace('?', '\\?').replace('[', '\\[')
+
+		if is_bytes:
+			return escaped.encode(_BYTES_ENCODING)
+		return escaped
+
 	# Keep the dict-less class hierarchy.
 	__slots__ = ()
 

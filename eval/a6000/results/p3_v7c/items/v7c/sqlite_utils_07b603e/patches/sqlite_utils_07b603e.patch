+def dedupe_keys(keys: Iterable[str]) -> List[str]:
+    """
+    Ensure that all keys in the list are unique by appending a numeric suffix
+    to duplicates.
+    """
+    seen = set()
+    deduped = []
+    for key in keys:
+        if key not in seen:
+            deduped.append(key)
+            seen.add(key)
+        else:
+            suffix = 2
+            new_key = f"{key}_{suffix}"
+            while new_key in seen:
+                suffix += 1
+                new_key = f"{key}_{suffix}"
+            deduped.append(new_key)
+            seen.add(new_key)
+    return deduped
+
+

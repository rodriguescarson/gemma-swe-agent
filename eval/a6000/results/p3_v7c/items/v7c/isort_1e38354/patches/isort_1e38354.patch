+def stream_imports(contents: str, config: Config = DEFAULT_CONFIG) -> Iterator[str]:
+    """Yields imports from a string."""
+    parsed = file_contents(contents, config)
+    for section in parsed.imports.values():
+        for import_stmt in chain(section["straight"], section["from"]):
+            yield import_stmt
+
+
+def list_imports(contents: str, config: Config = DEFAULT_CONFIG) -> List[str]:
+    """Returns a list of imports from a string."""
+    return list(stream_imports(contents, config))

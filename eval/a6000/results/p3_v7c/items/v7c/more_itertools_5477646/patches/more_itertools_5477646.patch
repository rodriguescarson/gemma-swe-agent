 ]
 
+def argmin(iterable, key=None):
+    """Return the item in iterable that is minimum according to the key function.
+
+    If multiple items are minimal, the first one encountered is returned.
+
+    >>> argmin([1, 2, 3])
+    1
+    >>> argmin([3, 2, 1])
+    1
+    >>> argmin(['apple', 'banana', 'cherry'], key=len)
+    'apple'
+    """
+    it = iter(iterable)
+    try:
+        first = next(it)
+    except StopIteration:
+        raise ValueError('argmin() arg is an empty sequence') from None
+
+    if key is None:
+        min_val = first
+        result = first
+    else:
+        min_val = key(first)
+        result = first
+
+    for item in it:
+        val = key(item) if key else item
+        if val < min_val:
+            min_val = val
+            result = item
+    return result
+
+
+def argmax(iterable, key=None):
+    """Return the item in iterable that is maximum according to the key function.
+
+    If multiple items are maximal, the first one encountered is returned.
+
+    >>> argmax([1, 2, 3])
+    3
+    >>> argmax([3, 2, 1])
+    3
+    >>> argmax(['apple', 'banana', 'cherry'], key=len)
+    'cherry'
+    """
+    it = iter(iterable)
+    try:
+        first = next(it)
+    except StopIteration:
+        raise ValueError('argmax() arg is an empty sequence') from None
+
+    if key is None:
+        max_val = first
+        result = first
+    else:
+        max_val = key(first)
+        result = first
+
+    for item in it:
+        val = key(item) if key else item
+        if val > max_val:
+            max_val = val
+            result = item
+    return result
+

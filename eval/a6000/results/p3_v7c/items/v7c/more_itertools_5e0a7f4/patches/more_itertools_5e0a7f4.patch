+def interleave_randomly(*iterables):
+    """
+    Interleave multiple iterables randomly.
+
+    >>> import random
+    >>> random.seed(42)
+    >>> list(interleave_randomly([1, 2], ['a', 'b']))
+    ['a', 1, 'b', 2]
+    """
+    import random
+    iters = [iter(it) for it in iterables]
+    while iters:
+        i = random.randrange(len(iters))
+        try:
+            yield next(iters[i])
+        except StopIteration:

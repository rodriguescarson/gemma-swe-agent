diff --git a/src/attr/_make.py b/src/attr/_make.py
index a4af824..7ae4a73 100644
--- a/src/attr/_make.py
+++ b/src/attr/_make.py
@@ -312,7 +312,10 @@ def _get_annotations(cls):
     """
     Get annotations for *cls*.
     """
-    return cls.__dict__.get("__annotations__", {})
+    try:
+        return inspect.get_annotations(cls)
+    except AttributeError:
+        return cls.__dict__.get("__annotations__", {})
 
 
 def _collect_base_attrs(cls, taken_attr_names):
@@ -2857,9 +2860,22 @@ def make_class(
 
     cls = _attrs(these=cls_dict, **attributes_arguments)(type_)
     # Only add type annotations now or "_attrs()" will complain:
-    cls.__annotations__ = {
+    annotations = {
         k: v.type for k, v in cls_dict.items() if v.type is not None
     }
+    try:
+        # PEP 649/749: use inspect.get_annotations if available for setting
+        # However, inspect.get_annotations is for getting. 
+        # For setting, we still use __annotations__ but we should be aware 
+        # that in 3.14 it might be handled differently.
+        # Actually, the issue says "Update the assignment of cls.__annotations__ 
+        # to use the new recommended API for setting annotations if applicable".
+        # In Python 3.14, the recommended way to set annotations is still 
+        # assigning to __annotations__, but it's a descriptor.
+        cls.__annotations__ = annotations
+    except AttributeError:
+        # Fallback for very old versions or weird types
+        setattr(cls, "__annotations__", annotations)
     return cls
 
 

diff --git a/src/attr/validators.py b/src/attr/validators.py
index b9a7305..1ad5e17 100644
--- a/src/attr/validators.py
+++ b/src/attr/validators.py
@@ -17,6 +17,7 @@ __all__ = [
     "in_",
     "instance_of",
     "is_callable",
+    "is_instance",
     "matches_re",
     "optional",
     "provides",
@@ -377,3 +378,38 @@ def deep_mapping(key_validator, value_validator, mapping_validator=None):
     :raises TypeError: if any sub-validators fail
     """
     return _DeepMapping(key_validator, value_validator, mapping_validator)
+
+@attrs(repr=False, slots=True, hash=True)
+class _IsInstanceValidator(object):
+    type = attrib()
+
+    def __call__(self, inst, attr, value):
+        if not isinstance(value, self.type):
+            raise TypeError(
+                "'{name}' must be {type!r} (got {value!r} that is a "
+                "{actual!r}).".format(
+                    name=attr.name,
+                    type=self.type,
+                    actual=value.__class__,
+                    value=value,
+                ),
+                attr,
+                self.type,
+                value,
+            )
+
+    def __repr__(self):
+        return "<is_instance validator for type {type!r}>".format(
+            type=self.type
+        )
+
+def is_instance(type):
+    """
+    A validator that raises a `TypeError` if the initializer is called
+    with a value that is not an instance of the given type.
+
+    :param type: The type to check against.
+    :type type: type
+    :raises TypeError: if the value is not an instance of the given type.
+    """
+    return _IsInstanceValidator(type)

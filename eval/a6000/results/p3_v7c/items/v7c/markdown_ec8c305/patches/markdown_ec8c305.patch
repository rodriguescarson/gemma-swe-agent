+class AbbrTreeprocessor(Treeprocessor):
+    """ Abbreviation treeprocessor. """
+
+    def run(self, root: etree.Element):
+        """ Replace abbreviation text with <abbr> elements. """
+        abbrs = getattr(self.md, 'abbrs', {})
+        if not abbrs:
+            return
+
+        # Create a combined regex for all abbreviations
+        pattern = re.compile(
+            '|'.join(f'\\b{re.escape(k)}\\b' for k in abbrs.keys()),
+            re.IGNORECASE
+        )
+
+        for node in root.iter():
+            if node.text:
+                self._replace_abbrs(node, 'text', abbrs, pattern)
+            if node.tail:
+                self._replace_abbrs(node, 'tail', abbrs, pattern)
+
+    def _replace_abbrs(self, node: etree.Element, attr: str, abbrs: dict[str, str], pattern: re.Pattern):
+        """ Replace abbreviations in text with <abbr> elements. """
+        text = getattr(node, attr)
+        if not text:
+            return
+
+        last_pos = 0
+        for m in pattern.finditer(text):
+            start, end = m.span()
+            abbr_text = m.group(0)
+            # Find the correct title (case-insensitive match)
+            title = next((v for k, v in abbrs.items() if k.lower() == abbr_text.lower()), "")
+            
+            # Insert the <abbr> element
+            abbr_el = etree.Element('abbr')
+            abbr_el.text = AtomicString(abbr_text)
+            abbr_el.set('title', title)
+            
+            if attr == 'text':
+                # Insert before the current node's text
+                # This is tricky. We need to insert it as a child of the parent.
+                parent = node.getparent()
+                if parent is not None:
+                    # Find the index of the current node among children
+                    children = list(parent)
+                    idx = children.index(node)
+                    # Insert before the node
+                    parent.insert(idx, abbr_el)
+                    # Update the text of the node
+                    node.text = text[last_pos:start]
+                    # The rest of the text will be handled by subsequent matches or at the end
+                    # But wait, this changes the structure. 
+                    # A better way is to use a temporary list of elements.
+                    pass
+            
+            last_pos = end
+        # We need to insert elements into the tree.
+        # Since we are in a Treeprocessor, we should be manipulating the ElementTree.

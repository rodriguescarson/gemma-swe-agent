+def classify_unique(iterable, key=None):
+    """Yields (element, is_unique_justseen, is_unique_everseen)
+
+    >>> list(classify_unique('AAAABBBCCDAABBB'))
+    [('A', True, True), ('A', False, False), ('A', False, False), ('A', False, False),
+     ('B', True, True), ('B', False, False), ('B', False, False),
+     ('C', True, True), ('C', False, False),
+     ('D', True, True),
+     ('A', True, False), ('A', False, False),
+     ('B', True, False), ('B', False, False), ('B', False, False)]
+    >>> list(classify_unique('ABBCcAD', str.lower))
+    [('A', True, True), ('B', True, True), ('B', False, False),
+     ('C', True, True), ('c', False, False),
+     ('A', True, False),
+     ('D', True, True)]
+    """
+    seen = set()
+    last_key = object()
+    for element in iterable:
+        k = key(element) if key else element
+        is_unique_justseen = k != last_key
+        is_unique_everseen = k not in seen
+        seen.add(k)
+        last_key = k
+        yield (element, is_unique_justseen, is_unique_everseen)

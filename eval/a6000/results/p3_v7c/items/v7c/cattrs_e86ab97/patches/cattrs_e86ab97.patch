+from ._compat import (
+    AbcMapping,
+    AbcMutableMapping,
+    Dict,
+    TypingMapping,
+    TypingMutableMapping,
+    _GenericAlias,
+    is_subclass,
+)
+from .gen import make_mapping_structure_fn
+
+mapping_structure_factory = make_mapping_structure_fn
+
+def is_mapping(type) -> bool:
+    return (
+        type in (dict, Dict, TypingMapping, TypingMutableMapping, AbcMutableMapping)
+        or (
+            type.__class__ is _GenericAlias
+            and is_subclass(type.__origin__, TypingMapping)
+        )
+        or (
+            getattr(type, "__origin__", None)
+            in (dict, AbcMutableMapping, AbcMapping)
+        )
+        or is_subclass(type, dict)
+    )
+
 def is_any_set(type) -> bool:
     """A predicate function for both mutable and frozensets."""
     return is_set(type) or is_frozenset(type)

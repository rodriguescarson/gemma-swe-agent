     @classmethod
     def parse(cls, tzinfo_string: str) -> dt_tzinfo:
 
+        # Remove (UTC prefix and trailing descriptive text
+        if tzinfo_string.startswith("(UTC"):
+            # Find the closing parenthesis of the (UTC+XX:XX) part
+            end_idx = tzinfo_string.find(")")
+            if end_idx != -1:
+                # Extract the part inside the parentheses, e.g., "UTC+01:00"
+                tzinfo_string = tzinfo_string[1:end_idx]
+
+        # Remove UTC prefix if it's still there (e.g., "UTC+01:00")
+        # But only if it's followed by a sign, to avoid stripping "UTC" entirely
+        if tzinfo_string.startswith("UTC") and len(tzinfo_string) > 3 and tzinfo_string[3] in "+-":
+            tzinfo_string = tzinfo_string[3:]

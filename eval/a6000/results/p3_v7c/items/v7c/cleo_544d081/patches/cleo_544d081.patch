+def wcwidth(text: str) -> int:
+    """Return the number of columns used to display the text."""
+    width = 0
+    for char in text:
+        cp = ord(char)
+        if cp == 0x0009:  # \t
+            width += 8
+            continue
+        if cp == 0x000a or cp == 0x000d:  # \n, \r
+            continue
+        if (
+            (0x1100 <= cp <= 0x115f)
+            or (0x2329 <= cp <= 0x232a)
+            or (0x2e80 <= cp <= 0xa4cf and cp != 0x303f)
+            or (0xac00 <= cp <= 0xd7a3)
+            or (0xf900 <= cp <= 0xfdff)
+            or (0xfdf0 <= cp <= 0xfdff)
+            or (0x20000 <= cp <= 0x243ff)
+            or (0x2a600 <= cp <= 0x2eef)
+            or (0x30000 <= cp <= 0x3fffd)
+        ):
+            width += 2
+        elif cp < 0x20:
+            width += 0
+        else:
+            width += 1
+    return width

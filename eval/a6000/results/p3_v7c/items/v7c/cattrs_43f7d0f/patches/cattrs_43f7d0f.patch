+
+
+def create_tagged_union_dis_func(
+    *classes: Type[Any],
+    tag_name: str = "_type",
+    tag_generator: Optional[Callable[[Type[Any]], Any]] = None,
+) -> Callable[[Mapping[Any, Any]], Optional[Type[Any]]]:
+    """Given attr classes, generate a disambiguation function.
+
+    The function is based on a tag field.
+    """
+    if len(classes) < 2:
+        raise ValueError("At least two classes required.")
+
+    if tag_generator is None:
+        tag_generator = lambda cl: cl.__name__
+
+    tag_to_cls = {tag_generator(get_origin(cl) or cl): cl for cl in classes}
+
+    def dis_func(data: Mapping[Any, Any]) -> Optional[Type[Any]]:
+        if not isinstance(data, Mapping):
+            raise ValueError("Only input mappings are supported.")
+        try:
+            tag = data[tag_name]
+            return tag_to_cls.get(tag)
+        except KeyError:
+            return None
+
+    return dis_func

+    def lookup(self, key, column=DEFAULT):
+        if column is DEFAULT:
+            pks = self.pks
+            if len(pks) == 0:
+                raise BadPrimaryKey(
+                    "Table '{}' has no primary key".format(self.name)
+                )
+            if len(pks) > 1:
+                raise BadPrimaryKey(
+                    "Table '{}' has multiple primary keys".format(self.name)
+                )
+            column = pks[0]
+        sql = "SELECT * FROM [{table}] WHERE [{column}] = :key".format(
+            table=self.name,
+            column=column,
+        )
+        row = self.db.conn.execute(sql, (key,)).fetchone()
+        return row
+
     def value_or_default(self, key, value):
         return self._defaults[key] if value is DEFAULT else value
 

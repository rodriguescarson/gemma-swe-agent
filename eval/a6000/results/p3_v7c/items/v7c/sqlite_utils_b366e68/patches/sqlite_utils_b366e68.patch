+++ b/sqlite_utils/db.py
@@ -1295,6 +1295,11 @@ class Table(Queryable):
     def exists(self) -> bool:
         return self.name in self.db.table_names()
 
+    def duplicate(self, new_name: str) -> 'Table':
+        """Duplicate this table into a new table."""
+        self.db.execute(f"CREATE TABLE {new_name} AS SELECT * FROM {self.name}")
+        return self.db[new_name]

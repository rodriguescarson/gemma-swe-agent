+def get_console_renderer() -> ConsoleRenderer | None:
+    """
+    Get the currently configured ConsoleRenderer.
+
+    Return None if no ConsoleRenderer is found in the processor chain.
+    """
+    from structlog.dev import ConsoleRenderer
+    for processor in _CONFIG.default_processors:
+        if isinstance(processor, ConsoleRenderer):
+            return processor
+    return None

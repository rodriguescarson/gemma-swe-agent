+def dft(iterable):
+    """Compute the discrete Fourier transform of the given iterable.
+
+    Args:
+        iterable: An iterable of numbers.
+
+    Returns:
+        A list of complex numbers.
+    """
+    x = list(iterable)
+    N = len(x)
+    X = []
+    for k in range(N):
+        s = sum(x[n] * cmath.exp(-2j * cmath.pi * k * n / N) for n in range(N))
+        X.append(s)
+    return X
+
+def idft(iterable):
+    """Compute the inverse discrete Fourier transform of the given iterable.
+
+    Args:
+        iterable: An iterable of complex numbers.
+
+    Returns:
+        A list of complex numbers.
+    """
+    X = list(iterable)
+    N = len(X)
+    x = []
+    for n in range(N):
+        s = sum(X[k] * cmath.exp(2j * cmath.pi * k * n / N) for k in range(N))
+        x.append(s / N)
+    return x
+

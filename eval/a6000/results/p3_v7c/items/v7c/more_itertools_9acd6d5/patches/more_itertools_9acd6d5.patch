+def takewhile_inclusive(predicate, iterable):
+    """Yield elements from *iterable* as long as *predicate* is true,
+    and include the first element that fails the predicate.
+
+    >>> list(takewhile_inclusive(lambda x: x < 3, [1, 2, 3, 4, 5]))
+    [1, 2, 3]
+    >>> list(takewhile_inclusive(lambda x: x < 3, [1, 2]))
+    [1, 2]
+    >>> list(takewhile_inclusive(lambda x: x < 3, [4, 5]))
+    [4]
+    """
+    iterable = iter(iterable)
+    try:
+        item = next(iterable)
+    except StopIteration:
+        return
+
+    yield item
+    while predicate(item):
+        try:
+            item = next(iterable)
+        except StopIteration:
+            return
+        yield item
+

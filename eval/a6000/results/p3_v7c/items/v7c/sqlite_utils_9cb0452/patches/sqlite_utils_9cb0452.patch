+        
+        args = where_args or []
+        
+        # SQLite has a limit on the number of host parameters (SQLITE_LIMIT_VARIABLE_NUMBER).
+        # If we have too many arguments, we can't execute the query in one go.
+        # We can't easily chunk a generic WHERE clause, but we can try to execute it
+        # and if it fails with a "too many SQL variables" error, we can't do much here
+        # without knowing the structure of the query.
+        
+        try:
+            cursor = self.db.conn.execute(sql, args)
+            columns = [c[0] for c in cursor.description]
+            for row in cursor:
+                yield dict(zip(columns, row))
+        except sqlite3.OperationalError as e:
+            if "too many SQL variables" in str(e):
+                raise RuntimeError(
+                    "Too many SQL variables. SQLite has a limit on the number of host parameters. "
+                    "Try chunking your query or using a temporary table."
+                ) from e
+            raise
 

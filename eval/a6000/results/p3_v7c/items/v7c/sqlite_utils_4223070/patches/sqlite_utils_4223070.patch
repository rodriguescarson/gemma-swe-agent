+def transform_sql(
+    self,
+    *,
+    types=None,
+    rename=None,
+    drop=None,
+    pk=None,
+    not_null=None,
+    keep_table=False,
+):
+    """Return the SQL to transform the table.
+    """
+    types = types or {}
+    rename = rename or {}
+    drop = drop or []
+    not_null = not_null or []
+
+    # The new table name
+    new_table_name = f"{self.name}_new"
+    
+    # The columns for the new table
+    columns = []
+    for col in self.columns:
+        if col in drop:
+            continue
+        
+        col_name = rename.get(col, col)
+        col_type = types.get(col, "TEXT")
+        
+        # Handle NOT NULL
+        not_null_sql = " NOT NULL" if col in not_null else ""
+        
+        columns.append(f'"{col_name}" {col_type}{not_null_sql}')
+
+    # The primary key
+    if pk:
+        pk_cols = [f'"{rename.get(col, col)}"' for col in pk]
+        pk_sql = f" PRIMARY KEY ({', '.join(pk_cols)})"
+    else:
+        pk_sql = ""
+
+    # Create the new table
+    create_table_sql = f'CREATE TABLE "{new_table_name}" ({", ".join(columns)}{pk_sql})'
+    
+    # Copy the data
+    select_cols = []
+    for col in self.columns:
+        if col in drop:
+            continue
+        select_cols.append(f'"{col}"')
+    
+    insert_sql = f'INSERT INTO "{new_table_name}" SELECT {", ".join(select_cols)} FROM "{self.name}"'
+    
+    sqls = [create_table_sql, insert_sql]
+    
+    # Recreate indexes
+    if not keep_table:
+        for index in self.indexes():
+            # index is a dict with 'name', 'columns', 'unique'
+            index_cols = index['columns']
+            
+            # Check if all columns in the index still exist
+            for col in index_cols:
+                if col in drop:
+                    raise ValueError(f"Index {index['name']} refers to dropped column {col}")
+            
+            # Map columns to their new names
+            new_index_cols = [f'"{rename.get(col, col)}"' for col in index_cols]
+            unique_sql = "UNIQUE " if index['unique'] else ""
+            
+            index_sql = f'CREATE {unique_sql}INDEX "{index["name"]}" ON "{new_table_name}" ({", ".join(new_index_cols)})'
+            sqls.append(index_sql)
+
+    # Finalize the transformation
+    if keep_table:
+        # Rename original table to backup
+        backup_name = f"{self.name}_old"
+        sqls.append(f'ALTER TABLE "{self.name}" RENAME TO "{backup_name}"')
+        sqls.append(f'ALTER TABLE "{new_table_name}" RENAME TO "{self.name}"')
+    else:
+        sqls.append(f'DROP TABLE "{self.name}"')
+        sqls.append(f'ALTER TABLE "{new_table_name}" RENAME TO "{self.name}"')
 
+    return sqls

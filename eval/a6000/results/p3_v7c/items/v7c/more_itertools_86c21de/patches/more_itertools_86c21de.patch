+def join_mappings(*mappings):
+    """Merge multiple mappings, with later mappings overriding earlier ones.
+
+    >>> join_mappings({'a': 1}, {'b': 2})
+    {'a': 1, 'b': 2}
+    >>> join_mappings({'a': 1}, {'a': 2})
+    {'a': 2}
+    >>> join_mappings({'a': 1}, {'b': 2}, {'a': 3})
+    {'a': 3, 'b': 2}
+    """
+    result = {}
+    for mapping in mappings:
+        result.update(mapping)
+    return result
+

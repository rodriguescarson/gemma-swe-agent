+def format_literal(value: Any, config: Config, bracket_open: str, bracket_close: str) -> str:
+    """Format a literal to be black-compatible."""
+    # Convert all elements to double-quoted strings if they are strings
+    items = []
+    if isinstance(value, (list, tuple, set)):
+        for item in value:
+            if isinstance(item, str) and config.profile == "black":
+                items.append(f'\"{item}\"')
+            else:
+                items.append(repr(item))
+    elif isinstance(value, dict):
+        # For dicts, we sort by value as per existing _dict implementation
+        sorted_items = sorted(value.items(), key=lambda item: item[1])
+        for k, v in sorted_items:
+            k_str = f'\"{k}\"' if isinstance(k, str) and config.profile == "black" else repr(k)
+            v_str = f'\"{v}\"' if isinstance(v, str) and config.profile == "black" else repr(v)
+            items.append(f"{k_str}: {v_str}")
+    else:
+        return repr(value)
+
+    # Calculate total length if joined by comma-space
+    joined_items = ", ".join(items)
+    total_length = len(bracket_open) + len(joined_items) + len(bracket_close)
+
+    if total_length <= config.line_length:
+        return f"{bracket_open}{joined_items}{bracket_close}"
+
+    # Multi-line format: one item per line, vertical hanging indent
+    # Black uses 4 spaces for indent
+    lines = [f"    {item}" for item in items]
+    trailing_comma = "," if config.include_trailing_comma else ""
+    if items:
+        lines[-1] = f"    {items[-1]}{trailing_comma}"
+    
+    content = "\n".join(lines)
+    return f"{bracket_open}\n{content}\n{bracket_close}"
+
+

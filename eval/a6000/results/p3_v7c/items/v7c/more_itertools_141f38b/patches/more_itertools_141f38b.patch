+def random_ordered_combination(iterable, r):
+    """Return a random *r* length subsequence of the elements in *iterable*
+    in a random order.
+
+        >>> random_ordered_combination(range(5), 3)  # doctest:+SKIP
+        (4, 0, 2)
+
+    This equivalent to taking a random selection from
+    ``itertools.permutations(iterable, r)``, but where the selection
+    is first made as a combination.
+
+    """
+    pool = tuple(iterable)
+    n = len(pool)
+    indices = sample(range(n), r)
+    return tuple([pool[i] for i in indices])
+
+

+def random_ordered_combination_with_replacement(iterable, r):
+    """Return a random *r* length subsequence of elements in *iterable*,
+    allowing individual elements to be repeated, in a random order.
+
+        >>> random_ordered_combination_with_replacement(range(3), 5) # doctest:+SKIP
+        (2, 0, 2, 1, 0)
+
+    This equivalent to taking a random selection from
+    ``itertools.product(iterable, repeat=r)``, but where the selection
+    is first made as a combination with replacement.
+
+    """
+    pool = tuple(iterable)
+    n = len(pool)
+    indices = [randrange(n) for i in range(r)]
+    return tuple([pool[i] for i in indices])

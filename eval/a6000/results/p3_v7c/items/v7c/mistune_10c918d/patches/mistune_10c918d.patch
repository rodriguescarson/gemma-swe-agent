diff --git a/src/mistune/renderers/markdown.py b/src/mistune/renderers/markdown.py
index de7ba3a..1450aab 100644
--- a/src/mistune/renderers/markdown.py
+++ b/src/mistune/renderers/markdown.py
@@ -77,7 +77,16 @@ class MarkdownRenderer(BaseRenderer):
         return "!" + self.link(token, state)
 
     def codespan(self, token: Dict[str, Any], state: BlockState) -> str:
-        return "`" + cast(str, token["raw"]) + "`"
+        code = cast(str, token["raw"])
+        marker_len = 1
+        if "`" in code:
+            import re
+            ticks = [len(m) for m in re.findall(r"`+", code)]
+            marker_len = max(ticks) + 1
+        if code.startswith("`") or code.endswith("`"):
+            code = f" {code} "
+        marker = "`" * marker_len
+        return f"{marker}{code}{marker}"
 
     def linebreak(self, token: Dict[str, Any], state: BlockState) -> str:
         return "  \n"

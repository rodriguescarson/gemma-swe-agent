+import arrow
+from datetime import datetime, date
+from dateutil import tz
+import calendar
+from time import gmtime
+
+def test_tzinfo_kwarg():
+    # 1. datetime
+    dt = datetime(2013, 5, 5)
+    arw = arrow.get(dt, tzinfo='US/Pacific')
+    print(f"datetime: {arw}")
+    assert str(arw.tzinfo) == 'US/Pacific' or 'US/Pacific' in str(arw)
+
+    # 2. date
+    d = date(2013, 5, 5)
+    arw = arrow.get(d, tzinfo='US/Pacific')
+    print(f"date: {arw}")
+    assert str(arw.tzinfo) == 'US/Pacific' or 'US/Pacific' in str(arw)
+
+    # 3. Arrow object
+    arw_obj = arrow.utcnow()
+    arw = arrow.get(arw_obj, tzinfo='US/Pacific')
+    print(f"Arrow object: {arw}")
+    assert str(arw.tzinfo) == 'US/Pacific' or 'US/Pacific' in str(arw)
+
+    # 4. struct_time
+    st = gmtime(0)
+    arw = arrow.get(st, tzinfo='US/Pacific')
+    print(f"struct_time: {arw}")
+    assert str(arw.tzinfo) == 'US/Pacific' or 'US/Pacific' in str(arw)
+
+    # 5. iso calendar tuple
+    tup = (2013, 18, 7)
+    arw = arrow.get(tup, tzinfo='US/Pacific')
+    print(f"iso calendar: {arw}")
+    assert str(arw.tzinfo) == 'US/Pacific' or 'US/Pacific' in str(arw)
+
+if __name__ == "__main__":
+    try:
+        test_tzinfo_kwarg()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed!")
+    except Exception as e:
+        print(f"An error occurred: {e}")

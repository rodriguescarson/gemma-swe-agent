diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..ea08ed0
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,50 @@
+import arrow
+from datetime import datetime, date
+from time import gmtime
+from dateutil import tz
+
+def test_get_tzinfo():
+    # Test datetime
+    dt = datetime(2023, 1, 1, 12, 0)
+    arw = arrow.get(dt, tzinfo='US/Pacific')
+    print(f"datetime: {arw}")
+    assert str(arw.tzinfo) == 'US/Pacific' or arw.utcoffset() is not None
+
+    # Test date
+    d = date(2023, 1, 1)
+    arw = arrow.get(d, tzinfo='US/Pacific')
+    print(f"date: {arw}")
+    assert str(arw.tzinfo) == 'US/Pacific' or arw.utcoffset() is not None
+
+    # Test Arrow
+    arw1 = arrow.get(2023, 1, 1, 12, 0)
+    arw2 = arrow.get(arw1, tzinfo='US/Pacific')
+    print(f"Arrow: {arw2}")
+    assert str(arw2.tzinfo) == 'US/Pacific' or arw2.utcoffset() is not None
+
+    # Test struct_time
+    st = gmtime(0)
+    arw = arrow.get(st, tzinfo='US/Pacific')
+    print(f"struct_time: {arw}")
+    assert str(arw.tzinfo) == 'US/Pacific' or arw.utcoffset() is not None
+
+    # Test tuple (iso calendar)
+    tup = (2023, 1, 1) # This is not exactly an iso calendar tuple (year, week, day)
+    # let's use a proper one
+    tup = (2023, 1, 1) 
+    arw = arrow.get(tup, tzinfo='US/Pacific')
+    print(f"tuple: {arw}")
+    assert str(arw.tzinfo) == 'US/Pacific' or arw.utcoffset() is not None
+
+    # Test that defaults still work (UTC)
+    arw_default = arrow.get(dt)
+    print(f"default: {arw_default}")
+    assert arw_default.utcoffset() == None or arw_default.utcoffset().total_seconds() == 0 # Arrow default is UTC
+
+if __name__ == "__main__":
+    try:
+        test_get_tzinfo()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e

+++ b/src/trio/_tools/sync_pre_commit.py
@@ -0,0 +1,69 @@
+import yaml
+import re
+import sys
+from pathlib import Path
+
+def sync():
+    config_path = Path(".pre-commit-config.yaml")
+    reqs_path = Path("test-requirements.txt")
+    
+    if not config_path.exists() or not reqs_path.exists():
+        print("Missing .pre-commit-config.yaml or test-requirements.txt")
+        sys.exit(1)
+        
+    with open(config_path, "r") as f:
+        config = yaml.safe_load(f)
+        
+    # Mapping of repo URL to package name
+    mapping = {
+        "https://github.com/psf/black-pre-commit-mirror": "black",
+        "https://github.com/astral-sh/ruff-pre-commit": "ruff",
+        "https://github.com/codespell-project/codespell": "codespell",
+        "https://github.com/adhtruong/mirrors-typos": "typos",
+        "https://github.com/sphinx-contrib/sphinx-lint": "sphinx-lint",
+        "https://github.com/woodruffw/zizmor-pre-commit": "zizmor",
+    }
+    
+    updates = {}
+    for repo_entry in config.get("repos", []):
+        repo_url = repo_entry.get("repo")
+        rev = repo_entry.get("rev")
+        if repo_url in mapping and rev:
+            package_name = mapping[repo_url]
+            # Strip leading 'v' if present
+            version = rev[1:] if rev.startswith("v") else rev
+            updates[package_name] = version
+            
+    if not updates:
+        print("No updates to apply.")
+        return
+
+    with open(reqs_path, "r") as f:
+        lines = f.readlines()
+        
+    new_lines = []
+    changed = False
+    for line in lines:
+        # Match lines like 'black==25.1.0 ; implementation_name == "cpython"'
+        # or 'codespell==2.4.1'
+        # We want to replace the version part after '=='
+        match = re.match(r'^([a-zA-Z0-9\-_]+)==([a-zA-Z0-9\.\-_]+)(.*)$', line)
+        if match:
+            package, version, rest = match.groups()
+            if package in updates:
+                new_version = updates[package]
+                if version != new_version:
+                    print(f"Updating {package}: {version} -> {new_version}")
+                    line = f"{package}=={new_version}{rest}\n"
+                    changed = True
+        new_lines.append(line)
+        
+    if changed:
+        with open(reqs_path, "w") as f:
+            f.writelines(new_lines)
+        print("Updated test-requirements.txt")
+    else:
+        print("No versions needed updating.")
+
+if __name__ == "__main__":
+    sync()

diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..436b709
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,54 @@
+import attr
+
+@attr.s
+class A:
+    x = attr.ib(default=1)
+
+    def __attr__pre_init__(self, x):
+        print(f"pre_init x: {x}")
+
+# The issue is that __attrs_pre_init__ (note the 's' in attrs)
+# is the one called, not __attr__pre_init__.
+# Wait, the source code says `__attrs_pre_init__`.
+# Let's redefine the class.
+
+@attr.s
+class B:
+    x = attr.ib(default=1)
+
+    def __attrs_pre_init__(self, x):
+        print(f"pre_init x: {x}")
+
+print("Test 1: default value")
+b1 = B()
+# Expected: pre_init x: 1
+
+print("Test 2: provided value")
+b2 = B(x=2)
+# Expected: pre_init x: 2
+
+if b2.x == 2:
+    print("Success!")
+else:
+    print("Failure!")
+
+# To properly verify if __attrs_pre_init__ received the right value,
+# we can use a mock or a simple flag.
+
+flag = []
+@attr.s
+class C:
+    x = attr.ib(default=1)
+    def __attrs_pre_init__(self, x):
+        flag.append(x)
+
+print("Test 3: default value propagation")
+C()
+assert flag == [1], f"Expected [1], got {flag}"
+
+flag.clear()
+print("Test 4: provided value propagation")
+C(x=2)
+assert flag == [2], f"Expected [2], got {flag}"
+
+print("All tests passed!")

--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,42 @@
+import arrow
+from arrow.parser import ParserMatchError
+
+try:
+    arrow.get("2023-01-01 13:00 AM", "YYYY-MM-DD hh:mm A")
+    print("FAILED: 13:00 AM should have raised ParserMatchError")
+except ParserMatchError:
+    print("SUCCESS: 13:00 AM raised ParserMatchError")
+except Exception as e:
+    print(f"FAILED: 13:00 AM raised {type(e).__name__} instead of ParserMatchError: {e}")
+
+try:
+    arrow.get("2023-01-01 13:00 PM", "YYYY-MM-DD hh:mm A")
+    print("FAILED: 13:00 PM should have raised ParserMatchError")
+except ParserMatchError:
+    print("SUCCESS: 13:00 PM raised ParserMatchError")
+except Exception as e:
+    print(f"FAILED: 13:00 PM raised {type(e).__name__} instead of ParserMatchError: {e}")
+
+try:
+    # This should still work
+    print(f"SUCCESS: 12:00 AM -> {arrow.get('2023-01-01 12:00 AM', 'YYYY-MM-DD hh:mm A')}")
+except Exception as e:
+    print(f"FAILED: 12:00 AM raised exception: {e}")
+
+try:
+    # This should still work
+    print(f"SUCCESS: 12:00 PM -> {arrow.get('2023-01-01 12:00 PM', 'YYYY-MM-DD hh:mm A')}")
+except Exception as e:
+    print(f"FAILED: 12:00 PM raised exception: {e}")
+
+try:
+    # This should still work
+    print(f"SUCCESS: 01:00 AM -> {arrow.get('2023-01-01 01:00 AM', 'YYYY-MM-DD hh:mm A')}")
+except Exception as e:
+    print(f"FAILED: 01:00 AM raised exception: {e}")
+
+try:
+    # This should still work
+    print(f"SUCCESS: 01:00 PM -> {arrow.get('2023-01-01 01:00 PM', 'YYYY-MM-DD hh:mm A')}")
+except Exception as e:
+    print(f"FAILED: 01:00 PM raised exception: {e}")

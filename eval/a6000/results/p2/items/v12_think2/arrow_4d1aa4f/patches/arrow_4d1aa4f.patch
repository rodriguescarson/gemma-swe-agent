+from arrow import arrow, locales
+
+def test_az_locale():
+    az_locale = locales.get_locale('az')
+    print(f"Timeframes: {az_locale.timeframes}")
+    
+    # Test second
+    res_singular = az_locale._format_timeframe("second", 0)
+    print(f"Singular second: {res_singular}")
+    
+    # Test second plural
+    res_plural = az_locale._format_timeframe("seconds", 2)
+    print(f"Plural seconds: {res_plural}")
+    
+    # Test week (newly added)
+    res_week = az_locale._format_timeframe("week", 0)
+    print(f"Singular week: {res_week}")
+    
+    res_weeks = az_locale._format_timeframe("weeks", 2)
+    print(f"Plural weeks: {res_weeks}")
+    
+    # Test year (updated)
+    res_year = az_locale._format_timeframe("year", 0)
+    print(f"Singular year: {res_year}")
+
+if __name__ == "__main__":
+    test_az_locale()

@@ -0,0 +1,43 @@
+import pytest
+from boltons.namedutils import namedtuple, namedlist
+
+def test_empty_type_name_namedtuple():
+    with pytest.raises(ValueError, match="must be non-empty"):
+        namedtuple("", ["x"])
+
+def test_empty_field_name_namedtuple():
+    with pytest.raises(ValueError, match="must be non-empty"):
+        namedtuple("T", ["x", ""])
+
+def test_empty_type_name_namedlist():
+    with pytest.raises(ValueError, match="must be non-empty"):
+        namedlist("", ["x"])
+
+def test_empty_field_name_namedlist():
+    with pytest.raises(ValueError, match="must be non-empty"):
+        namedlist("T", ["x", ""])
+
+def test_invalid_char_namedtuple():
+    with pytest.raises(ValueError, match="alphanumeric"):
+        namedtuple("T", ["x-y"])
+
+def test_valid_namedtuple():
+    T = namedtuple("T", ["x", "y"])
+    t = T(1, 2)
+    assert t.x == 1
+    assert t.y == 2
+
+def test_invalid_char_namedlist():
+    with pytest.raises(ValueError, match="alphanumeric"):
+        namedlist("T", ["x-y"])
+
+def test_valid_namedlist():
+    L = namedlist("L", ["x", "y"])
+    l = L(1, 2)
+    assert l.x == 1
+    assert l.y == 2
+
+if __name__ == "__main__":
+    # This is just to allow running as a script, 
+    # but we will use pytest.
+    pass

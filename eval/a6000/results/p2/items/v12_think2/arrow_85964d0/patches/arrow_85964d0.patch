+class LithuanianLocale(Locale):
+    names = ["lt", "lt_lt"]
+    past = "prieš {0}"
+    future = "per {0}"
+    and_word = "ir"
+
+    timeframes = {
+        "now": "dabar",
+        "second": "sekundę",
+        "seconds": {
+            "one": "{0} sekundę",
+            "few": "{0} sekundės",
+            "many": "{0} sekundžių",
+        },
+        "minute": "minutę",
+        "minutes": {
+            "one": "{0} minutę",
+            "few": "{0} minutės",
+            "many": "{0} minučių",
+        },
+        "hour": "valandą",
+        "hours": {
+            "one": "{0} valandą",
+            "few": "{0} valandos",
+            "many": "{0} valandų",
+        },
+        "day": "dieną",
+        "days": {
+            "one": "{0} dieną",
+            "few": "{0} dienos",
+            "many": "{0} dienų",
+        },
+        "week": "savaitę",
+        "weeks": {
+            "one": "{0} savaitę",
+            "few": "{0} savaitės",
+            "many": "{0} savaičių",
+        },
+        "month": "mėnesį",
+        "months": {
+            "one": "{0} mėnesį",
+            "few": "{0} mėnesiai",
+            "many": "{0} mėnesių",
+        },
+        "year": "metus",
+        "years": {
+            "one": "{0} metus",
+            "few": "{0} metai",
+            "many": "{0} metų",
+        },
+    }
+
+    month_names = [
+        "",
+        "sausis",
+        "vasaris",
+        "kovas",
+        "balandis",
+        "majus",
+        "birželis",
+        "liepa",
+        "rugpjūtis",
+        "rugsėjis",
+        "spalis",
+        "listapadis",
+        "gruodis",
+    ]
+    month_abbreviations = [
+        "",
+        "saus.",
+        "vas.",
+        "kov.",
+        "bal.",
+        "maj.",
+        "birž.",
+        "liep.",
+        "rugpj.",
+        "rugs.",
+        "spal.",
+        "list.",
+        "grud.",
+    ]
+    day_names = [
+        "",
+        "pirmadienis",
+        "antradienis",
+        "trečiadienis",
+        "ketvirtadienis",
+        "penktadienis",
+        "šeštadienis",
+        "sekmadienis",
+    ]
+    day_abbreviations = [
+        "",
+        "pirm.",
+        "ant.",
+        "treč.",
+        "ketv.",
+        "penkt.",
+        "šešt.",
+        "sekm.",
+    ]
+
+    def _format_timeframe(
+        self, timeframe: TimeFrameLiteral, delta: Union[float, int]
+    ) -> str:
+        form = self.timeframes[timeframe]
+        delta = abs(delta)
+
+        if isinstance(form, dict):
+            if delta % 10 == 1 and delta % 100 != 11:
+                form = form["one"]
+            elif 2 <= delta % 10 <= 9 and not (12 <= delta % 100 <= 19):
+                form = form["few"]
+            else:
+                form = form["many"]
+
+        return form.format(delta)
+
+
 _locales: Dict[str, Type[Locale]] = _map_locales()

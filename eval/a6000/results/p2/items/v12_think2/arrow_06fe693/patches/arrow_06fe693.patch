--- /dev/null
+++ b/repro_struct.py
@@ -0,0 +1,19 @@
+import arrow
+import time
+from datetime import datetime
+
+# Test with tzinfo
+st = time.gmtime(0) # 1970-01-01 00:00:00 UTC
+a_tz = arrow.get(st, tzinfo='US/Pacific')
+print(f"With tzinfo - Arrow: {a_tz} | Timezone: {a_tz.tzinfo}")
+# Expected: 1970-01-01T00:00:00-08:00
+
+# Test without tzinfo
+a_no_tz = arrow.get(st)
+print(f"Without tzinfo - Arrow: {a_no_tz} | Timezone: {a_no_tz.tzinfo}")
+# Expected: 1970-01-01T00:00:00+00:00
+
+# Simple assertions
+assert str(a_tz) == "1970-01-01T00:00:00-08:00"
+assert str(a_no_tz) == "1970-01-01T00:00:00+00:00"
+print("All tests passed!")

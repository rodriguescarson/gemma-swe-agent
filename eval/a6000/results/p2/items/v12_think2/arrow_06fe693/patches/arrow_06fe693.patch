diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..bd97f4a
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,28 @@
+import arrow
+from datetime import datetime
+import dateutil.tz
+
+dt = datetime(2013, 5, 5)
+# This should use US/Pacific timezone
+arw = arrow.get(dt, tzinfo='US/Pacific')
+print(f"Datetime: {dt}")
+print(f"Arrow: {arw}")
+print(f"Timezone: {arw.tzinfo}")
+
+# Expected: Arrow [2013-05-05T00:00:00-07:00] (or similar for US/Pacific)
+# Actual: Arrow [2013-05-05T00:00:00+00:00]
+
+# Also test with date
+from datetime import date
+d = date(2013, 5, 5)
+arw_d = arrow.get(d, tzinfo='US/Pacific')
+print(f"Date: {d}")
+print(f"Arrow Date: {arw_d}")
+print(f"Timezone Date: {arw_d.tzinfo}")
+
+# Also test with Arrow object
+arw_orig = arrow.utcnow()
+arw_copy = arrow.get(arw_orig, tzinfo='US/Pacific')
+print(f"Arrow Orig: {arw_orig}")
+print(f"Arrow Copy: {arw_copy}")
+print(f"Timezone Copy: {arw_copy.tzinfo}")
diff --git a/repro_struct.py b/repro_struct.py
new file mode 100644

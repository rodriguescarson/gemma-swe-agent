index 0000000..056bd67
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,47 @@
+
+import click
+from unittest.mock import MagicMock, patch
+from src.black import read_pyproject_toml
+
+def test_validation():
+    ctx = MagicMock(spec=click.Context)
+    ctx.params = {}
+    ctx.command = MagicMock()
+    ctx.command.params = []
+    ctx.default_map = {}
+    
+    # Test include as list
+    with patch("src.black.parse_pyproject_toml", return_value={"include": ["file.py"]}):
+        try:
+            read_pyproject_toml(ctx, None, "pyproject.toml")
+        except click.BadOptionUsage as e:
+            assert "Config key include must be a string" in str(e)
+        else:
+            assert False, "Should have raised click.BadOptionUsage for include"
+
+    # Test force_exclude as list
+    with patch("src.black.parse_pyproject_toml", return_value={"force_exclude": ["file.py"]}):
+        try:
+            read_pyproject_toml(ctx, None, "pyproject.toml")
+        except click.BadOptionUsage as e:
+            assert "Config key force-exclude must be a string" in str(e)
+        else:
+            assert False, "Should have raised click.BadOptionUsage for force_exclude"
+
+    # Test include as string
+    with patch("src.black.parse_pyproject_toml", return_value={"include": "file.py"}):
+        try:
+            read_pyproject_toml(ctx, None, "pyproject.toml")
+        except click.BadOptionUsage:
+            assert False, "Should not have raised click.BadOptionUsage for include string"
+
+    # Test force_exclude as string
+    with patch("src.black.parse_pyproject_toml", return_value={"force_exclude": "file.py"}):
+        try:
+            read_pyproject_toml(ctx, None, "pyproject.toml")
+        except click.BadOptionUsage:
+            assert False, "Should not have raised click.BadOptionUsage for force_exclude string"
+
+if __name__ == "__main__":
+    test_validation()
+    print("Tests passed!")

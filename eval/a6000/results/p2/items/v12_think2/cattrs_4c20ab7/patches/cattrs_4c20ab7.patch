+
+from typing import Union, Literal
+from cattrs import Converter
+from cattrs.strategies import configure_union_passthrough, configure_tagged_union
+
+# Python 3.12+ PEP 695 type alias
+type Alias2 = Union[int, str]
+type Alias1 = Alias2
+
+converter = Converter()
+
+print("Testing configure_tagged_union with nested aliases...")
+try:
+    configure_tagged_union(Alias1, converter)
+    print("configure_tagged_union succeeded")
+except Exception as e:
+    print(f"configure_tagged_union failed: {e}")
+
+print("\nTesting configure_union_passthrough with nested aliases...")
+try:
+    configure_union_passthrough(Alias1, converter)
+    print("configure_union_passthrough succeeded")
+except Exception as e:

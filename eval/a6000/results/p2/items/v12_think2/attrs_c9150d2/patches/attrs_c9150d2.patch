index 0000000..1d2f491
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,37 @@
+import pickle
+from attr import s, ib
+
+@s(slots=True)
+class MyClass:
+    x = ib()
+    y = ib()
+
+def create_uninitialized_obj():
+    # Create an instance without calling __init__
+    obj = MyClass.__new__(MyClass)
+    return obj
+
+obj = create_uninitialized_obj()
+
+# Simulate unpickling with tuple state (attrs < 22.2.0)
+state_tuple = (1, 2)
+print(f"Simulating unpickling with tuple state: {state_tuple}")
+try:
+    obj.__setstate__(state_tuple)
+    print(f"After __setstate__ with tuple: {obj}")
+    # Check if attributes are set
+    print(f"x: {getattr(obj, 'x', 'NOT SET')}, y: {getattr(obj, 'y', 'NOT SET')}")
+except Exception as e:
+    print(f"Caught exception: {e}")
+
+# Simulate unpickling with dict state (attrs >= 22.2.0)
+obj = create_uninitialized_obj()
+state_dict = {'x': 3, 'y': 4}
+print(f"Simulating unpickling with dict state: {state_dict}")
+try:
+    obj.__setstate__(state_dict)
+    print(f"After __setstate__ with dict: {obj}")
+    # Check if attributes are set
+    print(f"x: {getattr(obj, 'x', 'NOT SET')}, y: {getattr(obj, 'y', 'NOT SET')}")
+except Exception as e:
+    print(f"Caught exception: {e}")

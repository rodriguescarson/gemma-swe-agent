@@ -117,7 +117,35 @@ def isoparse(iso_str):
     .. _dateutil: https://pypi.python.org/pypi/python-dateutil
 
     """
-    dt_args = [int(p) for p in _NONDIGIT_RE.split(iso_str)]
+    # Split by non-digits, but keep the dot for fractional seconds.
+    # _NONDIGIT_RE is r'\D', which splits on everything that's not a digit.
+    # This means it splits on the dot too.
+    # We need to handle the case where the input has fractional seconds.
+    # Example: '2023-01-01T12:00:00.851'
+    # _NONDIGIT_RE.split('2023-01-01T12:00:00.851') -> ['2023', '01', '01', '12', '00', '00', '851']
+    # The problem is that '851' is treated as 851 microseconds, but it should be 851000.
+    
+    # Let's use a more robust way to parse the ISO string.
+    import re
+    # Find all sequences of digits, potentially with a leading dot.
+    # But the standard isoformat() is YYYY-MM-DDTHH:MM:SS.ffffff
+    # We can split by non-digits, but we need to know if the last part was fractional.
+    
+    # If we use the original logic but check if the original string had a dot:
+    parts = _NONDIGIT_RE.split(iso_str)
+    # Filter out empty strings from split
+    parts = [p for p in parts if p]
+    
+    dt_args = []
+    for i, p in enumerate(parts):
+        if i == len(parts) - 1 and '.' in iso_str:
+            # The last part is fractional seconds if there was a dot in the string.
+            # We need to normalize it to microseconds (6 digits).
+            frac_part = iso_str.split('.')[-1]
+            frac_val = frac_part[:6].ljust(6, '0')
+            dt_args.append(int(frac_val))
+        else:
+            dt_args.append(int(p))
     return datetime(*dt_args)
 
 

diff --git a/tests/repro_recursive_alias.py b/tests/repro_recursive_alias.py
new file mode 100644
index 0000000..136ed3f
--- /dev/null
+++ b/tests/repro_recursive_alias.py
@@ -0,0 +1,39 @@
+import pytest
+from cattrs import BaseConverter
+from cattrs.strategies import configure_tagged_union
+from dataclasses import dataclass
+from typing import Union
+
+@dataclass
+class A:
+    a: int
+
+@dataclass
+class B:
+    b: str
+
+# Recursive type alias: AOrB is used inside A
+@dataclass
+class Recursive:
+    val: "AOrB"
+
+type AOrB = Union[A, B, Recursive]
+
+def test_recursive_alias():
+    converter = BaseConverter()
+    configure_tagged_union(AOrB, converter)
+    
+    # This should work
+    assert converter.unstructure(A(1), AOrB) == {"_type": "A", "a": 1}
+    
+    # This is the recursive part
+    rec = Recursive(A(1))
+    unstruct = converter.unstructure(rec, AOrB)
+    print(f"Unstructured: {unstruct}")
+    
+    assert unstruct["_type"] == "Recursive"
+    assert unstruct["val"] == {"_type": "A", "a": 1}
+    assert converter.structure(unstruct, AOrB) == rec
+
+if __name__ == "__main__":
+    test_recursive_alias()

+def test_jsonl_iterator_binary_rel_seek(tmp_path):
+    # This test specifically checks for the TypeError that occurred
+    # when performing relative seeking in binary JSONL streams.
+    path = tmp_path / 'binary_test.jsonl'
+    data = '{"a": 1}\n{"b": 2}\n{"c": 3}\n'
+    path.write_text(data)
+    
+    with path.open('rb') as stream:
+        # Rel seek to ~50% of the file.
+        # For data above, length is 12+12+12 = 36. 0.5 * 36 = 18.
+        # '{"a": 1}\n{"b": 2}\n{"c": 3}\n'
+        # 0123456789012345678
+        # '{"a": 1}\n{"b": 2'
+        # Should align to the newline after {"b": 2} and then read {"c": 3}
+        jsonl_iter = JSONLIterator(stream, rel_seek=0.5)
+        results = list(jsonl_iter)
+        assert results == [{"c": 3}]

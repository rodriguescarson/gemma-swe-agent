+import pytest
+from boltons.iterutils import split_iter
+
+def test_maxsplit_zero_returns_unsplit_values():
+    # Test with list input
+    src_list = [1, None, 2]
+    result_list = list(split_iter(src_list, sep=None, maxsplit=0))
+    assert result_list == [[1, None, 2]]
+
+    # Test with iterator input
+    src_iter = iter([1, None, 2])
+    result_iter = list(split_iter(src_iter, sep=None, maxsplit=0))
+    assert result_iter == [[1, None, 2]]

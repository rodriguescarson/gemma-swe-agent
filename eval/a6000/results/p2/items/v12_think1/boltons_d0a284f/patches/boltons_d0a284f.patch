+from boltons.setutils import IndexedSet
+import pytest
+
+def test_iset_slice_after_removal():
+    iset = IndexedSet([1, 2, 3, 4, 5])
+    iset.remove(2) # [1, 3, 4, 5]
+    # Apparent indices: 0:1, 1:3, 2:4, 3:5
+    # Slicing [1:3] should be [3, 4]
+    result = list(iset[1:3])
+    print(f"Slice [1:3] after remove(2): {result}")
+    assert result == [3, 4]
+
+def test_iset_scalar_index_bounds():
+    iset = IndexedSet([1, 2, 3, 4, 5, 6, 7, 8, 9])
+    # len(iset) == 9
+    # iset[-10] should raise IndexError
+    print("Testing iset[-10]...")
+    try:
+        _ = iset[-10]
+    except IndexError:
+        print("Caught expected IndexError for iset[-10]")
+    except Exception as e:
+        print(f"Caught unexpected exception for iset[-10]: {type(e).__name__}: {e}")
+    else:
+        print("FAILED: iset[-10] did not raise IndexError")
+
+def test_iset_scalar_index_wrap():
+    iset = IndexedSet([1, 2, 3])
+    # len(iset) == 3
+    # iset[-4] should raise IndexError, not return iset[-1]
+    print("Testing iset[-4]...")
+    try:
+        _ = iset[-4]
+    except IndexError:
+        print("Caught expected IndexError for iset[-4]")
+    except Exception as e:
+        print(f"Caught unexpected exception for iset[-4]: {type(e).__name__}: {e}")
+    else:
+        print("FAILED: iset[-4] did not raise IndexError")
+
+if __name__ == "__main__":
+    try:
+        test_iset_slice_after_removal()
+        print("test_iset_slice_after_removal passed")
+    except Exception as e:
+        print(f"test_iset_slice_after_removal failed: {e}")
+
+    try:
+        test_iset_scalar_index_bounds()
+        print("test_iset_scalar_index_bounds passed")
+    except Exception as e:
+        print(f"test_iset_scalar_index_bounds failed: {e}")
+
+    try:
+        test_iset_scalar_index_wrap()
+        print("test_iset_scalar_index_wrap passed")
+    except Exception as e:
+        print(f"test_iset_scalar_index_wrap failed: {e}")

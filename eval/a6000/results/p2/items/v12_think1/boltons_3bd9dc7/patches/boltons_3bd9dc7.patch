+
+from boltons.cacheutils import LRI
+
+def test_lri_bug():
+    # max_size=2
+    cache = LRI(max_size=2)
+    
+    # Fill cache
+    cache['a'] = 1
+    cache['a'] = 2  # queue: ['a', 'a'], dict: {'a': 2}
+    
+    cache['b'] = 3  # queue: ['a', 'a', 'b'], dict: {'a': 2, 'b': 3}
+    
+    # Now cache is full (len=2). Adding 'c' should evict the first item in queue ('a').
+    # queue: ['a', 'b', 'c'], dict: {'b': 3, 'c': 4}
+    cache['c'] = 4  # queue.popleft() -> 'a', del cache['a'].
+    
+    # Now cache is still full (len=2). Adding 'd' should evict the next item in queue ('a').
+    # But 'a' was already deleted! This should raise KeyError.
+    try:
+        cache['d'] = 5
+    except KeyError:
+        print("Caught expected KeyError!")
+    else:
+        print("Failed to reproduce KeyError")
+
+if __name__ == "__main__":
+    test_lri_bug()

diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..1fed561
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,36 @@
+import pickle
+import attr
+
+@attr.s(slots=True)
+class TestClass:
+    a = attr.ib()
+    b = attr.ib()
+
+# Manually test the current __setstate__ with a tuple
+obj = TestClass(a=1, b=2)
+print(f"Initial object: {obj}")
+
+# Simulating old pickle: state is a tuple
+old_state = (10, 20)
+try:
+    obj.__setstate__(old_state)
+    print(f"After tuple __setstate__: {obj}")
+    if obj.a == 10 and obj.b == 20:
+        print("Successfully set state from tuple!")
+    else:
+        print("Failed to set state from tuple: values not updated")
+except Exception as e:
+    print(f"Failed to set state from tuple: {type(e).__name__}: {e}")
+
+# Now try the current way (dict)
+obj = TestClass(a=1, b=2)
+new_state = {'a': 100, 'b': 200}
+try:
+    obj.__setstate__(new_state)
+    print(f"After dict __setstate__: {obj}")
+    if obj.a == 100 and obj.b == 200:
+        print("Successfully set state from dict!")
+    else:
+        print("Failed to set state from dict: values not updated")
+except Exception as e:
+    print(f"Failed to set state from dict: {type(e).__name__}: {e}")

--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,16 @@
+import attr
+
+@attr.define(slots=True)
+class MyClass:
+    a: int = 1
+    b: int = 2
+
+obj = MyClass(a=10, b=20)
+print(f"Original: {obj}")
+
+# Simulate an old pickle state (a tuple)
+old_state = (100, 200)
+obj.__setstate__(old_state)
+print(f"After __setstate__ with tuple: {obj}")
+
+assert obj.a == 100 and obj.b == 200, f"Failed to update state from tuple. obj: {obj}"

diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..e04aebd
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,41 @@
+from boltons.namedutils import namedtuple, namedlist
+
+try:
+    print("Testing namedtuple with empty typename...")
+    namedtuple('', ['a'])
+except IndexError:
+    print("caught IndexError for namedtuple empty typename")
+except ValueError as e:
+    print(f"caught ValueError for namedtuple empty typename: {e}")
+except Exception as e:
+    print(f"caught unexpected exception for namedtuple empty typename: {type(e).__name__}: {e}")
+
+try:
+    print("Testing namedtuple with empty field name...")
+    namedtuple('T', [''])
+except IndexError:
+    print("caught IndexError for namedtuple empty field name")
+except ValueError as e:
+    print(f"caught ValueError for namedtuple empty field name: {e}")
+except Exception as e:
+    print(f"caught unexpected exception for namedtuple empty field name: {type(e).__name__}: {e}")
+
+try:
+    print("Testing namedlist with empty typename...")
+    namedlist('', ['a'])
+except IndexError:
+    print("caught IndexError for namedlist empty typename")
+except ValueError as e:
+    print(f"caught ValueError for namedlist empty typename: {e}")
+except Exception as e:
+    print(f"caught unexpected exception for namedlist empty typename: {type(e).__name__}: {e}")
+
+try:
+    print("Testing namedlist with empty field name...")
+    namedlist('T', [''])
+except IndexError:
+    print("caught IndexError for namedlist empty field name")
+except ValueError as e:
+    print(f"caught ValueError for namedlist empty field name: {e}")
+except Exception as e:
+    print(f"caught unexpected exception for namedlist empty field name: {type(e).__name__}: {e}")

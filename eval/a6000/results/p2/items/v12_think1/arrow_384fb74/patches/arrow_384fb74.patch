diff --git a/verify_locales.py b/verify_locales.py
new file mode 100644
index 0000000..b783499
--- /dev/null
+++ b/verify_locales.py
@@ -0,0 +1,66 @@
+import arrow
+
+def test_maltese():
+    print("Testing Maltese...")
+    t = arrow.get(2023, 10, 23) # A Monday
+    
+    try:
+        assert t.format('dddd', locale='mt') == 'tnejn'
+        print("Day name ok")
+    except AssertionError:
+        print(f"Day name failed: {t.format('dddd', locale='mt')} != tnejn")
+
+    try:
+        assert t.format('MMMM', locale='mt') == 'Ottubru'
+        print("Month name ok")
+    except AssertionError:
+        print(f"Month name failed: {t.format('MMMM', locale='mt')} != Ottubru")
+
+    try:
+        assert t.format('MMM', locale='mt') == 'Ott'
+        print("Month abbreviation ok")
+    except AssertionError:
+        print(f"Month abbreviation failed: {t.format('MMM', locale='mt')} != Ott")
+
+    try:
+        assert t.format('ddd', locale='mt') == 'tnejn'
+        print("Day abbreviation ok")
+    except AssertionError:
+        print(f"Day abbreviation failed: {t.format('ddd', locale='mt')} != tnejn")
+
+    print("Testing Maltese humanize...")
+    t_now = arrow.get(2023, 10, 23)
+    t_past = arrow.get(2023, 10, 20) # 3 days before
+    try:
+        delta = t_now.humanize(t_past, locale='mt')
+        print(f"Delta (past): {delta}")
+        assert delta == '3 ġurnati ilu'
+    except AssertionError:
+        print(f"Delta (past) failed: {delta} != 3 ġurnati ilu")
+
+    t_future = arrow.get(2023, 10, 26) # 3 days after
+    try:
+        delta = t_now.humanize(t_future, locale='mt')
+        print(f"Delta (future): {delta}")
+        assert delta == 'sadir 3 ġurnati'
+    except AssertionError:
+        print(f"Delta (future) failed: {delta} != sadir 3 ġurnati")
+
+def test_malay_whitespace():
+    print("Testing Malay...")
+    t = arrow.get(2023, 10, 22) # A Sunday
+    try:
+        assert t.format('dddd', locale='ms') == 'Ahad'
+        print("Day name ok")
+    except AssertionError:
+        print(f"Day name failed: {t.format('dddd', locale='ms')} != Ahad")
+
+    try:
+        assert t.format('ddd', locale='ms') == 'Ahad'
+        print("Day abbreviation ok")
+    except AssertionError:
+        print(f"Day abbreviation failed: {t.format('ddd', locale='ms')} != Ahad")
+
+if __name__ == "__main__":
+    test_maltese()
+    test_malay_whitespace()

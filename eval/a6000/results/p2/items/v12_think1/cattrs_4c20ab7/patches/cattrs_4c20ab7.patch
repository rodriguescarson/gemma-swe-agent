diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..a30bc58
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,53 @@
+
+import sys
+from typing import Union
+import attrs
+from cattrs import Converter
+from cattrs.strategies._unions import configure_tagged_union
+
+# Only works on Python 3.12+
+if sys.version_info < (3, 12):
+    print("This reproduction requires Python 3.12+")
+    sys.exit(0)
+
+@attrs.define
+class A:
+    x: int
+
+@attrs.define
+class B:
+    y: str
+
+# Recursive type alias
+type Alias1 = Alias2
+type Alias2 = Union[A, B]
+
+converter = Converter()
+try:
+    configure_tagged_union(Alias1, converter)
+    print("Successfully configured!")
+except Exception as e:
+    print(f"Failed to configure: {e}")
+
+# Testing structuring and unstructuring
+try:
+    # Unstructure A
+    a = A(x=1)
+    res = converter.unstructure(a, Alias1)
+    print(f"Unstructured A: {res}")
+    
+    # Structure it back
+    val = converter.structure(res, Alias1)
+    print(f"Structured back: {val}")
+    
+    # Unstructure B
+    b = B(y="hello")
+    res = converter.unstructure(b, Alias1)
+    print(f"Unstructured B: {res}")
+    
+    # Structure it back
+    val = converter.structure(res, Alias1)
+    print(f"Structured back: {val}")
+
+except Exception as e:
+    print(f"Error during unstructure/structure: {e}")

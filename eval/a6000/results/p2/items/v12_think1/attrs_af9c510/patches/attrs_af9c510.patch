diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..da19841
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,50 @@
+from attr import attrs, attrib, validators
+
+@attrs
+class C:
+    x = attrib(validator=validators.instance_of(int))
+
+def test_nesting():
+    print("Testing nested disabled()...")
+    with validators.disabled():
+        print("Entered outer disabled()")
+        with validators.disabled():
+            print("Entered inner disabled()")
+        print("Exited inner disabled()")
+        # At this point, validators should still be disabled because we are in the outer disabled()
+        try:
+            C(x="not_int")
+            print("Success: validator was disabled as expected")
+        except TypeError as e:
+            print(f"Failure: validator was enabled unexpectedly: {e}")
+            raise e
+
+def test_pre_disabled():
+    print("Testing pre-disabled state...")
+    validators.set_run_validators(False)
+    print("Validators disabled manually")
+    try:
+        with validators.disabled():
+            print("Entered disabled()")
+            pass
+        print("Exited disabled()")
+        # At this point, validators should still be disabled because they were disabled before
+        try:
+            C(x="not_int")
+            print("Success: validator remained disabled")
+        except TypeError as e:
+            print(f"Failure: validator was enabled unexpectedly: {e}")
+            raise e
+    finally:
+        validators.set_run_validators(True)
+
+if __name__ == "__main__":
+    try:
+        test_nesting()
+        test_pre_disabled()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed with exception: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

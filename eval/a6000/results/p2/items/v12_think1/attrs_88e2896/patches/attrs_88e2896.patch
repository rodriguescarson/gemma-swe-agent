diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..6f78214
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,15 @@
+import attr
+from functools import cached_property
+
+@attr.s(slots=True)
+class A:
+    @cached_property
+    def foo(self):
+        return 1
+
+a = A()
+print("Testing A.bar")
+try:
+    print(a.bar)
+except AttributeError as e:
+    print(f"Caught: {e}")

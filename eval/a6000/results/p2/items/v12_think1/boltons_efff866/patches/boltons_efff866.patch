diff --git a/boltons/mathutils.py b/boltons/mathutils.py
index 668cda6..eb52cc4 100644
--- a/boltons/mathutils.py
+++ b/boltons/mathutils.py
@@ -160,7 +160,7 @@ class Bits:
         if val < 0:
             raise ValueError('Bits cannot represent negative values')
         if len_ is None:
-            len_ = len(f'{val:b}')
+            len_ = len(f'{val:b}') if val > 0 else 0
         if val >= 2 ** len_:
             raise ValueError(f'value {val} cannot be represented with {len_} bits')
         self.val = val  # data is stored internally as integer
@@ -208,9 +208,13 @@ class Bits:
         return [c == '1' for c in self.as_bin()]
 
     def as_bin(self):
+        if self.len == 0:
+            return ''
         return f'{{0:0{self.len}b}}'.format(self.val)
 
     def as_hex(self):
+        if self.len == 0:
+            return ''
         # make template to pad out to number of bytes necessary to represent bits
         tmpl = f'%0{2 * (self.len // 8 + ((self.len % 8) != 0))}X'
         ret = tmpl % self.val
@@ -234,6 +238,8 @@ class Bits:
     def from_hex(cls, hex):
         if isinstance(hex, bytes):
             hex = hex.decode('ascii')
+        if not hex:
+            return cls(0, 0)
         if not hex.startswith('0x'):
             hex = '0x' + hex
         return cls(hex)

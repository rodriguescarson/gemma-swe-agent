+import arrow
+from datetime import datetime
+
+# Mocking the locales as they might be in the library
+# Since we can't easily change the library's locale definitions in a test script without modifying the files
+# we will use the actual library if it's already modified or just try with the locales mentioned.
+
+try:
+    # Finnish locale
+    arw = arrow.utcnow()
+    # "2 minuuttia sitten" means 2 minutes ago in Finnish
+    # Note: we need to make sure Finnish is in DEHUMANIZE_LOCALES in arrow/constants.py
+    result = arw.dehumanize("2 minuuttia sitten", locale="fi")
+    print(f"Finnish result: {result}")
+except Exception as e:
+    print(f"Finnish error: {e}")
+
+try:
+    # Estonian locale
+    arw = arrow.utcnow()
+    result = arw.dehumanize("2 kuu eel", locale="et")
+    print(f"Estonian result: {result}")
+except Exception as e:
+    print(f"Estonian error: {e}")

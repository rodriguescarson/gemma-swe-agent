diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..9a0bf65
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,62 @@
+
+import re
+import sys
+
+BLACK_VERSION_RE = re.compile(
+    r"^black((?:\s*(?:~=|==|!=|<=|>=|<|>|===)\s*[A-Za-z0-9*+._-]+)"
+    r"(?:\s*,\s*(?:~=|==|!=|<=|>=|<|>|===)\s*[A-Za-z0-9*+._-]+)*)\s*$",
+    re.IGNORECASE,
+)
+EXTRAS_RE = re.compile(r"\[.*\]")
+
+def find_black_version_in_array(array: object) -> str | None:
+    if not isinstance(array, list):
+        return None
+    try:
+        for item in array:
+            if not isinstance(item, str):
+                continue
+            # Rudimentary PEP 508 parsing.
+            item = item.split(";")[0]
+            item = EXTRAS_RE.sub("", item).strip()
+            if item == "black":
+                print(
+                    "::error::Version specifier missing for 'black' dependency in "
+                    "pyproject.toml.",
+                    file=sys.stderr,
+                    flush=True,
+                )
+                sys.exit(1)
+            elif m := BLACK_VERSION_RE.match(item):
+                return m.group(1).strip()
+    except TypeError:
+        pass
+
+    return None
+
+def test_find_black_version_in_array():
+    # This should have crashed before the fix
+    array = ["black>=23.1.0", {"include-group": "test"}]
+    try:
+        version = find_black_version_in_array(array)
+        print(f"Result for mixed array: {version}")
+    except AttributeError as e:
+        print(f"Caught AttributeError: {e}")
+        sys.exit(1)
+
+    # Test with only strings
+    array2 = ["black==23.1.0"]
+    version2 = find_black_version_in_array(array2)
+    print(f"Result for string array: {version2}")
+    assert version2 == "==23.1.0"
+
+    # Test with no black
+    array3 = ["requests"]
+    version3 = find_black_version_in_array(array3)
+    print(f"Result for no black array: {version3}")
+    assert version3 is None
+
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    test_find_black_version_in_array()

@@ -0,0 +1,27 @@
+import io
+import os
+from boltons.jsonutils import JSONLIterator
+
+def test_binary_rel_seek():
+    # Create a binary JSONL file
+    content = b'{"a": 1}\n{"b": 2}\n{"c": 3}\n'
+    with open('test_jsonl.bin', 'wb') as f:
+        f.write(content)
+
+    try:
+        with open('test_jsonl.bin', 'rb') as f:
+            # rel_seek=0.5 should put us somewhere in the middle
+            # and then _align_to_newline should be called.
+            iterator = JSONLIterator(f, rel_seek=0.5)
+            for obj in iterator:
+                print(f"Found object: {obj}")
+    except TypeError as e:
+        print(f"Caught TypeError: {e}")
+        raise e
+    except Exception as e:
+        print(f"Caught unexpected exception: {e}")
+        raise e
+    print("No TypeError raised!")
+
+if __name__ == "__main__":
+    test_binary_rel_seek()

@@ -0,0 +1,24 @@
+import json
+import os
+from boltons.jsonutils import JSONLIterator
+
+def test_binary_seek():
+    content = b'{"a": 1}\n{"b": 2}\n{"c": 3}\n'
+    with open('test_jsonl.bin', 'wb') as f:
+        f.write(content)
+    
+    with open('test_jsonl.bin', 'rb') as f:
+        # rel_seek=0.5 should trigger _align_to_newline
+        it = JSONLIterator(f, rel_seek=0.5)
+        print("Seek successful")
+        for obj in it:
+            print(obj)
+
+    os.remove('test_jsonl.bin')
+
+try:
+    test_binary_seek()
+except Exception as e:
+    import traceback
+    traceback.print_exc()
+    raise e

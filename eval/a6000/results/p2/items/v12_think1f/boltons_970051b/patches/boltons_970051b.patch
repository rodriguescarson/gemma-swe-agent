diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..6239486
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,38 @@
+from boltons.namedutils import namedtuple, namedlist
+
+def test_namedtuple_empty_field():
+    try:
+        namedtuple('Point', ['x', ''])
+    except ValueError as e:
+        print(f"caught expected ValueError: {e}")
+    except Exception as e:
+        print(f"caught unexpected exception: {type(e).__name__}: {e}")
+
+def test_namedtuple_empty_type():
+    try:
+        namedtuple('', ['x', 'y'])
+    except ValueError as e:
+        print(f"caught expected ValueError: {e}")
+    except Exception as e:
+        print(f"caught unexpected exception: {type(e).__name__}: {e}")
+
+def test_namedlist_empty_field():
+    try:
+        namedlist('Point', ['x', ''])
+    except ValueError as e:
+        print(f"caught expected ValueError: {e}")
+    except Exception as e:
+        print(f"caught unexpected exception: {type(e).__name__}: {e}")
+
+def test_namedlist_empty_type():
+    try:
+        namedlist('', ['x', 'y'])
+    except ValueError as e:
+        print(f"caught expected ValueError: {e}")
+    except Exception as e:
+        print(f"caught unexpected exception: {type(e).__name__}: {e}")
+
+test_namedtuple_empty_field()
+test_namedtuple_empty_type()
+test_namedlist_empty_field()
+test_namedlist_empty_type()
diff --git a/repro_rename.py b/repro_rename.py
new file mode 100644
index 0000000..8cf5be2
--- /dev/null
+++ b/repro_rename.py
@@ -0,0 +1,15 @@
+from boltons.namedutils import namedtuple, namedlist
+
+def test_rename():
+    try:
+        Point = namedtuple('Point', ['x', ''], rename=True)
+        p = Point(1, 2)
+        print(f"namedtuple rename success: {p._asdict()}")
+        
+        PointL = namedlist('PointL', ['x', ''], rename=True)
+        pl = PointL(1, 2)
+        print(f"namedlist rename success: {pl._asdict()}")
+    except Exception as e:
+        print(f"unexpected exception: {type(e).__name__}: {e}")
+
+test_rename()

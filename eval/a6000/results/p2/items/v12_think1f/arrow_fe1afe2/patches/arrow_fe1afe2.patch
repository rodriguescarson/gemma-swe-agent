@@ -0,0 +1,27 @@
+import arrow
+from arrow.parser import ParserMatchError
+
+try:
+    # 'hh' is 12-hour clock, 'A' is AM/PM.
+    # 13 AM should be invalid.
+    print(f"Parsing 13 AM with 'hh A': {arrow.get('13 AM', 'hh A')}")
+except Exception as e:
+    print(f"Caught expected error: {e}")
+
+try:
+    # 13 PM should be invalid.
+    print(f"Parsing 13 PM with 'hh A': {arrow.get('13 PM', 'hh A')}")
+except Exception as e:
+    print(f"Caught expected error: {e}")
+
+try:
+    # 0 AM should be invalid for 'hh' (usually 12 AM).
+    print(f"Parsing 0 AM with 'hh A': {arrow.get('0 AM', 'hh A')}")
+except Exception as e:
+    print(f"Caught expected error: {e}")
+
+try:
+    # 13 should be valid for 'HH' (24-hour clock).
+    print(f"Parsing 13 with 'HH': {arrow.get('13', 'HH')}")
+except Exception as e:
+    print(f"Error parsing 13 with 'HH': {e}")

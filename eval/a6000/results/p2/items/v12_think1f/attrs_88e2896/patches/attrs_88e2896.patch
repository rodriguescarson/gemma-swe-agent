@@ -0,0 +1,23 @@
+import attr
+from attr.cached_property import cached_property
+
+@attr.s(slots=True)
+class A:
+    @cached_property
+    def foo(self):
+        return 42
+
+    def __getattr__(self, item):
+        print(f"A.__getattr__ for {item}")
+        try:
+            return super().__getattribute__(item)
+        except AttributeError:
+            if hasattr(super(), '__getattr__'):
+                return super().__getattr__(item)
+            raise
+
+a = A()
+try:
+    print(a.bar)
+except AttributeError as e:
+    print(f"Caught: {e}")

+class LithuanianLocale(Locale):
+    names = ["lt", "lt_lt"]
+
+    past = "{0} prieš"
+    future = "per {0}"
+
+    timeframes: ClassVar[Mapping[TimeFrameLiteral, Union[str, List[str]]]] = {
+        "now": "dabar",
+        "second": "vieną sekundę",
+        "seconds": ["{0} sekundę", "{0} sekundės", "{0} sekundžių"],
+        "minute": "vieną minutę",
+        "minutes": ["{0} minutę", "{0} minutės", "{0} minučių"],
+        "hour": "vieną valandą",
+        "hours": ["{0} valandą", "{0} valandos", "{0} valandų"],
+        "day": "vieną dieną",
+        "days": ["{0} dieną", "{0} dienos", "{0} dienų"],
+        "week": "vieną savaitę",
+        "weeks": ["{0} savaitę", "{0} savaitės", "{0} savaičių"],
+        "month": "vieną mėnesį",
+        "months": ["{0} mėnesį", "{0} mėnesiai", "{0} mėnesių"],
+        "year": "vienus metus",
+        "years": ["{0} metus", "{0} metai", "{0} metų"],
+    }
+
+    meridians = {"am": "ryto", "pm": "vakaro", "AM": "RYTO", "PM": "VAKARO"}
+
+    month_names = [
+        "",
+        "sausis",
+        "vasaris",
+        "kovas",
+        "balandis",
+        "gegužė",
+        "birželis",
+        "liepa",
+        "rugpjūtis",
+        "rugsėjis",
+        "spalis",
+        "listapadis",
+        "gruodis",
+    ]
+    month_abbreviations = ["", "saus.", "vas.", "kov.", "bal.", "geg.", "birž.", "liep.", "rugpj.", "rugs.", "spal.", "list.", "gru."]
+
+    day_names = [
+        "",
+        "pirmadienis",
+        "antradienis",
+        "trečiadienis",
+        "ketvirtadienis",
+        "penktadienis",
+        "šeštadienis",
+        "sekmadienis",
+    ]
+    day_abbreviations = ["", "pirm.", "antr.", "treč.", "ketv.", "penkt.", "šešt.", "sekm."]
+
+    def _format_timeframe(
+        self, timeframe: TimeFrameLiteral, delta: Union[float, int]
+    ) -> str:
+        form = self.timeframes[timeframe]
+        delta = abs(delta)
+
+        if isinstance(form, list):
+            if delta == 1:
+                form = form[0]
+            elif 2 <= delta % 10 <= 9 and delta % 100 not in (11, 12, 13):
+                form = form[1]
+            else:
+                form = form[2]
+
+        return form.format(delta)
+
+
 class MacedonianLocale(SlavicBaseLocale):
     names = ["mk", "mk_mk"]
 

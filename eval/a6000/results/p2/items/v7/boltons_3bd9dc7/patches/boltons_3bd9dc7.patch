diff --git a/tests/test_lri_issue.py b/tests/test_lri_issue.py
new file mode 100644
index 0000000..259b369
--- /dev/null
+++ b/tests/test_lri_issue.py
@@ -0,0 +1,40 @@
+import pytest
+from boltons.cacheutils import LRI
+
+def test_lri_update_existing_key():
+    # LRI should not increase size when updating an existing key
+    cache = LRI(max_size=2)
+    cache['a'] = 1
+    cache['b'] = 2
+    assert len(cache) == 2
+    cache['a'] = 3
+    assert len(cache) == 2
+    cache['c'] = 3
+    assert len(cache) == 2
+    assert 'b' not in cache
+    assert 'a' in cache
+    assert 'c' in cache
+
+def test_lri_pop_support():
+    # LRI currently doesn't support pop/popitem well according to TODOs
+    cache = LRI(max_size=2)
+    cache['a'] = 1
+    cache['b'] = 2
+    # This might fail or behave unexpectedly
+    val = cache.pop('a')
+    assert val == 1
+    assert len(cache) == 1
+    assert 'a' not in cache
+
+def test_lri_del_support():
+    cache = LRI(max_size=2)
+    cache['a'] = 1
+    cache['b'] = 2
+    del cache['a']
+    assert len(cache) == 1
+    cache['c'] = 3
+    cache['d'] = 4
+    # If 'a' was deleted, 'b' should be the oldest
+    assert 'b' not in cache
+    assert 'c' in cache
+    assert 'd' in cache

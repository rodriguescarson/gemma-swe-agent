@@ -0,0 +1,38 @@
+from typing import Union, Any
+from cattrs import Converter
+from cattrs.strategies import configure_tagged_union
+
+class A:
+    def __init__(self, a: int):
+        self.a = a
+    def __repr__(self):
+        return f"A({self.a})"
+    def __eq__(self, other):
+        return isinstance(other, A) and self.a == other.a
+
+class B:
+    def __init__(self, b: str):
+        self.b = b
+    def __repr__(self):
+        return f"B({self.b})"
+    def __eq__(self, other):
+        return isinstance(other, B) and self.b == other.b
+
+# Recursive type alias
+type Recursive = A | B | list["Recursive"]
+
+converter = Converter()
+converter.register_structure_hook(A, lambda v, c: A(v['a']))
+converter.register_structure_hook(B, lambda v, c: B(v['b']))
+
+# We need to register the tagged union strategy FIRST, but the strategy 
+# itself calls get_structure_hook for each member of the union.
+# If one of the members is a recursive reference to the alias, 
+# it will fail because the hook for the alias isn't registered yet.
+
+try:
+    configure_tagged_union(Recursive, converter)
+    print("Success")
+except Exception as e:
+    import traceback
+    traceback.print_exc()

--- /dev/null
+++ b/repro.py
@@ -0,0 +1,36 @@
+import pytest
+from boltons.namedutils import namedtuple, namedlist
+
+def test_empty_type_name_raises_value_error():
+    for factory in [namedtuple, namedlist]:
+        with pytest.raises(ValueError) as excinfo:
+            factory('', ['x'])
+        assert 'must be non-empty' in str(excinfo.value)
+
+def test_empty_field_name_raises_value_error():
+    for factory in [namedtuple, namedlist]:
+        with pytest.raises(ValueError) as excinfo:
+            factory('Point', ['x', ''])
+        assert 'must be non-empty' in str(excinfo.value)
+
+def test_invalid_char_raises_value_error():
+    for factory in [namedtuple, namedlist]:
+        with pytest.raises(ValueError) as excinfo:
+            factory('Point', ['x-y'])
+        assert 'can only contain alphanumeric characters and underscores' in str(excinfo.value)
+
+def test_valid_names_accepted():
+    for factory in [namedtuple, namedlist]:
+        factory('Point', ['x', 'y'])
+
+if __name__ == "__main__":
+    # Run tests manually since we are in a script
+    try:
+        test_empty_type_name_raises_value_error()
+        test_empty_field_name_raises_value_error()
+        test_invalid_char_raises_value_error()
+        test_valid_names_accepted()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e
diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 0000000..efbd556
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,48 @@
+
+from boltons.namedutils import namedtuple, namedlist
+import pytest
+
+def test_namedtuple_empty_field_name():
+    with pytest.raises(ValueError) as excinfo:
+        namedtuple('Point', ['x', ''])
+    assert 'must be non-empty' in str(excinfo.value)
+
+def test_namedtuple_empty_type_name():
+    with pytest.raises(ValueError) as excinfo:
+        namedtuple('', ['x', 'y'])
+    assert 'must be non-empty' in str(excinfo.value)
+
+def test_namedtuple_invalid_char():
+    with pytest.raises(ValueError) as excinfo:
+        namedtuple('Point', ['x-y'])
+    assert 'can only contain alphanumeric characters and underscores' in str(excinfo.value)
+
+def test_namedtuple_valid():
+    Point = namedtuple('Point', ['x', 'y'])
+    p = Point(1, 2)
+    assert p.x == 1
+    assert p.y == 2
+
+def test_namedlist_empty_field_name():
+    with pytest.raises(ValueError) as excinfo:
+        namedlist('Point', ['x', ''])
+    assert 'must be non-empty' in str(excinfo.value)
+
+def test_namedlist_empty_type_name():
+    with pytest.raises(ValueError) as excinfo:
+        namedlist('', ['x', 'y'])
+    assert 'must be non-empty' in str(excinfo.value)
+
+def test_namedlist_invalid_char():
+    with pytest.raises(ValueError) as excinfo:
+        namedlist('Point', ['x-y'])
+    assert 'can only contain alphanumeric characters and underscores' in str(excinfo.value)
+
+def test_namedlist_valid():
+    Point = namedlist('Point', ['x', 'y'])
+    p = Point(1, 2)
+    assert p.x == 1
+    assert p.y == 2
+
+if __name__ == "__main__":
+    pytest.main([__file__])

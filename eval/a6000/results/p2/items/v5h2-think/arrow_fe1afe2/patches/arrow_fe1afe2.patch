new file mode 100644
index 0000000..27d20e6
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,26 @@
+
+import arrow
+from arrow.parser import ParserMatchError
+from datetime import datetime
+
+def test_invalid_hour_with_am_pm():
+    try:
+        # This should probably raise ParserMatchError according to the issue
+        arrow.get("13 am", "h a")
+        print("Failed: 13 am did not raise error")
+    except ParserMatchError:
+        print("Success: 13 am raised ParserMatchError")
+    except Exception as e:
+        print(f"Raised unexpected exception: {type(e).__name__}: {e}")
+
+    try:
+        # This should probably raise ParserMatchError according to the issue
+        arrow.get("13 pm", "h a")
+        print("Failed: 13 pm did not raise error")
+    except ParserMatchError:
+        print("Success: 13 pm raised ParserMatchError")
+    except Exception as e:
+        print(f"Raised unexpected exception: {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    test_invalid_hour_with_am_pm()

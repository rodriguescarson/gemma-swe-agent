@@ -0,0 +1,23 @@
+
+import os
+from boltons.jsonutils import JSONLIterator
+
+def test_binary_rel_seek():
+    with open('test_binary.jsonl', 'wb') as f:
+        f.write(b'{"1": 1}\n{"2": 2}\n{"3": 3}\n')
+    
+    try:
+        with open('test_binary.jsonl', 'rb') as f:
+            print("Attempting rel_seek on binary stream...")
+            list(JSONLIterator(f, rel_seek=0.5))
+            print("Success!")
+    except TypeError as e:
+        print(f"Caught expected TypeError: {e}")
+    except Exception as e:
+        print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+    finally:
+        if os.path.exists('test_binary.jsonl'):
+            os.remove('test_binary.jsonl')
+
+if __name__ == '__main__':
+    test_binary_rel_seek()

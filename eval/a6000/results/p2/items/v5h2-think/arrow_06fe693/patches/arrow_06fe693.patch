diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..b816ae2
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,29 @@
+
+import arrow
+from datetime import datetime
+from dateutil import tz
+
+# Test 1: Arrow object
+arw = arrow.utcnow()
+tz_pacific = tz.gettz("US/Pacific")
+result = arrow.get(arw, tzinfo=tz_pacific)
+print(f"Arrow: {arw.tzinfo} -> {result.tzinfo}")
+assert result.tzinfo == tz_pacific
+
+# Test 2: datetime object
+dt = datetime.utcnow().replace(tzinfo=tz.tzutc())
+result = arrow.get(dt, tzinfo=tz_pacific)
+print(f"datetime: {dt.tzinfo} -> {result.tzinfo}")
+assert result.tzinfo == tz_pacific
+
+# Test 3: date object
+from datetime import date
+d = date.today()
+result = arrow.get(d, tzinfo=tz_pacific)
+print(f"date: {result.tzinfo}")
+assert result.tzinfo == tz_pacific
+
+# Test 4: ISO calendar tuple
+result = arrow.get((2013, 18, 7), tzinfo=tz_pacific)
+print(f"tuple: {result.tzinfo}")
+assert result.tzinfo == tz_pacific

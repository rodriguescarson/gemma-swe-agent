diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..aba61d7
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,29 @@
+
+import sys
+from action.main import find_black_version_in_array
+
+def test_find_black_version_in_array():
+    # Case 1: Normal string array
+    assert find_black_version_in_array(["black==23.1.0"]) == "23.1.0"
+    
+    # Case 2: Array with include-group (dict)
+    # This is what caused the crash
+    assert find_black_version_in_array([{"include-group": "lint"}, "black==23.1.0"]) == "23.1.0"
+    
+    # Case 3: Array with only include-group
+    assert find_black_version_in_array([{"include-group": "lint"}]) is None
+    
+    # Case 4: Array with other types
+    assert find_black_version_in_array([123, None, "black==23.1.0"]) == "23.1.0"
+    
+    # Case 5: Not a list
+    assert find_black_version_in_array("not a list") is None
+    
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    try:
+        test_find_black_version_in_array()
+    except Exception as e:
+        print(f"Test failed: {e}")
+        sys.exit(1)

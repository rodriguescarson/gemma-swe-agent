diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..f335476
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,9 @@
+from boltons.urlutils import URL
+
+try:
+    url = URL('http://example.com/a/b').navigate('c').navigate('d')
+    print("Success:", url)
+except TypeError as e:
+    print("Caught expected TypeError:", e)
+except Exception as e:
+    print("Caught unexpected exception:", type(e), e)
diff --git a/repro_list.py b/repro_list.py
new file mode 100644
index 0000000..d6436fc
--- /dev/null
+++ b/repro_list.py
@@ -0,0 +1,9 @@
+from boltons.urlutils import URL
+
+url = URL('http://example.com/a/b')
+url.path_parts = ['a', 'b'] # Manually set to list
+try:
+    url.navigate('c')
+    print("Success")
+except TypeError as e:
+    print("Caught expected TypeError:", e)
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..68b8d1d
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,14 @@
+
+from boltons.urlutils import URL
+
+def reproduce():
+    try:
+        url = URL('http://example.com/a/b').navigate('c').navigate('d')
+        print("Success!")
+        print(f"Result: {url}")
+    except TypeError as e:
+        print(f"Caught expected TypeError: {e}")
+        raise e
+
+if __name__ == "__main__":
+    reproduce()

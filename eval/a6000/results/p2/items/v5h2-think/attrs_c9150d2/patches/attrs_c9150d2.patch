index 0000000..d62d781
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,31 @@
+import attr
+import pickle
+
+@attr.s(slots=True)
+class C:
+    x = attr.ib()
+    y = attr.ib()
+
+def test_backward_compatibility():
+    c = C(1, 2)
+    print(f"Before: x={c.x}, y={c.y}")
+    
+    # Simulate old pickle state (tuple)
+    state = (10, 20)
+    try:
+        c.__setstate__(state)
+        print(f"After: x={c.x}, y={c.y}")
+    except Exception as e:
+        print(f"Error: {e}")
+
+    assert c.x == 10
+    assert c.y == 20
+
+if __name__ == "__main__":
+    try:
+        test_backward_compatibility()
+        print("Test passed!")
+    except AssertionError:
+        print("Test failed: values were not updated")
+    except Exception as e:
+        print(f"Test failed with error: {e}")

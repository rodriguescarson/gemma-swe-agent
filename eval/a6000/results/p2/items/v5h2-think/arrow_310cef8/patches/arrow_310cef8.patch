+++ b/repro.py
@@ -0,0 +1,22 @@
+import arrow
+
+locales_to_test = ["fi", "fi-fi", "ne", "ne-np", "ee", "et", "zu", "zu-za"]
+
+for loc in locales_to_test:
+    try:
+        # We don't care if it actually parses the string correctly, 
+        # just that it doesn't raise the "Dehumanize does not currently support" ValueError.
+        # We use a dummy string.
+        arrow.utcnow().dehumanize("dummy", locale=loc)
+    except ValueError as e:
+        if "Dehumanize does not currently support" in str(e):
+            print(f"FAILED: Locale {loc} is not supported")
+            exit(1)
+        else:
+            # Other ValueErrors might be expected because "dummy" is not a valid relative time string
+            pass
+    except Exception as e:
+        # Other exceptions might be expected because "dummy" is not a valid relative time string
+        pass
+
+print("SUCCESS: All locales are supported by dehumanize")

+++ b/repro.py
@@ -0,0 +1,69 @@
+
+import click
+import tomllib
+import os
+from src.black.__init__ import read_pyproject_toml
+
+class MockParam:
+    def __init__(self, name):
+        self.name = name
+
+def test_read_pyproject_toml_validation():
+    # Mock click context and command
+    class MockCommand:
+        def __init__(self):
+            self.params = [MockParam("include"), MockParam("force-exclude")]
+
+    class MockContext:
+        def __init__(self):
+            self.params = {}
+            self.default_map = {}
+            self.command = MockCommand()
+    
+    ctx = MockContext()
+    
+    # Test invalid include (list instead of string)
+    with open("pyproject.toml", "w") as f:
+        f.write('[tool.black]\ninclude = ["some_regex"]\n')
+    
+    try:
+        read_pyproject_toml(ctx, None, "pyproject.toml")
+    except click.BadOptionUsage as e:
+        assert "Config key include must be a string" in str(e)
+        print("Successfully rejected invalid include")
+    except Exception as e:
+        print(f"Unexpected exception for include: {type(e).__name__}: {e}")
+        raise e
+    else:
+        print("Failed to reject invalid include")
+        raise AssertionError("Failed to reject invalid include")
+
+    # Test invalid force_exclude (list instead of string)
+    with open("pyproject.toml", "w") as f:
+        f.write('[tool.black]\nforce_exclude = ["some_regex"]\n')
+    
+    try:
+        read_pyproject_toml(ctx, None, "pyproject.toml")
+    except click.BadOptionUsage as e:
+        assert "Config key force-exclude must be a string" in str(e)
+        print("Successfully rejected invalid force_exclude")
+    except Exception as e:
+        print(f"Unexpected exception for force_exclude: {type(e).__name__}: {e}")
+        raise e
+    else:
+        print("Failed to reject invalid force_exclude")
+        raise AssertionError("Failed to reject invalid force_exclude")
+
+    # Test valid string values
+    with open("pyproject.toml", "w") as f:
+        f.write('[tool.black]\ninclude = "some_regex"\nforce_exclude = "another_regex"\n')
+    
+    try:
+        read_pyproject_toml(ctx, None, "pyproject.toml")
+        print("Successfully accepted valid string values")
+    except Exception as e:
+        print(f"Unexpected exception for valid values: {type(e).__name__}: {e}")
+        raise e
+
+if __name__ == "__main__":
+    test_read_pyproject_toml_validation()

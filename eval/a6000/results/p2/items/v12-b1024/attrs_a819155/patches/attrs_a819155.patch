--- /dev/null
+++ b/reproduction.py
@@ -0,0 +1,38 @@
+import timeit
+from attr import define, field
+
+@define(frozen=True, slots=True)
+class Small:
+    a: int = 1
+
+@define(frozen=True, slots=True)
+class Large:
+    a: int = 1
+    b: int = 2
+    c: int = 3
+    d: int = 4
+    e: int = 5
+    f: int = 6
+    g: int = 7
+    h: int = 8
+    i: int = 9
+    j: int = 10
+    k: int = 11
+    l: int = 12
+    m: int = 13
+    n: int = 14
+    o: int = 15
+    p: int = 16
+    q: int = 17
+    r: int = 18
+    s: int = 19
+    t: int = 20
+
+def test_small():
+    Small()
+
+def test_large():
+    Large()
+
+print(f"Small: {timeit.timeit(test_small, number=1000000):.4f}")
+print(f"Large: {timeit.timeit(test_large, number=1000000):.4f}")

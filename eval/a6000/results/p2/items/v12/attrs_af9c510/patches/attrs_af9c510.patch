new file mode 100644
index 0000000..be76ddf
--- /dev/null
+++ b/debug_config.py
@@ -0,0 +1,10 @@
+from attr import _config as config1
+from attr.validators import disabled
+from attr._config import _run_validators as rv1
+
+print(f"Initial rv1: {rv1}")
+with disabled():
+    from attr import _config as config2
+    print(f"Inside disabled, config1._run_validators: {config1._run_validators}")
+    print(f"Inside disabled, config2._run_validators: {config2._run_validators}")
+print(f"After disabled, rv1: {rv1}")

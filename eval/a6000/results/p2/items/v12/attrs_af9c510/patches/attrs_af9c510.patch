new file mode 100644
index 0000000..2d98531
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,18 @@
+from attr import attrs, validators
+from attr.validators import disabled
+
+@attrs
+class C:
+    x = validators.instance_of(int)
+
+try:
+    with disabled():
+        with disabled():
+            pass
+        # BUG: validators are now ENABLED even though we're still in the outer disabled()
+        C(x="not_int")
+        print("Success: validator is still disabled")
+except TypeError:
+    print("Failure: validator was enabled unexpectedly")
+    import sys
+    sys.exit(1)

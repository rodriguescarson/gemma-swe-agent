+
+from click.testing import CliRunner
+import click
+import os
+
+def workers_callback(ctx, param, value):
+    if value is None:
+        return None
+    
+    source = ctx.get_parameter_source(param.name)
+    env_var_name = param.envvar if hasattr(param, 'envvar') else "the environment variable"
+    
+    try:
+        ivalue = int(value)
+    except (ValueError, TypeError):
+        if source == click.core.ParameterSource.ENVIRONMENT:
+            raise click.BadParameter(f"Malformed value for {env_var_name}: {value}")
+        raise click.BadParameter(f"Invalid value for {param.name}: {value}")
+
+    if ivalue < 1:
+        if source == click.core.ParameterSource.ENVIRONMENT:
+            raise click.BadParameter(f"Value for {env_var_name} must be at least 1: {value}")
+        raise click.BadParameter(f"Invalid value for {param.name}: {value}")
+        
+    return ivalue
+
+@click.command()
+@click.option("--workers", type=str, default=None, envvar="BLACK_NUM_WORKERS", callback=workers_callback)
+def test_workers(workers):
+    click.echo(f"Workers: {workers}")
+
+if __name__ == "__main__":
+    runner = CliRunner()
+
+    # Test case 3: Env var set to invalid value (0)
+    print("Case 3: Env var set to 0")
+    result = runner.invoke(test_workers, [], env={"BLACK_NUM_WORKERS": "0"})
+    print(f"Exit code: {result.exit_code}")
+    print(f"Output: {result.output}")
+
+    # Test case 4: Env var set to malformed value
+    print("\nCase 4: Env var set to 'abc'")
+    result = runner.invoke(test_workers, [], env={"BLACK_NUM_WORKERS": "abc"})
+    print(f"Exit code: {result.exit_code}")
+    print(f"Output: {result.output}")
+
+    # Test case 5: CLI set to invalid value (0)
+    print("\nCase 5: CLI set to 0")
+    result = runner.invoke(test_workers, ["--workers", "0"])
+    print(f"Exit code: {result.exit_code}")
+    print(f"Output: {result.output}")

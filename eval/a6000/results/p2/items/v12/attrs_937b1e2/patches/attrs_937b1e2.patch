+import attr
+
+class Base:
+    def __attrs_pre_init__(self, **kwargs):
+        print(f"Base pre-init: {kwargs}")
+
+@attr.s
+class Child(Base):
+    x: int = 1
+
+print("Instantiating Child with x=2:")
+c = Child(x=2)
+print("Done.")

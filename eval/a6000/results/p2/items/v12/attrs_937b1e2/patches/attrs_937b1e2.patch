@@ -0,0 +1,15 @@
+import attr
+
+@attr.s
+class A:
+    x = attr.ib()
+    def __attrs_pre_init__(self):
+        print("Pre-init called")
+
+try:
+    a = A(x=1)
+    print("Success")
+except TypeError as e:
+    print(f"Caught expected TypeError: {e}")
+except Exception as e:
+    print(f"Caught unexpected exception: {type(e).__name__}: {e}")

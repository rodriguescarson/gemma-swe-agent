diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..c7b52ce
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,15 @@
+import attr
+from functools import cached_property
+
+@attr.s(slots=True)
+class A:
+    @cached_property
+    def x(self):
+        return 1
+
+a = A()
+print(f"a.x: {a.x}")
+try:
+    print(a.y)
+except AttributeError as e:
+    print(f"Caught: {e}")

--- /dev/null
+++ b/repro_base.py
@@ -0,0 +1,19 @@
+import attr
+from functools import cached_property
+
+class Base:
+    def __getattr__(self, name):
+        raise AttributeError("Base getattr called")
+
+@attr.s(slots=True)
+class A(Base):
+    @cached_property
+    def x(self):
+        return 1
+
+a = A()
+print(f"a.x: {a.x}")
+try:
+    print(a.y)
+except AttributeError as e:
+    print(f"Caught: {e}")
diff --git a/repro_custom_getattribute.py b/repro_custom_getattribute.py
new file mode 100644
index 0000000..49ad724
--- /dev/null
+++ b/repro_custom_getattribute.py
@@ -0,0 +1,25 @@
+import attr
+from functools import cached_property
+
+class A:
+    __slots__ = ('x',)
+    def __getattribute__(self, name):
+        if name == 'y':
+            raise AttributeError("Custom getattribute error")
+        return super().__getattribute__(name)
+
+# We need to make A an attrs class. 
+# But we already defined A. 
+# Let's use attr.s on a new class that inherits from A.
+
+@attr.s(slots=True)
+class B(A):
+    @cached_property
+    def x(self):
+        return 1
+
+b = B()
+try:
+    print(b.y)
+except AttributeError as e:
+    print(f"Caught: {e}")

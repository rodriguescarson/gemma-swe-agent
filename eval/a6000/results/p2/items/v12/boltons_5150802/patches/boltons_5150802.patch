diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..2cef481
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,18 @@
+
+from boltons.jsonutils import JSONLIterator
+import io
+
+data = b'{"a": 1}\n{"b": 2}\n'
+fo = io.BytesIO(data)
+try:
+    JSONLIterator(fo, rel_seek=1.0)
+    print("Success: rel_seek=1.0 accepted")
+except ValueError as e:
+    print(f"Failure: rel_seek=1.0 rejected: {e}")
+
+fo.seek(0)
+try:
+    JSONLIterator(fo, rel_seek=-1.0)
+    print("Success: rel_seek=-1.0 accepted")
+except ValueError as e:
+    print(f"Failure: rel_seek=-1.0 rejected: {e}")

+from boltons.mathutils import Bits
+import binascii
+
+def test_empty_bits():
+    print("Testing empty Bits...")
+    # Issue 1: An empty Bits value serializes as a one-bit zero
+    # If we want an empty Bits object, we can use Bits(0, 0) or Bits('')
+    b_empty = Bits(0, 0)
+    print(f"Bits(0, 0): len={b_empty.len}, bin={b_empty.as_bin()}")
+    
+    # The problem says "An empty Bits value serializes as a one-bit zero"
+    # This might mean Bits(0) is considered empty by some, but it has len=1.
+    b_zero = Bits(0)
+    print(f"Bits(0): len={b_zero.len}, bin={b_zero.as_bin()}")
+
+    # Issue 2: byte conversion raises an odd-length hex error
+    try:
+        print(f"Bits(0, 0).as_hex(): {b_empty.as_hex()}")
+        print(f"Bits(0, 0).as_bytes(): {b_empty.as_bytes()}")
+    except Exception as e:
+        print(f"Bits(0, 0) conversion failed: {e}")
+
+    # Issue 3: allow empty hex and byte inputs to round-trip
+    try:
+        b_from_hex = Bits.from_hex('')
+        print(f"Bits.from_hex(''): len={b_from_hex.len}, bin={b_from_hex.as_bin()}")
+    except Exception as e:
+        print(f"Bits.from_hex('') failed: {e}")
+
+    try:
+        b_from_bytes = Bits.from_bytes(b'')
+        print(f"Bits.from_bytes(b''): len={b_from_bytes.len}, bin={b_from_bytes.as_bin()}")
+    except Exception as e:
+        print(f"Bits.from_bytes(b'') failed: {e}")
+
+if __name__ == '__main__':
+    test_empty_bits()

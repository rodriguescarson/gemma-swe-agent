diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..02601df
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,16 @@
+import arrow
+from arrow.parser import ParserMatchError
+
+try:
+    # This should probably fail if we are using 12-hour clock tokens
+    # 'hh' is 12-hour clock, 'A' is AM/PM
+    res = arrow.get("13:00 AM", "hh:mm A")
+    print(f"Parsed 13:00 AM as: {res}")
+except Exception as e:
+    print(f"Error parsing 13:00 AM: {e}")
+
+try:
+    res = arrow.get("13:00 PM", "hh:mm A")
+    print(f"Parsed 13:00 PM as: {res}")
+except Exception as e:
+    print(f"Error parsing 13:00 PM: {e}")

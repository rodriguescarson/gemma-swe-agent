new file mode 100644
index 0000000..1e18b91
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,51 @@
+
+from typing import Annotated, List, TypeVar, Generic
+import attr
+from cattrs import Converter
+
+T = TypeVar("T")
+
+@attr.s
+class MyClass(Generic[T]):
+    x: Annotated[List[T], "metadata"] = attr.ib()
+
+def test_annotated_generic_unstructure():
+    converter = Converter()
+    # Generate unstructure function for MyClass[int]
+    # This should trigger make_dict_unstructure_fn
+    unstructure_fn = converter.unstructure
+    
+    # We need to force the generation of the specialized function.
+    # In cattrs, this happens when we call unstructure on an instance of the class.
+    
+    @attr.s
+    class MyClassInt(MyClass[int]):
+        pass
+    
+    instance = MyClassInt(x=[1, 2, 3])
+    result = converter.unstructure(instance)
+    print(f"Result: {result}")
+    assert result == {"x": [1, 2, 3]}
+
+def test_annotated_generic_structure():
+    converter = Converter()
+    
+    @attr.s
+    class MyClassInt(MyClass[int]):
+        pass
+    
+    # This should trigger make_dict_structure_fn
+    result = converter.structure({"x": [1, 2, 3]}, MyClassInt)
+    print(f"Result: {result}")
+    assert result.x == [1, 2, 3]
+
+if __name__ == "__main__":
+    try:
+        test_annotated_generic_unstructure()
+        print("test_annotated_generic_unstructure passed")
+        test_annotated_generic_structure()
+        print("test_annotated_generic_structure passed")
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
+        exit(1)

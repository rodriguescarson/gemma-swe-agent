@@ -0,0 +1,12 @@
+import arrow
+from datetime import datetime
+
+# US/Pacific DST end: 2023-11-05 02:00:00 -> 01:00:00
+# 01:00 occurs twice.
+start = datetime(2023, 11, 5, 0, 0)
+end = datetime(2023, 11, 5, 4, 0)
+tz = 'US/Pacific'
+
+print(f"Range in {tz}:")
+for r in arrow.Arrow.range('hour', start, end, tz=tz):
+    print(repr(r))

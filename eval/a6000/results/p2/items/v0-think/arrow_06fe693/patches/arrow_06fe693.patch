diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..5140384
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,39 @@
+import arrow
+from datetime import datetime, date
+from dateutil import tz
+
+def test_tzinfo_kwarg():
+    # Case 1: datetime with tzinfo kwarg
+    dt = datetime(2023, 1, 1)
+    arw = arrow.get(dt, tzinfo='US/Pacific')
+    print(f"Case 1: {arw}")
+    assert arw.tzinfo.utcoffset(None).total_seconds() != 0
+
+    # Case 2: Arrow object with tzinfo kwarg
+    arw_orig = arrow.utcnow()
+    arw = arrow.get(arw_orig, tzinfo='US/Pacific')
+    print(f"Case 2: {arw}")
+    assert arw.tzinfo.utcoffset(None).total_seconds() != 0
+
+    # Case 3: date with tzinfo kwarg
+    d = date(2023, 1, 1)
+    arw = arrow.get(d, tzinfo='US/Pacific')
+    print(f"Case 3: {arw}")
+    assert arw.tzinfo.utcoffset(None).total_seconds() != 0
+
+    # Case 4: iso calendar tuple with tzinfo kwarg
+    tup = (2023, 1, 1)
+    arw = arrow.get(tup, tzinfo='US/Pacific')
+    print(f"Case 4: {arw}")
+    assert arw.tzinfo.utcoffset(None).total_seconds() != 0
+
+if __name__ == "__main__":
+    try:
+        test_tzinfo_kwarg()
+        print("All tests passed!")
+    except AssertionError as e:
+        print("Test failed!")
+        raise e
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        raise e

diff --git a/verify_scrub.py b/verify_scrub.py
new file mode 100644
index 0000000..b3160bc
--- /dev/null
+++ b/verify_scrub.py
@@ -0,0 +1,27 @@
+from boltons import ecoutils
+import os
+import socket
+import getpass
+
+def test_scrubbing():
+    prof = ecoutils.get_profile(scrub=True)
+    
+    print(f"Username: {prof.get('username')}")
+    print(f"Hostname: {prof.get('hostname')}")
+    print(f"FQDN: {prof.get('hostfqdn')}")
+    print(f"CWD: {prof.get('cwd')}")
+    print(f"Python Bin: {prof['python'].get('bin')}")
+    print(f"Python Argv: {prof['python'].get('argv')}")
+    print(f"Uname Node: {prof['uname'].get('node')}")
+
+    assert prof.get('username') == '-'
+    assert prof.get('hostname') == '-'
+    assert prof.get('hostfqdn') == '-'
+    assert prof.get('cwd') == '-'
+    assert prof['python'].get('bin') == '-'
+    assert prof['python'].get('argv') == '-'
+    assert prof['uname'].get('node') == '-'
+    print("All scrubbed values are correct!")
+
+if __name__ == "__main__":
+    test_scrubbing()

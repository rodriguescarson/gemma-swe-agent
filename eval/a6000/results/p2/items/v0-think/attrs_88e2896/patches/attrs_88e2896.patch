diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..d589907
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,43 @@
+
+from attr import define
+from functools import cached_property
+
+@define(slots=True)
+class A:
+    @cached_property
+    def x(self):
+        raise AttributeError("original error")
+
+def test_preserve_attribute_error():
+    a = A()
+    try:
+        _ = a.x
+    except AttributeError as e:
+        assert str(e) == "original error"
+        print("Preserved AttributeError from cached_property")
+
+@define(slots=True)
+class B:
+    @cached_property
+    def x(self):
+        return 1
+
+def test_attribute_error_for_missing_attr():
+    b = B()
+    try:
+        _ = b.y
+    except AttributeError as e:
+        print(f"AttributeError for missing attr: {e}")
+
+if __name__ == "__main__":
+    try:
+        test_preserve_attribute_error()
+        print("test_preserve_attribute_error passed")
+    except Exception as e:
+        print(f"test_preserve_attribute_error failed: {e}")
+
+    try:
+        test_attribute_error_for_missing_attr()
+        print("test_attribute_error_for_missing_attr passed")
+    except Exception as e:
+        print(f"test_attribute_error_for_missing_attr failed: {e}")
diff --git a/repro_base.py b/repro_base.py
new file mode 100644
index 0000000..a315bce
--- /dev/null
+++ b/repro_base.py
@@ -0,0 +1,31 @@
+
+from attr import define
+from functools import cached_property
+
+class Base:
+    def __getattribute__(self, name):
+        if name == 'y':
+            raise AttributeError("Base error")
+        return super().__getattribute__(name)
+
+@define(slots=True)
+class A(Base):
+    @cached_property
+    def x(self):
+        return 1
+
+def test_preserve_attribute_error():
+    a = A()
+    try:
+        _ = a.y
+    except AttributeError as e:
+        print(f"Caught AttributeError: {e}")
+        assert str(e) == "Base error"
+        print("Preserved AttributeError from Base")
+
+if __name__ == "__main__":
+    try:
+        test_preserve_attribute_error()
+        print("test_preserve_attribute_error passed")
+    except Exception as e:
+        print(f"test_preserve_attribute_error failed: {e}")

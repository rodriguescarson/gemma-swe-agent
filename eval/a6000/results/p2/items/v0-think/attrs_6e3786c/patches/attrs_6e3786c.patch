diff --git a/verify_kw_only.py b/verify_kw_only.py
new file mode 100644
index 0000000..4e5ac4b
--- /dev/null
+++ b/verify_kw_only.py
@@ -0,0 +1,65 @@
+import attr
+import attrs
+import pytest
+
+def test_attr_s_backward_compatibility():
+    @attr.s(kw_only=True)
+    class A:
+        x = attr.ib(kw_only=False)
+        y = attr.ib()
+
+    # Should fail if we try to pass x as positional
+    try:
+        A(1, y=2)
+    except TypeError as e:
+        print(f"attr.s(kw_only=True) caught expected TypeError: {e}")
+    else:
+        pytest.fail("attr.s(kw_only=True) should force all attributes to be kw-only")
+
+def test_attrs_define_new_behavior():
+    @attrs.define(kw_only=True)
+    class A:
+        x = attrs.field(kw_only=False)
+        y = attrs.field()
+
+    # x should be positional-or-keyword, y should be kw-only
+    a = A(1, y=2)
+    assert a.x == 1
+    assert a.y == 2
+    print("attrs.define(kw_only=True) allows kw_only=False attributes to be positional")
+
+def test_attr_s_force_kw_only_false():
+    @attr.s(kw_only=True, force_kw_only=False)
+    class A:
+        x = attr.ib(kw_only=False)
+        y = attr.ib()
+
+    a = A(1, y=2)
+    assert a.x == 1
+    assert a.y == 2
+    print("attr.s(kw_only=True, force_kw_only=False) allows kw_only=False attributes to be positional")
+
+def test_attrs_define_force_kw_only_true():
+    @attrs.define(kw_only=True, force_kw_only=True)
+    class A:
+        x = attrs.field(kw_only=False)
+        y = attrs.field()
+
+    try:
+        A(1, y=2)
+    except TypeError as e:
+        print(f"attrs.define(kw_only=True, force_kw_only=True) caught expected TypeError: {e}")
+    else:
+        pytest.fail("attrs.define(kw_only=True, force_kw_only=True) should force all attributes to be kw-only")
+
+if __name__ == "__main__":
+    try:
+        test_attr_s_backward_compatibility()
+        test_attrs_define_new_behavior()
+        test_attr_s_force_kw_only_false()
+        test_attrs_define_force_kw_only_true()
+        print("All tests passed!")
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
+        exit(1)

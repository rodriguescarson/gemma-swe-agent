diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000..fba83a5
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,15 @@
+from attr import define, field
+
+@define
+class A:
+    x: int = field(default=10, init=False)
+    y: int = 20
+
+    def __attrs_pre_init__(self, x, y):
+        print(f"pre_init called with x={x}, y={y}")
+
+try:
+    a = A(y=30)
+    print("Success")
+except TypeError as e:
+    print(f"TypeError: {e}")

@@ -0,0 +1,30 @@
+import io
+import json
+from boltons.jsonutils import JSONLIterator
+
+def test_seek(mode, rel_seek):
+    print(f"Testing {mode} rel_seek={rel_seek}")
+    data = b'{"a": 1}\n{"b": 2}\n{"c": 3}\n' if mode == 'binary' else '{"a": 1}\n{"b": 2}\n{"c": 3}\n'
+    
+    if mode == 'binary':
+        fo = io.BytesIO(data)
+    else:
+        fo = io.StringIO(data)
+    
+    try:
+        it = JSONLIterator(fo, rel_seek=rel_seek)
+        obj = next(it)
+        print(f"Got object: {obj}")
+    except Exception as e:
+        print(f"Caught exception: {type(e).__name__}: {e}")
+    finally:
+        fo.close()
+    print()
+
+if __name__ == "__main__":
+    test_seek('binary', 0)
+    test_seek('binary', 0.5)
+    test_seek('binary', 1)
+    test_seek('text', 0)
+    test_seek('text', 0.5)
+    test_seek('text', 1)

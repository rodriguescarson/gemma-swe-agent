            >>> earlier = arrow.utcnow().shift(hours=-2)
            >>> earlier.humanize()
            '2 hours ago'
    
            >>> later = earlier.shift(hours=4)
            >>> later.humanize(earlier)
            'in 4 hours'
    
        """
    

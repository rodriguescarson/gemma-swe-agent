new file mode 100644
index 0000000..1db18b7
--- /dev/null
+++ b/src/trio/_tools/sync_test_requirements.py
@@ -0,0 +1,69 @@
+import yaml
+import re
+from pathlib import Path
+import sys
+
+def main():
+    precommit_config_path = Path(".pre-commit-config.yaml")
+    test_reqs_path = Path("test-requirements.txt")
+
+    if not precommit_config_path.exists() or not test_reqs_path.exists():
+        print("Required files not found.")
+        sys.exit(0)
+
+    with open(precommit_config_path) as f:
+        config = yaml.safe_load(f)
+
+    # Mapping from repo url to package name in test-requirements.txt
+    mapping = {
+        "https://github.com/psf/black-pre-commit-mirror": "black",
+        "https://github.com/astral-sh/ruff-pre-commit": "ruff",
+        "https://github.com/codespell-project/codespell": "codespell",
+    }
+
+    versions = {}
+    for repo in config.get("repos", []):
+        repo_url = repo.get("repo")
+        if repo_url in mapping:
+            rev = repo.get("rev", "")
+            # Remove leading 'v' if present
+            if rev.startswith("v"):
+                rev = rev[1:]
+            versions[mapping[repo_url]] = rev
+
+    if not versions:
+        print("No versions to sync.")
+        return
+
+    with open(test_reqs_path, "r") as f:
+        lines = f.readlines()
+
+    new_lines = []
+    changed = False
+    for line in lines:
+        updated_line = line
+        for pkg, ver in versions.items():
+            # This regex looks for the package name followed by == and any version,
+            # potentially followed by environment markers.
+            pattern = rf"^({pkg})==([^ \s;]+)(.*)$"
+            match = re.match(pattern, line)
+            if match:
+                if match.group(2) != ver:
+                    updated_line = f"{match.group(1)}=={ver}{match.group(3)}"
+                    if not updated_line.endswith("\n"):
+                        updated_line += "\n"
+                    changed = True
+                break
+        new_lines.append(updated_line)
+
+    if changed:
+        with open(test_reqs_path, "w") as f:
+            f.writelines(new_lines)
+        print("Updated test-requirements.txt")
+        sys.exit(1)
+    else:
+        print("test-requirements.txt is already in sync")
+        sys.exit(0)
+
+if __name__ == "__main__":
+    main()

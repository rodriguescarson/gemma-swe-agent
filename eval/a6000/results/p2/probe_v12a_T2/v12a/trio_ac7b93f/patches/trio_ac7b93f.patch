index 0000000..910328f
--- /dev/null
+++ b/src/trio/_tools/sync_pre_commit.py
@@ -0,0 +1,59 @@
+import yaml
+import re
+import sys
+
+def sync():
+    try:
+        with open(".pre-commit-config.yaml", "r") as f:
+            config = yaml.safe_load(f)
+    except FileNotFoundError:
+        print("Error: .pre-commit-config.yaml not found")
+        sys.exit(1)
+    
+    repos = config.get("repos", [])
+    versions = {}
+    for repo in repos:
+        url = repo.get("repo")
+        rev = repo.get("rev")
+        if url and rev:
+            # Clean the version string (remove 'v' prefix)
+            version = rev[1:] if rev.startswith('v') else rev
+            
+            # Determine package name
+            # This is a bit hacky but seems to cover the cases
+            pkg = url.split('/')[-1]
+            pkg = pkg.replace('-pre-commit-mirror', '').replace('-pre-commit', '').replace('mirrors-', '')
+            
+            versions[pkg] = version
+
+    try:
+        with open("test-requirements.txt", "r") as f:
+            lines = f.readlines()
+    except FileNotFoundError:
+        print("Error: test-requirements.txt not found")
+        sys.exit(1)
+
+    new_lines = []
+    changed = False
+    for line in lines:
+        # Look for lines like 'package==version' or 'package==version ; markers'
+        match = re.match(r'^([a-zA-Z0-9\-_]+)==([a-zA-Z0-9\.\-_]+)(.*)$', line)
+        if match:
+            pkg, version, suffix = match.groups()
+            if pkg in versions and versions[pkg] != version:
+                new_lines.append(f"{pkg}=={versions[pkg]}{suffix}\n")
+                changed = True
+                continue
+        new_lines.append(line)
+
+    if changed:
+        with open("test-requirements.txt", "w") as f:
+            f.writelines(new_lines)
+        print("Updated test-requirements.txt")
+        sys.exit(1) # Signal that changes were made
+    else:
+        print("test-requirements.txt is already in sync")
+        sys.exit(0)
+
+if __name__ == "__main__":
+    sync()

index 0000000..21fbdaa
--- /dev/null
+++ b/src/trio/_tools/sync_pre_commit_versions.py
@@ -0,0 +1,87 @@
+import yaml
+import re
+import sys
+from pathlib import Path
+
+def get_package_name(repo_url):
+    if repo_url == 'local':
+        return None
+    repo_name = repo_url.split('/')[-1]
+    if repo_name == 'pre-commit-hooks':
+        return None
+    if repo_name == 'mirrors-typos':
+        return 'typos'
+    if repo_name.endswith('-pre-commit-mirror'):
+        return repo_name[:-len('-pre-commit-mirror')]
+    if repo_name.endswith('-pre-commit'):
+        return repo_name[:-len('-pre-commit')]
+    return repo_name
+
+def sync_versions():
+    config_path = Path('.pre-commit-config.yaml')
+    reqs_in_path = Path('test-requirements.in')
+    
+    if not config_path.exists() or not reqs_in_path.exists():
+        return
+
+    with open(config_path, 'r') as f:
+        config = yaml.safe_load(f)
+    
+    versions = {}
+    for repo in config.get('repos', []):
+        url = repo.get('repo')
+        rev = repo.get('rev')
+        if url and rev:
+            pkg = get_package_name(url)
+            if pkg:
+                # Remove 'v' prefix from version if present
+                version = rev[1:] if rev.startswith('v') else rev
+                versions[pkg] = version
+
+    with open(reqs_in_path, 'r') as f:
+        lines = f.readlines()
+
+    new_lines = []
+    updated_pkgs = set()
+    
+    for line in lines:
+        matched = False
+        for pkg, version in versions.items():
+            # Match package name at the start of the line, 
+            # followed by either a space, a semicolon, a version specifier, or end of line.
+            pattern = re.compile(rf'^({pkg})([\s;=<>!].*)?$')
+            match = pattern.match(line.strip())
+            if match:
+                rest = match.group(2) if match.group(2) else ""
+                marker = ""
+                if ';' in rest:
+                    marker = ';' + rest.split(';', 1)[1]
+                
+                new_line = f"{pkg}=={version}{marker}\n"
+                new_lines.append(new_line)
+                updated_pkgs.add(pkg)
+                matched = True
+                break
+        
+        if not matched:
+            new_lines.append(line)
+
+    # Add any tools that were in .pre-commit-config.yaml but not in test-requirements.in
+    for pkg, version in versions.items():
+        if pkg not in updated_pkgs:
+            # Find the # Tools section
+            for i, line in enumerate(new_lines):
+                if line.strip() == '# Tools':
+                    new_lines.insert(i + 1, f"{pkg}=={version}\n")
+                    updated_pkgs.add(pkg)
+                    break
+            if pkg not in updated_pkgs:
+                # If # Tools section not found, just append to the end
+                new_lines.append(f"{pkg}=={version}\n")
+                updated_pkgs.add(pkg)
+
+    with open(reqs_in_path, 'w') as f:
+        f.writelines(new_lines)
+
+if __name__ == '__main__':
+    sync_versions()

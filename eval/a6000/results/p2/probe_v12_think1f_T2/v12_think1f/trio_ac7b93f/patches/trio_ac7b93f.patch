+import yaml
+import re
+import sys
+
+# Mapping from pre-commit repo URL to the package name in test-requirements.txt
+REPO_MAPPING = {
+    "https://github.com/psf/black-pre-commit-mirror": "black",
+    "https://github.com/astral-sh/ruff-pre-commit": "ruff",
+    "https://github.com/codespell-project/codespell": "codespell",
+}
+
+def sync():
+    try:
+        with open(".pre-commit-config.yaml", "r") as f:
+            config = yaml.safe_load(f)
+    except FileNotFoundError:
+        print("Error: .pre-commit-config.yaml not found")
+        sys.exit(1)
+
+    repos = config.get("repos", [])
+    versions = {}
+    for repo in repos:
+        repo_url = repo.get("repo", "")
+        rev = repo.get("rev", "")
+        if not rev:
+            continue
+        
+        # Strip leading 'v' if present
+        clean_rev = rev[1:] if rev.startswith("v") else rev
+        
+        # Find if this repo is in our mapping
+        for url, package in REPO_MAPPING.items():
+            if url == repo_url:
+                versions[package] = clean_rev
+                break
+
+    if not versions:
+        print("No matching tools found in .pre-commit-config.yaml")
+        return
+
+    try:
+        with open("test-requirements.txt", "r") as f:
+            content = f.read()
+    except FileNotFoundError:
+        print("Error: test-requirements.txt not found")
+        sys.exit(1)
+
+    original_content = content
+    for package, version in versions.items():
+        # Match package==version, potentially followed by environment markers
+        # Example: black==25.1.0 ; implementation_name == 'cpython'
+        pattern = rf"^(?P<prefix>{package}==)[^\s;]+(?P<suffix> ; [^#\n]+)?$"
+        content = re.sub(pattern, rf"\g<prefix>{version}\g<suffix>", content, flags=re.MULTILINE)
+
+    if content == original_content:
+        print("test-requirements.txt is already in sync")
+    else:
+        with open("test-requirements.txt", "w") as f:
+            f.write(content)
+        print("Updated test-requirements.txt with versions from .pre-commit-config.yaml")
+
+if __name__ == "__main__":
+    sync()

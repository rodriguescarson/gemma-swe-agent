new file mode 100644
index 0000000..bee2fb3
--- /dev/null
+++ b/src/trio/_tools/sync_test_requirements.py
@@ -0,0 +1,72 @@
+import yaml
+import re
+import sys
+from pathlib import Path
+
+REPO_TO_PACKAGE = {
+    "https://github.com/psf/black-pre-commit-mirror": "black",
+    "https://github.com/astral-sh/ruff-pre-commit": "ruff",
+    "https://github.com/codespell-project/codespell": "codespell",
+}
+
+def sync():
+    config_path = Path(".pre-commit-config.yaml")
+    reqs_path = Path("test-requirements.in")
+    
+    if not config_path.exists() or not reqs_path.exists():
+        print("Missing .pre-commit-config.yaml or test-requirements.in")
+        sys.exit(1)
+
+    with open(config_path, "r") as f:
+        config = yaml.safe_load(f)
+    
+    versions = {}
+    for repo in config.get("repos", []):
+        repo_url = repo.get("repo", "")
+        rev = repo.get("rev", "")
+        if not rev:
+            continue
+        
+        version = rev[1:] if rev.startswith("v") else rev
+        
+        package = REPO_TO_PACKAGE.get(repo_url)
+        if package:
+            versions[package] = version
+
+    with open(reqs_path, "r") as f:
+        lines = f.readlines()
+
+    new_lines = []
+    changed = False
+    for line in lines:
+        updated = False
+        for package, version in versions.items():
+            # Match package name at start of line, preserve markers and comments.
+            # Pattern: start of line, optional whitespace, package name, 
+            # optional version specifier, then the rest of the line.
+            pattern = r"^(\s*)(" + re.escape(package) + r")(\s*([>=<]+[^\s#]+)?)(.*)$"
+            match = re.match(pattern, line)
+            if match:
+                indent = match.group(1)
+                rest = match.group(5)
+                new_line = f"{indent}{package}=={version}{rest}\n"
+                if new_line != line:
+                    changed = True
+                new_lines.append(new_line)
+                updated = True
+                break
+        
+        if not updated:
+            new_lines.append(line)
+
+    if changed:
+        with open(reqs_path, "w") as f:
+            f.writelines(new_lines)
+        print("Updated test-requirements.in")
+        sys.exit(1)
+    else:
+        print("test-requirements.in is already in sync")
+        sys.exit(0)
+
+if __name__ == "__main__":
+    sync()

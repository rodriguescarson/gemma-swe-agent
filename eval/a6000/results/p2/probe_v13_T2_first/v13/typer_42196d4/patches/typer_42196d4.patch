diff --git a/verify_metavar.py b/verify_metavar.py
new file mode 100644
index 0000000..69fa888
--- /dev/null
+++ b/verify_metavar.py
@@ -0,0 +1,22 @@
+import typer
+from typer.core import TyperArgument, TyperOption
+from typer._click.core import Context
+from typer._click.types import STRING
+
+ctx = Context(typer.Typer())
+
+# Test Argument (required)
+arg_req = TyperArgument(param_decls=["name"], type=STRING, required=True)
+print(f"Arg Req: {arg_req.make_metavar(ctx)}") # Expected: {name}<str>
+
+# Test Argument (optional)
+arg_opt = TyperArgument(param_decls=["name"], type=STRING, required=False)
+print(f"Arg Opt: {arg_opt.make_metavar(ctx)}") # Expected: [name]<str>
+
+# Test Option (no metavar)
+opt_no_metavar = TyperOption(param_decls=["--name"], type=STRING)
+print(f"Opt No Metavar: {opt_no_metavar.make_metavar(ctx)}") # Expected: <str>
+
+# Test Option (with metavar)
+opt_metavar = TyperOption(param_decls=["--name"], type=STRING, metavar="CUSTOM")
+print(f"Opt Metavar: {opt_metavar.make_metavar(ctx)}") # Expected: CUSTOM

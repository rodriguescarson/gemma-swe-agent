diff --git a/src/trio/_tools/sync_pre_commit_versions.py b/src/trio/_tools/sync_pre_commit_versions.py
new file mode 100644
index 0000000..ab86f67
--- /dev/null
+++ b/src/trio/_tools/sync_pre_commit_versions.py
@@ -0,0 +1,74 @@
+import yaml
+import sys
+from pathlib import Path
+
+def main():
+    pre_commit_config_path = Path(".pre-commit-config.yaml")
+    test_requirements_path = Path("test-requirements.txt")
+
+    if not pre_commit_config_path.exists() or not test_requirements_path.exists():
+        print("Config files not found", file=sys.stderr)
+        sys.exit(1)
+
+    with open(pre_commit_config_path, "r") as f:
+        config = yaml.safe_load(f)
+
+    versions = {}
+    for repo in config.get("repos", []):
+        rev = repo.get("rev")
+        if not rev:
+            continue
+        
+        # Normalize rev (remove 'v' prefix if present)
+        normalized_rev = rev
+        if normalized_rev.startswith("v"):
+            normalized_rev = normalized_rev[1:]
+
+        for hook in repo.get("hooks", []):
+            hook_id = hook.get("id")
+            if hook_id:
+                versions[hook_id] = normalized_rev
+
+    if not versions:
+        print("No matching tools found in .pre-commit-config.yaml")
+        sys.exit(0)
+
+    content = test_requirements_path.read_text()
+    lines = content.splitlines()
+    new_lines = []
+    changed = False
+
+    for line in lines:
+        # We are looking for lines like 'black==25.1.0' or 'black==25.1.0 ; implementation_name == "cpython"'
+        # We only want to modify lines that start with package==version
+        
+        modified_line = line
+        for tool, version in versions.items():
+            if line.startswith(f"{tool}=="):
+                # Split by == to get the current version and potential markers
+                parts = line.split("==", 1)
+                if len(parts) == 2:
+                    version_and_markers = parts[1]
+                    # Separate version from markers (starting with ;)
+                    version_part = version_and_markers.split(";", 1)
+                    current_version = version_part[0].strip()
+                    
+                    if current_version != version:
+                        marker = ""
+                        if len(version_part) > 1:
+                            marker = " ; " + version_part[1].strip()
+                        
+                        modified_line = f"{tool}=={version}{marker}"
+                        changed = True
+                        break # Found the tool, no need to check other tools for this line
+        
+        new_lines.append(modified_line)
+
+    if changed:
+        test_requirements_path.write_text("\n".join(new_lines) + "\n")
+        print(f"Updated {test_requirements_path}")
+    else:
+        print("Versions are already in sync")
+
+if __name__ == "__main__":
+    main()

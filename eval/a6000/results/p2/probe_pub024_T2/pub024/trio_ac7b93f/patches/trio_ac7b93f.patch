index 0000000..d38c0db
--- /dev/null
+++ b/src/trio/_tools/sync_pre_commit.py
@@ -0,0 +1,98 @@
+import yaml
+import re
+import sys
+from pathlib import Path
+
+def main():
+    config_path = Path(".pre-commit-config.yaml")
+    reqs_path = Path("test-requirements.in")
+
+    if not config_path.exists() or not reqs_path.exists():
+        print("Missing config or requirements file")
+        sys.exit(1)
+
+    with open(config_path, "r") as f:
+        config = yaml.safe_load(f)
+
+    # Map of repo URL fragment to requirement name
+    tool_map = {
+        "black-pre-commit-mirror": "black",
+        "ruff-pre-commit": "ruff",
+        "codespell": "codespell",
+    }
+
+    versions = {}
+    for repo in config.get("repos", []):
+        repo_url = repo.get("repo", "")
+        for fragment, name in tool_map.items():
+            if fragment in repo_url:
+                rev = repo.get("rev", "")
+                # Strip leading 'v'
+                if rev.startswith("v"):
+                    rev = rev[1:]
+                versions[name] = rev
+
+    if not versions:
+        print("No matching tools found in .pre-commit-config.yaml")
+        return
+
+    with open(reqs_path, "r") as f:
+        lines = f.readlines()
+
+    new_lines = []
+    changed = False
+    for line in lines:
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            new_lines.append(line)
+            continue
+
+        matched_tool = None
+        for tool in versions:
+            # Match tool name at the beginning of the stripped line, 
+            # followed by space, semicolon, or end of line
+            if re.match(rf"^{tool}(\s|[;]|$)", stripped):
+                matched_tool = tool
+                break
+        
+        if matched_tool:
+            version = versions[matched_tool]
+            
+            # Find the marker (starts with ;)
+            marker_start = stripped.find(';')
+            if marker_start != -1:
+                marker = stripped[marker_start:]
+                # The tool name is the part before the first space or semicolon
+                tool_name = re.split(r"[\s;]", stripped)[0]
+                new_line_stripped = f"{tool_name}=={version}{marker}"
+            else:
+                # No marker, just tool and maybe version
+                parts = stripped.split()
+                if not parts:
+                    new_line_stripped = stripped
+                else:
+                    tool_name = parts[0]
+                    new_line_stripped = f"{tool_name}=={version}"
+            
+            # Preserve original indentation and newline
+            indent = line[:line.find(stripped)]
+            newline_char = "\n" if line.endswith("\n") else ""
+            new_line = f"{indent}{new_line_stripped}{newline_char}"
+            
+            if new_line != line:
+                changed = True
+                new_lines.append(new_line)
+            else:
+                new_lines.append(line)
+        else:
+            new_lines.append(line)
+
+    if changed:
+        with open(reqs_path, "w") as f:
+            f.writelines(new_lines)
+        print("Updated test-requirements.in")
+    else:
+        print("No changes needed")
+
+if __name__ == "__main__":
+    main()

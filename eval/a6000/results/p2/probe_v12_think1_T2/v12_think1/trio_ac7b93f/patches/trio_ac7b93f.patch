diff --git a/src/trio/_tools/sync_pre_commit_versions.py b/src/trio/_tools/sync_pre_commit_versions.py
new file mode 100644
index 0000000..5b0c097
--- /dev/null
+++ b/src/trio/_tools/sync_pre_commit_versions.py
@@ -0,0 +1,56 @@
+import yaml
+import re
+import sys
+
+def main():
+    try:
+        with open('.pre-commit-config.yaml', 'r') as f:
+            config = yaml.safe_load(f)
+    except FileNotFoundError:
+        print("Error: .pre-commit-config.yaml not found")
+        sys.exit(0)
+
+    tool_versions = {}
+    for repo in config.get('repos', []):
+        rev = repo.get('rev')
+        if not rev:
+            continue
+        
+        version = rev
+        if version.startswith('v'):
+            version = version[1:]
+            
+        for hook in repo.get('hooks', []):
+            hook_id = hook.get('id')
+            if hook_id:
+                tool_versions[hook_id] = version
+
+    try:
+        with open('test-requirements.txt', 'r') as f:
+            lines = f.readlines()
+    except FileNotFoundError:
+        print("Error: test-requirements.txt not found")
+        sys.exit(0)
+
+    changed = False
+    new_lines = []
+    for line in lines:
+        match = re.match(r'^([a-zA-Z0-9\-_]+)==([^; \s]+)(.*)$', line)
+        if match:
+            tool, version, rest = match.groups()
+            if tool in tool_versions:
+                new_version = tool_versions[tool]
+                if version != new_version:
+                    line = f"{tool}=={new_version}{rest}\n"
+                    changed = True
+        new_lines.append(line)
+
+    if changed:
+        with open('test-requirements.txt', 'w') as f:
+            f.writelines(new_lines)
+        sys.exit(1)
+    else:
+        sys.exit(0)
+
+if __name__ == "__main__":
+    main()

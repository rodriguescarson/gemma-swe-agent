index 0000000..4657170
--- /dev/null
+++ b/src/trio/_tools/sync_pre_commit.py
@@ -0,0 +1,59 @@
+import yaml
+import re
+import sys
+from pathlib import Path
+
+def sync_versions():
+    config_path = Path(".pre-commit-config.yaml")
+    requirements_path = Path("test-requirements.in")
+
+    if not config_path.exists() or not requirements_path.exists():
+        print("Missing configuration or requirements file.")
+        sys.exit(1)
+
+    with open(config_path, "r") as f:
+        config = yaml.safe_load(f)
+
+    tool_versions = {}
+    for repo in config.get("repos", []):
+        repo_url = repo.get("repo", "")
+        rev = repo.get("rev")
+        if not rev:
+            continue
+
+        # Normalize version (remove 'v' prefix if present)
+        version = rev.lstrip("v")
+        
+        # Map repo URL to tool name
+        if "black" in repo_url:
+            tool_versions["black"] = version
+        elif "ruff" in repo_url:
+            tool_versions["ruff"] = version
+        elif "codespell" in repo_url:
+            tool_versions["codespell"] = version
+        elif "uv" in repo_url:
+            tool_versions["uv"] = version
+
+    with open(requirements_path, "r") as f:
+        requirements_content = f.read()
+
+    updated_content = requirements_content
+    for tool, version in tool_versions.items():
+        # This regex looks for the tool name at the start of a line,
+        # potentially followed by a version specifier, and
+        # captures the rest of the line to preserve markers/comments.
+        # Example: ruff >= 0.8.0 -> ruff == 0.11.8
+        # Example: black; implementation_name == "cpython" -> black == 25.1.0; implementation_name == "cpython"
+        pattern = rf"^({re.escape(tool)})(\s*[>=<]+[^#\s;]+)?(\s*.*)$"
+        replacement = rf"\1 == {version}\3"
+        updated_content = re.sub(pattern, replacement, updated_content, flags=re.MULTILINE)
+
+    if updated_content != requirements_content:
+        with open(requirements_path, "w") as f:
+            f.write(updated_content)
+        print(f"Updated {requirements_path}")
+    else:
+        print("No changes needed.")
+
+if __name__ == "__main__":
+    sync_versions()

index 0000000..90e5c09
--- /dev/null
+++ b/src/trio/_tools/sync_pre_commit.py
@@ -0,0 +1,52 @@
+import re
+import sys
+import yaml
+
+def main():
+    with open(".pre-commit-config.yaml", "r") as f:
+        config = yaml.safe_load(f)
+
+    tool_versions = {}
+    for repo in config.get("repos", []):
+        rev = repo.get("rev")
+        if not rev:
+            continue
+        version = rev[1:] if rev.startswith("v") else rev
+        for hook in repo.get("hooks", []):
+            hook_id = hook.get("id")
+            if hook_id:
+                tool_versions[hook_id] = version
+
+    with open("test-requirements.txt", "r") as f:
+        lines = f.readlines()
+
+    updated = False
+    new_lines = []
+    for line in lines:
+        new_line = line
+        for tool, version in tool_versions.items():
+            # Match tool==version, potentially with environment markers
+            # We want to replace the version part.
+            # The line should start with the tool name, followed by ==, then the version.
+            # We use a regex to ensure we match the tool name exactly.
+            pattern = rf"^({re.escape(tool)})==([^ ;]+)"
+            match = re.match(pattern, line)
+            if match:
+                old_version = match.group(2)
+                if old_version != version:
+                    new_line = line.replace(f"{tool}=={old_version}", f"{tool}=={version}", 1)
+                    updated = True
+                break
+        new_lines.append(new_line)
+
+    if updated:
+        with open("test-requirements.txt", "w") as f:
+            f.writelines(new_lines)
+        print("Updated test-requirements.txt to sync with .pre-commit-config.yaml")
+        sys.exit(1)  # Signal that the file was changed
+    else:
+        print("test-requirements.txt is already in sync with .pre-commit-config.yaml")
+        sys.exit(0)
+
+if __name__ == "__main__":
+    main()

index 0000000..fccc52c
--- /dev/null
+++ b/src/trio/_tools/sync_pre_commit.py
@@ -0,0 +1,54 @@
+import yaml
+import re
+from pathlib import Path
+import sys
+
+def main():
+    pre_commit_config = Path(".pre-commit-config.yaml")
+    test_requirements = Path("test-requirements.txt")
+
+    if not pre_commit_config.exists():
+        print(f"Error: {pre_commit_config} not found")
+        sys.exit(1)
+    if not test_requirements.exists():
+        print(f"Error: {test_requirements} not found")
+        sys.exit(1)
+
+    with open(pre_commit_config, "r") as f:
+        config = yaml.safe_load(f)
+
+    versions = {}
+    for repo in config.get("repos", []):
+        repo_url = repo.get("repo", "")
+        rev = repo.get("rev", "")
+        if "black-pre-commit-mirror" in repo_url:
+            versions["black"] = rev
+        elif "ruff-pre-commit" in repo_url:
+            versions["ruff"] = rev.lstrip("v")
+        elif "codespell-project/codespell" in repo_url:
+            versions["codespell"] = rev
+
+    if not versions:
+        print("No versions found in .pre-commit-config.yaml")
+        return
+
+    with open(test_requirements, "r") as f:
+        content = f.read()
+
+    new_content = content
+    for tool, version in versions.items():
+        # Match tool==version and potentially some markers
+        # e.g., black==25.1.0 ; implementation_name == 'cpython'
+        pattern = rf"^({tool}==)[^ \n]+( ; .*)?$"
+        replacement = rf"\1{version}\2"
+        new_content = re.sub(pattern, replacement, new_content, flags=re.MULTILINE)
+
+    if new_content != content:
+        with open(test_requirements, "w") as f:
+            f.write(new_content)
+        print(f"Updated {test_requirements}")
+    else:
+        print(f"{test_requirements} is already in sync")
+
+if __name__ == "__main__":
+    main()

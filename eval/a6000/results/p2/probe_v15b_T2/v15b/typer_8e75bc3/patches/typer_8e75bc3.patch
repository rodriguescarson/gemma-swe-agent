diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..b4f0a77
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,32 @@
+import subprocess
+import shutil
+from unittest.mock import MagicMock, patch
+from typer.main import launch
+
+def test_launch_xdg_open_wait_false():
+    with patch("typer.main._is_macos", return_value=False), \
+         patch("typer.main._is_linux_or_bsd", return_value=True), \
+         patch("shutil.which", return_value="/usr/bin/xdg-open"), \
+         patch("subprocess.Popen") as mock_popen:
+        
+        mock_process = MagicMock()
+        mock_popen.return_value = mock_process
+        
+        # Test wait=False
+        result = launch("http://example.com", wait=False)
+        assert result == 0
+        mock_process.wait.assert_not_called()
+        
+        # Test wait=True
+        mock_process.wait.return_value = 0
+        result = launch("http://example.com", wait=True)
+        assert result == 0
+        mock_process.wait.assert_called()
+
+if __name__ == "__main__":
+    try:
+        test_launch_xdg_open_wait_false()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)

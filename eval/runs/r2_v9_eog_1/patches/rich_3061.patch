--- /dev/null
+++ b/tests/test_expand_tabs.py
@@ -0,0 +1,38 @@
+from rich.text import Text
+from rich.style import Style
+
+def test_expand_tabs_styles():
+    text = Text("a\tb")
+    text.stylize("red", 1, 2)
+    text.expand_tabs(tab_size=4)
+    # "a" (pos 0), tab expanded to 3 spaces (pos 1, 2, 3), "b" (pos 4)
+    # Total length: 1 + 3 + 1 = 5
+    assert text.plain == "a   b"
+    # The style of the tab should be extended to the expanded spaces.
+    # Original tab was at index 1. Expanded spaces are at index 1, 2, 3.
+    # So the span should be from 1 to 4.
+    assert text.spans[0].start == 1
+    assert text.spans[0].end == 4
+    assert text.spans[0].style == Style(color="red")
+
+def test_expand_tabs_styles_multiple():
+    text = Text("a\t\tb")
+    text.stylize("red", 1, 2)
+    text.stylize("blue", 2, 3)
+    text.expand_tabs(tab_size=4)
+    # "a" (0)
+    # tab 1: pos 1, expanded to 3 spaces (1, 2, 3)
+    # tab 2: pos 4, expanded to 4 spaces (4, 5, 6, 7)
+    # "b" (8)
+    assert text.plain == "a       b"
+    assert text.spans[0].start == 1
+    assert text.spans[0].end == 4
+    assert text.spans[0].style == Style(color="red")
+    assert text.spans[1].start == 4
+    assert text.spans[1].end == 8
+    assert text.spans[1].style == Style(color="blue")
+
+if __name__ == "__main__":
+    test_expand_tabs_styles()
+    test_expand_tabs_styles_multiple()
+    print("Tests passed!")

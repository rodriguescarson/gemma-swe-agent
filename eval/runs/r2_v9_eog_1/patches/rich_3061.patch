+from rich.text import Text
+from rich.style import Style
+
+def test_expand_tabs_style():
+    # Create a Text object with a tab character and a specific style
+    text = Text("Hello\tWorld")
+    style = Style(color="red")
+    text.stylize(style, 5, 6)  # Apply red style to the tab character at index 5
+
+
+    
+    # Expand tabs
+    text.expand_tabs()
+    expanded = text
+
+    
+    # The tab at index 5 should be expanded into spaces.
+    # "Hello" is 5 chars. The next tab stop is usually at index 8 (tab_size=8).
+    # So tab should expand to 3 spaces.
+    # The expanded text should be "Hello   World"
+    # Indices 5, 6, 7 should now have the red style.
+    
+    # We can check the spans of the expanded text
+    # expanded.spans is a list of (start, end, style)
+    spans = expanded.spans
+    
+    # Check if any span covers the expanded spaces and has the red style
+    found_style = False
+    for start, end, s in spans:
+        if start <= 5 and end >= 8 and s == style:
+            found_style = True
+            break
+    
+    assert found_style, f"Expected red style to be extended to expanded spaces. Spans: {spans}"
+    print("Test passed!")
+
+if __name__ == "__main__":
+    try:
+        test_expand_tabs_style()
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        exit(1)

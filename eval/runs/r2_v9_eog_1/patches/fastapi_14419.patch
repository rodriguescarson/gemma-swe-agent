+import pytest
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import SecurityScopes
+from fastapi.testclient import TestClient
+
+def dep_a():
+    return "a"
+
+def dep_b(a = Depends(dep_a)):
+    return f"b-{a}"
+
+def dep_c(a = Depends(dep_a)):
+    return f"c-{a}"
+
+def dep_d(b = Depends(dep_b), c = Depends(dep_c)):
+    return f"d-{b}-{c}"
+
+app = FastAPI()
+
+call_counts = {"dep_a": 0, "dep_b": 0, "dep_c": 0, "dep_d": 0}
+
+def dep_a_counted():
+    call_counts["dep_a"] += 1
+    return "a"
+
+def dep_b_counted(a = Depends(dep_a_counted)):
+    call_counts["dep_b"] += 1
+    return f"b-{a}"
+
+def dep_c_counted(a = Depends(dep_a_counted)):
+    call_counts["dep_c"] += 1
+    return f"c-{a}"
+
+def dep_d_counted(b = Depends(dep_b_counted), c = Depends(dep_c_counted)):
+    call_counts["dep_d"] += 1
+    return f"d-{b}-{c}"
+
+@app.get("/")
+async def root(d = Depends(dep_d_counted)):
+    return d
+
+client = TestClient(app)
+
+def test_dependency_cache_no_scopes():
+    call_counts.clear()
+    response = client.get("/")
+    assert response.status_code == 200
+    assert response.json() == "d-b-a-c-a"
+    # dep_a should be called once, dep_b once, dep_c once, dep_d once
+    assert call_counts["dep_a"] == 1
+    assert call_counts["dep_b"] == 1
+    assert call_counts["dep_c"] == 1
+    assert call_counts["dep_d"] == 1
+
+def dep_scope_a():
+    return "a"
+
+def dep_scope_b(a = Depends(dep_scope_a)):
+    return "b"
+
+def dep_scope_c(a = Depends(dep_scope_a)):
+    return "c"
+
+def dep_scope_d(b = Depends(dep_scope_b), c = Depends(dep_scope_c)):
+    return "d"
+
+app_scope = FastAPI()
+call_counts_scope = {"dep_scope_a": 0, "dep_scope_b": 0, "dep_scope_c": 0, "dep_scope_d": 0}
+
+def dep_scope_a_counted():
+    call_counts_scope["dep_scope_a"] += 1
+    return "a"
+
+def dep_scope_b_counted(a = Depends(dep_scope_a_counted)):
+    call_counts_scope["dep_scope_b"] += 1
+    return "b"
+
+def dep_scope_c_counted(a = Depends(dep_scope_a_counted)):
+    call_counts_scope["dep_scope_c"] += 1
+    return "c"
+
+def dep_scope_d_counted(b = Depends(dep_scope_b_counted), c = Depends(dep_scope_c_counted)):
+    call_counts_scope["dep_scope_d"] += 1
+    return "d"
+
+@app_scope.get("/")
+async def root_scope(d = Depends(dep_scope_d_counted)):
+    return d
+
+client_scope = TestClient(app_scope)
+
+def test_dependency_cache_with_scopes_requested():
+    call_counts_scope.clear()
+    response = client_scope.get("/")
+    assert response.status_code == 200
+    assert call_counts_scope["dep_scope_a"] == 1
+    assert call_counts_scope["dep_scope_b"] == 1
+    assert call_counts_scope["dep_scope_c"] == 1
+    assert call_counts_scope["dep_scope_d"] == 1

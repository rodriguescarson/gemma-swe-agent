diff --git a/tests/test_sse_validation.py b/tests/test_sse_validation.py
new file mode 100644
index 000000000..56b8f3411
--- /dev/null
+++ b/tests/test_sse_validation.py
@@ -0,0 +1,28 @@
+import pytest
+from fastapi.sse import ServerSentEvent
+
+def test_sse_event_newline_raises_value_error():
+    with pytest.raises(ValueError, match="SSE field must not contain newlines"):
+        ServerSentEvent(event="my-event\n")
+
+def test_sse_event_carriage_return_raises_value_error():
+    with pytest.raises(ValueError, match="SSE field must not contain newlines"):
+        ServerSentEvent(event="my-event\r")
+
+def test_sse_id_newline_raises_value_error():
+    with pytest.raises(ValueError, match="SSE field must not contain newlines"):
+        ServerSentEvent(id="my-id\n")
+
+def test_sse_id_carriage_return_raises_value_error():
+    with pytest.raises(ValueError, match="SSE field must not contain newlines"):
+        ServerSentEvent(id="my-id\r")
+
+def test_sse_data_newline_allowed():
+    # data field should allow newlines
+    event = ServerSentEvent(data="line1\nline2")
+    assert event.data == "line1\nline2"
+
+def test_sse_valid_event_and_id():
+    event = ServerSentEvent(event="test-event", id="test-id")
+    assert event.event == "test-event"
+    assert event.id == "test-id"

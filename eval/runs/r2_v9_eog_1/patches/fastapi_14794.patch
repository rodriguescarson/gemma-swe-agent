diff --git a/tests/test_response_dependency.py b/tests/test_response_dependency.py
new file mode 100644
index 00000000..0debe5b0
--- /dev/null
+++ b/tests/test_response_dependency.py
@@ -0,0 +1,47 @@
+from fastapi import FastAPI, Depends, Response
+from fastapi.testclient import TestClient
+from typing import Annotated
+
+app = FastAPI()
+
+def modify_response(response: Response):
+    response.headers["X-Custom-Header"] = "custom-value"
+    return response
+
+@app.get("/test1")
+def endpoint1(response: Annotated[Response, Depends(modify_response)]):
+    return {"message": "test1"}
+
+@app.get("/test2")
+def endpoint2(response: Response = Depends(modify_response)):
+    return {"message": "test2"}
+
+@app.get("/test3")
+def endpoint3(response: Response):
+    return {"message": "test3"}
+
+client = TestClient(app)
+
+def test_response_dependency():
+    # Test Annotated[Response, Depends(...)]
+    res1 = client.get("/test1")
+    assert res1.status_code == 200
+    assert res1.headers["x-custom-header"] == "custom-value"
+
+    # Test Response = Depends(...)
+    res2 = client.get("/test2")
+    assert res2.status_code == 200
+    assert res2.headers["x-custom-header"] == "custom-value"
+
+    # Test regular Response injection (should still work)
+    res3 = client.get("/test3")
+    assert res3.status_code == 200
+    assert "x-custom-header" not in res3.headers
+
+if __name__ == "__main__":
+    try:
+        test_response_dependency()
+        print("Tests passed!")
+    except Exception as e:
+        print(f"Tests failed: {e}")
+        raise e

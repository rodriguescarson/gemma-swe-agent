+from rich.console import Console
+from rich.text import Text
+
+def test_wrap_cjk():
+    text = Text("あいうえお")  # 5 chars, each width 2
+    # Total width = 10. 
+    # If width = 3, it should wrap at 1 char (width 2), next line 1 char...
+    # If width = 5, it should wrap at 2 chars (width 4), next line 3 chars (width 6 -> wrap again)
+    
+    # The issue is when fold location sat WITHIN a double-width character.
+    # Let's try width=1. 1 < 2 (width of 'あ').
+    # If overflow='fold', it should fold the character.
+    
+    print("Testing wrap with width=1, overflow='fold'")
+    lines = text.wrap(Console(), 1, overflow="fold")
+    for i, line in enumerate(lines):
+        print(f"Line {i}: {repr(line)}")
+
+    # The issue says "CJK characters disappearing when the 'fold' location sat within a double-width character"
+    # Let's try a case where a word is exactly the width or slightly over.
+    
+    text2 = Text("あいう") # Width 6
+    print("\nTesting wrap with width=3, overflow='fold'")
+    lines2 = text2.wrap(Console(), 3, overflow="fold")
+    for i, line in enumerate(lines2):
+        print(f"Line {i}: {repr(line)}")
+
+if __name__ == "__main__":
+    test_wrap_cjk()

@@ -0,0 +1,17 @@
+import inspect
+from rich.repr import auto
+
+class CustomEq:
+    def __init__(self, value):
+        self.value = value
+    def __eq__(self, other):
+        return True
+
+@auto
+class Foo:
+    def __init__(self, a, b=CustomEq(1)):
+        self.a = a
+        self.b = b
+
+foo = Foo(1)
+print(f"Repr: {repr(foo)}")

+def iter_graphemes(text: str) -> Iterator[str]:
+    """Iterate over the grapheme clusters in a string.
+
+    Args:
+        text (str): The text to split into grapheme clusters.
+
+    Yields:
+        str: The next grapheme cluster.
+    """
+    # This is a simplified implementation. In a real scenario,
+    # you'd use a library like `uniseg` or `grapheme`.
+    # For Rich, we'll implement a basic version that handles
+    # Zero Width Joiner (ZWJ) and other common combiners.
+    
+    if not text:
+        return
+
+    index = 0
+    length = len(text)
+    while index < length:
+        start = index
+        char = text[index]
+        index += 1
+        
+        # Simple ZWJ and combiner handling
+        while index < length:
+            next_char = text[index]
+            if next_char == "\u200d" or (ord(next_char) >= 0x0300 and ord(next_char) <= 0x036f):
+                index += 1
+            else:
+                break
+
+        if index < length and text[index - 1] == "\u200d":
+            index += 1
+            # After a ZWJ, the next character (if any) is part of the same grapheme
+            # and we might have more ZWJs or combiners following it.
+            while index < length:
+                next_char = text[index]
+                if next_char == "\u200d" or (ord(next_char) >= 0x0300 and ord(next_char) <= 0x036f):
+                    index += 1
+                    # If we hit another ZWJ, we need to include the character it joins
+                    if index < length and text[index] == "\u200d":
+                        index += 1
+                        while index < length and (text[index] == "\u200d" or (ord(text[index]) >= 0x0300 and ord(text[index]) <= 0x036f)):
+                            index += 1
+                            if index < length and text[index] == "\u200d":
+                                index += 1
+                    # This is getting complex, let's simplify.
+                else:
+                    break
+                
+        yield text[start:index]
+
 

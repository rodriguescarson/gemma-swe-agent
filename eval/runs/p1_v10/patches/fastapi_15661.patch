diff --git a/.github/workflows/prepare-release.yml b/.github/workflows/prepare-release.yml
new file mode 100644
index 000000000..671d5f02b
--- /dev/null
+++ b/.github/workflows/prepare-release.yml
@@ -0,0 +1,30 @@
+name: Prepare Release
+
+on:
+  workflow_dispatch:
+
+jobs:
+  prepare-release:
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.11"
+
+      - name: Add release date
+        run: python scripts/add_latest_release_date.py
+
+      - name: Create Pull Request
+        uses: peter-evans/create-pull-request@v6
+        with:
+          commit-message: "docs: add release date"
+          title: "Prepare release"
+          body: "This is an automated PR to add the release date to the release notes."
+          branch: "prepare-release"
+          labels: "automation"

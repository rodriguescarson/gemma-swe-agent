+++ b/tests/test_wrapped_method_forward_reference.py
@@ -0,0 +1,25 @@
+from functools import wraps
+from typing import ForwardRef, get_type_hints
+import pytest
+from fastapi import FastAPI, Depends
+from fastapi.dependencies.utils import get_typed_signature
+
+def test_wrapped_method_type_inference():
+    class MyModel:
+        def __init__(self, x: "MyModel"):
+            self.x = x
+
+    def wrap_func(func):
+        @wraps(func)
+        def wrapper(*args, **kwargs):
+            return func(*args, **kwargs)
+        return wrapper
+
+    def my_dependency(x: "MyModel"):
+        return x
+
+    wrapped_my_dependency = wrap_func(my_dependency)
+    
+    # This should not raise NameError
+    sig = get_typed_signature(wrapped_my_dependency)
+    assert sig.parameters["x"].annotation == MyModel

diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..f967a6fa
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,23 @@
+from rich.console import Console
+
+def test_capture_and_record_multiple():
+    recorder = Console(record=True, width=80, force_terminal=False)
+    recorder.print("ABC")
+
+    with recorder.capture() as capture:
+        recorder.print("Hello")
+        recorder.print("World")
+
+    assert capture.get() == "Hello\nWorld\n"
+
+    recorded_text = recorder.export_text()
+    print(f"DEBUG: recorded_text = {repr(recorded_text)}")
+    assert recorded_text == "ABC\nHello\nWorld\n"
+
+if __name__ == "__main__":
+    try:
+        test_capture_and_record_multiple()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
diff --git a/repro_capture_record.py b/repro_capture_record.py
new file mode 100644
index 00000000..9ae86fc7
--- /dev/null
+++ b/repro_capture_record.py
@@ -0,0 +1,26 @@
+
+from rich.console import Console
+
+def test_capture_and_record():
+    recorder = Console(record=True, width=80)
+    recorder.print("ABC")
+    
+    with recorder.capture() as capture:
+        recorder.print("Hello")
+        recorder.print("World")
+    
+    # capture.get() should be "Hello\nWorld\n"
+    captured = capture.get()
+    assert captured == "Hello\nWorld\n"
+    
+    # recorder.export_text() should be "ABC\nHello\nWorld\n"
+    recorded = recorder.export_text()
+    assert recorded == "ABC\nHello\nWorld\n"
+    print("Test passed!")
+
+if __name__ == "__main__":
+    try:
+        test_capture_and_record()
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)

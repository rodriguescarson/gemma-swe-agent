@@ -0,0 +1,15 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/")
+async def root(x_header: str = Header(default="default")):
+    return {"x_header": x_header}
+
+client = TestClient(app)
+# This SHOULD NOT work (should return default) when convert_underscores=True (default)
+# because it should not accept underscore headers.
+print("Underscore header:", client.get("/", headers={"x_header": "val"}).json())
+# This SHOULD work
+print("Hyphen header:", client.get("/", headers={"x-header": "val"}).json())

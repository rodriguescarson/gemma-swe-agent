@@ -0,0 +1,12 @@
+from typing import Any
+
+def is_typealiastype(annotation: Any) -> bool:
+
+    """
+    Check if the annotation is a PEP 695 type alias.
+    """
+    try:
+        from typing import TypeAliasType
+        return isinstance(annotation, TypeAliasType)
+    except ImportError:
+        return False

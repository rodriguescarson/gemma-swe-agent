diff --git a/tests/test_repr_custom_class.py b/tests/test_repr_custom_class.py
new file mode 100644
index 00000000..ec5ad435
--- /dev/null
+++ b/tests/test_repr_custom_class.py
@@ -0,0 +1,23 @@
+import inspect
+from rich.repr import auto
+
+def test_auto_repr_with_custom_class_eq():
+    class EqParam:
+        def __init__(self, value):
+            self.value = value
+        def __eq__(self, other):
+            return True
+        def __repr__(self):
+            return f"EqParam({self.value})"
+
+    @auto
+    class Foo:
+        def __init__(self, a=EqParam(1)):
+            self.a = a
+
+    foo = Foo()
+    assert repr(foo) == "Foo()"
+
+if __name__ == "__main__":
+    test_auto_repr_with_custom_class_eq()
+    print("All tests passed!")

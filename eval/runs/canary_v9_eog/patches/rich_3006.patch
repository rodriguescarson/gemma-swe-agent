diff --git a/tests/test_repr_custom_class.py b/tests/test_repr_custom_class.py
new file mode 100644
index 00000000..b6b56681
--- /dev/null
+++ b/tests/test_repr_custom_class.py
@@ -0,0 +1,47 @@
+import inspect
+from rich.repr import rich_repr
+
+class BadEq:
+    def __init__(self, value):
+        self.value = value
+
+    def __eq__(self, other):
+        # Only return True if other is NOT a BadEq instance to simulate 
+        # the bug where it equals inspect.Parameter.empty
+        if isinstance(other, BadEq):
+            return self.value == other.value
+        return True
+
+    def __repr__(self):
+        return f"BadEq({self.value})"
+
+def test_repr_custom_class_eq():
+    @rich_repr
+    class TestClass:
+        def __init__(self, a, b=BadEq(1)):
+            self.a = a
+            self.b = b
+
+    obj = TestClass(1)
+    r = repr(obj)
+    # a=1, b=BadEq(1), default=BadEq(1)
+    # Fixed: b is default, skipped. -> "TestClass(1)"
+    # Bugged: b treated as no-default, yielded as value -> "TestClass(1, BadEq(1))"
+    assert "BadEq(1)" not in r
+    assert "1" in r
+
+def test_repr_custom_class_eq_different_value():
+    @rich_repr
+    class TestClassDiff:
+        def __init__(self, a, b=BadEq(1)):
+            self.a = a
+            self.b = b
+            
+    obj = TestClassDiff(1)
+    obj.b = BadEq(2)
+    
+    r = repr(obj)
+    # a=1, b=BadEq(2), default=BadEq(1)
+    # Fixed: b != default, yields ('b', BadEq(2), BadEq(1)) -> "b=BadEq(2)"
+    # Bugged: b treated as no-default, yielded as value -> "BadEq(2)"
+    assert "b=BadEq(2)" in r

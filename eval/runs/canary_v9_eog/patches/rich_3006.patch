@@ -0,0 +1,34 @@
+import inspect
+from rich.repr import auto
+
+# Case 1: Normal class without __eq__
+class NormalParam:
+    def __init__(self, value):
+        self.value = value
+    def __repr__(self):
+        return f"NormalParam({self.value})"
+
+@auto
+class FooNormal:
+    def __init__(self, a=NormalParam(1)):
+        self.a = a
+
+foo_normal = FooNormal()
+print(f"Normal: {repr(foo_normal)}")
+
+# Case 2: Class with __eq__ that always returns True
+class EqParam:
+    def __init__(self, value):
+        self.value = value
+    def __eq__(self, other):
+        return True
+    def __repr__(self):
+        return f"EqParam({self.value})"
+
+@auto
+class FooEq:
+    def __init__(self, a=EqParam(1)):
+        self.a = a
+
+foo_eq = FooEq()
+print(f"Eq: {repr(foo_eq)}")

+def is_typealiastype(annotation: Any) -> bool:
+    """Check if the annotation is a PEP 695 TypeAliasType."""
+    try:
+        from types import TypeAliasType
+        return isinstance(annotation, TypeAliasType)
+    except ImportError:
+        return False
+
+def unpack_typealiastype(annotation: Any) -> Any:
+    """Unpack a PEP 695 TypeAliasType to its underlying type."""
+    if is_typealiastype(annotation):
+        return annotation.__value__
+    return annotation

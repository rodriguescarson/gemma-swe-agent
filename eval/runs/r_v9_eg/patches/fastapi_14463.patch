diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..c449757e
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,51 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+app = FastAPI(
+    responses={
+        500: {
+            'model': ModelA | ModelB,
+            'content': {"application/json": {
+                'examples': {"Case A": {"value": "a"}}
+            }}
+        }
+    }
+)
+
+@app.get('/route1')
+def route1():
+    return "test"
+
+@app.get('/route2')
+def route2():
+    return "test"
+
+@app.get('/route3')
+def route3():
+    return "test"
+
+def test_repro():
+    openapi_json = app.openapi()
+    responses_500 = []
+    for path in openapi_json['paths'].values():
+        for method in path.values():
+            responses_500.append(method['responses']['500'])
+    
+    for i, resp in enumerate(responses_500):
+        any_of = resp['content']['application/json']['schema']['anyOf']
+        print(f"Route {i+1} anyOf length: {len(any_of)}")
+        if len(any_of) != 2:
+            print(f"FAILURE: Expected length 2, got {len(any_of)}")
+            assert len(any_of) == 2
+
+    print("SUCCESS: No duplication found.")
+
+if __name__ == "__main__":
+    test_repro()

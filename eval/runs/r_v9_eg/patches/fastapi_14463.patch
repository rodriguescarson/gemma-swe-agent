@@ -0,0 +1,52 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+from fastapi.openapi.utils import get_openapi
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+app = FastAPI(
+    responses={
+        500: {
+            'model': ModelA | ModelB,
+            'content': {"application/json": {
+                'examples': {"Case A": {"value": "a"}}
+            }}
+        }
+    }
+)
+
+@app.get('/route1')
+def route1():
+    return "test"
+
+@app.get('/route2')
+def route2():
+    return "test"
+
+@app.get('/route3')
+def route3():
+    return "test"
+
+openapi_schema = get_openapi(
+    title="Test App",
+    version="0.1.0",
+    routes=app.routes,
+)
+response_500_schema = openapi_schema["paths"]["/route1"]["get"]["responses"]["500"]["content"]["application/json"]["schema"]
+any_of_len = len(response_500_schema.get("anyOf", []))
+print(f"Length of anyOf for route1: {any_of_len}")
+
+route2_500_schema = openapi_schema["paths"]["/route2"]["get"]["responses"]["500"]["content"]["application/json"]["schema"]
+route3_500_schema = openapi_schema["paths"]["/route3"]["get"]["responses"]["500"]["content"]["application/json"]["schema"]
+
+print(f"Length of anyOf for route2: {len(route2_500_schema.get('anyOf', []))}")
+print(f"Length of anyOf for route3: {len(route3_500_schema.get('anyOf', []))}")
+
+assert any_of_len == 2, f"Expected 2 items in anyOf, got {any_of_len}"
+assert len(route2_500_schema.get('anyOf', [])) == 2
+assert len(route3_500_schema.get('anyOf', [])) == 2

@@ -0,0 +1,69 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.get("/test")
+async def test_endpoint(x_test: str = Header(convert_underscores=True)):
+    return {"x_test": x_test}
+
+@app.get("/test-alias")
+async def test_alias_endpoint(x_alias: str = Header(alias="x_test", convert_underscores=True)):
+    return {"x_alias": x_alias}
+
+client = TestClient(app)
+
+def test_header_convert_underscores_true():
+    # Should accept hyphen
+    response = client.get("/test", headers={"x-test": "hyphen"})
+    print(f"Test 1 (hyphen): status={response.status_code}, json={response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"x_test": "hyphen"}
+
+    # Should NOT accept underscore
+    response = client.get("/test", headers={"x_test": "underscore"})
+    print(f"Test 2 (underscore): status={response.status_code}")
+    assert response.status_code == 422
+
+def test_header_alias_convert_underscores_true():
+    # Should accept hyphen (converted alias)
+    response = client.get("/test-alias", headers={"x-test": "hyphen"})
+    print(f"Test 3 (hyphen alias): status={response.status_code}, json={response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"x_alias": "hyphen"}
+
+    # Should NOT accept underscore (even if alias is "x_test")
+    response = client.get("/test-alias", headers={"x_test": "underscore"})
+    print(f"Test 4 (underscore alias): status={response.status_code}")
+    assert response.status_code == 422
+
+def test_header_convert_underscores_false():
+    app_false = FastAPI()
+    @app_false.get("/test-false")
+    async def test_false_endpoint(x_test: str = Header(convert_underscores=False)):
+        return {"x_test": x_test}
+    
+    client_false = TestClient(app_false)
+    
+    # Should accept underscore
+    response = client_false.get("/test-false", headers={"x_test": "underscore"})
+    print(f"Test 5 (false convert): status={response.status_code}, json={response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"x_test": "underscore"}
+
+if __name__ == "__main__":
+    try:
+        test_header_convert_underscores_true()
+        print("test_header_convert_underscores_true: PASSED")
+        test_header_alias_convert_underscores_true()
+        print("test_header_alias_convert_underscores_true: PASSED")
+        test_header_convert_underscores_false()
+        print("test_header_convert_underscores_false: PASSED")
+        print("All manual tests PASSED")
+    except AssertionError as e:
+        print(f"Test FAILED: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        exit(1)

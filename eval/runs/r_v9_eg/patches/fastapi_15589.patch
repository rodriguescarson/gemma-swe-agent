+++ b/repro.py
@@ -0,0 +1,68 @@
+
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+app = FastAPI()
+
+@app.get("/simple")
+async def simple(x_test: str = Header()):
+    return {"x_test": x_test}
+
+@app.get("/alias")
+async def alias(x_test: str = Header(alias="x_test")):
+    return {"x_test": x_test}
+
+@app.get("/no_convert")
+async def no_convert(x_test: str = Header(convert_underscores=False)):
+    return {"x_test": x_test}
+
+class HeaderModel(BaseModel):
+    x_test: str
+
+@app.get("/model")
+async def model(headers: HeaderModel = Header()):
+    return {"x_test": headers.x_test}
+
+client = TestClient(app)
+
+def test_simple():
+    # Should accept hyphen
+    assert client.get("/simple", headers={"x-test": "hyphen"}).json() == {"x_test": "hyphen"}
+    # Should NOT accept underscore
+    assert client.get("/simple", headers={"x_test": "underscore"}).status_code == 422
+
+def test_alias():
+    # Should accept hyphen because convert_underscores=True by default
+    assert client.get("/alias", headers={"x-test": "hyphen"}).json() == {"x_test": "hyphen"}
+    # Should NOT accept underscore even if alias="x_test"
+    assert client.get("/alias", headers={"x_test": "underscore"}).status_code == 422
+
+def test_no_convert():
+    # Should accept underscore
+    assert client.get("/no_convert", headers={"x_test": "underscore"}).json() == {"x_test": "underscore"}
+    # Should NOT accept hyphen
+    assert client.get("/no_convert", headers={"x-test": "hyphen"}).status_code == 422
+
+def test_model():
+    # Should accept hyphen
+    assert client.get("/model", headers={"x-test": "hyphen"}).json() == {"x_test": "hyphen"}
+    # Should NOT accept underscore
+    assert client.get("/model", headers={"x_test": "underscore"}).status_code == 422
+
+if __name__ == "__main__":
+    try:
+        test_simple()
+        print("test_simple passed")
+        test_alias()
+        print("test_alias passed")
+        test_no_convert()
+        print("test_no_convert passed")
+        test_model()
+        print("test_model passed")
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

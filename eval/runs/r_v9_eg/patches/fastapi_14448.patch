+    }
+
+    def analyse_text(text):
+        rv = 0
+        if re.search(r'\bimport\s+haxe\.', text):
+            rv = max(rv, 0.2)
+        if re.search(r'\bStd\.', text):
+            rv = max(rv, 0.1)

+    aliases = ['ampl']
+    filenames = ['*.run']
+    version_added = '2.2'
+
+    tokens = {
+        'root': [
+            (r'\n', Text),
+            (r'\s+', Whitespace),
+            (r'#.*?\n', Comment.Single),
+            (r'/[*][\s\S]*?[*]/', Comment.Multiline),
+            (words((
+                'call', 'cd', 'close', 'commands', 'data', 'delete', 'display',
+                'drop', 'end', 'environ', 'exit', 'expand', 'include', 'load',
+                'model', 'objective', 'option', 'problem', 'purge', 'quit',

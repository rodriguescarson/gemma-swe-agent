+                print("hello world")
+                print("some error", file=sys.stderr)
+        ```
+
+    === "ignore stdout"
+
+        <!-- inline-snapshot: outcome-passed=1 -->
+        ``` python hl_lines="2 8 9 10 11"
+        import sys
+        from dirty_equals import IsStr
+        from inline_snapshot import snapshot
+        from inline_snapshot.extra import prints
+

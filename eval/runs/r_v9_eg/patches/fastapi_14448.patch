+        'namespace-body': [
+            (r'\}', Punctuation, '#pop'),
+            include('root'),
+        ],
+        'annotation': [
+            (r'\]\]', Punctuation, '#pop'),
+            (r'\(', Punctuation, 'annotation-args'),
+            (r'::', Punctuation),
+            (r',', Punctuation),
+            (CFamilyLexer._ident, Name.Decorator),
+            include('whitespace'),
+        ],
+        'annotation-args': [
+            (r'\)', Punctuation, '#pop'),
+            (r'\(', Punctuation, '#push'),
+            include('statements'),
+        ],
+    }
+
+    def analyse_text(text):
+        if re.search('#include <[a-z_]+>', text):
+            return 0.2
+        if re.search('using namespace ', text):
+            return 0.4

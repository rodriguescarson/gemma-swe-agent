+    filenames = ['*.bmx']
+    mimetypes = ['text/x-bmx']
+    version_added = '1.4'
+
+    bmax_vopwords = r'\b(Shl|Shr|Sar|Mod)\b'
+    bmax_sktypes = r'@{1,2}|[!#$%]'

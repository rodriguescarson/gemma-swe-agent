+        ]
+    }
+
+
+class CsoundDocumentLexer(RegexLexer):
+    """
+    For Csound documents.
+    """
+
+    name = 'Csound Document'
+    aliases = ['csound-document', 'csound-csd']
+    filenames = ['*.csd']
+    url = 'https://csound.com'
+    version_added = '2.1'
+

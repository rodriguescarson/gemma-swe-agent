+class MonkeyLexer(RegexLexer):
+    """
+    For Monkey source code.
+    """
+
+    name = 'Monkey'
+    aliases = ['monkey']
+    filenames = ['*.monkey']
+    mimetypes = ['text/x-monkey']
+    url = 'https://blitzresearch.itch.io/monkeyx'

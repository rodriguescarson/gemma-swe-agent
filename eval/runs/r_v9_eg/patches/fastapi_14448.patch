+    delimiter = r'()<>\[\]{}/%\s'
+    delimiter_end = rf'(?=[{delimiter}])'
+
+    valid_name_chars = rf'[^{delimiter}]'
+    valid_name = rf"{valid_name_chars}+{delimiter_end}"
+

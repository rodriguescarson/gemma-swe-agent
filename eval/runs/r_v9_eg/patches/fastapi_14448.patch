+        ],
+        # SAS is multi-line regardless, but * is ended by ;
+        'comments': [
+            (r'^\s*\*.*?;', Comment),
+            (r'/\*.*?\*/', Comment),
+            (r'^\s*\*[\s\S]*?;', Comment.Multiline),
+            (r'/[*][\s\S]*?[*]/', Comment.Multiline),
+        ],

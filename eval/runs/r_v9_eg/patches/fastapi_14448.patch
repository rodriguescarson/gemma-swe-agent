+            (r'[a-z]\w*\b', Name.Function),
+            # Comments
+            (r'#.*', Comment.Single),
+            # Punctuation
+            (r'[,;()]', Punctuation),
+            # Space is not significant
+            (r'\s+', Whitespace)
+        ],
+        'string-literal': [
+            (r'\\[tnrfbae"\\]', String.Escape),

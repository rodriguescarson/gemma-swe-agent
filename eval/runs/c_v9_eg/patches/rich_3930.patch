+def split_graphemes(text: str) -> Iterable[str]:
+    """Split text into grapheme clusters."""
+    if not text:
+        return
+    
+    # A simple grapheme splitter that handles ZWJ and combining characters
+    # This is a basic implementation of the grapheme cluster rule
+    import unicodedata
+    
+    start = 0
+    for i, char in enumerate(text):
+        # ZWJ (Zero Width Joiner) is U+200D
+        # Combining characters typically have category 'M' (Mark)
+        if i > 0 and (char == "200d" or unicodedata.category(char).startswith("M")):
+            continue
+        if i > 0 and text[i-1] == "200d":
+            continue
+        
+        if i > start:
+            yield text[start:i]
+        start = i
+    yield text[start:]
+

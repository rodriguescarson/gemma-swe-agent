+from rich.markup import render
+import reprlib
+
+def test_render(markup, expected):
+    result = render(markup)
+    print(f"Input: {repr(markup)} | Expected: {repr(expected)} | Result: {repr(result)}")
+    assert result == expected
+
+if __name__ == "__main__":
+    try:
+        test_render("foo\\", "foo\\")
+        test_render("foo\\\\", "foo\\\\")
+        test_render("foo\\[bar]", "foo[bar]")
+        test_render("foo\\\\[bar]", "foo\\[bar]")
+        test_render("\\", "\\")
+        test_render("\\\\", "\\\\")
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed!")
+        exit(1)

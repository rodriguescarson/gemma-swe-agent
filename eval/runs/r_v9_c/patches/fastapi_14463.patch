+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+app = FastAPI(
+    responses={
+        500: {
+            'model': ModelA | ModelB,
+            'content': {"application/json": {
+                'examples': {"Case A": {"value": "a"}}
+            }}
+        }
+    }
+)
+
+@app.get('/route1')
+def route1():
+    return "test"
+
+@app.get('/route2')
+def route2():
+    return "test"
+
+@app.get('/route3')
+def route3():
+    return "test"
+
+openapi_json = app.openapi()
+any_of = openapi_json["paths"]["/route3"]["get"]["responses"]["500"]["content"]["application/json"]["schema"]["anyOf"]
+print(json.dumps(any_of, indent=2))

new file mode 100644
index 00000000..efff71e9
--- /dev/null
+++ b/test_recursion.py
@@ -0,0 +1,11 @@
+import sys
+from rich.traceback import Traceback
+try:
+    exc = Exception('Root')
+    for i in range(1000):
+        exc = ExceptionGroup(f'Group {i}', [exc])
+    Traceback.extract(type(exc), exc, exc.__traceback__)
+    print('Successfully extracted')
+except RecursionError:
+    print('FAILED: RecursionError')
+    sys.exit(1)

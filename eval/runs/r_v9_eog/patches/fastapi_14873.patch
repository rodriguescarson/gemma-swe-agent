diff --git a/repro_test.py b/repro_test.py
new file mode 100644
index 00000000..7635409e
--- /dev/null
+++ b/repro_test.py
@@ -0,0 +1,28 @@
+from fastapi import FastAPI
+import asyncio
+
+def s_start():
+    print("SYNC START", flush=True)
+
+async def a_start():
+    print("ASYNC START", flush=True)
+
+def s_stop():
+    print("SYNC STOP", flush=True)
+
+async def a_stop():
+    print("ASYNC STOP", flush=True)
+
+async def main():
+    print("Starting app...")
+    app = FastAPI(on_startup=[s_start, a_start], on_shutdown=[s_stop, a_stop])
+    
+    print(f"App on_startup: {app.on_startup}")
+    print(f"App on_shutdown: {app.on_shutdown}")
+    
+    assert len(app.on_startup) == 2
+    assert len(app.on_shutdown) == 2
+    print("Success: Events were preserved!")
+
+if __name__ == "__main__":
+    asyncio.run(main())

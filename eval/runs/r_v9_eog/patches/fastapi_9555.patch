@@ -0,0 +1,59 @@
+import asyncio
+from functools import cache, wraps
+from typing import Awaitable, Callable, Generic, Iterator, ParamSpec, TypeVar
+from fastapi import Depends, FastAPI, Request
+from pydantic import BaseModel
+import inspect
+
+P = ParamSpec('P')
+T = TypeVar('T')
+
+class Reawaitable(Generic[T]):
+    __sentinel = object()
+
+    def __init__(self, awaitable: Awaitable[T]) -> None:
+        self.awaitable = awaitable
+        self.result = self.__sentinel
+
+    def __await__(self) -> Iterator[T]:
+        if self.result is self.__sentinel:
+            self.result = yield from self.awaitable.__await__()
+        return self.result
+
+def reawaitable(func: Callable[P, Awaitable[T]]) -> Callable[P, Reawaitable[T]]:
+    @wraps(func)
+    def wrapper(*args: P.args, **kwargs: P.kwargs) -> Reawaitable[T]:
+        return Reawaitable(func(*args, **kwargs))
+    return wrapper
+
+class Settings(BaseModel):
+    foo: str = 'bar'
+
+app = FastAPI()
+
+@cache
+@reawaitable
+async def get_settings() -> Settings:
+    return Settings()
+
+@app.get('/foo')
+async def foo(request: Request, settings: Settings = Depends(get_settings)) -> str:
+    return settings.foo
+
+async def test_reproduce():
+    from httpx import ASGITransport, AsyncClient
+    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as ac:
+        # First call
+        response = await ac.get("/foo")
+        print(f"First call status: {response.status_code}, body: {response.text}")
+        
+        # Second call
+        response = await ac.get("/foo")
+        print(f"Second call status: {response.status_code}, body: {response.text}")
+
+if __name__ == "__main__":
+    try:
+        asyncio.run(test_reproduce())
+    except Exception as e:
+        import traceback
+        traceback.print_exc()

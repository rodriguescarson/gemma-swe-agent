diff --git a/test_fix.py b/test_fix.py
new file mode 100644
index 00000000..437405fa
--- /dev/null
+++ b/test_fix.py
@@ -0,0 +1,32 @@
+
+from fastapi import FastAPI, File, Form, UploadFile
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(form_val: str = Form(...), file_val: bytes = File(...)):
+    return {"form_val": form_val, "file_val": len(file_val)}
+
+client = TestClient(app)
+
+def test_form_before_file():
+    # Send form data and a file
+    # The issue is that if Form is before File, it might return 422
+    response = client.post(
+        "/test",
+        data={"form_val": "hello"},
+        files={"file_val": b"world"}
+    )
+    print(f"Status code: {response.status_code}")
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"form_val": "hello", "file_val": 5}
+
+if __name__ == "__main__":
+    try:
+        test_form_before_file()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)

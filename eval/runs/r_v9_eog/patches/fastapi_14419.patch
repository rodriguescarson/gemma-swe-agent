--- /dev/null
+++ b/repro.py
@@ -0,0 +1,40 @@
+
+from fastapi import Depends, FastAPI, Security
+from fastapi.security import SecurityScopes
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+counter_holder = {"counter": 0}
+
+async def dep_counter():
+    counter_holder["counter"] += 1
+    return counter_holder["counter"]
+
+async def dep_with_scopes(security_scopes: SecurityScopes, count: int = Depends(dep_counter)):
+    return count
+
+@app.get("/test-repro")
+async def repro(
+    a1: int = Depends(dep_with_scopes),
+    a2: int = Depends(dep_with_scopes)
+):
+    return {"a1": a1, "a2": a2}
+
+client = TestClient(app)
+
+def test_repro():
+    counter_holder["counter"] = 0
+    response = client.get("/test-repro")
+    print(f"Response: {response.json()}, Counter: {counter_holder['counter']}")
+    assert response.json() == {"a1": 1, "a2": 1}
+    assert counter_holder["counter"] == 1
+
+if __name__ == "__main__":
+    try:
+        test_repro()
+        print("SUCCESS")
+    except AssertionError as e:
+        print(f"FAILURE: {e}")
+    except Exception as e:
+        print(f"ERROR: {e}")

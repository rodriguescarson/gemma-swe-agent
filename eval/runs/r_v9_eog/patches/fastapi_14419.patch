@@ -0,0 +1,47 @@
+from fastapi import Depends, FastAPI, Security
+from fastapi.security import SecurityScopes
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+counter_holder = {"counter": 0}
+
+async def dep_no_scope():
+    counter_holder["counter"] += 1
+    return counter_holder["counter"]
+
+async def super_dep_with_scope(security_scopes: SecurityScopes, count: int = Depends(dep_no_scope)):
+    return count
+
+@app.get("/test")
+async def test_endpoint(
+    a: int = Depends(super_dep_with_scope),
+    b: int = Depends(super_dep_with_scope),
+):
+    return {"a": a, "b": b}
+
+client = TestClient(app)
+
+def test_cache_with_scope():
+    counter_holder["counter"] = 0
+    response = client.get("/test")
+    assert response.status_code == 200
+    # super_dep_with_scope depends on dep_no_scope.
+    # super_dep_with_scope uses SecurityScopes.
+    # In the current implementation:
+    # super_dep_with_scope has security_scopes=None (because it's not declared via Security()),
+    # but it uses SecurityScopes.
+    # The cache_key uses self.security_scopes.
+    # If we call super_dep_with_scope twice:
+    # First call:
+    # - a: super_dep_with_scope(SecurityScopes(...), dep_no_scope())
+    #   - dep_no_scope called (1), returns 1.
+    #   - super_dep_with_scope returns 1.
+    # Second call:
+    # - b: super_dep_with_scope(SecurityScopes(...), dep_no_scope())
+    #   - dep_no_scope called (2), returns 2.
+    #   - super_dep_with_scope returns 2.
+    # If cached:
+    # - b: returns 1.
+    assert response.json() == {"a": 1, "b": 1}
+    assert counter_holder["counter"] == 1

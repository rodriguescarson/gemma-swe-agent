--- /dev/null
+++ b/repro2.py
@@ -0,0 +1,13 @@
+from rich.console import Console
+from rich.padding import Padding
+
+c = Console(width=20)
+p = Padding('Hello', (1,1,1,1), expand=False)
+print("Expand=False:")
+for segment in c.render(p):
+    print(f"Segment: {segment}")
+
+p_exp = Padding('Hello', (1,1,1,1), expand=True)
+print("\nExpand=True:")
+for segment in c.render(p_exp):
+    print(f"Segment: {segment}")
diff --git a/repro3.py b/repro3.py
new file mode 100644
index 00000000..b8603a72
--- /dev/null
+++ b/repro3.py
@@ -0,0 +1,13 @@
+from rich.console import Console
+from rich.padding import Padding
+
+c = Console(width=10)
+# Content width should be 10 - 1 - 1 = 8
+# 'This is a long string' (20 chars) will wrap.
+# Measured max width should be 20.
+# min(20 + 1 + 1, 10) = 10.
+# So the blank lines should be 10 spaces.
+p = Padding('This is a long string', (1,1,1,1), expand=False)
+print("Expand=False (Long string):")
+for segment in c.render(p):
+    print(f"Segment: {segment}")

diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..05060880
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,12 @@
+from rich.padding import Padding
+from rich.console import Console
+
+c = Console(width=20, force_terminal=True)
+# expand=False should result in width = measured_max + left + right
+# 'Hello' is 5, left=1, right=1 -> width=7
+p = Padding('Hello', (1, 1, 1, 1), expand=False)
+print(c.render(p))
+
+# expand=True should result in width = options.max_width (20)
+p_expand = Padding('Hello', (1, 1, 1, 1), expand=True)
+print(c.render(p_expand))
diff --git a/repro2.py b/repro2.py

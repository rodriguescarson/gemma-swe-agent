+def is_typealiastype(annotation: Any) -> bool:
+    """Check if the annotation is a PEP 695 TypeAliasType."""
+    if sys.version_info >= (3, 12):
+        return isinstance(annotation, typing.TypeAliasType)
+    return False
+
+
+def get_typealiastype_value(annotation: Any) -> Any:
+    """Get the underlying type of a PEP 695 TypeAliasType."""
+    if is_typealiastype(annotation):
+        return getattr(annotation, "__value__", annotation)
+    return annotation
+
+PYDANTIC_VERSION_MINOR_TUPLE = tuple(int(x) for x in PYDANTIC_VERSION.split("."))[:2]

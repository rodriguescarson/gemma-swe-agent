--- /dev/null
+++ b/repro.py
@@ -0,0 +1,29 @@
+
+from fastapi import FastAPI, Header
+from pydantic import BaseModel
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+class HeaderModel(BaseModel):
+    x_header: str
+
+@app.get("/")
+async def root(headers: HeaderModel = Header()):
+    return {"headers": headers}
+
+client = TestClient(app)
+
+def test_underscore_header():
+    # This should FAIL (be ignored) because convert_underscores=True by default
+    # If the fix works, this request will likely result in a 422 Unprocessable Entity 
+    # because x_header is required but not provided (since x_header in headers is ignored).
+    response = client.get("/", headers={"x_header": "foo"})
+    print(f"Request with x_header: status={response.status_code}, json={response.json()}")
+    
+    # This should SUCCEED
+    response = client.get("/", headers={"x-header": "bar"})
+    print(f"Request with x-header: status={response.status_code}, json={response.json()}")
+
+if __name__ == "__main__":
+    test_underscore_header()

diff --git a/reproduce_pydantic_model.py b/reproduce_pydantic_model.py
new file mode 100644
index 000000000..0c5246fc5
--- /dev/null
+++ b/reproduce_pydantic_model.py
@@ -0,0 +1,42 @@
+from fastapi import FastAPI, Header
+from pydantic import BaseModel
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+class HeaderModel(BaseModel):
+    x_header: str
+
+@app.get("/")
+async def read_root(headers: HeaderModel = Header()):
+    return {"headers": headers}
+
+client = TestClient(app)
+
+def test_headers_underscore():
+    # This should be REJECTED when convert_underscores=True (default)
+    # Because it contains an underscore and we want only hyphens
+    response = client.get("/", headers={"x_header": "foo"})
+    print(f"Underscore header result: {response.json()}")
+    # If it's accepted, it'll be in the response
+    assert response.status_code != 200 or response.json().get("headers") != {"x_header": "foo"}
+
+def test_headers_hyphen():
+    # This should be ACCEPTED and converted to x_header
+    response = client.get("/", headers={"x-header": "bar"})
+    print(f"Hyphen header result: {response.json()}")
+    assert response.status_code == 200
+    assert response.json()["headers"] == {"x_header": "bar"}
+
+if __name__ == "__main__":
+    try:
+        test_headers_underscore()
+        print("test_headers_underscore passed (meaning x_header was NOT accepted)")
+    except AssertionError as e:
+        print(f"test_headers_underscore failed: {e}")
+
+    try:
+        test_headers_hyphen()
+        print("test_headers_hyphen passed")
+    except AssertionError as e:
+        print(f"test_headers_hyphen failed: {e}")

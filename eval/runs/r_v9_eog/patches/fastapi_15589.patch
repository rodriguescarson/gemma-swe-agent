new file mode 100644
index 000000000..8e5c8bc41
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,27 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/")
+async def root(x_header: str = Header(default=None, convert_underscores=True)):
+    return {"x_header": x_header}
+
+client = TestClient(app)
+
+print("Testing with underscore header (should be rejected/None when convert_underscores=True):")
+res_underscore = client.get("/", headers={"x_header": "foo"})
+print(f"Response: {res_underscore.json()}")
+
+print("\nTesting with hyphen header (should be accepted when convert_underscores=True):")
+res_hyphen = client.get("/", headers={"x-header": "bar"})
+print(f"Response: {res_hyphen.json()}")
+
+print("\nTesting with underscore header when convert_underscores=False:")
+app_false = FastAPI()
+@app_false.get("/")
+async def root_false(x_header: str = Header(default=None, convert_underscores=False)):
+    return {"x_header": x_header}
+client_false = TestClient(app_false)
+res_underscore_false = client_false.get("/", headers={"x_header": "foo"})
+print(f"Response: {res_underscore_false.json()}")

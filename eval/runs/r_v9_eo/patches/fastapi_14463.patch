@@ -0,0 +1,61 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+from fastapi.openapi.utils import get_openapi
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+app = FastAPI(
+    responses={
+        500: {
+            'model': ModelA | ModelB,
+            'content': {"application/json": {
+                'examples': {"Case A": {"value": "a"}}
+            }}
+        }
+    }
+)
+
+@app.get('/route1')
+def route1():
+    return "test"
+
+@app.get('/route2')
+def route2():
+    return "test"
+
+@app.get('/route3')
+def route3():
+    return "test"
+
+def test_openapi_responses_duplication():
+    openapi_schema = get_openapi(
+        title=app.title,
+        version=app.version,
+        routes=app.routes,
+    )
+    paths = openapi_schema["paths"]
+    
+    for path, methods in paths.items():
+        for method, operation in methods.items():
+            response_500 = operation["responses"].get("500")
+            assert response_500 is not None
+            content = response_500.get("content", {})
+            json_content = content.get("application/json", {})
+            schema = json_content.get("schema", {})
+            any_of = schema.get("anyOf", [])
+            
+            # We expect exactly 2 refs: ModelA and ModelB
+            assert len(any_of) == 2, f"Path {path} {method} has {len(any_of)} items in anyOf, expected 2"
+            
+            refs = [item.get("$ref") for item in any_of]
+            assert "#/components/schemas/ModelA" in refs
+            assert "#/components/schemas/ModelB" in refs
+
+if __name__ == "__main__":
+    test_openapi_responses_duplication()
+    print("Test passed!")

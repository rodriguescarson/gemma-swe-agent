@@ -0,0 +1,20 @@
+from rich.text import Text, Span
+
+def test_expand_tabs_styles():
+    text = Text("\tHello", style="bold")
+    text.stylize("italic", 0, 1) # style the tab as italic
+    text.expand_tabs(tab_size=4)
+    # Tab is at 0, expanded to 4 spaces. "Hello" starts at 4.
+    # Spans should be: 0-4 italic, 4-9 bold.
+    assert text._spans == [Span(0, 4, "italic"), Span(4, 9, "bold")]
+
+if __name__ == "__main__":
+    try:
+        test_expand_tabs_styles()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        exit(1)

diff --git a/tests/test_validation_error_context.py b/tests/test_validation_error_context.py
new file mode 100644
index 00000000..a1db2030
--- /dev/null
+++ b/tests/test_validation_error_context.py
@@ -0,0 +1,86 @@
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from fastapi.exceptions import RequestValidationError, ResponseValidationError, WebSocketRequestValidationError
+from pydantic import BaseModel
+from fastapi import WebSocket
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    price: float
+
+@app.get("/items/{item_id}")
+async def read_item(item_id: int):
+    return {"item_id": item_id}
+
+@app.post("/items_response/", response_model=Item)
+async def create_item_response(item: Item):
+    return {"name": "Widget"} # Missing 'price'
+
+@app.websocket("/ws/{item_id}")
+async def websocket_endpoint(websocket: WebSocket, item_id: int):
+    await websocket.accept()
+    await websocket.send_text(f"Hello {item_id}")
+
+client = TestClient(app)
+
+def test_validation_exception_str():
+    errors = [{"type": "missing", "loc": ("body", "name"), "msg": "Field required", "input": None}]
+    context = 'File "test.py", line 10, in my_func\nGET /test'
+    
+    rv = RequestValidationError(errors=errors, endpoint_context=context)
+    assert "1 validation error(s):" in str(rv)
+    assert context in str(rv)
+    
+    ov = ResponseValidationError(errors=errors, endpoint_context=context)
+    assert "1 validation error(s):" in str(ov)
+    assert context in str(ov)
+    
+    wv = WebSocketRequestValidationError(errors=errors, endpoint_context=context)
+    assert "1 validation error(s):" in str(wv)
+    assert context in str(wv)
+
+def test_routing_context_extraction():
+    from fastapi.routing import get_endpoint_context
+    
+    # Mock a dependant and scope
+    class MockDependant:
+        def __init__(self, call):
+            self.call = call
+    
+    def my_endpoint():
+        pass
+        
+    dependant = MockDependant(my_endpoint)
+    scope = {
+        "type": "http",
+        "method": "GET",
+        "route": type('Route', (), {'path': '/test-route'})(),
+    }
+    
+    context = get_endpoint_context(dependant, scope)
+    assert 'File' in context
+    assert 'line' in context
+    assert 'my_endpoint' in context
+    assert 'GET /test-route' in context
+
+def test_websocket_context_extraction():
+    from fastapi.routing import get_endpoint_context
+    
+    class MockDependant:
+        def __init__(self, call):
+            self.call = call
+    
+    def my_websocket():
+        pass
+        
+    dependant = MockDependant(my_websocket)
+    scope = {
+        "type": "websocket",
+        "route": type('Route', (), {'path': '/ws-route'})(),
+    }
+    
+    context = get_endpoint_context(dependant, scope)
+    assert 'WS /ws-route' in context

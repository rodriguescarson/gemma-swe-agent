@@ -23,6 +23,45 @@ from typing import (
     Union,
 )
 
+_ENDPOINT_CONTEXT_CACHE: Dict[Any, str] = {}
+
+
+def get_endpoint_context(dependant: Dependant, scope: Scope) -> str:
+    endpoint = dependant.call
+    if endpoint in _ENDPOINT_CONTEXT_CACHE:
+        return _ENDPOINT_CONTEXT_CACHE[endpoint]
+
+    try:
+        frame = inspect.getframeinfo(endpoint)
+        filepath = frame.filename
+        line_number = frame.lineno
+        function_name = endpoint.__name__
+        
+        # Try to get the route and method
+        method = \"UNKNOWN\"
+        path = \"UNKNOWN\"
+        
+        # In Starlette, scope['path'] is the request path. 
+        # But we want the route pattern (e.g. /users/{user_id})
+        # The route is usually available in scope['route'] if matched
+        route = scope.get(\"route\")
+        if route:
+            path = route.path
+            # The method is in scope['method']
+            method = scope.get(\"method\", \"UNKNOWN\")
+        
+        # Special case for WebSockets
+        if scope.get(\"type\") == \"websocket\":
+            method = \"WS\"
+            
+        context = f'File \"{filepath}\", line {line_number}, in {function_name}\\n    {method} {path}'
+    except Exception:
+        context = \"Unknown endpoint context\"
+
+    _ENDPOINT_CONTEXT_CACHE[endpoint] = context
+    return context
+

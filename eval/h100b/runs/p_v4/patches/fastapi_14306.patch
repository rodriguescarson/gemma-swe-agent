--- /dev/null
+++ b/test_endpoint_metadata.py
@@ -0,0 +1,52 @@
+
+from fastapi import FastAPI
+from fastapi.exceptions import RequestValidationError
+from pydantic import BaseModel
+import pytest
+from httpx import AsyncClient
+
+class Item(BaseModel):
+    item_id: int
+
+app = FastAPI()
+
+@app.get("/test-request")
+async def test_request(item_id: int):
+    return {"item_id": item_id}
+
+def test_request_validation_error():
+    # Using sync client for simplicity as we don't need async for this
+    # Note: AsyncClient(app=app) is for httpx versions that support it, 
+    # usually we use transport=ASGITransport(app=app) in newer versions.
+    from httpx import ASGITransport
+    with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as ac:
+        # We use a sync context for simplicity in the check but AsyncClient is async
+        # Actually, just use the manual exception check for the logic.
+        pass
+
+def test_manual_validation_error_str():
+    try:
+        raise RequestValidationError(
+            errors=[{"type": "int_parsing"}], 
+            endpoint_context="File 'test.py', line 1, in test_request\nGET /test-request"
+        )
+    except RequestValidationError as e:
+        err_str = str(e)
+        assert "1 validation errors" in err_str
+        assert "File 'test.py', line 1, in test_request" in err_str
+        assert "GET /test-request" in err_str
+
+def test_endpoint_context_extraction():
+    from fastapi.routing import get_endpoint_context
+    
+    def dummy_endpoint():
+        pass
+    
+    context = get_endpoint_context(dummy_endpoint, "GET", "/dummy")
+    assert "File" in context
+    assert "dummy_endpoint" in context
+    assert "GET /dummy" in context
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__])

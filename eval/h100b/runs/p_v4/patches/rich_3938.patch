@@ -0,0 +1,26 @@
+from rich.console import Console
+from io import StringIO
+
+def test_soft_wrap_background():
+    console = Console(width=10, file=StringIO())
+    # This should wrap at 10 chars. 
+    # With soft_wrap=True, rich doesn't wrap, but we want to see how background behaves.
+    # If we have a background style and it's long, some terminals might not wrap the background.
+    # Rich's fix is to split by '\n' if they exist, or essentially ensure the style is preserved.
+    # Wait, the issue was specifically about background styles NOT persisting across wrapped lines.
+    # But soft_wrap=True tells the TERMINAL to wrap. 
+    # If rich splits the segments into lines based on '\n' already in the text, 
+    # then the background style is repeated for each line.
+    
+    text = "line 1\nline 2"
+    console.print(text, style="on red", soft_wrap=True)
+    result = console.file.getvalue()
+    
+    # We expect the 'on red' style to be applied to both lines.
+    # \x1b[41m is red background. \x1b[0m is reset.
+    assert "\x1b[41mline 1\x1b[0m" in result
+    assert "\x1b[41mline 2\x1b[0m" in result
+
+if __name__ == "__main__":
+    test_soft_wrap_background()
+    print("Test passed!")

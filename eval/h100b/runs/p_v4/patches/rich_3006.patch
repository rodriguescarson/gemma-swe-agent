--- /dev/null
+++ b/tests/test_custom_repr_issue.py
@@ -0,0 +1,26 @@
+
+import pytest
+import rich.repr
+
+class CustomParam:
+    def __eq__(self, other):
+        return True
+
+@rich.repr.auto
+class CustomClass:
+    def __init__(self, a, b=CustomParam()):
+        self.a = a
+        self.b = b
+
+def test_custom_class_repr():
+    obj = CustomClass(1)
+    # If param.default == param.empty is True, it will yield only 'a'
+    # If it's False, it should yield 'a' and 'b=CustomParam()'
+    # Expected: CustomClass(1, b=<repr of CustomParam>)
+    # Actual bug: it might treat b as empty and skip it or yield just value.
+    # Based on the issue, it yields as if it's empty.
+    r = repr(obj)
+    assert "b=" in r, f"Expected 'b=' in repr, got {r}"
+
+if __name__ == "__main__":
+    test_custom_class_repr()

diff --git a/tests/test_json_form.py b/tests/test_json_form.py
new file mode 100644
index 00000000..9d3d5f7b
--- /dev/null
+++ b/tests/test_json_form.py
@@ -0,0 +1,38 @@
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from pydantic import Json
+from typing import Annotated
+from fastapi import UploadFile
+
+app = FastAPI()
+
+@app.post("/upload")
+def upload(
+    file: UploadFile,
+    tags: Annotated[Json[list[str]], Form()]
+):
+    return {"file": file.filename, "tags": tags}
+
+client = TestClient(app)
+
+def test_json_form():
+    # Create a dummy file
+    file_content = b"hello"
+    file_name = "test.txt"
+    
+    # The 'tags' field should be sent as a JSON string in the form data
+    # tags=["abc", "def"] as a JSON string is '["abc", "def"]'
+    data = {
+        "tags": '["abc", "def"]'
+    }
+    files = {
+        "file": (file_name, file_content)
+    }
+    
+    response = client.post("/upload", data=data, files=files)
+    assert response.status_code == 200
+    assert response.json() == {"file": file_name, "tags": ["abc", "def"]}
+
+if __name__ == "__main__":
+    test_json_form()
+    print("Test passed!")
diff --git a/tests/test_json_form_debug.py b/tests/test_json_form_debug.py
new file mode 100644
index 00000000..47070ce3
--- /dev/null
+++ b/tests/test_json_form_debug.py
@@ -0,0 +1,38 @@
+from fastapi import FastAPI, Form, UploadFile
+from fastapi.testclient import TestClient
+from pydantic import Json
+from typing import Annotated
+import logging
+
+# Configure logging to see errors from FastAPI/Pydantic
+logging.basicConfig(level=logging.DEBUG)
+
+app = FastAPI()
+
+@app.post("/upload")
+def upload(
+    file: UploadFile,
+    tags: Annotated[Json[list[str]], Form()]
+):
+    return {"file": file.filename, "tags": tags}
+
+client = TestClient(app)
+
+def test_json_form():
+    data = {"tags": '["abc", "def"]'}
+    files = {"file": ("test.txt", b"hello")}
+    print(f"Sending request with data: {data} and files: {files}")
+    response = client.post("/upload", data=data, files=files)
+    print(f"Response status code: {response.status_code}")
+    print(f"Response text: {response.text}")
+    assert response.status_code == 200
+    assert response.json() == {"file": "test.txt", "tags": ["abc", "def"]}
+
+if __name__ == "__main__":
+    try:
+        test_json_form()
+        print("Test passed!")
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
+        exit(1)

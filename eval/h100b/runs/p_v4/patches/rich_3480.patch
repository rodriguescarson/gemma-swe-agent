+from rich.text import Text
+import time
+
+def test_infinite_loop():
+    text = Text("Hello")
+    # Appending the same Text instance to itself
+    # This is a common cause of infinite loops in such structures
+    text.append(text) 
+    print("Finished appending")
+
+if __name__ == "__main__":
+    try:
+        test_infinite_loop()
+    except Exception as e:
+        print(f"Caught exception: {e}")

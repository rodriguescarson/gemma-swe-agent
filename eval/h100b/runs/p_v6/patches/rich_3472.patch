--- /dev/null
+++ b/test_fix.py
@@ -0,0 +1,14 @@
+from rich.pretty import Pretty
+from attrs import define, field
+from rich import print
+
+@define
+class MyAttr:
+    a = field(default=1, repr=False)
+    b = field(default=2, repr=False)
+
+obj = MyAttr()
+pretty_repr = Pretty(obj)
+print(f"Repr: {repr(pretty_repr)}")
+# We want to see MyAttr() in the output when printed
+print(pretty_repr)
diff --git a/tests/repro_dataclass.py b/tests/repro_dataclass.py
new file mode 100644
index 00000000..805c687f
--- /dev/null
+++ b/tests/repro_dataclass.py
@@ -0,0 +1,17 @@
+from dataclasses import dataclass, field
+from rich.pretty import Pretty
+from rich.console import Console
+
+@dataclass
+class A:
+    x: int = field(repr=False)
+
+def test_repro():
+    a = A(x=1)
+    console = Console()
+    print("--- Result ---")
+    console.print(Pretty(a))
+    print("--- End ---")
+
+if __name__ == "__main__":
+    test_repro()

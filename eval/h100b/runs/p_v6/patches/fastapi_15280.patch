diff --git a/test_vibe.py b/test_vibe.py
new file mode 100644
index 000000000..4d94146ab
--- /dev/null
+++ b/test_vibe.py
@@ -0,0 +1,19 @@
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.vibe("/")
+def read_vibe():
+    return {"vibe": "good"}
+
+client = TestClient(app)
+
+def test_vibe():
+    response = client.request("VIBE", "/")
+    assert response.status_code == 200
+    assert response.json() == {"vibe": "good"}
+
+if __name__ == "__main__":
+    test_vibe()
+    print("Test passed!")

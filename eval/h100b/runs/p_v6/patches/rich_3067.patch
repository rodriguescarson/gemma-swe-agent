index 00000000..32d6c795
--- /dev/null
+++ b/repro_tilde.py
@@ -0,0 +1,18 @@
+from rich.highlighter import ReprHighlighter
+from rich.text import Text
+
+def test_tilde_in_url():
+    highlighter = ReprHighlighter()
+    url = "https://example.com/~user"
+    text = Text(url)
+    highlighter.highlight(text)
+    # Check if the whole URL is highlighted as repr.url
+    # text.spans should contain a Span from 0 to 24 with style "repr.url"
+    assert len(text.spans) > 0
+    assert text.spans[0].style == "repr.url"
+    assert text.spans[0].start == 0
+    assert text.spans[0].end == len(url)
+
+if __name__ == "__main__":
+    test_tilde_in_url()
+    print("Test passed!")

+import pytest
+from rich.console import Console
+from rich.text import Text
+
+def test_cjk_disappearing_when_wrapping():
+    # 5 CJK characters = 10 cells.
+    # Word length 10, width 5.
+    text = "こんにちは" # 5 chars, 10 cells
+    console = Console(width=5, force_terminal=True)
+    t = Text(text)
+    wrapped = t.wrap(console, 5)
+    full_text = "".join([line.plain for line in wrapped])
+    assert full_text == text
+
+def test_mixed_cjk_disappearing():
+    # Mixed single and double width
+    text = "abcこんにちは"
+    console = Console(width=5, force_terminal=True)
+    t = Text(text)
+    wrapped = t.wrap(console, 5)
+    full_text = "".join([line.plain for line in wrapped])
+    assert full_text == text
+
+def test_cjk_wrap_mid_character():
+    text = "あああああ" # 10 cells
+    console = Console(width=3, force_terminal=True)
+    t = Text(text)
+    wrapped = t.wrap(console, 3)
+    full_text = "".join([line.plain for line in wrapped])
+    assert full_text == text

+from rich._wrap import divide_line
+
+def test_cjk_disappearance():
+    text = "ABCこんにちは"
+    width = 5
+    divides = divide_line(text, width, True)
+    
+    lines = []
+    last = 0
+    for d in divides:
+        lines.append(text[last:d])
+        last = d
+    lines.append(text[last:])
+    
+    print(f"Text: {text}")
+    print(f"Width: {width}")
+    print(f"Divides: {divides}")
+    print(f"Lines: {lines}")
+
+if __name__ == "__main__":
+    test_cjk_disappearance()

@@ -0,0 +1,47 @@
+import pytest
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+from typing import Optional
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    description: Optional[str] = None
+
+@app.post("/items/")
+async def create_item(item: Item = Form(...)):
+    return item
+
+client = TestClient(app)
+
+def test_form_empty_string_interpreted_as_none():
+    # Case 1: description is missing
+    response = client.post("/items/", data={"name": "test"})
+    assert response.status_code == 200
+    assert response.json() == {"name": "test", "description": None}
+
+    # Case 2: description is empty string
+    response = client.post("/items/", data={"name": "test", "description": ""})
+    assert response.status_code == 200
+    assert response.json() == {"name": "test", "description": None}
+
+def test_form_description_provided():
+    response = client.post("/items/", data={"name": "test", "description": "hello"})
+    assert response.status_code == 200
+    assert response.json() == {"name": "test", "description": "hello"}
+
+if __name__ == "__main__":
+    try:
+        test_form_empty_string_interpreted_as_none()
+        print("test_form_empty_string_interpreted_as_none: PASSED")
+        test_form_description_provided()
+        print("test_form_description_provided: PASSED")
+        print("ALL TESTS PASSED")
+    except AssertionError as e:
+        print(f"TEST FAILED: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"UNEXPECTED ERROR: {e}")
+        exit(1)

+from rich.text import Text
+import pytest
+
+def test_private_escape_sequences():
+    # \x1b7 stores cursor position, \x1b8 restores it.
+    # The issue says \x1b0 to \x1b? should be stripped.
+    # \x1b7 is 7, \x1b8 is 8. Both are in range 0-63 (0x3f).
+    ansi_text = "Hello \x1b7World \x1b8!"
+    text = Text.from_ansi(ansi_text)
+    assert str(text) == "Hello World !"
+
+    ansi_text_range = "".join(chr(0x1b) + chr(i) for i in range(64)) # \x1b0 to \x1b?
+    text_range = Text.from_ansi(ansi_text_range)
+    assert str(text_range) == ""
+

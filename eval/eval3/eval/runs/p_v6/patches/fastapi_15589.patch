index 000000000..5cc95f37f
--- /dev/null
+++ b/tests/test_reproduce_underscore_header.py
@@ -0,0 +1,26 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.get("/header")
+async def read_header(strange_header: str = Header()):
+    return {"strange_header": strange_header}
+
+@app.get("/header_allowed")
+async def read_header_allowed(strange_header: str = Header(convert_underscores=False)):
+    return {"strange_header": strange_header}
+
+def test_header_underscores_not_accepted_by_default():
+    client = TestClient(app)
+    # SHOULD FAIL: underscore (this is what we want to ensure)
+    response = client.get("/header", headers={"strange_header": "value"})
+    assert response.status_code == 422, f"Should have failed with 422, but got {response.status_code}"
+
+def test_header_underscores_accepted_when_explicitly_allowed():
+    client = TestClient(app)
+    # SHOULD WORK: underscore when convert_underscores=False
+    response = client.get("/header_allowed", headers={"strange_header": "value"})
+    assert response.status_code == 200, f"Should have worked with 200, but got {response.status_code}: {response.text}"
+    assert response.json() == {"strange_header": "value"}

new file mode 100644
index 000000000..59c8030ad
--- /dev/null
+++ b/repro_test.py
@@ -0,0 +1,41 @@
+
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/")
+async def read_root(x_test_header: str = Header()):
+    return {"x_test_header": x_test_header}
+
+@app.get("/explicit")
+async def read_explicit(x_test_header: str = Header(convert_underscores=False)):
+    return {"x_test_header": x_test_header}
+
+client = TestClient(app)
+
+def test_default_behavior():
+    # Should fail (422) when sending underscore header by default
+    response = client.get("/", headers={"x_test_header": "hello"})
+    print(f"Default underscore header: {response.status_code}")
+    assert response.status_code == 422
+
+    # Should pass (200) when sending hyphenated header by default
+    response = client.get("/", headers={"x-test-header": "hello"})
+    print(f"Default hyphenated header: {response.status_code}")
+    assert response.status_code == 200
+
+def test_explicit_behavior():
+    # Should pass (200) when convert_underscores=False
+    response = client.get("/explicit", headers={"x_test_header": "hello"})
+    print(f"Explicit underscore header: {response.status_code}")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    try:
+        test_default_behavior()
+        test_explicit_behavior()
+        print("All tests passed!")
+    except AssertionError as e:
+        print("Test failed!")
+        raise e

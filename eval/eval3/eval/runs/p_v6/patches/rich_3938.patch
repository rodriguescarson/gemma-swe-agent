+from rich.console import Console
+import io
+
+def test_background_soft_wrap():
+    console = Console(width=10, file=io.StringIO())
+    # Test with a style that has a background color
+    # Using markup to set background color
+    console.print("[bg=red]This is a long text that should soft wrap[/]", soft_wrap=True)
+    output = console.file.getvalue()
+    print(f"Output: {repr(output)}")
+    # With soft_wrap=True, it should not be cropped.
+    # If it's working correctly, it should contain the full text.
+    assert "soft wrap" in output
+
+if __name__ == "__main__":
+    test_background_soft_wrap()

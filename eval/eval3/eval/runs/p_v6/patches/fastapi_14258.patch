+++ b/tests/test_circular_router.py
@@ -0,0 +1,14 @@
+from fastapi import FastAPI, APIRouter
+from fastapi.exceptions import FastAPIError
+import pytest
+
+def test_include_router_itself():
+    app = FastAPI()
+    router = APIRouter()
+    with pytest.raises(FastAPIError, match="Cannot include a router into itself"):
+        router.include_router(router)
+
+def test_fastapi_include_itself():
+    app = FastAPI()
+    with pytest.raises(FastAPIError, match="Cannot include a router into itself"):
+        app.include_router(app)

diff --git a/test_endpoint_context.py b/test_endpoint_context.py
new file mode 100644
index 00000000..8478afe4
--- /dev/null
+++ b/test_endpoint_context.py
@@ -0,0 +1,80 @@
+from fastapi import FastAPI, Request
+from fastapi.exceptions import RequestValidationError, ResponseValidationError
+from pydantic import BaseModel, Field
+import pytest
+import asyncio
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    id: int
+
+@app.get("/invalid-response", response_model=Item)
+async def invalid_response():
+    return {'name': 'Widget'} # missing id
+
+def test_request_validation_error_context():
+    # Trigger RequestValidationError by providing wrong type to a path param
+    @app.get("/int-param/{item_id}")
+    async def get_int_param(item_id: int):
+        return {"item_id": item_id}
+    
+    from fastapi.routing import get_request_handler
+    from starlette.requests import Request
+    
+    scope = {
+        'type': 'http',
+        'method': 'GET',
+        'path': '/int-param/abc',
+        'raw_path': '/int-param/abc',
+        'query_string': b'',
+    }
+    request = Request(scope)
+    
+    route = next(r for r in app.routes if r.path == '/int-param/{item_id}')
+    dependant = route.dependant
+    handler = get_request_handler(dependant, route)
+    
+    try:
+        asyncio.run(handler(request))
+    except RequestValidationError as exc:
+        str_exc = str(exc)
+        print(f'DEBUG: Exception string: {str_exc}')
+        assert 'File' in str_exc
+        assert 'line' in str_exc
+        assert 'get_int_param' in str_exc
+        assert 'GET' in str_exc
+        return
+
+    pytest.fail('RequestValidationError not raised')
+
+def test_response_validation_error_context():
+    from fastapi.routing import get_request_handler
+    from starlette.requests import Request
+    
+    scope = {
+        'type': 'http',
+        'method': 'GET',
+        'path': '/invalid-response',
+        'raw_path': '/invalid-response',
+        'query_string': b'',
+    }
+    request = Request(scope)
+    
+    route = next(r for r in app.routes if r.path == '/invalid-response')
+    dependant = route.dependant
+    handler = get_request_handler(dependant, route)
+    
+    try:
+        asyncio.run(handler(request))
+    except ResponseValidationError as exc:
+        str_exc = str(exc)
+        print(f'DEBUG: Exception string: {str_exc}')
+        assert 'File' in str_exc
+        assert 'line' in str_exc
+        assert 'invalid_response' in str_exc
+        assert 'GET' in str_exc
+        return
+
+    pytest.fail('ResponseValidationError not raised')

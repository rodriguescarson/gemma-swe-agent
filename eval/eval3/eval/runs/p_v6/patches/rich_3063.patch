@@ -0,0 +1,16 @@
+from rich.markup import render
+
+test_cases = [
+    ("\\\\", "\\"),
+    ("foo\\\\", "foo\\"),
+    ("\\\\\\\\", "\\\\"),
+    ("foo\\\\bar", "foo\\bar"),
+    ("\\\\[", "["),
+    ("\\\\\\\\[", "\\["),
+]
+
+for input_str, expected in test_cases:
+    actual = render(input_str).plain
+    assert actual == expected, f"Failed on {repr(input_str)}: expected {repr(expected)}, got {repr(actual)}"
+
+print("All tests passed!")

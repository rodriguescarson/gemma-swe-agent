+++ b/repro.py
@@ -0,0 +1,23 @@
+from rich.repr import auto
+import inspect
+
+class CustomClass:
+    def __init__(self, value):
+        self.value = value
+    def __eq__(self, other):
+        return True
+
+@auto
+class Container:
+    def __init__(self, param: CustomClass = CustomClass(0)):
+        self.param = param
+
+def test_custom_class_repr():
+    obj = CustomClass(1)
+    container = Container(obj)
+    repr_str = repr(container)
+    print(f"Repr: {repr_str}")
+    assert "param" in repr_str
+
+if __name__ == "__main__":
+    test_custom_class_repr()

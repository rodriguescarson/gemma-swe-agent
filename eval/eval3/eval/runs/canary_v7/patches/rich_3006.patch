@@ -0,0 +1,24 @@
+
+import pytest
+from rich.repr import auto
+
+class CustomClass:
+    def __init__(self, value):
+        self.value = value
+    def __eq__(self, other):
+        return True
+
+@auto
+class Container:
+    def __init__(self, param: CustomClass = CustomClass(0)):
+        self.param = param
+
+def test_custom_class_repr():
+    obj = CustomClass(1)
+    container = Container(obj)
+    # Now param.default is CustomClass(0)
+    # CustomClass.__eq__ always returns True, so CustomClass(0) == param.empty
+    # might be True if param.empty is compared via CustomClass.__eq__
+    repr_str = repr(container)
+    assert "param" in repr_str
+    assert "CustomClass" in repr_str

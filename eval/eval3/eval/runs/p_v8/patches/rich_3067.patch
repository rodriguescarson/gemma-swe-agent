diff --git a/tests/reproduce_tilde.py b/tests/reproduce_tilde.py
new file mode 100644
index 00000000..7df99968
--- /dev/null
+++ b/tests/reproduce_tilde.py
@@ -0,0 +1,19 @@
+from rich.highlighter import ReprHighlighter
+from rich.text import Text
+
+def test_tilde_url():
+    highlighter = ReprHighlighter()
+    text = Text("Visit http://example.com/~user")
+    highlighted = highlighter.highlight(text)
+    # The URL should be highlighted. 
+    # In ReprHighlighter, the url regex is applied.
+    # We expect the span to cover the whole URL.
+    for span in highlighted.spans:
+        if span.style == "repr.url":
+            assert text.slice(span.start, span.end) == "http://example.com/~user"
+            return
+    raise AssertionError("URL with tilde was not highlighted")
+
+if __name__ == "__main__":
+    test_tilde_url()
+    print("Test passed!")

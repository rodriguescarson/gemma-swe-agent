diff --git a/test_json_form.py b/test_json_form.py
new file mode 100644
index 00000000..a15f794b
--- /dev/null
+++ b/test_json_form.py
@@ -0,0 +1,35 @@
+
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from pydantic import Json
+from typing import Annotated
+import pytest
+
+app = FastAPI()
+
+@app.post("/upload")
+def upload(
+    tags: Annotated[Json[list[str]], Form()]
+):
+    return {"tags": tags}
+
+client = TestClient(app)
+
+def test_json_list_form():
+    # The client sends a form field 'tags' containing a JSON string
+    # If FastAPI incorrectly uses getlist(), it will wrap this string in a list
+    # which Pydantic Json will fail to parse.
+    response = client.post(
+        "/upload",
+        data={"tags": '["abc", "def"]'}
+    )
+    assert response.status_code == 200
+    assert response.json() == {"tags": ["abc", "def"]}
+
+if __name__ == "__main__":
+    try:
+        test_json_list_form()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)

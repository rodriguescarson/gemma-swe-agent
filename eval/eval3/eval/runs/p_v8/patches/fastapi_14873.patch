diff --git a/tests/test_reproduce_issue.py b/tests/test_reproduce_issue.py
new file mode 100644
index 00000000..2e7cf5d0
--- /dev/null
+++ b/tests/test_reproduce_issue.py
@@ -0,0 +1,15 @@
+import pytest
+from fastapi import FastAPI
+from httpx import AsyncClient
+
+def s_start():
+    s_start.called = True
+s_start.called = False
+
+async def test_startup_event_called():
+    app = FastAPI(on_startup=[s_start])
+
+    async with AsyncClient(app=app, base_url="http://test") as ac:
+        await ac.get("/health")
+
+    assert s_start.called is True

diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..2f369d4f
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,31 @@
+
+import pytest
+from rich.cells import split_graphemes
+
+def test_infinite_loop_zwj():
+    # ZWJ at the start
+    split_graphemes("\u200dABC")
+    # ZWJ in middle
+    split_graphemes("A\u200dB")
+
+def test_infinite_loop_vs16():
+    # VS16 at the start
+    split_graphemes("\ufe0fABC")
+    # VS16 in middle
+    split_graphemes("A\ufe0fB")
+
+def test_infinite_loop_zero_width():
+    # Zero width character that is not in SPECIAL
+    # \u200b is zero width space
+    split_graphemes("\u200bABC")
+    split_graphemes("A\u200bB")
+
+if __name__ == "__main__":
+    try:
+        test_infinite_loop_zwj()
+        test_infinite_loop_vs16()
+        test_infinite_loop_zero_width()
+        print("All reproduction tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)

+from rich.cells import split_graphemes
+
+def test_infinite_loop():
+    print("Testing with ZWJ at start...")
+    # Case 1: ZWJ at the beginning of the string
+    split_graphemes("\u200d")
+    print("Case 1 passed")
+
+    print("Testing with FE0F at start...")
+    # Case 2: FE0F at the beginning of the string
+    split_graphemes("\ufe0f")
+    print("Case 2 passed")
+
+    print("Testing with ZWJ followed by something...")
+    # Case 3: ZWJ followed by character
+    split_graphemes("\u200dA")
+    print("Case 3 passed")
+
+if __name__ == "__main__":
+    try:
+        test_infinite_loop()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)

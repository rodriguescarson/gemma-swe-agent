+
+import asyncio
+from fastapi import FastAPI, Request, WebSocket, HTTPException
+from fastapi.exceptions import RequestValidationError, ResponseValidationError, WebSocketRequestValidationError
+from pydantic import BaseModel
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    id: int
+
+@app.get("/users/{user_id}")
+async def get_user(user_id: int):
+    return {"user_id": user_id}
+
+@app.post("/items/")
+async def create_item(item: Item):
+    return item
+
+@app.get("/items-response-error-fixed", response_model=Item)
+async def response_error_fixed():
+    return {"name": "Widget"} # Missing 'id'
+
+@app.websocket("/ws/{item_id}")
+async def websocket_endpoint(websocket: WebSocket, item_id: int):
+    await websocket.accept()
+    await websocket.send_text(f"Item ID: {item_id}")
+    await websocket.close()
+
+async def test_exceptions():
+    print("Testing RequestValidationError...")
+    try:
+        # We pass the endpoint_context as it should be passed by the routing logic
+        raise RequestValidationError(errors=[], endpoint_context="File \"test.py\", line 10, in get_user\nGET /users/{user_id}")
+    except RequestValidationError as e:
+        print(f"Caught: {e}")
+
+    print("\nTesting ResponseValidationError...")
+    try:
+        raise ResponseValidationError(errors=[], endpoint_context="File \"test.py\", line 25, in response_error_fixed\nGET /items-response-error-fixed")
+    except ResponseValidationError as e:
+        print(f"Caught: {e}")
+
+    print("\nTesting WebSocketRequestValidationError...")
+    try:
+        raise WebSocketRequestValidationError(errors=[], endpoint_context="File \"test.py\", line 30, in websocket_endpoint\nWS /ws/{item_id}")
+    except WebSocketRequestValidationError as e:
+        print(f"Caught: {e}")
+
+if __name__ == "__main__":
+    asyncio.run(test_exceptions())

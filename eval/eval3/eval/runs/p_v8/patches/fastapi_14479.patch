index 00000000..e2babd5e
--- /dev/null
+++ b/tests/test_issue_reproduce.py
@@ -0,0 +1,30 @@
+from typing import Annotated, Any
+from fastapi import FastAPI, Query
+from pydantic import BeforeValidator, WithJsonSchema
+import pytest
+
+app = FastAPI()
+
+FilterableStr = Annotated[
+    str | dict,
+    BeforeValidator(lambda x: x),
+    WithJsonSchema({"type": "string"}, mode="serialization"),
+]
+
+@app.get("/hello")
+async def get_hello(data: FilterableStr | None = Query(default=None)) -> Any:
+    return data
+
+def test_startup_crash():
+    try:
+        # Triggering the creation of the dependant
+        for route in app.routes:
+            if hasattr(route, "dependant"):
+                _ = route.dependant
+    except AssertionError as e:
+        assert str(e) == "Query param 'data' must be of one of the supported types"
+        return
+    except AssertionError:
+        pytest.fail("AssertionError raised but without the expected error message")
+    except Exception as e:
+        pytest.fail(f"Unexpected exception raised: {e}")

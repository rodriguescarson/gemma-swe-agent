@@ -0,0 +1,18 @@
+import inspect
+from rich.repr import auto
+
+class CustomParam:
+    def __init__(self, value):
+        self.value = value
+    def __eq__(self, other):
+        return True
+    def __repr__(self):
+        return "CustomParam()"
+
+@auto
+class Foo:
+    def __init__(self, x=CustomParam(1)):
+        self.x = x
+
+foo = Foo()
+print(f"repr(foo): {repr(foo)}")

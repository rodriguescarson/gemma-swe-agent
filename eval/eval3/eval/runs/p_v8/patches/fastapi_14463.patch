@@ -0,0 +1,41 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+app = FastAPI(
+    responses={
+        500: {
+            "model": ModelA | ModelB,
+            "content": {"application/json": {
+                "examples": {"Case A": {"value": "a"}}
+            }}
+        }
+    }
+)
+
+@app.get("/route1")
+def route1():
+    return "test"
+
+@app.get("/route2")
+def route2():
+    return "test"
+
+@app.get("/route3")
+def route3():
+    return "test"
+
+openapi_schema = app.openapi()
+response_500 = openapi_schema["paths"]["/route1"]["get"]["responses"]["500"]
+any_of_len = len(response_500["content"]["application/json"]["schema"]["anyOf"])
+print(f"AnyOf length: {any_of_len}")
+if any_of_len > 2:
+    print("ISSUE REPRODUCED")
+else:
+    print("ISSUE NOT REPRODUCED")

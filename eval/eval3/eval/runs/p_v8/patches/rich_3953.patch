@@ -0,0 +1,22 @@
+from rich.cells import cell_len
+
+def test_zwj_basic():
+    # ZWJ should have 0 width
+    assert cell_len("\u200d") == 0
+    # Normal character + ZWJ + Normal character should be 2
+    assert cell_len("A\u200dA") == 2
+
+def test_zwj_emoji():
+    # Man + ZWJ + Bald = Bald Man (should be 2 usually, but depends on terminal)
+    # In rich's logic, let's see what it does.
+    # 👨 (U+1F468) is 2, ZWJ is 0, 🧑‍ Bald (U+1F9B2) is 2
+    # The current logic for ZWJ in _cell_len:
+    # if character == "\u200d": next(iter_characters)
+    # This skips the NEXT character!
+    text = "\U0001F468\u200d\U0001F9B2"
+    print(f"Length of {repr(text)}: {cell_len(text)}")
+
+if __name__ == "__main__":
+    test_zwj_basic()
+    test_zwj_emoji()
+    print("Tests passed!")

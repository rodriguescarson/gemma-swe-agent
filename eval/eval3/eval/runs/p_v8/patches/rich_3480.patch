@@ -0,0 +1,14 @@
+from rich.text import Text
+import pytest
+
+def test_append_self():
+    text = Text("foo")
+    # To trigger a potential infinite loop if the implementation iterates over itself
+    # and appends to itself. 
+    # But Text.append currently just appends text.plain and extends spans.
+    # Let's check if it can loop.
+    text.append(text)
+    print(f"Text content: {text.plain}")
+
+if __name__ == "__main__":
+    pytest.main([__file__])

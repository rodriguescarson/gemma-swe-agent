diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..f69e0800
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,58 @@
+import asyncio
+import inspect
+from fastapi.dependencies.models import Dependant
+
+def iscoroutinefunction(func):
+    return inspect.iscoroutinefunction(func)
+
+def _impartial(call):
+    return call
+
+def _unwrapped_call(call):
+    return call
+
+class Dependant:
+    def __init__(self, call):
+        self.call = call
+
+    def is_gen_callable(self) -> bool:
+        if self.call is None:
+            return False
+        dunder_call = getattr(_impartial(self.call), "__call__", None)
+        if dunder_call is None:
+            return False
+        if inspect.isgeneratorfunction(_impartial(dunder_call)) or inspect.isgeneratorfunction(_unwrapped_call(dunder_call)):
+            return True
+        return False
+
+    def is_async_gen_callable(self) -> bool:
+        if self.call is None:
+            return False
+        dunder_call = getattr(_impartial(self.call), "__call__", None)
+        if dunder_call is None:
+            return False
+        if inspect.isasyncgenfunction(_impartial(dunder_call)) or inspect.isasyncgenfunction(_unwrapped_call(dunder_call)):
+            return True
+        return False
+
+    def is_coroutine_callable(self) -> bool:
+        if self.call is None:
+            return False
+        dunder_call = getattr(_impartial(self.call), "__call__", None)
+        if dunder_call is None:
+            return False
+        if iscoroutinefunction(_impartial(dunder_call)) or iscoroutinefunction(_unwrapped_call(dunder_call)):
+            return True
+        return False
+
+class MyDependency:
+    async def __call__(self):
+        return 'hello'
+
+# The issue: Using the CLASS as a dependency
+dep_class = Dependant(call=MyDependency)
+print(f"Class as dependency is_coroutine_callable: {dep_class.is_coroutine_callable()}")
+
+# Correct behavior: An instance should be a coroutine callable
+dep_inst = Dependant(call=MyDependency())
+print(f"Instance as dependency is_coroutine_callable: {dep_inst.is_coroutine_callable()}")

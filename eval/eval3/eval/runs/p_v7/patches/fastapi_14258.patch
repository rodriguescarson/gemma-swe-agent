+++ b/test_circular_router.py
@@ -0,0 +1,17 @@
+from fastapi import APIRouter
+from fastapi.exceptions import FastAPIError
+import pytest
+
+def test_include_router_self():
+    router = APIRouter()
+    with pytest.raises(FastAPIError) as excinfo:
+        router.include_router(router)
+    assert str(excinfo.value) == "APIRouter cannot include itself"
+
+if __name__ == "__main__":
+    try:
+        test_include_router_self()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e

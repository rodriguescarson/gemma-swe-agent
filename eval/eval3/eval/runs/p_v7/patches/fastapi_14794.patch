diff --git a/tests/test_response_dependency.py b/tests/test_response_dependency.py
new file mode 100644
index 00000000..933dde29
--- /dev/null
+++ b/tests/test_response_dependency.py
@@ -0,0 +1,37 @@
+from fastapi import FastAPI, Depends, Response
+from fastapi.testclient import TestClient
+from typing import Annotated
+
+app = FastAPI()
+
+def modify_response(response: Response):
+    response.headers["X-Custom-Header"] = "CustomValue"
+    return response
+
+@app.get("/test-response")
+def test_response(response: Annotated[Response, Depends(modify_response)]):
+    return {"message": "success"}
+
+@app.get("/test-response-old")
+def test_response_old(response: Response = Depends(modify_response)):
+    return {"message": "success"}
+
+@app.get("/test-response-normal")
+def test_response_normal(response: Response):
+    return {"message": "success"}
+
+client = TestClient(app)
+
+def test_response_dependency():
+    response = client.get("/test-response")
+    assert response.status_code == 200
+    assert response.headers["X-Custom-Header"] == "CustomValue"
+
+def test_response_dependency_old_style():
+    response = client.get("/test-response-old")
+    assert response.status_code == 200
+    assert response.headers["X-Custom-Header"] == "CustomValue"
+
+def test_response_normal():
+    response = client.get("/test-response-normal")
+    assert response.status_code == 200

+from rich.markup import render
+
+test_cases = [
+    ("Hello \\\\", "Hello \\"),
+    ("Hello \\\\\\\\", "Hello \\\\"),
+    ("Hello \\", "Hello \\"),
+    ("Hello \\[", "Hello ["),
+    ("Hello \\\\ [", "Hello \\ ["),
+]
+
+for markup, expected in test_cases:
+    result = render(markup).plain
+    print(f"Markup: {markup!r} | Expected: {expected!r} | Result: {result!r} | {'PASS' if result == expected else 'FAIL'}")

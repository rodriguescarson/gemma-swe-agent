+import re
+# RE_TAGS = re.compile(r"(((\\*)\[([a-z#/@][^[]*?])])", re.VERBOSE)
+# Wait, the read_file output showed:
+# RE_TAGS = re.compile(
+#     r\"\"\"((\\*)\[([a-z#/@][^[]*?])])\"\"\",
+#     re.VERBOSE,
+# )
+# Let's test it.
+pattern = r"(((\\*)\[([a-z#/@][^[]*?])])" # This is not what was in the file.
+# The file has r\"\"\"((\\*)\[([a-z#/@][^[]*?])])\"\"\"
+# In Python r\"\"\"...\"\"\", \\ means literal backslash.
+# So (\\*) means zero or more backslashes.
+# Then \[ means a literal [.
+# Then ([a-z#/@][^[]*?) means a tag name.
+# Then ] means a literal ].
+
+# So it matches: <zero or more backslashes><[><tag name><]>

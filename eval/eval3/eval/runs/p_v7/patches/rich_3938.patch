--- a/rich/console.py
+++ b/rich/console.py
@@ -1741,6 +1741,24 @@ class Console:
                     new_segments, self.width, pad=False
                 ):
                     buffer_extend(line)
+            elif soft_wrap:
+                # When soft_wrap is True, we disable word wrapping and cropping,
+                # but we still want to ensure that background styles are
+                # preserved. The best way to do this is to use split_and_crop_lines
+                # with a very large width to avoid cropping, and then manually
+                # pad any lines that are shorter than the console width.
+                # But since split_and_crop_lines only splits by \n, we can just
+                # iterate over the lines and pad them.
+                for line in Segment.split_and_crop_lines(
+                    new_segments, 10**9, pad=False
+                ):
+                    # Pad the line to self.width if it's shorter
+                    line_length = sum(segment.cell_length for segment in line)
+                    if line_length < self.width:
+                        # Use the style of the last segment for padding
+                        padding_style = line[-1].style if line else None
+                        line.append(Segment(" " * (self.width - line_length), padding_style))
+                    self._buffer.extend(line)
             else:
                 self._buffer.extend(new_segments)
 

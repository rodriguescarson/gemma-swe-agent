diff --git a/tests/test_on_event_reimpl.py b/tests/test_on_event_reimpl.py
new file mode 100644
index 00000000..2ecce843
--- /dev/null
+++ b/tests/test_on_event_reimpl.py
@@ -0,0 +1,35 @@
+
+from fastapi import FastAPI
+import pytest
+from httpx import ASGITransport, AsyncClient
+
+app = FastAPI()
+startup_called = False
+shutdown_called = False
+
+@app.on_event("startup")
+async def startup_event():
+    global startup_called
+    startup_called = True
+
+@app.on_event("shutdown")
+async def shutdown_event():
+    global shutdown_called
+    shutdown_called = True
+
+@app.get("/")
+async def read_root():
+    return {"hello": "world"}
+
+@pytest.mark.asyncio
+async def test_on_event_startup_shutdown():
+    global startup_called, shutdown_called
+    startup_called = False
+    shutdown_called = False
+    
+    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as ac:
+        response = await ac.get("/")
+        assert response.status_code == 200
+        assert startup_called is True
+    
+    assert shutdown_called is True

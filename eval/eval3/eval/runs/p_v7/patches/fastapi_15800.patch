diff --git a/tests/test_frontend.py b/tests/test_frontend.py
new file mode 100644
index 000000000..c4bf0fb35
--- /dev/null
+++ b/tests/test_frontend.py
@@ -0,0 +1,52 @@
+
+from fastapi import FastAPI, APIRouter
+from fastapi.staticfiles import StaticFiles
+from fastapi.testclient import TestClient
+import os
+import shutil
+import pytest
+
+def test_fastapi_frontend():
+    app = FastAPI()
+    dist_dir = "test_dist"
+    os.makedirs(dist_dir, exist_ok=True)
+    with open(os.path.join(dist_dir, "index.html"), "w") as f:
+        f.write("Hello Frontend")
+    
+    try:
+        app.frontend("/", directory=dist_dir)
+        client = TestClient(app)
+        response = client.get("/")
+        assert response.status_code == 200
+        assert response.text == "Hello Frontend"
+    finally:
+        shutil.rmtree(dist_dir)
+
+def test_apirouter_frontend():
+    app = FastAPI()
+    router = APIRouter()
+    dist_dir = "test_dist_router"
+    os.makedirs(dist_dir, exist_ok=True)
+    with open(os.path.join(dist_dir, "index.html"), "w") as f:
+        f.write("Hello Router Frontend")
+    
+    try:
+        router.frontend("/static", directory=dist_dir)
+        app.include_router(router)
+        client = TestClient(app)
+        response = client.get("/static")
+        assert response.status_code == 200
+        assert response.text == "Hello Router Frontend"
+    finally:
+        shutil.rmtree(dist_dir)
+
+if __name__ == "__main__":
+    # Basic manual test execution
+    try:
+        test_fastapi_frontend()
+        print("test_fastapi_frontend passed")
+        test_apirouter_frontend()
+        print("test_apirouter_frontend passed")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)

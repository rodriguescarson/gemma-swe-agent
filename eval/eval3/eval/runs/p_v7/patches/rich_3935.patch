+from rich.console import Console
+from rich.padding import Padding
+from rich.text import Text
+
+def test_padding_width_overflow():
+    # Small console width
+    console = Console(width=10)
+    # Padding that exceeds console width
+    # renderable width (1) + left(10) + right(10) = 21 > 10
+    padding = Padding(Text("X"), (0, 10, 0, 10), expand=False)
+    
+    console.print(padding)
+
+if __name__ == "__main__":
+    test_padding_width_overflow()

@@ -0,0 +1,39 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+app = FastAPI(
+    responses={
+        500: {
+            'model': ModelA | ModelB,
+            'content': {"application/json": {
+                'examples': {"Case A": {"value": "a"}}
+            }}
+        }
+    }
+)
+
+@app.get('/route1')
+def route1():
+    return "test"
+
+@app.get('/route2')
+def route2():
+    return "test"
+
+@app.get('/route3')
+def route3():
+    return "test"
+
+# Manually trigger OpenAPI generation
+openapi_schema = app.openapi()
+responses_500 = openapi_schema["paths"]["/route1"]["get"]["responses"]["500"]
+any_of_count = len(responses_500["content"]["application/json"]["schema"]["anyOf"])
+print(f"anyOf count: {any_of_count}")
+assert any_of_count == 2, f"Expected 2 items in anyOf, got {any_of_count}"

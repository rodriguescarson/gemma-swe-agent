+import unittest
+from rich.cells import cell_len, chop_cells
+
+class TestGraphemes(unittest.TestCase):
+    def test_complex_emoji_width(self):
+        # Family emoji: 👨‍👩‍👧‍👦
+        text = "👨‍👩‍👧‍👦"
+        width = cell_len(text)
+        print(f"Width of {text}: {width}")
+        self.assertGreater(width, 0)
+
+    def test_chop_cells_grapheme(self):
+        # Family emoji: 👨‍👩‍👧‍👦
+        text = "👨‍👩‍👧‍👦"
+        # If the grapheme is treated as one unit, it should not be split.
+        # Even if the width is 1, the entire grapheme should stay together.
+        result = chop_cells(text, 1)
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0], text)
+
+    def test_mixed_content(self):
+        text = "Hello 👨‍👩‍👧‍👦 World"
+        # Force a chop that would split the emoji if it weren't handled as a grapheme.
+        # "Hello " is 6 cells.
+        result = chop_cells(text, 6)
+        # First line should be "Hello "
+        self.assertEqual(result[0], "Hello ")
+        # Second line should start with the full emoji
+        self.assertTrue(result[1].startswith("👨‍👩‍👧‍👦"))
+
+if __name__ == "__main__":
+    unittest.main()

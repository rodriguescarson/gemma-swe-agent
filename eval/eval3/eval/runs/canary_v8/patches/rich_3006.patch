new file mode 100644
index 00000000..8cc6ce9c
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,40 @@
+import inspect
+from typing import Type
+
+class CustomParam:
+    def __init__(self, value):
+        self.value = value
+    def __eq__(self, other):
+        return True # This will cause param.default == param.empty to be True
+    def __repr__(self):
+        return f"CustomParam({self.value})"
+
+def test_auto_rich_repr_logic(cls):
+    try:
+        signature = inspect.signature(cls.__init__)
+        for name, param in signature.parameters.items():
+            print(f"Param {name}: kind={param.kind}, default={param.default}")
+            if param.kind == param.POSITIONAL_ONLY:
+                print(f"  -> POSITIONAL_ONLY")
+            elif param.kind in (param.POSITIONAL_OR_KEYWORD, param.KEYWORD_ONLY):
+                if param.default == param.empty:
+                    print(f"  -> default is empty")
+                else:
+                    print(f"  -> default is {param.default}")
+    except Exception as e:
+        print(f"Error: {e}")
+
+class MyClass1:
+    def __init__(self, a, b=1):
+        self.a = a
+        self.b = b
+
+class MyClass2:
+    def __init__(self, a, b=CustomParam(1)):
+        self.a = a
+        self.b = b
+
+print("Testing MyClass1:")
+test_auto_rich_repr_logic(MyClass1)
+print("\nTesting MyClass2:")
+test_auto_rich_repr_logic(MyClass2)

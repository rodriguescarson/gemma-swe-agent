diff --git a/test_repr_fix_fixed.py b/test_repr_fix_fixed.py
new file mode 100644
index 00000000..dc547b9e
--- /dev/null
+++ b/test_repr_fix_fixed.py
@@ -0,0 +1,28 @@
+import inspect
+from rich.repr import auto
+from typing import Type
+
+class CustomParam:
+    def __init__(self, value):
+        self.value = value
+    def __eq__(self, other):
+        return True
+    def __repr__(self):
+        return f"CustomParam({self.value})"
+
+@auto
+class MyClass:
+    def __init__(self, a, b=CustomParam(1)):
+        self.a = a
+        self.b = b
+
+def test_rich_repr():
+    obj = MyClass(1, CustomParam(2))
+    repr_val = repr(obj)
+    print(f"Repr: {repr_val}")
+    if "b=CustomParam(2)" not in repr_val:
+        print("BUG FOUND: 'b=' is missing")
+    else:
+        print("BUG NOT FOUND: 'b=' is present")
+
+test_rich_repr()

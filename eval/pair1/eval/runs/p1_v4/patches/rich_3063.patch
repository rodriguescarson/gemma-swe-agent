@@ -0,0 +1,13 @@
+from rich.markup import render
+
+# Use a different way to represent trailing backslash to avoid Python syntax issues
+test_cases = [
+    ("foo" + "\\", "foo" + "\\"),
+    ("foo" + "\\\\", "foo" + "\\\\"),
+    ("foo" + "\\[", "foo" + "["),
+    ("foo" + "\\\\[", "foo" + "\\["),
+]
+
+for input_text, expected in test_cases:
+    result = render(input_text).plain
+    print(f"Input: {repr(input_text)} | Expected: {repr(expected)} | Result: {repr(result)} | {'PASS' if result == expected else 'FAIL'}")

@@ -0,0 +1,25 @@
+import pytest
+import requests
+from requests.models import PreparedRequest
+
+def test_excess_leading_slashes():
+    # Testing that multiple leading slashes in the path are trimmed to a single slash
+    url = "http://example.com//path"
+    req = requests.Request("GET", url).prepare()
+    # req.path_url should be the path part of the URL, handled by RequestEncodingMixin.path_url
+    assert req.path_url == "/path"
+
+    url2 = "http://example.com///another/path"
+    req2 = requests.Request("GET", url2).prepare()
+    assert req2.path_url == "/another/path"
+
+    url3 = "http://example.com/"
+    req3 = requests.Request("GET", url3).prepare()
+    assert req3.path_url == "/"
+
+    url4 = "http://example.com"
+    req4 = requests.Request("GET", url4).prepare()
+    assert req4.path_url == "/"
+
+if __name__ == "__main__":
+    pytest.main([__file__])

+++ b/tests/test_leading_slashes.py
@@ -0,0 +1,25 @@
+import requests
+from requests.models import PreparedRequest
+
+def test_excess_leading_slashes():
+    # Test with multiple leading slashes in the path
+    url = "http://example.com//path"
+    req = requests.Request("GET", url).prepare()
+    # The path_url should have only one leading slash
+    assert req.path_url == "/path"
+
+    url = "http://example.com///double/slash"
+    req = requests.Request("GET", url).prepare()
+    assert req.path_url == "/double/slash"
+
+    url = "http://example.com/"
+    req = requests.Request("GET", url).prepare()
+    assert req.path_url == "/"
+
+if __name__ == "__main__":
+    try:
+        test_excess_leading_slashes()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)

@@ -0,0 +1,37 @@
+
+import functools
+from typing import ForwardRef
+from fastapi.dependencies.utils import get_typed_signature
+
+def test_wrapped_method_type_inference():
+    # We need the forward reference to be in a place where the wrapper's globals
+    # cannot find it, but the wrapped function's globals can.
+    
+    def outer():
+        class LocalModel:
+            pass
+
+        def original_func(item: "LocalModel"):
+            return item
+
+        def wrap(func):
+            @functools.wraps(func)
+            def wrapper(*args, **kwargs):
+                return func(*args, **kwargs)
+            return wrapper
+
+        wrapped_func = wrap(original_func)
+        
+        # Now we call get_typed_signature on wrapped_func.
+        # wrapped_func.__globals__ will be outer's globals (which might contain LocalModel if it's defined in outer).
+        # Wait, if LocalModel is in outer, it's in outer's locals, not globals.
+        # This is tricky. Let's try to simulate what happens in a real module.
+        
+        return wrapped_func
+
+if __name__ == "__main__":
+    # The issue report says NameError: name 'ForwardRef' is not defined.
+    # This usually happens when the evaluation of the forward reference 
+    # uses a globalns that doesn't have the necessary types or the 
+    # original name of the class.
+    pass

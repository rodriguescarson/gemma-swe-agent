diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..ccbcdb2a
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,24 @@
+from fastapi import FastAPI
+import asyncio
+
+def s_start():
+    print("SYNC START", flush=True)
+
+async def s_stop():
+    print("ASYNC STOP", flush=True)
+
+async def main():
+    app = FastAPI(on_startup=[s_start], on_shutdown=[s_stop])
+
+    @app.get("/health")
+    async def health():
+        return {"ok": True}
+
+    # We need to trigger the lifespan events. 
+    # In a real app, uvicorn does this. Here we simulate it.
+    from fastapi.testclient import TestClient
+    with TestClient(app) as client:
+        client.get("/health")
+
+if __name__ == "__main__":
+    asyncio.run(main())

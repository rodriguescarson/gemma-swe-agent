+from dataclasses import dataclass, field
+from rich.pretty import pprint
+
+@dataclass
+class A:
+    a: int = field(repr=False)
+    b: int = field(repr=False)
+
+obj = A(1, 2)
+print("Testing A(1, 2) with repr=False fields:")
+pprint(obj)

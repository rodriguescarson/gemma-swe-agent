@@ -0,0 +1,15 @@
+from rich.text import Text
+
+def test_private_escape_sequences():
+    # \x1b7 and \x1b8 are private escape sequences for cursor position
+    # They should be stripped and not appear in the output text
+    ansi_text = "Hello \x1b7World\x1b8!"
+    text = Text.from_ansi(ansi_text)
+    assert str(text) == "Hello World!"
+
+    # \x1b0 to \x1b? should be stripped
+    for i in range(0, 64): # 0x00 to 0x3F (which is '?')
+        char = chr(i)
+        ansi_text = f"Start\x1b{char}End"
+        text = Text.from_ansi(ansi_text)
+        assert str(text) == "StartEnd"

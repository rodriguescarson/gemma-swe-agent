@@ -0,0 +1,11 @@
+from rich.live import Live
+import time
+
+print("Starting Live(None)...")
+with Live(None) as live:
+    print("Inside Live context")
+    time.sleep(0.1)
+    live.update(None)
+    print("Updated to None")
+    time.sleep(0.1)
+print("Exiting Live context")

diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..a78bbb8f
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,14 @@
+from rich.live import Live
+from rich.panel import Panel
+import time
+
+print("Starting live...")
+with Live(Panel("Initial")) as live:
+    time.sleep(0.1)
+    print("Updating to None...")
+    live.update(None)
+    time.sleep(0.1)
+    print("Updating back to Panel...")
+    live.update(Panel("Back"))
+    time.sleep(0.1)
+print("Finished live")

+import pytest
+from rich.text import Text
+
+def test_private_escape_sequences():
+    # \x1b7 and \x1b8 are commonly used for cursor store/restore
+    # \x1b0 to \x1b? should be stripped
+    ansi_text = "Hello \x1b7World\x1b8!"
+    text = Text.from_ansi(ansi_text)
+    assert str(text) == "Hello World!"
+
+    ansi_text = "Test \x1b0\x1b1\x1b2\x1b3\x1b4\x1b5\x1b6\x1b7\x1b8\x1b9\x1ba\x1bb\x1bc\x1bd\x1be\x1bf\x1bg\x1bh\x1b9\x1b?Text"
+    text = Text.from_ansi(ansi_text)
+    assert str(text) == "Test Text"
+
+def test_private_escape_sequences_with_others():
+    # Mix of private escapes and standard SGR (e.g., bold \x1b[1m)
+    ansi_text = "Normal \x1b[1mBold\x1b[0m \x1b7Private\x1b8 End"
+    text = Text.from_ansi(ansi_text)
+    assert str(text) == "Normal Bold Private End"

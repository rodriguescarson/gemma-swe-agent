+from rich.pretty import pprint
+
+class CustomList(list):
+    def __eq__(self, other):
+        return True
+    def __len__(self):
+        return 0
+
+# This is a container.
+# In rich/pretty.py:
+# open_brace, close_brace, empty = _BRACES[obj_type](obj)
+# if reached_max_depth: ...
+# elif obj_type.__repr__ != type(obj).__repr__: ...
+# elif obj:
+#     # iterate children
+# else:
+#     node = Node(empty=empty, children=[], last=root)
+
+# If we have CustomList(), then 'elif obj' is False (because __len__ is 0).
+# So it goes to the 'else' block: node = Node(empty=empty, children=[], last=root)
+# For a list, empty is '[]'.
+# So it returns '[]'.
+# This is CORRECT for an empty list.
+
+# But what if the user WANTED it to be treated as NOT empty, but it has __len__=0?
+# No, that's usually how empty is defined.
+
+# What if 'obj' is something that is TRUTHY but we WANT it to be treated as empty?
+# No, that's not the issue.
+
+# "When repr'ing classes that have overwritten __eq__ as parameters, the check with == Parameters.empty can be True."
+# Maybe "Parameters" is a class they are using in their project.
+# a = Parameters()
+# a.__eq__(anything) is True.
+# If rich does: if obj == some_sentinel:
+# it will be True.
+
+# But where does rich do that?
+# I searched for '==' and didn't find it.

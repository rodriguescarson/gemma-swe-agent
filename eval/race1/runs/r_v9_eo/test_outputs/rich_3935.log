    def test_vertical_align_top():
        console = Console(_environ={})
    
        def make_table(vertical_align):
            table = Table(show_header=False, box=box.SQUARE)
            table.add_column(vertical=vertical_align)
            table.add_row("foo", "\n".join(["bar"] * 5))
    

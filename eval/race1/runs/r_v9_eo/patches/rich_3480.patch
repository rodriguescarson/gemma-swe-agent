+from rich.console import Console
+from rich.containers import Renderables
+
+def test_circular_append():
+    console = Console()
+    r = Renderables()
+    r.append(r)
+    try:
+        console.print(r)
+        print("Failed: No RecursionError raised")
+    except RecursionError:
+        print("Success: RecursionError raised (this is what we want to fix)")
+    except ValueError as e:
+        print(f"Success: Caught expected ValueError: {e}")
+
+if __name__ == "__main__":
+    test_circular_append()

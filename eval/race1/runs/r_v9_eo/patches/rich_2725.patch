@@ -0,0 +1,51 @@
+
+from rich.table import Table
+from rich.box import Box
+from rich.console import Console
+from rich.segment import Segment
+
+def test_box_rendering_order():
+    console = Console(force_terminal=True, width=100)
+    
+    # Custom box characters to easily identify segments
+    custom_box = Box(
+        head_left='1', head_vertical='2', head_right='3',
+        mid_left='4', mid_vertical='5', mid_right='6',
+        foot_left='7', foot_vertical='8', foot_right='9'
+    )
+    
+    table = Table(box=custom_box, show_header=True, show_foot=False)
+    table.add_column("Col1")
+    table.add_column("Col2")
+    table.add_row("Row1-1", "Row1-2")
+    table.add_row("Row2-1", "Row2-2")
+    
+    # We capture the output. 
+    # The first row (header) should use head (1, 2, 3)
+    # Middle rows should use mid (4, 5, 6)
+    # Last row should use foot (7, 8, 9)
+    
+    import io
+    from rich.console import Console
+    sys.stdout = io.StringIO()
+    console.print(table)
+    output = sys.stdout.getvalue()
+    sys.stdout = sys.__stdout__
+    
+    print(output)
+    # Check that '4' (mid_left) appears before '7' (foot_left)
+    # and that '7' appears in the last row.
+    assert output.find('4') < output.find('7')
+    assert output.rfind('7') > output.rfind('4')
+
+if __name__ == "__main__":
+    import sys
+    try:
+        test_box_rendering_order()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        sys.exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        sys.exit(1)

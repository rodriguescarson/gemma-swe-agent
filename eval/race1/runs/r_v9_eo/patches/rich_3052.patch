diff --git a/test_case_insensitive.py b/test_case_insensitive.py
new file mode 100644
index 00000000..e559ab1d
--- /dev/null
+++ b/test_case_insensitive.py
@@ -0,0 +1,24 @@
+from rich.prompt import Prompt
+from unittest.mock import patch
+import io
+
+def test_case_sensitive_prompt():
+    with patch('rich.console.Console.input', return_value='Paul'):
+        assert Prompt.ask("Name", choices=["Paul", "Jessica"], case_sensitive=True) == "Paul"
+
+def test_case_insensitive_prompt_match():
+    with patch('rich.console.Console.input', return_value='paul'):
+        # Should accept 'paul' if case_sensitive=False
+        assert Prompt.ask("Name", choices=["Paul", "Jessica"], case_sensitive=False) == "paul"
+
+if __name__ == "__main__":
+    try:
+        test_case_sensitive_prompt()
+        test_case_insensitive_prompt_match()
+        print("Tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        exit(1)

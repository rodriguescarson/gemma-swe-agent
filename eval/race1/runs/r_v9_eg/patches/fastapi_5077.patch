+++ b/tests/test_wrapped_method_forward_reference.py
@@ -0,0 +1,30 @@
+import functools
+from typing import ForwardRef
+import pytest
+from fastapi.dependencies.utils import get_typed_signature
+
+# This is a dummy class to create a forward reference
+class Item:
+    def __init__(self, name: str):
+        self.name = name
+
+def wrapper(func):
+    @functools.wraps(func)
+    def wrapped(*args, **kwargs):
+        return func(*args, **kwargs)
+    return wrapped
+
+def test_wrapped_method_type_inference():
+    @wrapper
+    def my_endpoint(item: "Item"):
+        return {"name": item.name}
+
+    # This should not raise NameError
+    signature = get_typed_signature(my_endpoint)
+    
+    params = list(signature.parameters.values())
+    assert params[0].name == "item"
+    assert params[0].annotation is Item
+
+if __name__ == "__main__":
+    test_wrapped_method_type_inference()

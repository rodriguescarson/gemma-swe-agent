+from rich.ansi import re_ansi
+import re
+
+def test_private_escape_sequences():
+    # \x1b7 and \x1b8 are private escape sequences for store/restore cursor position
+    # They should be matched by re_ansi so they can be stripped
+    assert re_ansi.search("\x1b7") is not None
+    assert re_ansi.search("\x1b8") is not None
+    # \x1b0 is also in the private range
+    assert re_ansi.search("\x1b0") is not None
+    # \x1b? is also in the private range
+    assert re_ansi.search("\x1b?") is not None
+    # \x1b@ should still be matched (it's part of the existing range)
+    assert re_ansi.search("\x1b@") is not None

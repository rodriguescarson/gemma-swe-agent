diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..f17436f0
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,39 @@
+
+from fastapi import FastAPI
+import asyncio
+
+async def s_start():
+    print("SYNC START", flush=True)
+    s_start.called = True
+
+async def s_shutdown():
+    print("SYNC SHUTDOWN", flush=True)
+    s_shutdown.called = True
+
+s_start.called = False
+s_shutdown.called = False
+
+async def run_test():
+    app = FastAPI(on_startup=[s_start], on_shutdown=[s_shutdown])
+    
+    # Access the lifespan context directly
+    lifespan_ctx = app.router.lifespan_context
+    
+    async with lifespan_ctx(app):
+        pass
+        
+    assert s_start.called, "Startup event was not called"
+    assert s_shutdown.called, "Shutdown event was not called"
+    print("Test passed!")
+
+if __name__ == "__main__":
+    try:
+        asyncio.run(run_test())
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An unexpected error occurred: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

+import functools
+import asyncio
+import pytest
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+
+# 1. Plain function partial
+def plain_dep(a: int = 1):
+    return {"a": a}
+
+# 2. Async function partial
+async def async_dep(a: int = 1):
+    return {"a": a}
+
+# 3. Generator function partial
+def gen_dep(a: int = 1):
+    try:
+        yield {"a": a}
+    finally:
+        pass
+
+# 4. Callable class partial
+class CallableDep:
+    def __init__(self, a: int = 1):
+        self.a = a
+    def __call__(self, b: int = 2):
+        return {"a": self.a, "b": b}
+
+app = FastAPI()
+
+partial_plain = functools.partial(plain_dep, a=10)
+partial_async = functools.partial(async_dep, a=20)
+partial_gen = functools.partial(gen_dep, a=30)
+partial_class = functools.partial(CallableDep(a=40), b=50)
+
+@app.get("/plain")
+def read_plain(res = Depends(partial_plain)):
+    return res
+
+@app.get("/async")
+async def read_async(res = Depends(partial_async)):
+    return res
+
+@app.get("/gen")
+async def read_gen(res = Depends(partial_gen)):
+    return res
+
+@app.get("/class")
+async def read_class(res = Depends(partial_class)):
+    return res
+
+client = TestClient(app)
+
+def test_partial_plain():
+    response = client.get("/plain")
+    assert response.status_code == 200
+    assert response.json() == {"a": 10}
+
+def test_partial_async():
+    response = client.get("/async")
+    assert response.status_code == 200
+    assert response.json() == {"a": 20}
+
+def test_partial_gen():
+    response = client.get("/gen")
+    assert response.status_code == 200
+    assert response.json() == {"a": 30}
+
+def test_partial_class():
+    response = client.get("/class")
+    assert response.status_code == 200
+    assert response.json() == {"a": 40, "b": 50}

new file mode 100644
index 00000000..9895d877
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,24 @@
+
+from fastapi import Response, Depends, FastAPI
+from typing import Annotated
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+def modify_response(response: Response):
+    response.headers['X-Custom'] = 'True'
+    return response
+
+@app.get('/')
+def endpoint(response: Annotated[Response, Depends(modify_response)]):
+    return {'ok': True}
+
+def test_response_dependency():
+    client = TestClient(app)
+    r = client.get('/')
+    assert r.status_code == 200
+    assert r.headers.get('X-Custom') == 'True'
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__])
diff --git a/tests/test_response_dependency.py b/tests/test_response_dependency.py
new file mode 100644
index 00000000..b60531c2
--- /dev/null
+++ b/tests/test_response_dependency.py
@@ -0,0 +1,42 @@
+from fastapi import FastAPI, Depends, Response
+from fastapi.testclient import TestClient
+from typing import Annotated
+
+def test_response_depends():
+    app = FastAPI()
+    def modify_response():
+        return Response(content="Custom Response", media_type="text/plain")
+
+    @app.get("/response-depends")
+    def endpoint(response: Annotated[Response, Depends(modify_response)]):
+        return response
+
+    client = TestClient(app)
+    response = client.get("/response-depends")
+    assert response.status_code == 200
+    assert response.text == "Custom Response"
+
+def test_response_depends_default():
+    app = FastAPI()
+    def modify_response():
+        return Response(content="Custom Response", media_type="text/plain")
+
+    @app.get("/response-depends-default")
+    def endpoint_default(response: Response = Depends(modify_response)):
+        return response
+
+    client = TestClient(app)
+    response = client.get("/response-depends-default")
+    assert response.status_code == 200
+    assert response.text == "Custom Response"
+
+def test_response_normal():
+    app = FastAPI()
+    @app.get("/response-normal")
+    def endpoint_normal(response: Response):
+        return {"message": "normal"}
+
+    client = TestClient(app)
+    response = client.get("/response-normal")
+    assert response.status_code == 200
+    assert response.json() == {"message": "normal"}

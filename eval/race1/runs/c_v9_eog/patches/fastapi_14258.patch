+from fastapi import APIRouter, FastAPI
+from fastapi.exceptions import FastAPIError
+import pytest
+
+def test_include_router_self():
+    router = APIRouter()
+    with pytest.raises(FastAPIError) as excinfo:
+        router.include_router(router)
+    assert str(excinfo.value) == "You cannot include a router into itself"
+
+def test_fastapi_include_router_self():
+    app = FastAPI()
+    with pytest.raises(FastAPIError) as excinfo:
+        app.include_router(app)
+    assert str(excinfo.value) == "You cannot include a router into itself"
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__])

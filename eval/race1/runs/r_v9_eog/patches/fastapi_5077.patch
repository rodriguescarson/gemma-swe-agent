@@ -0,0 +1,28 @@
+import functools
+import pytest
+from fastapi import FastAPI, Depends
+from fastapi.dependencies.utils import get_typed_signature
+from typing import Annotated, ForwardRef
+
+class Model:
+    pass
+
+def get_model() -> "Model":
+    return Model()
+
+def wrapper(func):
+    @functools.wraps(func)
+    def wrapped(*args, **kwargs):
+        return func(*args, **kwargs)
+    return wrapped
+
+@wrapper
+def endpoint(item: Annotated[str, Depends(get_model)]):
+    return item
+
+def test_wrapped_method_type_inference():
+    # This should not raise NameError for 'Model'
+    signature = get_typed_signature(endpoint)
+    # Ensure the annotation is evaluated (get_typed_signature calls get_typed_annotation)
+    # which in turn calls evaluate_forwardref.
+    assert signature.parameters["item"].annotation is not None

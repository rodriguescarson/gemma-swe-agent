+def is_async_callable_unwrapped(func: Any) -> bool:
+    unwrapped = func
+    while True:
+        prev = unwrapped
+        unwrapped = inspect.unwrap(unwrapped)
+        if isinstance(unwrapped, functools.partial):
+            unwrapped = unwrapped.func
+        if unwrapped is prev:
+            break
+    return is_async_callable(unwrapped)

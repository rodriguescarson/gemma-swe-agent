index 00000000..a4c00c0a
--- /dev/null
+++ b/tests/test_dependencies_wraps_partial.py
@@ -0,0 +1,112 @@
+import asyncio
+import functools
+import inspect
+import pytest
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+from starlette.responses import Response
+from fastapi.routing import is_async_callable_unwrapped
+
+async def async_func():
+    return "async"
+
+def sync_func():
+    return "sync"
+
+def wrapper(f):
+    @functools.wraps(f)
+    def wrapped(*args, **kwargs):
+        return f(*args, **kwargs)
+    return wrapped
+
+async def async_wrapper(f):
+    @functools.wraps(f)
+    async def wrapped(*args, **kwargs):
+        return await f(*args, **kwargs)
+    return wrapped
+
+def test_wraps_partial_async_dependency():
+    app = FastAPI()
+
+    # Combine wraps and partial
+    # Case 1: async function wrapped then partialed
+    wrapped_async = wrapper(async_func)
+    partial_wrapped_async = functools.partial(wrapped_async)
+
+    @app.get("/")
+    async def root(dep = Depends(partial_wrapped_async)):
+        return {"dep": dep}
+
+    client = TestClient(app)
+    response = client.get("/")
+    assert response.status_code == 200
+    assert response.json() == {"dep": "async"}
+
+def test_wraps_partial_sync_dependency():
+    app = FastAPI()
+
+    # Case 2: sync function wrapped then partialed
+    wrapped_sync = wrapper(sync_func)
+    partial_wrapped_sync = functools.partial(wrapped_sync)
+
+    @app.get("/")
+    async def root(dep = Depends(partial_wrapped_sync)):
+        return {"dep": dep}
+
+    client = TestClient(app)
+    response = client.get("/")
+    assert response.status_code == 200
+    assert response.json() == {"dep": "sync"}
+
+def test_partial_wraps_async_dependency():
+    app = FastAPI()
+
+    # Case 3: partialed first then wrapped
+    partial_async = functools.partial(async_func)
+    wrapped_partial_async = wrapper(partial_async)
+
+    @app.get("/")
+    async def root(dep = Depends(wrapped_partial_async)):
+        return {"dep": dep}
+
+    client = TestClient(app)
+    response = client.get("/")
+    assert response.status_code == 200
+    assert response.json() == {"dep": "async"}
+
+def test_complex_nesting_async():
+    app = FastAPI()
+
+    # Multi layer
+    f = async_func
+    f = wrapper(f)
+    f = functools.partial(f)
+    f = wrapper(f)
+    f = functools.partial(f)
+
+    @app.get("/")
+    async def root(dep = Depends(f)):
+        return {"dep": dep}
+
+    client = TestClient(app)
+    response = client.get("/")
+    assert response.status_code == 200
+    assert response.json() == {"dep": "async"}
+
+def test_routing_unwrapped_async_detection():
+    # Test that it correctly identifies partially wrapped async functions
+    async def async_func_to_test():
+        return "success"
+    
+    wrapped = wrapper(async_func_to_test)
+    partial = functools.partial(wrapped)
+    
+    assert is_async_callable_unwrapped(partial) is True
+    
+    def sync_func_to_test():
+        return "success"
+    
+    wrapped_sync = wrapper(sync_func_to_test)
+    partial_sync = functools.partial(wrapped_sync)
+    
+    assert is_async_callable_unwrapped(partial_sync) is False

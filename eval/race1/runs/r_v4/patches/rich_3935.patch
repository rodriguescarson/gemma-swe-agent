+import io
+from rich.console import Console
+from rich.padding import Padding
+from rich.text import Text
+
+# The key to reproduing the issue is to have a renderable that DOES NOT 
+# expand to the width provided in render_options.
+# Text does not expand by default.
+# If Padding(expand=True), the result should be width 20.
+# But if Text is "Hello" (width 5), and left=1, right=1.
+# padding.left (1) + text (5) + padding.right (1) = 7.
+# If expand=True, we expect the line to be 20.
+
+si = io.StringIO()
+console = Console(width=20, file=si)
+text = Text("Hello")
+padding = Padding(text, pad=(1, 1, 1, 1), expand=True)
+console.print(padding)
+
+output = si.getvalue()
+lines = output.splitlines()
+print(f"Total lines: {len(lines)}")
+for i, line in enumerate(lines):
+    print(f"Line {i}: '{line}' (length {len(line)})")

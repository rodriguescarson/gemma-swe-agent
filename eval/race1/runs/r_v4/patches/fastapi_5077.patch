--- /dev/null
+++ b/tests/test_wrapped_method_forward_reference.py
@@ -0,0 +1,22 @@
+
+import functools
+from typing import ForwardRef
+from fastapi.dependencies.utils import get_typed_signature
+
+class Model:
+    pass
+
+def original_func(a: "Model"):
+    return a
+
+@functools.wraps(original_func)
+def wrapper(a: "Model"):
+    return original_func(a)
+
+def test_wrapped_method_type_inference():
+    signature = get_typed_signature(wrapper)
+    assert signature.parameters["a"].annotation is Model
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__])

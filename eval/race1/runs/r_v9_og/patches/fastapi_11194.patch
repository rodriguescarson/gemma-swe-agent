diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..fc1b3da3
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,19 @@
+from fastapi import FastAPI, File, Form, UploadFile
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.post('/test')
+async def test_endpoint(form_data: str = Form(...), file: UploadFile = File(...)):
+    return {'form_data': form_data, 'file': file.filename}
+
+client = TestClient(app)
+
+def test_order():
+    response = client.post('/test', data={'form_data': 'hello'}, files={'file': ('test.txt', b'content')})
+    print(f"Status: {response.status_code}")
+    print(f"Body: {response.json()}")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    test_order()

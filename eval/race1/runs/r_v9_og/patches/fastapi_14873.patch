diff --git a/tests/test_reproduce_issue.py b/tests/test_reproduce_issue.py
new file mode 100644
index 00000000..57e11cde
--- /dev/null
+++ b/tests/test_reproduce_issue.py
@@ -0,0 +1,32 @@
+from fastapi import FastAPI
+import pytest
+import asyncio
+
+def s_start():
+    print("SYNC START", flush=True)
+    s_start.called = True
+s_start.called = False
+
+@pytest.mark.asyncio
+async def test_on_startup_called():
+    app = FastAPI(on_startup=[s_start])
+
+    # Using lifespan context manager to trigger startup/shutdown
+    async with app.router.lifespan_context(app):
+        pass
+    
+    assert s_start.called is True
+
+@pytest.mark.asyncio
+async def test_on_shutdown_called():
+    def s_shutdown():
+        print("SYNC SHUTDOWN", flush=True)
+        s_shutdown.called = True
+    s_shutdown.called = False
+
+    app = FastAPI(on_shutdown=[s_shutdown])
+
+    async with app.router.lifespan_context(app):
+        pass
+    
+    assert s_shutdown.called is True

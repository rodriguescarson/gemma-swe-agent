@@ -0,0 +1,61 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+from fastapi.openapi.utils import get_openapi
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+app = FastAPI(
+    responses={
+        500: {
+            'model': ModelA | ModelB,
+            'content': {"application/json": {
+                'examples': {"Case A": {"value": "a"}}
+            }}
+        }
+    }
+)
+
+@app.get('/route1')
+def route1():
+    return "test"
+
+@app.get('/route2')
+def route2():
+    return "test"
+
+@app.get('/route3')
+def route3():
+    return "test"
+
+def test_openapi_duplication():
+    openapi_schema = get_openapi(
+        title=app.title,
+        version=app.version,
+        routes=app.routes,
+        description=app.description,
+    )
+    responses_500 = openapi_schema["paths"]["/route1"]["get"]["responses"]["500"]
+    any_of_list = responses_500["content"]["application/json"]["schema"]["anyOf"]
+    
+    # Each model should appear once. Total 2.
+    # If duplicated 3 times (for 3 routes), it would be 6.
+    assert len(any_of_list) == 2, f"Expected 2 items in anyOf, got {len(any_of_list)}"
+    
+    # Check that all routes have the same number of refs
+    for path in openapi_schema["paths"]:
+        for method in openapi_schema["paths"][path]:
+            any_of = openapi_schema["paths"][path][method]["responses"]["500"]["content"]["application/json"]["schema"]["anyOf"]
+            assert len(any_of) == 2, f"Path {path} {method} has {len(any_of)} items in anyOf"
+
+if __name__ == "__main__":
+    try:
+        test_openapi_duplication()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)

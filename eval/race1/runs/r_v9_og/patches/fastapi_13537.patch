index 00000000..e9a64c97
--- /dev/null
+++ b/tests/test_repro_form_empty_string.py
@@ -0,0 +1,31 @@
+import pytest
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from typing import Optional
+
+app = FastAPI()
+
+@app.post("/form")
+async def handle_form(age: Optional[int] = Form(None)):
+    return {"age": age}
+
+client = TestClient(app)
+
+def test_form_empty_string_optional_none():
+    # When 'age' is sent as an empty string, it should be interpreted as missing
+    # and take the default value (None), rather than attempting to validate "" as an int.
+    response = client.post("/form", data={"age": ""})
+    assert response.status_code == 200
+    assert response.json() == {"age": None}
+
+def test_form_missing_optional_none():
+    # Ensure it still works when the field is actually missing
+    response = client.post("/form", data={})
+    assert response.status_code == 200
+    assert response.json() == {"age": None}
+
+def test_form_value_optional_none():
+    # Ensure it still works when a valid value is provided
+    response = client.post("/form", data={"age": "25"})
+    assert response.status_code == 200
+    assert response.json() == {"age": 25}

diff --git a/tests/test_custom_param.py b/tests/test_custom_param.py
new file mode 100644
index 00000000..2f09c226
--- /dev/null
+++ b/tests/test_custom_param.py
@@ -0,0 +1,45 @@
+import pytest
+import rich.repr
+
+class CustomParam:
+    def __init__(self, value):
+        self.value = value
+    def __eq__(self, other):
+        if isinstance(other, CustomParam):
+            return self.value == other.value
+        return False
+
+def test_custom_param_not_empty():
+    @rich.repr.auto
+    class Foo:
+        def __init__(self, foo, bar=CustomParam(1)):
+            self.foo = foo
+            self.bar = bar
+    
+    # Fixed: param.default (CustomParam(1)) is NOT param.empty.
+    # It yields ('bar', <CustomParam 1>, <CustomParam 1>).
+    # Since they are equal, it is omitted.
+    f = Foo("hello")
+    assert repr(f) == "Foo('hello')"
+
+    # Fixed: Different value should be shown.
+    f2 = Foo("hello")
+    f2.bar = CustomParam(2)
+    assert "bar=" in repr(f2)
+
+def test_custom_param_eq_everything():
+    class AlwaysTrueEq:
+        def __eq__(self, other):
+            return True
+
+    @rich.repr.auto
+    class Foo:
+        def __init__(self, foo, bar=AlwaysTrueEq()):
+            self.foo = foo
+            self.bar = bar
+
+    # Fixed: param.default (AlwaysTrueEq) is NOT param.empty.
+    # It yields ('bar', <AlwaysTrueEq>, <AlwaysTrueEq>).
+    # Since they are equal, it is omitted.
+    f = Foo("hello")
+    assert repr(f) == "Foo('hello')"

@@ -0,0 +1,75 @@
+
+from rich.table import Table
+from rich.console import Console
+from rich.box import Box
+
+console = Console(record=True)
+
+table = Table(box=BOX.SQUARE)
+# Redefine box elements to verify order
+# head: 1, 2, 3
+# mid: 4, 5, 6
+# foot: 7, 8, 9
+table.box.head_left = '1'
+table.box.head_vertical = '2'
+table.box.head_right = '3'
+
+table.box.mid_left = '4'
+table.box.mid_vertical = '5'
+table.box.mid_right = '6'
+
+table.box.foot_left = '7'
+table.box.foot_vertical = '8'
+table.box.foot_right = '9'
+
+table.add_column("Date")
+table.add_column("Title")
+table.add_column("Production")
+table.add_column("Box Office")
+
+table.add_row("Dec 20, 2019", "Star Wars: The Rise of Skywalker", "$275,000,000", "$375,126,118")
+table.add_row("May 25, 2018", "Solo: A Star Wars Story", "$275,000,000", "$393,151,347")
+table.add_row("Dec 15, 2017", "Star Wars Ep. VIII: The Last Jedi", "$262,000,000", "$1,332,539,889")
+
+console.print(table)
+
+output = console.export()
+print(output)
+
+# Note: The issue description shows the header row is actually a data row if show_header=False (default)
+# Wait, if show_header is False, the first row is treated as a body row.
+# The original issue description: "Previously 'mid' box elements appeared in last line of table (footer), while 'footer' box elements appeared mid table body."
+# Let's check if the current code produces the expected output from the issue.
+
+expected_snippets = [
+    "4Dec 20, 2019", # Row 1 (Mid)
+    "7Dec 15, 2017", # Row 3 (Foot)
+]
+
+# If show_header=False, then the first row is just a body row.
+# The issue's example output:
+# +--------------------------------------------------------------------------+
+# 1Date        2Title                            2  Production2    Box Office3
+# |------------ --------------------------------- ------------ --------------|
+# 4Dec 20, 20195Star Wars: The Rise of Skywalker 5$275,000,0005  $375,126,1186
+# 4May 25, 20185Solo: A Star Wars Story          5$275,000,0005  $393,151,3476
+# 7Dec 15, 20178Star Wars Ep. VIII: The Last Jedi8$262,000,0008$1,332,539,8899
+# +--------------------------------------------------------------------------+
+
+# In the above:
+# Row 1: header (1, 2, 3)
+# Row 2: mid (4, 5, 6)
+# Row 3: mid (4, 5, 6)
+# Row 4: foot (7, 8, 9)
+
+# To reproduce this, we need a header.
+# Since the issue example shows "Date Title Production Box Office" as the header, 
+# we should define them as columns and let them render as header.
+# By default, Table has show_header=True.
+
+for snippet in expected_snippets:
+    if snippet not in output:
+        print(f"FAILED: Expected snippet {snippet} not found in output")
+        exit(1)
+
+print("SUCCESS")

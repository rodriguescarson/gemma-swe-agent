+from rich.table import Table
+from rich.box import Box
+from rich.console import Console
+from io import StringIO
+
+def test_box_order():
+    console = Console(file=StringIO(), force_terminal=True, width=100)
+    # Construct a custom box string.
+    # Each line must have exactly 4 characters for unpacking in Box.__init__
+    box_str = (
+        "TLTD\n" # top: top_left, top, top_divider, top_right
+        "1_23\n" # head: head_left, _, head_vertical, head_right
+        "HRHC\n" # head_row
+        "4_56\n" # mid: mid_left, _, mid_vertical, mid_right
+        "RLRC\n" # row
+        "FRFC\n" # foot_row
+        "7_89\n" # foot: foot_left, _, foot_vertical, foot_right
+        "BLBR"  # bottom
+    )
+    table = Table(box=Box(box_str))
+    table.add_column("Col1")
+    table.add_column("Col2")
+    table.add_row("Row1", "Val1")
+    table.add_row("Row2", "Val2")
+    
+    console.print(table)
+    output = console.file.getvalue()
+    print(output)
+
+if __name__ == "__main__":
+    test_box_order()

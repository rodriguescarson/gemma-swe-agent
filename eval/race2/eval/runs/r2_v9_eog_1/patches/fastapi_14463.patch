index 00000000..a6c1c3c0
--- /dev/null
+++ b/tests/test_openapi_duplication.py
@@ -0,0 +1,54 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+import pytest
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+def test_openapi_duplication():
+    app = FastAPI(
+        responses={
+            500: {
+                'model': ModelA | ModelB,
+                'content': {"application/json": {
+                    'examples': {"Case A": {"value": "a"}}
+                }}
+            }
+        }
+    )
+
+    @app.get('/route1')
+    def route1():
+        return "test"
+
+    @app.get('/route2')
+    def route2():
+        return "test"
+
+    @app.get('/route3')
+    def route3():
+        return "test"
+
+    openapi_schema = app.openapi()
+    
+    for path, methods in openapi_schema["paths"].items():
+        for method, operation in methods.items():
+            response_500 = operation["responses"]["500"]
+            schema = response_500["content"]["application/json"]["schema"]
+            any_of = schema.get("anyOf", [])
+            # With 2 models in Union, anyOf should have exactly 2 elements.
+            # If duplication occurs, it will grow as routes increase.
+            assert len(any_of) == 2, f"Expected 2 elements in anyOf for {path}, got {len(any_of)}"
+
+if __name__ == "__main__":
+    # This allows running the test as a script
+    try:
+        test_openapi_duplication()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)

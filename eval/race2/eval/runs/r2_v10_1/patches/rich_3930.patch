+def split_graphemes(text: str) -> Iterator[str]:
+    """Split a string into a sequence of grapheme clusters.
+
+    Args:
+        text (str): The text to split.
+
+    Returns:
+        An iterator of grapheme clusters.
+    """
+    if not text:
+        return
+    grapheme = ""
+    for char in text:
+        if grapheme and (unicodedata.combining(char) or char == "\u200d"):
+            grapheme += char
+        else:
+            if grapheme:
+                yield grapheme
+            grapheme = char
+    if grapheme:
+        yield grapheme
+

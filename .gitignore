.venv/
data/raw/
eval/runs/
eval/kernel_out/
kernels/*/
__pycache__/
.env*
!.env.example
*.safetensors
.DS_Store
backups/
*.tgz
*.tar.gz
.pytest_cache/
kaggle.json
*.pem
id_*

# golden eval runs (docs/eval/GOLDEN_EVALS_SPEC.md 6.1): per-case sandboxes/logs and the bundle copy stay local;
# run.json, cases/<id>.json, traces/ and summaries are small enough to commit
eval/golden/runs/*/cases/*/
eval/golden/runs/*/bundle/
# earlier attempts of re-run cases (--resume keeps their logs and spend) and locally built ablation arms
eval/golden/runs/*/attempts/*/
eval/golden/arms/
# data, collected trajectories, run logs and per-task outputs stay out of git (published separately)
data/graphs
data/embeddings
data/pallets/oracle/
data/pallets/*.jsonl
data/v11/
eval/collect/
eval/preflight/
eval/preflight_train159.out
eval/overnight/
eval/golden/runs/*/traces/
eval/golden/runs/*/grade/*.html
eval/kaggle/*/results/
eval/kaggle/*/bundle/
# adapter weights never enter git (Kaggle datasets carry them: scripts/adapters_dataset.py)
adapters/
submissions/*/adapters/*/adapter_model.safetensors

# SWE-Gym OpenHands-SFT-Trajectories download (train/convert_swegym.py)
data/swegym/

# held-out tasks: raw file is 69 MB (huge parametrized test lists); commit the .gz + sha256
data/heldout1k/tasks.jsonl
data/heldout1k/run*.log
# packed harness dirs (scripts/heldout/pack_heldout.py): snapshots, graphs, wheels; re-derivable, GBs
data/heldout1k/harness_*/
data/heldout1k/preflight_*/
eval/decide_out/
# adapter manifests and PEFT configs are not weights: tracked so the Mac can build the Kaggle kernels (2026-10-13)
!submissions/*/adapters/
!submissions/*/adapters/MANIFEST.json
!submissions/*/adapters/*/
!submissions/*/adapters/*/adapter_config.json
eval/linux_test_out/

# Harness² pilot: candidate bundles staged for the race runner on the box (h2g4/swe.py RaceLauncher)
submissions/_staging/h2_*/

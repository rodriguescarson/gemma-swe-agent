data/v11/
eval/collect/
eval/preflight/
eval/preflight_train159.out
eval/overnight/
eval/golden/runs/*/traces/
eval/golden/runs/*/grade/*.html
eval/kaggle/*/results/
eval/kaggle/*/bundle/
